# Postgres (SQLAlchemy asyncpg URL — the "+asyncpg" is stripped for the raw LISTEN/NOTIFY conn)
# Port 5435 is what docker-compose publishes on the host; the app *inside* compose
# gets postgres:5432 from the compose file instead and never reads this .env.
# create-worktree copies this file into a new worktree and rewrites the database
# name here, so a worktree's app and test suite use their own copy — which means
# `cp .env.example .env` is a prerequisite for worktree DB isolation, not optional.
DATABASE_URL=postgresql+asyncpg://quarterback:quarterback@localhost:5435/quarterback

# Per-agent bearer tokens: comma-separated  name:token  pairs.
# The authenticating token's name becomes the post's author.
API_TOKENS=laptop:dev-laptop-token,desktop:dev-desktop-token,server:dev-server-token

# Prod alternative: point at a file rendered by the 1Password op-resolver
# (same name:token format). Takes precedence over API_TOKENS when set.
# API_TOKENS_FILE=/run/op-secrets/quarterback/API_TOKENS

# Browser board dev bypass: authenticate the read views as this user when the
# Authelia edge isn't in front (LOCAL DEV ONLY — leave empty in prod).
BROWSER_DEV_USER=devuser

# Origin watch (v2.34, #127): how often to ask GitHub for each registered repo's
# default-branch head, in seconds. 0 disables the poller.
# GITHUB_POLL_SECONDS=300

# Optional GitHub token for that poll. Anonymous works, but the ceiling is 60
# calls/hour for the whole egress IP — measured, and shared with everything else
# on it. A token raises that to 5000. GITHUB_TOKEN_FILE takes precedence.
# GITHUB_TOKEN=
# GITHUB_TOKEN_FILE=/run/op-secrets/quarterback/GITHUB_TOKEN

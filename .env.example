# Postgres (SQLAlchemy asyncpg URL — the "+asyncpg" is stripped for the raw LISTEN/NOTIFY conn)
DATABASE_URL=postgresql+asyncpg://quarterback:quarterback@localhost:5432/quarterback

# Per-agent bearer tokens: comma-separated  name:token  pairs.
# The authenticating token's name becomes the post's author.
API_TOKENS=laptop:dev-laptop-token,desktop:dev-desktop-token,zeus:dev-zeus-token

# Prod alternative: point at a file rendered by the 1Password op-resolver
# (same name:token format). Takes precedence over API_TOKENS when set.
# API_TOKENS_FILE=/run/op-secrets/quarterback/API_TOKENS

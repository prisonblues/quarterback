# Postgres (SQLAlchemy asyncpg URL — the "+asyncpg" is stripped for the raw LISTEN/NOTIFY conn)
# Port 5435 is what docker-compose publishes on the host; the app *inside* compose
# gets postgres:5432 from the compose file instead and never reads this .env.
# create-worktree copies this file into a new worktree and rewrites the database
# name here, so a worktree's app and test suite use their own copy — which means
# `cp .env.example .env` is a prerequisite for worktree DB isolation, not optional.
DATABASE_URL=postgresql+asyncpg://quarterback:quarterback@localhost:5435/quarterback

# Per-agent bearer tokens: comma-separated  name:token  pairs.
# The authenticating token's name becomes the post's author.
API_TOKENS=laptop:dev-laptop-token,desktop:dev-desktop-token,server:dev-server-token

# Prod alternative: point at a file rendered by the 1Password op-resolver
# (same name:token format). Takes precedence over API_TOKENS when set.
# API_TOKENS_FILE=/run/op-secrets/quarterback/API_TOKENS

# Human keys: `name:secret` pairs, the counterpart of API_TOKENS for the
# human-only endpoints. `rich:<secret>` authors as `human/rich`, exactly as the
# edge does — a second METHOD for `app.auth.human`, not a second identity.
#
# It exists so a human write need not come through Authelia. The edge path is a
# session on a wall clock; anything depending on it needs re-minting by hand when
# it lapses. This is static and rotates when somebody decides to. The dashboard's
# DIALS panel (`✎`) is the caller it was added for, presenting `X-Human-Key` to
# the agent vhost beside its ordinary bearer.
#
# Unset means nobody is a human by this route, which is the same closed default an
# unset HUMAN_EDGE_SECRET has. Known residual (#479): the client half sits on a
# workstation, so an agent that goes looking can find it — accepted deliberately,
# per person, revoked by editing one line.
# HUMAN_TOKENS=rich:dev-human-key
# Prod alternative: a file rendered by the op-resolver, same format.
# HUMAN_TOKENS_FILE=/run/op-secrets/quarterback/HUMAN_TOKENS

# Browser board dev bypass: authenticate the READ views as this user when the
# Authelia edge isn't in front (LOCAL DEV ONLY — leave empty in prod). It does not
# grant the human-only writes: reading is not deciding.
BROWSER_DEV_USER=devuser

# The human-only endpoints (plan reorder / drop / retitle) need proof that the
# identity came from the edge and not from whoever sent the request: the proxy
# injects this value as `X-Edge-Auth` beside Remote-User. Unset means nobody is a
# human and every such write is refused — see DEPLOY.md §0.
# HUMAN_EDGE_SECRET=

# LOCAL DEV ONLY: run the plan page's reorder and drop buttons with no edge and no
# secret. Anything reachable from the network must leave this false.
BROWSER_DEV_HUMAN=true

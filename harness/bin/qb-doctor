def selectable() -> dict[str, set[str]]:
    """What `--only` accepts: every check name, and every group name as a shorthand.

    A group expands to its rows, so `--only landing` is `--only merges` today and
    stays correct as #407 adds to it — which is the point of naming the group at all.
    """
    names = {spec.name: {spec.name} for spec in CHECKS}
    for group in GROUPS:
        names[group] = {spec.name for spec in CHECKS if spec.group == group}
    return names


def run_checks(host: Host, only: set[str] | None = None) -> list[Check]:
    """Every selected check, each one's own failure contained.

    A check that raises becomes an `unknown` naming the exception rather than
    taking the report down with it. A doctor is the thing you run when the host
    is already odd, so "one row could not be computed" has to be a row.
    """
    out: list[Check] = []
    for spec in CHECKS:
        if only is not None and spec.name not in only:
            continue
        # Selection IS the bound on the expensive group. A bare `qb-doctor` is a
        # command people type when something already feels wrong, and attaching
        # unbounded model spend to that is what #55 settled: `--only semantic`
        # runs them, and a timer that wants them asks for them by name.
        if only is None and spec.group in SCHEDULED:
            continue
        try:
            check = spec.fn(host)
        except Exception as exc:                              # noqa: BLE001 — it IS the report
            check = Check(spec.name, "-",
                          f"the check itself raised {type(exc).__name__}: {exc}", "unknown")
        check.group = spec.group
        check.explanation = spec.explanation
        # The brief is composed HERE, from the registration, for the same reason the
        # group is assigned here: a check function that could write its own brief
        # could write one its registration disagrees with. `compose` is also the only
        # place that may decide there is none, and it always says why.
        check.prompt, check.prompt_for, check.no_prompt = compose(spec, check, host)
        out.append(check)
    return out


def apply_fixes(host: Host, checks: list[Check],
                only: set[str] | None = None) -> list[Check]:
    """Run the safe, idempotent installers, then take the whole report again.

    RE-CHECKED, never inferred from the installer's exit code. "The command
    succeeded" and "the guard is now installed" are the two sentences this whole
    file exists to keep apart, and an installer that exits 0 having written to a
    directory nothing reads would otherwise be reported as a fix.

    The re-check is the WHOLE selected set rather than only the rows that were
    fixed, because one guard's state is another row's input: `stash` reports
    residue differently depending on whether the guard is live, so installing
    hooks and re-running only `hooks` left the stash row describing a repo that
    had stopped existing a second earlier.
    """
    ran: dict[str, tuple[list[str], int]] = {}
    for check in checks:
        if check.verdict in HEALTHY or not check.fix:
            continue
        rc, stdout, stderr = run_cmd(check.fix, cwd=str(host.repo), timeout=120)
        for line in (stdout or stderr).splitlines():
            # stderr, for the reason `qb-reconcile` gives for its own aside: under
            # `--json` stdout is a document a consumer parses, and an installer's
            # chatter printed before it makes the whole run unparseable. Found by
            # Codex, on `--fix --json` together.
            print(f"  {check.name}: {line}", file=sys.stderr)
        ran[check.name] = (check.fix, rc)
    if not ran:
        return checks
    out = run_checks(host, only)
    for check in out:
        if check.name not in ran:
            continue
        argv, rc = ran[check.name]
        if check.verdict in HEALTHY:
            check.detail = f"{check.detail} (fixed by qb-doctor --fix)"
        else:
            check.detail = (f"{check.detail} — `{' '.join(argv)}` ran and did not fix it "
                            f"(exit {rc})")
    return out


#: Widest the report will grow, whatever the terminal says. A diagnostic is read,
#: quoted into an issue and pasted into a board post, and columns that stretch to
#: a 210-column monitor survive none of those.
MAX_WIDTH = 110

#: The subject column: a URL, a store path, a unit name. Truncated from the LEFT
#: when it will not fit, because the informative end of `/nix/store/<hash>-…/bin`
#: is the tail.
SUBJECT_WIDTH = 30


def _elide(text: str, width: int) -> str:
    return text if len(text) <= width else "…" + text[-(width - 1):]


def _wrap(text: str, width: int) -> list[str]:
    """Wrap on spaces only.

    `break_on_hyphens` and `break_long_words` are both off because every remedy
    this file prints is a path, a URL or a command line, and textwrap's defaults
    split `160-bug-quarterback-…` across two lines at a hyphen. A remedy a reader
    cannot select and paste is not a remedy — running past the right margin is the
    lesser harm, and the one a terminal already knows how to handle.
    """
    return textwrap.wrap(text, width, break_on_hyphens=False,
                         break_long_words=False) or [""]


def render(checks: list[Check], colour: bool, quiet: bool = False,
           explain: bool = False) -> str:
    """The report: one row per check, verdict last, remedy underneath.

    Verdict last rather than first because that is the shape #204 asked for, and
    because the eye reading a doctor's output is scanning the right-hand edge for
    the one word that is not `ok`. Long details wrap under the detail column
    rather than being truncated: the reason a check failed is the payload, and a
    report that hides it behind an ellipsis sends the reader back to the source.
    """
    rows = [c for c in checks if not quiet or c.verdict != "ok"]
    if not rows:
        return summary(checks)
    name_w = max(len(c.name) for c in rows)
    subj_w = min(max(len(c.subject) for c in rows), SUBJECT_WIDTH)
    verdict_w = max(len(_GLYPHS[c.verdict]) for c in rows)
    lead = name_w + 2 + subj_w + 2
    detail_w = max(MAX_WIDTH - lead - verdict_w - 2, 30)

    lines: list[str] = []
    for c in rows:
        glyph = _GLYPHS[c.verdict].rjust(verdict_w)
        if colour:
            glyph = f"{_COLOURS[c.verdict]}{glyph}{_RESET}"
        wrapped = _wrap(c.detail, detail_w)
        head = f"{c.name:<{name_w}}  {_elide(c.subject, subj_w):<{subj_w}}  "
        lines.append(f"{head}{wrapped[0]:<{detail_w}}  {glyph}")
        for extra in wrapped[1:]:
            lines.append(f"{'':<{lead}}{extra}")
        # NOT wrapped. A remedy is a command or a path, and hard-wrapping one
        # breaks copy-and-paste for the reader it exists to serve; a terminal's
        # own soft wrap runs past the margin and still yields one line on select.
        if c.manual:
            lines.append(f"{'':<{lead}}-> {c.manual}")
        if explain and c.verdict != "ok":
            lines += ["", *_explained(c), ""]
    lines += ["", summary(checks)]
    if not explain:
        lines += [_dispatchable(checks)]
    return "\n".join(x for x in lines if x is not None)


def _explained(check: Check) -> list[str]:
    """One row's explanation and brief, indented under it, for `--explain`.

    Off by default and that is not timidity: a brief is twenty lines and the report
    is seventeen rows, so printing them always would bury the one word a reader came
    for. The footer says how many there are.
    """
    out = [f"  {line}" for line in _wrap(" ".join(check.explanation.split()), 86)]
    if check.prompt:
        who = "an agent" if check.prompt_for == "agent" else "a person"
        out += ["", f"  --- brief for {who} " + "-" * 40]
        out += [f"  {line}" if line else "" for line in check.prompt.splitlines()]
    else:
        out += ["", *(f"  (no brief: {line})" for line in _wrap(check.no_prompt, 80))]
    return out


def _dispatchable(checks: list[Check]) -> str | None:
    """The footer that says a brief exists, without printing seventeen of them.

    It also names the rows that have none, because "this fault has no brief written
    for it" is a fact about the tool that a reader should be able to see — a report
    that mentioned only the rows it could brief would read as though the rest were
    fine.
    """
    interesting = [c for c in checks if c.verdict != "ok"]
    if not interesting:
        return None
    briefed = [c for c in interesting if c.prompt]
    bare = [c.name for c in interesting if not c.prompt]
    if not briefed:
        return (f"no brief for {', '.join(bare)} — qb-doctor --explain says why, per row")
    line = (f"{len(briefed)} row(s) carry a brief ready to hand over "
            f"({', '.join(c.name for c in briefed)}) — qb-doctor --explain, or --json")
    if bare:
        line += f"; nothing written for {', '.join(bare)}"
    return line


def summary(checks: list[Check]) -> str:
    """One line saying what the verdicts add up to — and refusing to round up.

    `N ok` on its own is the sentence that hides an unknown, so the counts are
    always spelled in full and the trailing clause names the state of the host in
    words rather than leaving a reader to add them up.
    """
    counts = {v: sum(1 for c in checks if c.verdict == v) for v in VERDICTS}
    spelled = ", ".join(f"{counts[v]} {v}" for v in VERDICTS)
    if counts["fail"]:
        verdict = "this host is NOT wired up"
    elif counts["unknown"]:
        verdict = ("some of this host could not be checked, which is not the same as it "
                   "being fine")
    elif counts["warn"]:
        verdict = "wired up, with residue nothing installs away"
    else:
        verdict = "wired up"
    return f"{spelled} — {verdict}"


def exit_code(checks: list[Check]) -> int:
    """0 healthy, 1 something could not be checked, 2 something failed."""
    if any(c.verdict == "fail" for c in checks):
        return 2
    if any(c.verdict == "unknown" for c in checks):
        return 1
    return 0


# --------------------------------------------------------------------------- #
# --announce — the half of #405 that runs when nobody is watching
# --------------------------------------------------------------------------- #

#: What class of judgement a failing row is, in #279's closed vocabulary. One
#: class for every row rather than a per-check mapping, because every question this
#: tool can raise is the same kind of question: some piece of shared machinery — a
#: hook, a token, a repository setting, a line to land in — is not working, and the
#: fix is an act rather than a taste. `environment` is spelled "does it work on the
#: box it has to work on", which is exact for the `host` group and the nearest true
#: word for the `landing` one; `other` would be less informative and #279's list is
#: closed on purpose.
NEEDS_HUMAN_CLASS = "environment"

#: What `--announce` puts on the board. `fail` only, and the omission is deliberate
#: rather than an oversight: an `unknown` is a check that could NOT be made, and the
#: ordinary causes — no network, no `gh`, no board token — hold for hours and would
#: announce on every tick of a timer forever. A person typing `qb-doctor` sees every
#: unknown in the report, which is where that distinction earns its keep; an
#: unattended escalation is for an established finding.
ANNOUNCED = ("fail",)

#: `extra` fields that say HOW LONG or HOW MANY rather than WHICH. They move on every
#: tick while the fault stays the same fault, so they are kept out of the dedupe key —
#: otherwise a stall announces afresh every fifteen minutes because one minute has
#: passed. Everything else in `extra` is what makes a fault *this* fault: which pull
#: request holds the head, which tags are misplaced, which briefs still tell an agent to
#: stamp a release. Codex found the first cut keying on `head_pr` alone, which read the
#: rule the other way round and let a row with no head PR suppress its own successors
#: for twelve hours.
#:
#: `ready` is conspicuously NOT here, and it is the one that has to be reasoned about
#: rather than pattern-matched: the `queue` row spells it as a count (always 0 on the
#: branch that fails, so it adds nothing and costs nothing) while `landed` spells it as
#: the LIST of pull requests that are ready and cannot land — which is precisely what
#: makes that finding this finding. One name, two meanings, and dropping it by name
#: would have silenced the second for the sake of the first.
#: `bytes`, `digest` and `cached` join them from the semantic group, and for a
#: reason worth stating: a digest is a "which", but it is the which of EVERY document
#: read, so an unrelated edit to an unrelated brief would change it and re-announce a
#: fault that has not changed. What makes a semantic finding this finding is the file
#: and the sentence, which are `telling` and `quote`.
VOLATILE = ("queued", "open", "entries", "behind", "read", "bytes", "digest", "cached",
            "asked", "readings")


def _instance(check: Check) -> str:
    """What distinguishes THIS occurrence of a row's fault from the next one.

    Sorted and JSON, so two runs that found the same thing produce the same string and
    a dict's iteration order cannot make one fault look like two.
    """
    keeps = {k: v for k, v in check.extra.items()
             if k not in VOLATILE and not k.endswith("_minutes")}
    return json.dumps(keeps, sort_keys=True, default=str)


def loops_dir(script: str) -> Path | None:
    """`harness/loops`, in the two layouts there are — a checkout and the package.

    The same two-place lookup :func:`commands_dir` and `qb-bump` do, for the same
    reason: `bin/` and `share/quarterback-harness/loops` are siblings in the store
    output, and `bin/` and `loops/` are siblings in a checkout.
    """
    here = Path(os.path.realpath(script)).parent
    for cand in (os.environ.get("QB_LOOPS_DIR"),
                 here.parent / "loops",
                 here.parent / "share" / "quarterback-harness" / "loops"):
        if cand and Path(cand, "needs_human.py").is_file():
            return Path(cand)
    return None


def _escalation(check: Check, slug: str, base_url: str) -> tuple[str, str]:
    """`(summary, detail)` for one failing row — what a person reads on the board."""
    summary = f"{check.name}: {check.detail}"
    lines = [f"row:     {check.name} ({check.group})",
             f"subject: {check.subject}",
             f"verdict: {check.verdict}",
             "", check.detail]
    if check.explanation:
        lines += ["", "why it matters:", check.explanation]
    if check.manual:
        lines += ["", f"needs a person: {check.manual}"]
    if check.fix:
        lines += ["", f"or run: qb-doctor --fix --only {check.name}"]
    # The brief travels through the SAME door as the finding, rather than beside it.
    # #408 is explicit that the doctor must not dispatch — so what goes on the board
    # is a post somebody reads and decides about, and `--announce` (#405) is the seam
    # that already exists for exactly that. A prompt on a second channel would be a
    # dispatch mechanism wearing an escalation's clothes.
    if check.prompt:
        who = "an agent" if check.prompt_for == "agent" else "a person"
        lines += ["", f"a brief is ready for {who} — nothing has run it, and nothing "
                      "here will:", "", check.prompt]
    elif check.no_prompt:
        lines += ["", f"no brief: {check.no_prompt}"]
    if check.extra:
        lines += ["", json.dumps(check.extra, indent=2, sort_keys=True)]
    if base_url:
        lines += ["", f"board: {base_url}"]
    if slug:
        lines += [f"repo:  {slug}"]
    return summary, "\n".join(lines)


def announce_failures(checks: list[Check], host: Host, script: str) -> list[str]:
    """Put every failing row on the board, through #274's one door. Never raises.

    This is the whole of #405's second half, and the reason it is a flag on this
    tool rather than a new checker somewhere else. #407 already landed the
    predicate — :func:`check_queue` asks whether the line has stopped, and
    :func:`check_landed` whether `main` has moved while something was ready to land
    on it — and on the night #405 records, both would have been `fail` within
    fifteen minutes. Nobody ran them. A doctor is a command a person types, and the
    failure #405 is about is precisely that nobody was there to type anything: the
    queue faithfully reported its state to anyone who asked, and for three hours
    nobody asked.

    So the missing piece was never a second predicate. It was a caller. With
    `qb-doctor --announce --only landing` on a timer, the rows that already exist
    reach a person by themselves, and a second implementation of "has the line
    stopped" — which would be free to disagree with the first — is not written.

    Nothing here evicts an entry, re-orders a line or merges anything. #405 and
    #227 both settled that the queue stays advisory and the measurements held the
    argument up: the system was never wrong about who should land next, only about
    who was still there. This says so out loud and names somebody to ask.
    """
    where = loops_dir(script)
    if where is None:
        return ["qb-doctor: NOT announced — no harness/loops beside this script, so "
                "#274's door is not reachable from here"]
    sys.path.insert(0, str(where))
    try:
        import needs_human  # noqa: PLC0415 — resolved at call time, by design
    except Exception as exc:  # noqa: BLE001 — an escalation must survive its courier
        return [f"qb-doctor: NOT announced — {type(exc).__name__} importing needs_human"]
    slug = github_slug(host) or ""
    said: list[str] = []
    for check in (c for c in checks if c.verdict in ANNOUNCED):
        summary, detail = _escalation(check, slug, host.base_url or "")
        refs = [{"kind": "repo", "value": slug}] if slug else []
        pr = check.extra.get("head_pr")
        if slug and isinstance(pr, int):
            refs.append({"kind": "pr", "value": str(pr), "repo": slug})
        try:
            line = needs_human.announce(
                cls=NEEDS_HUMAN_CLASS,
                reason=check.manual or check.detail,
                summary=summary,
                repo=slug,
                detail=detail,
                # The row name, the subject, and whatever the row itself says
                # identifies THIS instance of the fault. Without the last part a
                # second stall behind a different PR is swallowed by the first for
                # twelve hours, which is #274's dedupe protecting the fleet from
                # noise by hiding the news.
                key=needs_human.digest("qb-doctor", check.name, check.subject,
                                       _instance(check)),
                refs=refs or None)
        except Exception as exc:  # noqa: BLE001 — the courier, not the news
            # `announce` documents that it never raises, and this does not take its
            # word for it. The harness on PATH goes stale — that is what the
            # `harness` row is for — so the copy imported above may be older than
            # the contract, and this runs unattended on a timer where an escape
            # would take the whole report down with it. One row's courier failing
            # must not silence the rows behind it.
            said.append(f"qb-doctor: {check.name} NOT announced — "
                        f"{type(exc).__name__} from needs_human.announce")
            continue
        if line:
            said.append(line)
    if not said:
        return []
    return said


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="qb-doctor",
        description="Is this host wired up? Compares the board, the harness and the client "
                    "against each other, and checks the harness's own guards are installed.")
    parser.add_argument("--repo", metavar="DIR",
                        help="the checkout to check (default: the cwd's)")
    parser.add_argument("--fix", action="store_true",
                        help="also run the installers that are safe and idempotent; anything "
                             "needing a person is still only printed")
    parser.add_argument("--json", action="store_true", dest="as_json",
                        help="the whole report as JSON")
    parser.add_argument("--only", metavar="NAMES",
                        help="comma-separated check names ("
                             + ",".join(spec.name for spec in CHECKS)
                             + ") or group names (" + ",".join(GROUPS) + ")")
    parser.add_argument("--human-url", metavar="URL", dest="human_url",
                        help="the browser vhost, for the edge check (else QUARTERBACK_HUMAN_URL)")
    parser.add_argument("--quiet", action="store_true",
                        help="print only the rows that are not ok")
    parser.add_argument("--explain", action="store_true",
                        help="under every row that is not ok, print why it matters and "
                             "the brief written for it — or say why there is none (#408)")
    parser.add_argument("--announce", action="store_true",
                        help="put every FAILING row on the board through the "
                             "needs-human door, so a timer can run this unattended "
                             "(#405). `unknown` rows are printed, never announced")
    args = parser.parse_args(argv)

    only = None
    if args.only:
        asked = {n.strip() for n in args.only.split(",") if n.strip()}
        expand = selectable()
        unknown_names = asked - set(expand)
        if unknown_names:
            print(f"qb-doctor: no such check or group: {', '.join(sorted(unknown_names))}",
                  file=sys.stderr)
            return 3
        only = {name for asked_name in asked for name in expand[asked_name]}

    host = survey(args.repo, args.human_url, __file__)
    checks = run_checks(host, only)
    if args.fix:
        checks = apply_fixes(host, checks, only)

    if args.as_json:
        print(json.dumps({"checks": [c.as_dict() for c in checks],
                          "summary": summary(checks),
                          "exit_code": exit_code(checks)}, indent=2))
    else:
        colour = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        print(render(checks, colour, quiet=args.quiet, explain=args.explain))
        manual = [c for c in checks if c.verdict not in HEALTHY and c.manual and not c.fix]
        if manual:
            print("\nNeeds a person — nothing above ran these:")
            for c in manual:
                print(f"  {c.name}: {c.manual}")
    if args.announce:
        # After the report, and to stderr, so `--json` stays a document: a caller
        # piping this into `jq` must not have a courier's progress note spliced
        # into it. Announcing is best-effort and never changes the exit code —
        # the report is the finding whether or not the board took the post.
        for line in announce_failures(checks, host, __file__):
            print(line, file=sys.stderr)
    return exit_code(checks)


if __name__ == "__main__":
    sys.exit(main())

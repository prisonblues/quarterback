#!/usr/bin/env bash
set -uo pipefail

# qb-stage — say which stage of the workflow this session is in (bar + board).
#
# Usage: qb-stage <stage>     record it (F0, R1, R1F, R2, R2F, …)
#        qb-stage --clear     forget it (the work is finished or torn down)
#        qb-stage --show      print the current stage, if any
#        qb-stage -h|--help   this text
#
# Exit codes:
#   0  recorded, cleared, or nothing to do (no session id — not under Claude Code)
#   2  malformed stage — a typo, which is a caller bug and says so
#
# It also TELLS THE BOARD, so the fleet knows too — see "AND THE FLEET" below.
#
# WHAT THIS IS FOR. The statusline can say which repo, branch, worktree and PR a
# session is on, and still not answer the question you actually have when you
# glance at eight of them: is this one still writing the fix, or is it three
# review rounds deep? Branch and PR are identical at every stage of a PR's life.
# Nothing else knows the answer either — a round number lives in the skill
# driving the loop (`panel.py --round <r>` is passed it, not derived), so it
# cannot be recovered from the repo, the board, or the process table. It has to
# be *said*, which is what this does.
#
# THE CONVENTION (documented, not enforced — see below):
#
#   F0     implementing the first cut          /fix-issue
#   R1     review round 1                      /review-pr, /panel, /panel-review-pr
#   R1F    fixing round 1's findings           /panel-review-pr's fix fan-out
#   R2     review round 2                      …and so on, R2F, R3, R3F
#
# Only the SHAPE is checked (1-6 alphanumerics), not the vocabulary. A check
# that hard-coded F/R would have to be edited by anyone adding a stage, and the
# cost of the two failure modes is lopsided: an unknown-but-well-formed token
# renders as six harmless characters on a status bar, where a rejected one stops
# a workflow to argue about a cosmetic field. The vocabulary is a convention
# between the skills and the reader; this only defends the pixels.
#
# BEST-EFFORT BY CONSTRUCTION. No session id means nobody is watching a bar —
# a loop under systemd, a script run by hand — so that exits 0 in silence rather
# than failing a review over a status field. Same reasoning as the panel's board
# recording: telemetry that can fail the thing it reports on is worse than none.
#
# WHY tee AND NOT `>`. A `>` redirect anywhere under $HOME is refused by the dcg
# pre-tool guard (core.filesystem:redirect-truncate-root-home), so the obvious
# `printf … > "$marker"` is blocked when an agent runs it. That is not a
# hypothetical: it is what silently broke the session-cwd marker this sits
# beside, leaving the bar pointing at the main checkout for whole sessions.
# Having one short command to call is the other half of the fix — a caller that
# writes no path of its own cannot get the path or the redirect wrong.

# AND THE FLEET. The marker above answers the question for the pane it is written
# on, which is exactly half of what a fleet is. Cross-machine that file is not
# there to read; same-machine nothing read it. So the same call that writes it
# posts the stage to the board (#262), where `/active`, `/overlap`, the fleet
# page and the three terminal dashboards can all show it.
#
# THIS SCRIPT IS THE RIGHT PLACE TO SAY IT, and the alternative is instructive.
# The lifecycle hook could read the marker on every heartbeat, and would need no
# board-facing code here — but it lives in nix-fleet, it lags by up to a
# heartbeat, and it would make a fact the fleet ACTS on arrive late for nothing.
# qb-stage is the only thing in the system that is *told* the stage, at the
# moment it changes. It says it.
#
# FAIL-OPEN, AND IT MEANS THE WHOLE PATH. This writes a marker a person's status
# line depends on. A board that is down, slow, unconfigured, or asking for a
# passphrase must not break that or make anyone wait for it — so the report goes
# to a backgrounded subshell with its output discarded and its stdin closed, and
# the config resolution goes in there WITH it. Resolving is not free: a
# QUARTERBACK_TOKEN_CMD is an arbitrary command, and one that blocks on a prompt
# would otherwise hang the caller on a cosmetic field. There is no exit code to
# check and no message on failure, which is the point — a telemetry path that can
# fail the thing it reports on is worse than none. Same bargain the panel's board
# recording strikes.
#
# NOT sourcing `qb-env`: that lives beside the `qb` CLI, a separate install, and
# the harness is meant to work without it. Board URL and token are resolved from
# the same per-host contract `worktree-holder` reads, and there is deliberately
# NO default base URL — an unset variable means this machine has not been told
# which board it belongs to, and guessing points the report at another island's.

STAGE_DIR="${QB_SESSION_STAGE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/session-stage}"
SESSION_ID="${CLAUDE_CODE_SESSION_ID:-}"

usage() { sed -n '4,9p' "$0" | sed 's/^# \{0,1\}//'; }

#: How long the credential source gets. Seconds.
TOKEN_TIMEOUT=5

# The token command, bounded — the one part of this that can hang forever.
#
# `worktree-holder` runs the identical command with a bare `eval`, and is right
# to: it runs in the foreground of something a person is waiting on, so a slow
# credential source is visible and interruptible. This one is detached, so an
# unbounded one leaves an orphaned subshell per qb-stage call that nobody ever
# sees. `curl --max-time` bounds only curl's half of the work.
#
# `timeout … bash -c` rather than a bare `eval` so there is a process to bound.
# A QUARTERBACK_TOKEN_CMD is a command line — `pass show …`, `cat ~/.token` — and
# both spellings run it as a shell string against the same environment; what the
# child does NOT see is a non-exported variable a config file happened to set,
# which no credential command in this fleet uses. Falls back to `eval` where
# there is no `timeout` at all, because a token that arrives beats one that does
# not, and that is the one shell missing coreutils.
run_token_cmd() {
    if command -v timeout >/dev/null 2>&1; then
        timeout "$TOKEN_TIMEOUT" bash -c "$QUARTERBACK_TOKEN_CMD" 2>/dev/null
    else
        eval "$QUARTERBACK_TOKEN_CMD" 2>/dev/null
    fi
}

# The per-host contract documented in `qb-env`, read directly. Returns non-zero
# when this machine has no board configured, which is a normal state and not an
# error: the caller is already inside the backgrounded subshell by then, so
# giving up costs nothing and says nothing.
board_config() {
    local env_url="${QUARTERBACK_BASE_URL:-}" env_tok="${QUARTERBACK_TOKEN:-}"
    local env_cmd="${QUARTERBACK_TOKEN_CMD:-}"
    local cfg="${QUARTERBACK_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/quarterback/config}"
    if [[ -r "$cfg" ]]; then
        # shellcheck disable=SC1090
        . "$cfg" || return 1
    fi
    # Sourcing assigns unconditionally, so restore anything the caller had set: a
    # single invocation must be able to override the file without editing it.
    # TOKEN_CMD included — it is a whole credential source, and a config file
    # silently winning it means reporting to the board as somebody else.
    [[ -n "$env_url" ]] && QUARTERBACK_BASE_URL="$env_url"
    [[ -n "$env_tok" ]] && QUARTERBACK_TOKEN="$env_tok"
    [[ -n "$env_cmd" ]] && QUARTERBACK_TOKEN_CMD="$env_cmd"
    [[ -n "${QUARTERBACK_BASE_URL:-}" ]] || return 1
    if [[ -z "${QUARTERBACK_TOKEN:-}" && -n "${QUARTERBACK_TOKEN_CMD:-}" ]]; then
        QUARTERBACK_TOKEN="$(run_token_cmd | head -1)"
    fi
    [[ -n "${QUARTERBACK_TOKEN:-}" ]] || return 1
    BASE="${QUARTERBACK_BASE_URL%/}"
    return 0
}

# tell_board <json-stage-value>   — `"R1"` to set, `null` to clear.
#
# The value is interpolated into JSON, so it must not be able to carry a quote or
# a brace. Both callers below pass a literal `null` or a $STAGE that has already
# been matched against ^[A-Za-z0-9]{1,6}$, and $SESSION_ID against
# ^[A-Za-z0-9._-]+$ — the same two checks the board makes at its edge, which is
# why they are worth making here rather than reaching for a JSON encoder.
tell_board() {
    command -v curl >/dev/null 2>&1 || return 0
    (
        board_config || exit 0
        curl -sS -o /dev/null --max-time 5 -X POST "$BASE/lease/stage" \
            -H "Authorization: Bearer $QUARTERBACK_TOKEN" \
            -H "Content-Type: application/json" \
            -d "{\"session\":\"$SESSION_ID\",\"stage\":$1}"
    ) </dev/null >/dev/null 2>&1 &
    return 0
}

case "${1-}" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        printf 'qb-stage: need a stage (or --clear)\n\n' >&2
        usage >&2
        exit 2
        ;;
esac

# No session, no marker, no complaint. Checked after --help so the help text
# still works anywhere, and before the write so the rest can assume an id.
[[ -n "$SESSION_ID" ]] || exit 0

# The session id becomes a filename, so it must not be able to escape the
# directory. Claude Code's ids are UUIDs; anything else is refused rather than
# sanitised, because a mangled id would write a marker no reader ever finds.
if [[ ! "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ || "$SESSION_ID" == *".."* ]]; then
    printf 'qb-stage: refusing a session id that is not a plain token: %s\n' \
        "$SESSION_ID" >&2
    exit 2
fi

MARKER="$STAGE_DIR/$SESSION_ID"

case "$1" in
    --clear)
        rm -f "$MARKER"
        # Unconditionally, not only when a marker was there to remove. The board
        # is a second store and can hold a stage this machine's cache does not —
        # a session resumed on another box, a cache cleared by hand — and a lease
        # still advertising `R2` after the work landed is worse than a blank one.
        tell_board null
        exit 0
        ;;
    --show)
        [[ -f "$MARKER" ]] && cat "$MARKER"
        exit 0
        ;;
esac

STAGE="$1"
if [[ ! "$STAGE" =~ ^[A-Za-z0-9]{1,6}$ ]]; then
    printf 'qb-stage: %s is not a stage — expected 1-6 alphanumerics (F0, R1, R1F)\n' \
        "$STAGE" >&2
    exit 2
fi

# The board first, because it is the half that cannot be recovered later and it
# costs nothing to start: `tell_board` returns the moment the subshell is
# backgrounded. An unwritable cache directory must not silently cost the fleet
# the report — the `exit 0` below is about a marker nobody can read anyway.
tell_board "\"$STAGE\""

mkdir -p "$STAGE_DIR" || exit 0
printf '%s' "$STAGE" | tee "$MARKER" >/dev/null

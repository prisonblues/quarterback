#!/usr/bin/env bash
set -uo pipefail

# Generic Worktree Pruner
# Sweeps a repo for worktree *detritus* left behind when worktrees were torn
# down without a full `remove-worktree` run (e.g. a raw `git worktree remove`
# or `rm -rf`): orphaned per-worktree databases, stale `.worktree-ports`
# entries, and de-registered leftover directories.
#
# A worktree DB/dir/port is "orphaned" when no *live* worktree (per
# `git worktree list`) maps to it. Mapping mirrors create-worktree:
#   create-name  ->  dir  <project>-<create-name with / -> ->
#                ->  db   <project>_<create-name with / and - -> _>
#                ->  port  .worktree-ports line "<port>:<create-name>"
#
# Safe by default: DRY-RUN unless --prune is given. The main DB (<project>) and
# <project>_test are always protected, plus anything matching a pattern in
# `.database.protect` -- a list of GLOBS, so a family of generated databases
# (`<project>_test_tmpl_*`) can be named without pinning names that go stale. A
# directory another live agent is working in is reported separately and never
# removed, however de-registered it looks (see `worktree-holder`).
#
# Each category has FOUR states, not three: "none", a list, and `NOT CHECKED` for
# a sweep that could not run at all — an unreachable board, a Postgres container
# that answered nothing, a docker daemon that is not up, a config file nothing
# can read. A category with no answer is never reported as empty, and "Nothing to
# prune. Clean." is printed only when all six were looked at. Every external read
# here captures its exit status before parsing what it produced, because through
# a pipe or a process substitution that status goes nowhere and "the command
# failed" arrives as "the command found nothing".
#
# Usage: prune-worktrees [options]
#   (no flags)         Dry-run: report orphan DBs, ports, dirs, containers,
#                      nginx blocks and board claims.
#   --prune, -y        Drop orphan DBs and rewrite .worktree-ports.
#   --remove-dirs      `rm -rf` the leftover (de-registered) worktree dirs.
#   --remove-containers  `docker rm -f` orphan per-worktree containers (matched
#                      by the com.docker.compose.project label — never the main
#                      stack, whose project has no worktree suffix).
#   --remove-nginx     Strip orphan `# WORKTREE-START/END:<branch>` blocks from
#                      the nginx config and restart nginx.
#                      --prune also hands back board claims taken by checkouts
#                      that no longer exist (#337).
#                      Each --remove-* flag is independent of --prune; combine
#                      any of them to do several at once.
#   --config <path>    Config file (default: .worktree.json in repo root)
#   --project <name>   Override the detected project name
#   -h, --help         Show this help

# ============================================
# COLORS & HELPERS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

die() { echo -e "${RED}Error: $1${NC}" >&2; exit 1; }

env_val() {
    local var="$1" file="$2"
    [[ -f "$file" ]] || return 0
    local line
    line=$(grep "^[[:space:]]*${var}[[:space:]]*=" "$file" 2>/dev/null | head -1 || true)
    [[ -z "$line" ]] && return 0
    local val="${line#*=}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
    elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
    if [[ "$val" != *"://"* ]]; then val="${val%%[[:space:]]#*}"; fi
    echo "$val"
}

db_url_user() { echo "$1" | sed 's|.*://\([^:]*\):.*|\1|'; }

cfg() {
    local key="$1" default="${2:-}"
    if [[ -n "$CONFIG_JSON" ]]; then
        if echo "$CONFIG_JSON" | jq -e "$key != null" >/dev/null 2>&1; then
            echo "$CONFIG_JSON" | jq -r "$key" 2>/dev/null
            return
        fi
    fi
    echo "$default"
}

# >>> cfg-array
cfg_array() {
    local key="$1"
    [[ -n "$CONFIG_JSON" ]] && echo "$CONFIG_JSON" | jq -r "$key[]? // empty" 2>/dev/null
}
# <<< cfg-array

detect_project_name() {
    local root="$1"
    if [[ -f "$root/pyproject.toml" ]]; then
        local name
        name=$(grep -E '^name[[:space:]]*=' "$root/pyproject.toml" | head -1 | sed 's/.*=[[:space:]]*"\(.*\)".*/\1/' 2>/dev/null)
        [[ -n "$name" ]] && echo "$name" && return
    fi
    if [[ -f "$root/package.json" ]]; then
        local name
        name=$(jq -r '.name // empty' "$root/package.json" 2>/dev/null)
        [[ -n "$name" ]] && echo "$name" && return
    fi
    basename "$root"
}

# Every running container whose name looks like a Postgres, most-plausible
# first. Deliberately NOT `| head -1`: "the first thing docker happens to list"
# is not a choice. On a box that also runs CI containers this picked
# `10bad74c…_postgres16_…` — an ephemeral runner service — over the project's
# own `postgres-local`. The psql call against it then failed behind `2>/dev/null`
# and the sweep reported "Orphan databases: none" while 103 orphans sat in the
# real container. Silent, and it flipped run to run as containers came and went.
# The caller picks the first candidate that actually answers as $PG_USER.
# >>> pg-container
postgres_container_candidates() {
    local names
    names=$(docker ps --format '{{.Names}}' 2>/dev/null || true)
    # Stable, human-named containers first; hex-prefixed ephemerals last.
    grep -iE 'postgres|pgdb|_db' <<<"$names" | grep -vE '^[0-9a-f]{16,}_' || true
    grep -iE 'postgres|pgdb|_db' <<<"$names" | grep -E '^[0-9a-f]{16,}_' || true
}

# True if $1 can list databases as $PG_USER — the only test that matters.
postgres_container_answers() {
    docker exec "$1" psql -U "$PG_USER" -d postgres -tAc 'SELECT 1' >/dev/null 2>&1
}
# <<< pg-container

# Drop a database robustly. Try WITH (FORCE) (Postgres 13+) to evict any stray
# connections; fall back to terminating backends then a plain drop.
drop_db() {
    local db="$1"
    docker exec "$DB_CONTAINER" psql -U "$PG_USER" -d postgres \
        -c "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE);" >/dev/null 2>&1 && return 0
    docker exec "$DB_CONTAINER" psql -U "$PG_USER" -d postgres \
        -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$db' AND pid <> pg_backend_pid();" \
        >/dev/null 2>&1
    docker exec "$DB_CONTAINER" psql -U "$PG_USER" -d postgres \
        -c "DROP DATABASE IF EXISTS \"$db\";" >/dev/null 2>&1
}

# ============================================
# PARSE ARGUMENTS
# ============================================
APPLY=false
REMOVE_DIRS=false
REMOVE_CONTAINERS=false
REMOVE_NGINX=false
CONFIG_FILE=""
PROJECT_OVERRIDE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --prune|-y)          APPLY=true; shift ;;
        --remove-dirs)       REMOVE_DIRS=true; shift ;;
        --remove-containers) REMOVE_CONTAINERS=true; shift ;;
        --remove-nginx)      REMOVE_NGINX=true; shift ;;
        --config)      [[ -z "${2:-}" ]] && die "--config requires a path"; CONFIG_FILE="$2"; shift 2 ;;
        --project)     [[ -z "${2:-}" ]] && die "--project requires a name"; PROJECT_OVERRIDE="$2"; shift 2 ;;
        # To the first blank line, not to a pinned line number: the header
        # grew past 34 and the last two options stopped being printed.
        -h|--help)     sed -n '4,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)             die "Unknown option: $1" ;;
    esac
done

# Any --remove-* / --prune flag means we're in APPLY territory for that category.
ANY_APPLY=false
[[ "$APPLY" = true || "$REMOVE_DIRS" = true || "$REMOVE_CONTAINERS" = true || "$REMOVE_NGINX" = true ]] && ANY_APPLY=true

# ============================================
# FIND REPO AND LOAD CONFIG
# ============================================
MAIN_REPO=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a git repository"

if [[ -n "$CONFIG_FILE" ]]; then
    [[ -f "$CONFIG_FILE" ]] || die "Config file not found: $CONFIG_FILE"
    CONFIG_JSON=$(cat "$CONFIG_FILE")
elif [[ -f "$MAIN_REPO/.worktree.json" ]]; then
    CONFIG_JSON=$(cat "$MAIN_REPO/.worktree.json")
else
    CONFIG_JSON=""
fi

# Refused rather than degraded. Every `cfg` call drops jq's error and falls back
# to its default, so one stray comma silently erases the database engine, the
# nginx path, the worker prefix and the protect patterns — and the categories
# those configure then report "none" for a reason that has nothing to do with the
# repo. That is #735's shape arriving through the config file: a check that could
# not be set up, reported as a check that found nothing.
if [[ -n "$CONFIG_JSON" ]] && command -v jq >/dev/null 2>&1; then
    jq -e . >/dev/null 2>&1 <<<"$CONFIG_JSON" \
        || die "config file is not valid JSON: ${CONFIG_FILE:-$MAIN_REPO/.worktree.json}
Refusing to run: every setting in it would silently fall back to a default, and
the categories it configures would report \"none\" for the wrong reason."
fi

PROJECT="${PROJECT_OVERRIDE:-$(cfg '.project' "$(detect_project_name "$MAIN_REPO")")}"
DB_ENGINE=$(cfg '.database.engine' "")
DB_CONTAINER=$(cfg '.database.container' "auto")
DB_USER_ENV=$(cfg '.database.user_env' "POSTGRES_USER")
DB_URL_ENV=$(cfg '.database.url_env' "")

# Worker container prefix + nginx config, mirroring create-worktree/remove-worktree
# so we can recognise per-worktree containers and nginx blocks.
WORKER_PREFIX=$(cfg '.worker.container_prefix' "")
WORKER_TYPE=$(cfg '.worker.type' "")
if [[ -z "$WORKER_PREFIX" ]]; then
    case "$WORKER_TYPE" in
        huey)   WORKER_PREFIX="huey-consumer" ;;
        rq)     WORKER_PREFIX="${PROJECT}-rq-worker" ;;
        celery) WORKER_PREFIX="${PROJECT}-celery-worker" ;;
    esac
fi
NGINX_CONFIG=$(cfg '.nginx.config' "")
NGINX_CONTAINER=$(cfg '.nginx.container' "auto")

if [[ -z "$DB_ENGINE" && -f "$MAIN_REPO/.env" ]]; then
    grep -qiE 'POSTGRES|postgresql' "$MAIN_REPO/.env" 2>/dev/null && DB_ENGINE="postgresql"
fi

PARENT="$(dirname "$MAIN_REPO")"

echo -e "${GREEN}Pruning worktree detritus for project: $PROJECT${NC}"
echo -e "  Repo:   $MAIN_REPO"
echo -e "  Mode:   $([[ "$ANY_APPLY" = true ]] && echo "APPLY" || echo "dry-run")"
echo ""

# ============================================
# LIVE WORKTREES (the source of truth)
# ============================================
# Suffixes are dir basenames with the "<project>-" prefix stripped. The main
# repo (basename == project) has no suffix and is skipped.
declare -A LIVE_DB=()
declare -A LIVE_DIR=()
LIVE_SUFFIXES=()
LIVE_LIST_OK=false
# Captured whole, WITH its status, before anything parses it. Piped straight into
# the loop through process substitution, neither `git`'s status nor `awk`'s ever
# reached this shell — so a listing that failed halfway, after emitting the main
# checkout, satisfied the guard below and left every other live worktree looking
# dead. That is #735's discarded exit status again, on the one input every sweep
# in this file derives "is this live?" from, and the consequence of getting it
# wrong here is `rm -rf` rather than a misleading line.
if ! WORKTREE_LIST=$(git worktree list --porcelain 2>/dev/null); then
    die "\`git worktree list\` failed (is this a git repository?).
Refusing to classify anything as orphaned: with no live list, every worktree
directory, database and container looks dead."
fi
while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    LIVE_LIST_OK=true
    LIVE_DIR["$p"]=1
    b=$(basename "$p")
    [[ "$b" == "${PROJECT}-"* ]] || continue
    suffix="${b#${PROJECT}-}"
    LIVE_SUFFIXES+=("$suffix")
    LIVE_DB["${PROJECT}_$(echo "$suffix" | tr '-' '_')"]=1
done < <(printf '%s\n' "$WORKTREE_LIST" | awk '/^worktree /{print substr($0,10)}')

# Everything downstream decides what to DELETE by asking "is this live?", so an
# empty or truncated worktree list does not mean "nothing is live" — it means we
# cannot tell, and every live worktree then looks like detritus. Refuse rather
# than report a sweep that would delete the user's work.
if [[ "$LIVE_LIST_OK" != true ]]; then
    die "\`git worktree list\` returned nothing (run from inside the repo?).
Refusing to classify anything as orphaned: with no live list, every worktree
directory, database and container looks dead."
fi

is_live_suffix() {
    local norm; norm="$(echo "$1" | tr '/' '-')"
    local s
    for s in "${LIVE_SUFFIXES[@]:-}"; do [[ "$s" == "$norm" ]] && return 0; done
    return 1
}

# A leftover is a `<project>-*` sibling that is NOT a registered worktree but
# DOES look like a worktree remnant — i.e. it carries a worktree marker: a .git
# pointer, or any top-level entry create-worktree symlinks/copies in. This keeps
# unrelated dirs that merely share the prefix (and stray empty dirs) untouched.
WT_MARKERS=(.git)
while IFS= read -r m; do [[ -n "$m" ]] && WT_MARKERS+=("${m%%/*}"); done < <(
    { cfg_array '.symlinks'; cfg_array '.copies'; }
)

dir_is_worktree_remnant() {
    local dir="$1" m
    for m in "${WT_MARKERS[@]}"; do
        [[ -e "$dir/$m" || -L "$dir/$m" ]] && return 0
    done
    return 1
}

# A de-registered directory is not necessarily an abandoned one. An agent can be
# three commits into a review cycle in a worktree whose registration was lost —
# and this detector has classified LIVE worktrees as leftovers before (see the
# SIGPIPE note below), so a second, independent opinion on "is anybody in there"
# is worth having before `--remove-dirs` runs `rm -rf`. Only a named, live holder
# counts: `worktree-holder` may be absent and the board may be down, and neither
# is a reason to leave real debris uncollected.

# Resolved ONCE, not per directory: this runs inside a loop over every sibling
# directory of the project, and `command -v` in there was pure repetition.
HOLDER_BIN=$(command -v worktree-holder 2>/dev/null || true)
if [[ -z "$HOLDER_BIN" && "$0" == */* ]]; then HOLDER_BIN="${0%/*}/worktree-holder"; fi
[[ -n "$HOLDER_BIN" && -x "$HOLDER_BIN" ]] || HOLDER_BIN=""

# Exit 4 is "could not tell", and its usual cause — no board configured, or a
# board that is down — is a property of the RUN, not of the directory. Paying it
# once per sibling meant up to 20 × `curl --max-time 5` of stall on a plain dry
# run, plus one "could not check …" warning per directory, all saying the same
# thing. The first 4 settles it for the sweep.
HOLDER_GAVE_UP=false

holder_of() {
    local dir="$1" rc
    [[ -n "$HOLDER_BIN" ]] || return 1
    [[ "$HOLDER_GAVE_UP" = true ]] && return 1
    "$HOLDER_BIN" "$dir" >/dev/null
    rc=$?
    [[ $rc -eq 3 ]] && return 0
    # 4 = could not tell. Nothing else will tell either.
    [[ $rc -eq 4 ]] && HOLDER_GAVE_UP=true
    return 1
}


# ============================================
# A HELD WORKTREE COUNTS AS LIVE
# ============================================
# Run BEFORE any sweep, and fold the answer into LIVE_* rather than filtering a
# list afterwards. Diverting only the DIRECTORY was not enough: the database,
# port, nginx and container sweeps each derive orphan-ness independently from
# `git worktree list`, so a de-registered-but-HELD worktree was still reported as
# an orphan database and had DROP DATABASE run on it, still had its port entry
# rewritten away and reallocated, still had its nginx block stripped, and — via
# DEAD_SUFFIX, which is seeded from the stale-port list as well as the leftover
# dirs — still had `docker rm -f` run on its containers. All under a live agent,
# and all while the report said the directory was being left alone.
#
# Registering the suffix as live is the fix that cannot be forgotten by the next
# sweep somebody adds, because every one of them already asks "is this live?".
HELD_DIRS=()
shopt -s nullglob
for d in "$PARENT/${PROJECT}-"*; do
    [[ -d "$d" ]] || continue
    [[ -n "${LIVE_DIR[$d]:-}" ]] && continue      # already live; nothing to add
    dir_is_worktree_remnant "$d" || continue      # not ours to reason about
    holder_of "$d" || continue
    HELD_DIRS+=("$d")
    LIVE_DIR["$d"]=1
    b=$(basename "$d")
    suffix="${b#${PROJECT}-}"
    LIVE_SUFFIXES+=("$suffix")
    LIVE_DB["${PROJECT}_$(echo "$suffix" | tr '-' '_')"]=1
done
shopt -u nullglob

# ============================================
# 1. ORPHAN DATABASES
# ============================================
ORPHAN_DBS=()
PROTECTED_DBS=()
#: The database half of the same distinction (#735). Every branch below that
#: prints "skipping DB scan" ends with ORPHAN_DBS empty, which `report` was
#: printing as a green "none" — the failure README's own caveat records, where a
#: misresolved container made this say `Orphan databases: none` over a hundred
#: orphans in the real one.
DB_SCAN_UNKNOWN=""
if [[ "$DB_ENGINE" = "postgresql" ]]; then
    PG_USER=""
    if [[ -f "$MAIN_REPO/.env" ]]; then
        PG_USER=$(env_val "$DB_USER_ENV" "$MAIN_REPO/.env")
        if [[ -z "$PG_USER" && -n "$DB_URL_ENV" ]]; then
            db_url=$(env_val "$DB_URL_ENV" "$MAIN_REPO/.env")
            [[ -n "$db_url" ]] && PG_USER=$(db_url_user "$db_url")
        fi
    fi

# >>> db-scan
    # Protected: main DB and test DB always, plus anything the project
    # configured. The two built-ins are exact because we mint those names
    # ourselves; the configured entries are GLOB PATTERNS, because the databases
    # a project wants to protect are usually a *family* whose members this file
    # cannot name -- minted by the project's own tooling, carrying something the
    # config was written too early to know.
    #
    # The case that forced it: a test suite that copies each run's database from
    # a pre-migrated template, `<project>_test_tmpl_<migration head>`. That name
    # maps to no worktree by construction, so every sweep offers to drop it.
    # Naming them exactly means pinning live migration heads into shared
    # base-branch config -- heads that live on branches no single checkout can
    # see, so the list silently protects dead templates while the live one goes
    # back to being swept. `<project>_test_tmpl_*` cannot go stale, and keeps
    # the tool ignorant of the project's migration tool.
    #
    # A literal entry still works: a pattern with no metacharacters is an exact
    # match, so this is backward compatible with every list already written.
    declare -A PROTECT=()
    PROTECT["$PROJECT"]=1
    PROTECT["${PROJECT}_test"]=1
    PROTECT_GLOBS=()
    while IFS= read -r p; do [[ -n "$p" ]] && PROTECT_GLOBS+=("$p"); done < <(cfg_array '.database.protect')

    # Echoes the pattern that protects $1, or fails. Reporting *which* pattern
    # matched is the point: a too-broad one would otherwise suppress genuine
    # orphans invisibly, which is a worse failure than the staleness this fixes.
    protecting_glob() {
        local db="$1" g
        for g in ${PROTECT_GLOBS[@]+"${PROTECT_GLOBS[@]}"}; do
            # UNQUOTED on the right. Quoting $g degrades `==` to a literal
            # string comparison -- exactly the bug being fixed here, and it
            # would look like it worked for every pattern that has no wildcard.
            [[ "$db" == $g ]] && { printf '%s' "$g"; return 0; }
        done
        return 1
    }

    # Resolve the container only once PG_USER is known, so "does it answer as
    # this user?" is available as the tie-breaker.
    if [[ "$DB_CONTAINER" = "auto" && -n "$PG_USER" ]]; then
        DB_CONTAINER=""
        while IFS= read -r c; do
            [[ -z "$c" ]] && continue
            if postgres_container_answers "$c"; then DB_CONTAINER="$c"; break; fi
        done < <(postgres_container_candidates)
    fi

    if [[ -z "$PG_USER" ]]; then
        DB_SCAN_UNKNOWN="the DB user could not be read from the repo's .env"
        echo -e "${YELLOW}! Could not determine DB user — skipping DB scan${NC}"
    elif [[ -z "$DB_CONTAINER" || "$DB_CONTAINER" = "auto" ]]; then
        # Loud, because the failure mode this replaces was a confident "none".
        # The report line says NOT CHECKED for itself now; this stays for the
        # candidate list, which is the part that says what to fix.
        DB_SCAN_UNKNOWN="no Postgres container answered as '$PG_USER'"
        echo -e "${YELLOW}! No Postgres container answered as '$PG_USER' — skipping DB scan.${NC}"
        echo -e "${YELLOW}  Candidates tried: $(postgres_container_candidates | tr '\n' ' ')${NC}"
    elif ! DB_LIST=$(docker exec "$DB_CONTAINER" psql -U "$PG_USER" -d postgres -tAc \
                        "SELECT datname FROM pg_database ORDER BY 1" 2>/dev/null); then
        # The container answered `SELECT 1` and then failed the listing — it went
        # away between the two calls, or the role lost the privilege. Read into a
        # variable rather than piped through process substitution, because that
        # form discards the exit status: the loop simply read nothing, and no
        # rows is what an empty database server would give too.
        DB_SCAN_UNKNOWN="the database listing failed on container '$DB_CONTAINER'"
        echo -e "${YELLOW}! Could not list databases in '$DB_CONTAINER' — skipping DB scan${NC}"
    else
        while IFS= read -r db; do
            [[ "$db" == "${PROJECT}_"* ]] || continue
            [[ -n "${LIVE_DB[$db]:-}" ]] && continue
            [[ -n "${PROTECT[$db]:-}" ]] && continue
            if pattern=$(protecting_glob "$db"); then
                PROTECTED_DBS+=("$db  (.database.protect: $pattern)")
                continue
            fi
            ORPHAN_DBS+=("$db")
        done <<< "$DB_LIST"
    fi
# <<< db-scan
else
    # NOT marked unknown, unlike the two skips above, and the difference is what
    # the tool was told rather than what it found: a project that names no engine
    # has no per-worktree databases for this to have missed, the same answer the
    # nginx category gives a project with no nginx config. The two above were
    # told there is a Postgres and could not reach it.
    echo -e "${YELLOW}! No Postgres engine configured — skipping DB scan${NC}"
fi

# ============================================
# 2. STALE PORT ENTRIES
# ============================================
PORT_FILE="$MAIN_REPO/.worktree-ports"
STALE_PORTS=()
KEPT_PORTS=()
PORTS_UNKNOWN=""
if [[ -f "$PORT_FILE" ]]; then
    # A redirect that cannot open the file leaves the loop unentered and both
    # arrays empty, which under no `-e` is indistinguishable from a file with
    # nothing stale in it — and `--prune` would then rewrite the file from an
    # empty KEPT_PORTS, discarding every live allocation in it.
    if ! PORT_LINES=$(cat "$PORT_FILE" 2>/dev/null); then
        PORTS_UNKNOWN="$PORT_FILE exists but could not be read"
    else
        while IFS= read -r line; do
            [[ -z "${line//[[:space:]]/}" ]] && continue
            name="${line#*:}"
            if is_live_suffix "$name"; then KEPT_PORTS+=("$line"); else STALE_PORTS+=("$line"); fi
        done <<< "$PORT_LINES"
    fi
fi

# ============================================
# 3. LEFTOVER DIRECTORIES (de-registered)
# ============================================
LEFTOVER_DIRS=()
SKIPPED_DIRS=()
shopt -s nullglob
for d in "$PARENT/${PROJECT}-"*; do
    [[ -d "$d" ]] || continue
    # Membership test against the list captured once above — never a fresh
    # `git worktree list | grep -q` per directory. Under `set -o pipefail` that
    # pipeline is a coin flip: `grep -q` exits the moment it matches, git dies
    # of SIGPIPE, and the pipeline reports 141 *even though the match
    # succeeded*. The `&& continue` is then skipped and a LIVE worktree is
    # classified as a leftover — which `--remove-dirs` would `rm -rf`. The race
    # is per-directory and per-run, so the damage looked like flakiness: on this
    # repo it flagged 12, 18, 20 and 21 of 20-odd live worktrees on four
    # consecutive dry-runs, including ones with uncommitted work.
    [[ -n "${LIVE_DIR[$d]:-}" ]] && continue
    if ! dir_is_worktree_remnant "$d"; then SKIPPED_DIRS+=("$d"); continue; fi
    # Held dirs were registered as LIVE above and skipped by the LIVE_DIR test,
    # so anything reaching here is a genuine leftover.
    LEFTOVER_DIRS+=("$d")
done
shopt -u nullglob

# ============================================
# 4. ORPHAN CONTAINERS
# ============================================
# Per-worktree containers are named "<project>-<suffix>" and
# "<worker-prefix>-<suffix>". We only flag one as orphan when the SAME <suffix>
# is independently known-dead — it appears as a stale port entry or a leftover
# directory above. That evidence-gating guarantees we never touch a main-stack
# container that merely shares the "<project>-" prefix.
ORPHAN_CONTAINERS=()
CONTAINERS_UNKNOWN=""
if command -v docker >/dev/null 2>&1; then
    declare -A DEAD_SUFFIX=()
    for line in "${STALE_PORTS[@]:-}"; do
        [[ -z "$line" ]] && continue
        DEAD_SUFFIX["$(echo "${line#*:}" | tr '/' '-')"]=1
    done
    for d in "${LEFTOVER_DIRS[@]:-}"; do
        [[ -z "$d" ]] && continue
        b=$(basename "$d"); DEAD_SUFFIX["${b#${PROJECT}-}"]=1
    done
    # No known-dead suffix means this never asks, and "none" is then the right
    # answer rather than an unchecked one: the sweep is evidence-gated, so with
    # no evidence there is nothing a container listing could qualify.
    if [[ ${#DEAD_SUFFIX[@]} -gt 0 ]]; then
        # `docker` on PATH does not mean a daemon answering it. Through process
        # substitution a refused socket read exactly like a host with no
        # containers on it — #735, in the category next door.
        if ! DOCKER_PS=$(docker ps -a --format '{{.Names}}' 2>/dev/null); then
            CONTAINERS_UNKNOWN="\`docker ps\` failed — is the daemon running?"
        else
            while IFS= read -r cname; do
                [[ -z "$cname" ]] && continue
                suf=""
                [[ "$cname" == "${PROJECT}-"* ]] && suf="${cname#${PROJECT}-}"
                [[ -n "$WORKER_PREFIX" && "$cname" == "${WORKER_PREFIX}-"* ]] && suf="${cname#${WORKER_PREFIX}-}"
                [[ -z "$suf" ]] && continue
                is_live_suffix "$suf" && continue
                [[ -n "${DEAD_SUFFIX[$suf]:-}" ]] && ORPHAN_CONTAINERS+=("$cname")
            done <<< "$DOCKER_PS"
        fi
    fi
fi

# ============================================
# 5. ORPHAN NGINX BLOCKS
# ============================================
# create-worktree writes "# WORKTREE-START:<branch> ... # WORKTREE-END:<branch>"
# blocks into the nginx config. A block whose <branch> maps to no live worktree
# is orphaned. is_live_suffix normalises "/" -> "-" so "feat/x" matches the
# "feat-x" dir suffix.
ORPHAN_NGINX=()
NGINX_UNKNOWN=""
NGINX_CONF_PATH=""
if [[ -n "$NGINX_CONFIG" && -f "$MAIN_REPO/$NGINX_CONFIG" ]]; then
    NGINX_CONF_PATH="$MAIN_REPO/$NGINX_CONFIG"
    # `grep` has three answers and only two of them agree: 1 is "no worktree
    # blocks in here", which is the ordinary state of a config nobody has
    # wired yet, and 2-or-more is "I could not read it". Piped into the loop
    # both arrived as no lines. A file present but unreadable therefore said
    # `Orphan nginx blocks: none`, and `--remove-nginx` would go on to rewrite
    # the file it had just failed to read.
    NGINX_MARKS=$(grep -oE '# WORKTREE-START:[^[:space:]]+' "$NGINX_CONF_PATH" 2>/dev/null)
    if [[ $? -gt 1 ]]; then
        NGINX_UNKNOWN="$NGINX_CONF_PATH could not be read"
    else
        while IFS= read -r br; do
            [[ -z "$br" ]] && continue
            is_live_suffix "$br" && continue
            ORPHAN_NGINX+=("$br")
        done < <(printf '%s\n' "$NGINX_MARKS" | sed 's/# WORKTREE-START://' | sort -u)
    fi
fi

# ============================================
# 6. ORPHAN CLAIMS
# ============================================
# >>> claim-sweep (extracted verbatim by harness/tests/test_prune_worktrees_claims.py)
# A claim `create-worktree` took for a worktree that is no longer here (#337).
#
# The checkout claim is held by the MACHINE with no session and an 8h TTL, and
# until #337 nothing handed it back: #277's `stop` half releases a SESSION's
# claims and these have none. So a tree removed with a bare `git worktree remove`
# — the same debris every other sweep here exists for — left an issue claimed by
# nobody for the rest of the working day. Symmetry with the acquire, in the tool
# that already sweeps what a missed teardown left behind.
#
# **Only what this script can prove `create-worktree` took.** The discriminator
# is the NOTE, which that script writes as `worktree <branch> on <host>` and
# nothing else writes. An agent working an issue in place — no worktree, so
# `fix-issue-here`, or a claim taken through the `claim` MCP tool — carries a
# different note and is not touched. Without that, a sweep keyed on "no worktree
# for this issue" would free the claim of every agent that never made one, which
# is live work reported as debris.
#
# Machine-scoped by construction: `qb-claimed` asks `/claim/held`, which answers
# about the asking machine. A claim held by another box is neither listed here
# nor releasable from here, and both are correct — that worktree is on that box.
ORPHAN_CLAIMS=()
ORPHAN_CLAIM_BRANCHES=()
# Why this category has no answer, or empty when it has one (#735).
#
# There are three outcomes here and there were only ever two ways to print them.
# `|| true` on the ask below turned an unreachable board, a rotated token and a
# payload `jq` declines into an empty `CLAIMS_JSON`, which walks the same path as
# a board that answered "nothing held" — and `report` prints "none" for an empty
# array. So a sweep that never got an answer read as a sweep that found nothing,
# on the run in between two that listed seven claims.
#
# It matters more here than in the other five categories because only this one is
# on a clock. A leftover directory is still there next time; a claim is on an 8h
# TTL and this sweep is the thing that exists to hand it back early (#337), so a
# false "none" means the claim quietly runs to its fuse — #135's complaint
# arriving through the tool built to prevent it.
CLAIMS_UNKNOWN=""
CLAIM_BIN=$(command -v qb-claimed 2>/dev/null || true)
if [[ -z "$CLAIM_BIN" && "$0" == */* ]]; then CLAIM_BIN="${0%/*}/qb-claimed"; fi
[[ -n "$CLAIM_BIN" && -x "$CLAIM_BIN" ]] || CLAIM_BIN=""
RELEASE_BIN=$(command -v qb-release 2>/dev/null || true)
if [[ -z "$RELEASE_BIN" && "$0" == */* ]]; then RELEASE_BIN="${0%/*}/qb-release"; fi
[[ -n "$RELEASE_BIN" && -x "$RELEASE_BIN" ]] || RELEASE_BIN=""
# Resolved BEFORE the `jq` test, so that "no jq" is reachable as its own answer.
# Under the old order both names came out empty on a host without `jq` and were
# indistinguishable from a host without the tools.
if [[ -z "$CLAIM_BIN" && -z "$RELEASE_BIN" ]]; then
    # Neither half is installed, so nothing on this host ever took a board claim
    # for a worktree and there is none to sweep. Not "unknown": a feature that is
    # not installed is the nginx category's answer to a project with no nginx
    # config, and a `NOT CHECKED` on every run of a repo that has no board would
    # be the noise this whole category was careful to avoid.
    :
elif ! command -v jq >/dev/null 2>&1; then
    CLAIMS_UNKNOWN="jq is not installed, so the board's answer could not be read"
elif [[ -z "$CLAIM_BIN" ]]; then
    # One half present and the other missing is a partial install, and it is
    # exactly where a false "none" hides: `qb-release` being here says claims are
    # taken on this host, so an unasked board may well be holding some.
    CLAIMS_UNKNOWN="\`qb-claimed\` is not on PATH, so the board was never asked"
elif [[ -z "$RELEASE_BIN" ]]; then
    # Still collects nothing: reporting an orphan the run cannot act on is a
    # dry-run promise it cannot keep. But "cannot act" is not "nothing to act
    # on", and "none" can only say the second.
    CLAIMS_UNKNOWN="\`qb-release\` is not on PATH, so nothing could be handed back"
else
    # `--session ''` on purpose: the checkout claim names no session, and the
    # default would narrow to this process's own.
    #
    # Stderr is still dropped and the EXIT STATUS is what replaced `|| true`:
    # `qb-claimed` documents 0 held / 1 free / 2 unknown precisely so a caller
    # can tell "nothing" from "cannot tell" without parsing its prose. Keeping
    # the suppression keeps the original bargain — an unconfigured board is a
    # normal state for this tool and one warning per run about a feature nobody
    # enabled is noise — while the report line below now says which of the two
    # it got. That is the same one line either way, so nothing grew noisier; it
    # just stopped being wrong.
    CLAIMS_JSON=$("$CLAIM_BIN" --repo-path "$MAIN_REPO" --session '' --json 2>/dev/null)
    CLAIMS_RC=$?
    CLAIMS_TSV=""
    if [[ "$CLAIMS_RC" -gt 1 ]]; then
        CLAIMS_UNKNOWN="\`qb-claimed\` exited $CLAIMS_RC (no board configured, or it could not be reached)"
    elif [[ -z "$CLAIMS_JSON" ]]; then
        # Both 0 and 1 print the answer under `--json`, so an empty stdout is
        # something other than the tool this expects answering in its place.
        CLAIMS_UNKNOWN="\`qb-claimed\` exited $CLAIMS_RC but printed no answer"
    elif ! CLAIMS_SHAPE=$(printf '%s' "$CLAIMS_JSON" | jq -r '(.claims | type)' 2>/dev/null); then
        # A truncated or non-JSON payload. `jq` declining one was silent and
        # indistinguishable from a board with nothing on it.
        CLAIMS_UNKNOWN="the board's answer did not parse as JSON"
    elif [[ "$CLAIMS_SHAPE" != "array" ]]; then
        # Well-formed JSON that is not a claim answer — an error body served 200,
        # a different endpoint. `.claims[]?` accepts it and yields nothing, and
        # the `?` that makes it safe is what makes it silent, so the shape is
        # asked about rather than assumed.
        CLAIMS_UNKNOWN="the board's answer carried no claims list (.claims is $CLAIMS_SHAPE)"
    elif ! CLAIMS_TSV=$(printf '%s' "$CLAIMS_JSON" \
                | jq -r '.claims[]? | [(.note // ""), (.key // "")] | @tsv' 2>/dev/null); then
        CLAIMS_UNKNOWN="the board's claims list did not read as claims"
    else
        while IFS=$'\t' read -r note key; do
            [[ -z "$note" ]] && continue
            [[ "$note" =~ ^worktree[[:space:]](.+)[[:space:]]on[[:space:]] ]] || continue
            br="${BASH_REMATCH[1]}"
            is_live_suffix "$br" && continue
            ORPHAN_CLAIMS+=("$key  (worktree $br)")
            ORPHAN_CLAIM_BRANCHES+=("$br")
        done <<< "$CLAIMS_TSV"
    fi
    # Suppressing the stderr keeps the run quiet; it must not also make the
    # answer undiagnosable. An exit 2 covers an unconfigured board, a rotated
    # token, a TLS failure, a timeout and an outage, and `qb-claimed` prints
    # which — so the line names the command that will say, instead of carrying
    # the prose or leaving the reader to guess. Still one line, still no output
    # from a feature nobody enabled.
    [[ -n "$CLAIMS_UNKNOWN" ]] && CLAIMS_UNKNOWN+="; for the reason run: qb-claimed --repo-path '$MAIN_REPO' --session ''"
fi
# <<< claim-sweep

# ============================================
# REPORT
# ============================================
# Print a labelled section. Args after the count are the items (may be zero).
# `why` is the FOURTH state (#735), and it comes before the count because it
# outranks it: a sweep that could not run has no count, and zero is the one thing
# it must not be reported as. "none" and "not checked" are opposite answers with
# opposite remedies, and only the first is a reason to stop looking. `qb-doctor`
# settled this for its own six checks — `?` is not `ok`, "a doctor that prints ok
# because it could not look is worse than one that does not check" — and this is
# that verdict, in the sweep.
#
# One parameter on the one function every category already goes through, rather
# than a second function beside it: a category whose sweep grows a way to fail
# has somewhere to say so without a call site being rewritten to notice, and the
# six lines below then read as one table with one empty column.
report() {
    local title="$1" why="$2" count="$3"; shift 3
    if [[ -n "$why" ]]; then
        echo -e "${YELLOW}? $title: NOT CHECKED — $why${NC}"
    elif [[ "$count" -eq 0 ]]; then
        echo -e "${GREEN}✓ $title: none${NC}"
    else
        echo -e "${CYAN}$title ($count):${NC}"
        printf '    %s\n' "$@"
    fi
}
echo ""
report "Orphan databases"     "$DB_SCAN_UNKNOWN"    "${#ORPHAN_DBS[@]}"        "${ORPHAN_DBS[@]:-}"
report "Stale port entries"   "$PORTS_UNKNOWN"      "${#STALE_PORTS[@]}"       "${STALE_PORTS[@]:-}"
# Leftover directories is the one category with no fourth state, and that is not
# an omission: it is derived entirely from the live list, which is now refused
# outright above rather than allowed to come back short.
report "Leftover directories" ""                    "${#LEFTOVER_DIRS[@]}"     "${LEFTOVER_DIRS[@]:-}"
report "Orphan containers"    "$CONTAINERS_UNKNOWN" "${#ORPHAN_CONTAINERS[@]}" "${ORPHAN_CONTAINERS[@]:-}"
report "Orphan nginx blocks"  "$NGINX_UNKNOWN"      "${#ORPHAN_NGINX[@]}"      "${ORPHAN_NGINX[@]:-}"
report "Orphan board claims"  "$CLAIMS_UNKNOWN"     "${#ORPHAN_CLAIMS[@]}"     "${ORPHAN_CLAIMS[@]:-}"
if [[ ${#PROTECTED_DBS[@]} -gt 0 ]]; then
    echo -e "${YELLOW}Protected by .database.protect — not counted as orphans (${#PROTECTED_DBS[@]}):${NC}"
    printf '    %s\n' "${PROTECTED_DBS[@]}"
fi
if [[ ${#SKIPPED_DIRS[@]} -gt 0 ]]; then
    echo -e "${YELLOW}  (ignored ${#SKIPPED_DIRS[@]} ${PROJECT}-* dir(s) with no worktree markers — not touched)${NC}"
fi
if [[ ${#HELD_DIRS[@]} -gt 0 ]]; then
    echo -e "${YELLOW}Held by a live agent — left alone, NOT counted as leftovers (${#HELD_DIRS[@]}):${NC}"
    printf '    %s\n' "${HELD_DIRS[@]}"
    echo -e "${YELLOW}  Run ${CYAN}worktree-holder <dir>${YELLOW} to see who, and talk to them before removing it.${NC}"
fi
echo ""

TOTAL=$(( ${#ORPHAN_DBS[@]} + ${#STALE_PORTS[@]} + ${#LEFTOVER_DIRS[@]} \
        + ${#ORPHAN_CONTAINERS[@]} + ${#ORPHAN_NGINX[@]} + ${#ORPHAN_CLAIMS[@]} ))
# The categories that produced no answer, named for the two lines below. "Clean."
# is a statement about all six, so a run that looked at four of them cannot make
# it — that sentence is precisely what a caller quotes back as "the sweep ran and
# found nothing" (#735).
UNCHECKED=""
note_unchecked() {
    [[ -n "$1" ]] && UNCHECKED="${UNCHECKED:+$UNCHECKED, }$2"
    return 0            # or a category with no failure ends the function non-zero
}
note_unchecked "$DB_SCAN_UNKNOWN"    "orphan databases"
note_unchecked "$PORTS_UNKNOWN"      "stale port entries"
note_unchecked "$CONTAINERS_UNKNOWN" "orphan containers"
note_unchecked "$NGINX_UNKNOWN"      "orphan nginx blocks"
note_unchecked "$CLAIMS_UNKNOWN"     "board claims"

if [[ "$TOTAL" -eq 0 ]]; then
    if [[ -n "$UNCHECKED" ]]; then
        echo -e "${YELLOW}Nothing to prune in what was checked — but $UNCHECKED went unchecked (see above).${NC}"
    else
        echo -e "${GREEN}Nothing to prune. Clean.${NC}"
    fi
    exit 0
fi
[[ -n "$UNCHECKED" ]] && \
    echo -e "${YELLOW}Note: $UNCHECKED went unchecked — what follows is not the whole picture.${NC}"

# ============================================
# APPLY
# ============================================
# Each flag acts independently: --prune handles DBs + port entries, --remove-dirs
# handles leftover directories. With neither, it's a dry run.
if [[ "$ANY_APPLY" != true ]]; then
    echo -e "${YELLOW}Dry run — nothing changed.${NC}"
    [[ $(( ${#ORPHAN_DBS[@]} + ${#STALE_PORTS[@]} + ${#ORPHAN_CLAIMS[@]} )) -gt 0 ]] && \
        echo -e "  Re-run with ${CYAN}--prune${NC} to drop orphan DBs, prune port entries and hand back claims."
    [[ ${#LEFTOVER_DIRS[@]} -gt 0 ]] && \
        echo -e "  Re-run with ${CYAN}--remove-dirs${NC} to delete the leftover directories."
    [[ ${#ORPHAN_CONTAINERS[@]} -gt 0 ]] && \
        echo -e "  Re-run with ${CYAN}--remove-containers${NC} to force-remove the orphan containers."
    [[ ${#ORPHAN_NGINX[@]} -gt 0 ]] && \
        echo -e "  Re-run with ${CYAN}--remove-nginx${NC} to strip the orphan nginx blocks and restart nginx."
    exit 0
fi

echo -e "${GREEN}Applying...${NC}"

# Drop orphan DBs + prune stale port entries (--prune)
if [[ "$APPLY" = true ]]; then
    for db in "${ORPHAN_DBS[@]:-}"; do
        [[ -z "$db" ]] && continue
        if drop_db "$db"; then
            echo -e "  ${GREEN}dropped db: $db${NC}"
        else
            echo -e "  ${YELLOW}could not drop db: $db${NC}"
        fi
    done
    if [[ ${#STALE_PORTS[@]} -gt 0 && -f "$PORT_FILE" ]]; then
        if [[ ${#KEPT_PORTS[@]} -gt 0 ]]; then
            printf '%s\n' "${KEPT_PORTS[@]}" > "$PORT_FILE"
        else
            : > "$PORT_FILE"
        fi
        echo -e "  ${GREEN}pruned ${#STALE_PORTS[@]} stale port entr$([[ ${#STALE_PORTS[@]} -eq 1 ]] && echo y || echo ies)${NC}"
    fi
    # Handed back one at a time, by BRANCH: `qb-release` re-derives the key from
    # the branch through the board, so this never composes a key of its own —
    # the rule #172 exists for, and the reason the sweep above collected branch
    # names rather than the keys it printed.
    #
    # Silence would read as success here, because every other line in this block
    # reports an action: `--prune` must say outright that it handed nothing back
    # when it never got a list to hand back from (#735).
    if [[ -n "$CLAIMS_UNKNOWN" ]]; then
        echo -e "  ${YELLOW}claims NOT swept — $CLAIMS_UNKNOWN${NC}"
    else
        for br in "${ORPHAN_CLAIM_BRANCHES[@]:-}"; do
            [[ -z "$br" ]] && continue
            if "$RELEASE_BIN" --branch "$br" --repo-path "$MAIN_REPO" --quiet; then
                echo -e "  ${GREEN}released claim: $br${NC}"
            else
                echo -e "  ${YELLOW}could not release claim: $br (still held)${NC}"
            fi
        done
    fi
fi

# Remove leftover directories (--remove-dirs)
if [[ "$REMOVE_DIRS" = true ]]; then
    needsudo=0
    for d in "${LEFTOVER_DIRS[@]:-}"; do
        [[ -z "$d" ]] && continue
        err=$(rm -rf "$d" 2>&1)
        if [[ ! -d "$d" ]]; then
            echo -e "  ${GREEN}removed dir: $d${NC}"
        elif grep -q 'Permission denied' <<<"$err"; then
            # Almost always apps/models written by a root docker container — the
            # files are root-owned, so this user can't unlink them.
            echo -e "  ${YELLOW}could not remove (root-owned files): $d${NC}"
            needsudo=1
        else
            echo -e "  ${YELLOW}could not remove: $d${NC}${err:+ — ${err%%$'\n'*}}"
        fi
    done
    [[ ${#LEFTOVER_DIRS[@]} -gt 0 ]] && { git worktree prune 2>/dev/null || true; }
    if [[ "$needsudo" = 1 ]]; then
        echo -e "  ${CYAN}Some dirs contain root-owned files (e.g. a docker-as-root model download).${NC}"
        echo -e "  ${CYAN}Re-run the deletion with elevated privileges, e.g.:  sudo rm -rf <dir>${NC}"
    fi
elif [[ ${#LEFTOVER_DIRS[@]} -gt 0 ]]; then
    echo -e "  ${YELLOW}left ${#LEFTOVER_DIRS[@]} leftover director$([[ ${#LEFTOVER_DIRS[@]} -eq 1 ]] && echo y || echo ies) in place (use --remove-dirs)${NC}"
fi

# Force-remove orphan containers (--remove-containers)
if [[ "$REMOVE_CONTAINERS" = true && ${#ORPHAN_CONTAINERS[@]} -gt 0 ]]; then
    for c in "${ORPHAN_CONTAINERS[@]}"; do
        [[ -z "$c" ]] && continue
        if docker rm -f "$c" >/dev/null 2>&1; then
            echo -e "  ${GREEN}removed container: $c${NC}"
        else
            echo -e "  ${YELLOW}could not remove container: $c${NC}"
        fi
    done
elif [[ "$REMOVE_CONTAINERS" != true && ${#ORPHAN_CONTAINERS[@]} -gt 0 ]]; then
    echo -e "  ${YELLOW}left ${#ORPHAN_CONTAINERS[@]} orphan container(s) (use --remove-containers)${NC}"
fi

# Strip orphan nginx blocks + restart nginx (--remove-nginx)
# Two facts, not one: whether the config actually changed (which decides the
# restart) and whether any block failed (which the per-block line reports). A
# run that strips three of four still needs the restart for the three.
NGINX_REMOVED_ANY=false
if [[ "$REMOVE_NGINX" = true && ${#ORPHAN_NGINX[@]} -gt 0 && -n "$NGINX_CONF_PATH" ]]; then
    for br in "${ORPHAN_NGINX[@]}"; do
        [[ -z "$br" ]] && continue
        # Match the branch AFTER the tag exactly, so "issue-5" can't also strip
        # "issue-50" (substring). Trim trailing whitespace/CR before comparing.
        #
        # The `&& mv` used to be followed by an unconditional success line, and
        # under no `-e` an `awk` that could not read the config or an `mv` across
        # a full disk left the file untouched and the run still said "removed".
        # Same rule as `--prune` and the claims: a line reporting an action is a
        # claim that the action happened.
        if awk -v br="$br" '
            match($0, /# WORKTREE-(START|END):/) {
                tag  = substr($0, RSTART, RLENGTH)
                rest = substr($0, RSTART + RLENGTH)
                gsub(/[[:space:]]+$/, "", rest)
                if (rest == br) { skip = (tag ~ /START/) ? 1 : 0; next }
            }
            skip { next }
            { print }
        ' "$NGINX_CONF_PATH" > "$NGINX_CONF_PATH.tmp" && mv "$NGINX_CONF_PATH.tmp" "$NGINX_CONF_PATH"; then
            echo -e "  ${GREEN}removed nginx block: $br${NC}"
            NGINX_REMOVED_ANY=true
        else
            # The half-written temp file goes rather than sitting next to the
            # config it was going to replace.
            rm -f "$NGINX_CONF_PATH.tmp"
            echo -e "  ${YELLOW}could not remove nginx block: $br — config left as it was${NC}"
        fi
    done
    if [[ "$NGINX_REMOVED_ANY" = true ]]; then
        # Collapse the blank lines the removed blocks leave behind (mirror
        # remove-worktree). Cosmetic, so a failure here is not worth a line of
        # its own — but the temp file still goes.
        if ! { awk 'NF {blank=0; print} !NF {blank++; if (blank <= 2) print}' \
                "$NGINX_CONF_PATH" > "$NGINX_CONF_PATH.tmp" \
                && mv "$NGINX_CONF_PATH.tmp" "$NGINX_CONF_PATH"; }; then
            rm -f "$NGINX_CONF_PATH.tmp"
        fi
        # Restart nginx so the stripped config takes effect.
        nc="$NGINX_CONTAINER"
        [[ "$nc" = "auto" || -z "$nc" ]] && nc=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -iE 'nginx' | head -1)
        if [[ -n "$nc" ]]; then
            docker restart "$nc" >/dev/null 2>&1 && echo -e "  ${GREEN}restarted nginx ($nc)${NC}" \
                || echo -e "  ${YELLOW}could not restart nginx ($nc)${NC}"
        else
            echo -e "  ${YELLOW}nginx container not found — restart it manually${NC}"
        fi
    else
        # No restart, and said out loud: a restart line is what tells the reader
        # the change is live, so printing one over a config nothing was stripped
        # from is the same false report as the rest of this issue.
        echo -e "  ${YELLOW}nginx not restarted — nothing was stripped from the config${NC}"
    fi
elif [[ "$REMOVE_NGINX" != true && ${#ORPHAN_NGINX[@]} -gt 0 ]]; then
    echo -e "  ${YELLOW}left ${#ORPHAN_NGINX[@]} orphan nginx block(s) (use --remove-nginx)${NC}"
fi

echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}Prune complete: $PROJECT${NC}"
echo -e "${GREEN}========================================${NC}"

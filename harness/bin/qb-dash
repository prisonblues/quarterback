#!/usr/bin/env bash
# qb-dash — the fleet dashboard: who is alive, what they hold, what is open.
#
#   qb-dash              the plain renderer, redrawing in place
#   qb-dash --tui        the clickable one (what `qb` and `qb-dash-tui` run)
#   qb-dash --once       one frame and exit
#
# A LAUNCHER, NOT THE DASHBOARD. The dashboard is Python and needs three things
# the harness cannot assume: rich, textual, and mcp_server — the same board
# client the MCP server uses, which lives in this repo's mcp/ and is not on a
# plain python3. So a shebang is exactly the wrong mechanism: patchShebangs
# rewrites it to a store python3 that has none of them, and the whole thing dies
# on `import textual` the first time somebody types `qb` after a rebuild.
#
# Instead: find an interpreter that can actually import what this needs, the way
# qb-board does. QB_DASH_PYTHON short-circuits the search.
set -uo pipefail

PROG=${0##*/}

# Where this script really lives. NOT `readlink -f`: home-manager installs each
# file as its own flat /nix/store/…-hm_qb-dash path, so full resolution walks
# straight past the bin/ directory holding the .py beside it.
self_dir() {
  local p="$1" d
  for _ in 1 2 3 4 5 6 7 8; do
    d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || return 1
    [ -r "$d/qbdata.py" ] && { printf '%s\n' "$d"; return 0; }
    [ -L "$p" ] || return 1
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  return 1
}

BIN_DIR="$(self_dir "$0")" || {
  echo "$PROG: cannot find qbdata.py beside this script — broken install" >&2
  exit 1
}

MODE=plain
case "${1:-}" in --tui) MODE=tui; shift ;; esac
case "$PROG" in *-tui) MODE=tui ;; esac
[ "$MODE" = tui ] && TARGET="$BIN_DIR/qb-dash-tui.py" || TARGET="$BIN_DIR/qb-dash.py"

# `textual` only matters for the clickable one, so the plain renderer still runs
# on an interpreter that has rich and the client but no textual.
usable() {
  [ -x "$1" ] || return 1
  if [ "$MODE" = tui ]; then
    "$1" -c 'import rich, textual, mcp_server.board.config' >/dev/null 2>&1
  else
    "$1" -c 'import rich, mcp_server.board.config' >/dev/null 2>&1
  fi
}

CANDIDATES=(
  "${QB_DASH_PYTHON:-}"
  "${QUARTERBACK_REPO:-}/mcp/.venv/bin/python"
  "$BIN_DIR/../../mcp/.venv/bin/python"
  "$HOME/source/quarterback/mcp/.venv/bin/python"
)
PY=""
for candidate in "${CANDIDATES[@]}"; do
  case "$candidate" in ""|"/mcp/.venv/bin/python") continue ;; esac
  usable "$candidate" && { PY="$candidate"; break; }
done
[ -n "$PY" ] || { command -v python3 >/dev/null 2>&1 && usable "$(command -v python3)" \
  && PY="$(command -v python3)"; }

if [ -z "$PY" ]; then
  cat >&2 <<EOF
$PROG: no Python here can import what the dashboard needs
        (rich$([ "$MODE" = tui ] && printf ', textual'), and mcp_server for the board client).

        Point QB_DASH_PYTHON at one, or QUARTERBACK_REPO at a quarterback
        checkout whose mcp/.venv is built:

          QB_DASH_PYTHON=/path/to/venv/bin/python $PROG
          QUARTERBACK_REPO=~/source/quarterback $PROG
EOF
  exit 1
fi

exec "$PY" "$TARGET" "$@"

#!/usr/bin/env bash
# qb-dash — the fleet dashboard: who is alive, what they hold, what is open.
#
#   qb-dash                      the dashboard
#   qb-dash --scope all          every repo the BOARD knows, not just this screen's
#   qb-dash --repo ~/src/other   point it at a project other than the cwd's
#   qb-dash --can-tui            exit 0 if it can run here, else 1
#
# A LAUNCHER, NOT THE DASHBOARD. The dashboard is Python and needs rich and
# textual, which a plain python3 does not have — so a shebang is the wrong
# mechanism: patchShebangs rewrites it to a store python3 with neither, and the
# whole thing dies on `import textual` the first time somebody types `qb` after a
# rebuild.
#
# The nix build sets QB_DASH_PYTHON to an interpreter carrying exactly those two,
# so an installed harness needs nothing from the host. Run from a checkout it
# searches instead.
#
# ONE RENDERER. There were two, chosen by `--tui`: this clickable Textual app and
# a plain rich renderer that redrew in place. The plain one was the default until
# #426 and the fallback afterwards, and a fallback nobody chooses is a second
# implementation of every panel to keep in step — `qbdata.py` carries its six
# pairs of near-identical helpers because of exactly that. It is gone.
#
# `--tui` IS STILL ACCEPTED, and ignored. It is in muscle memory, it is what
# `qb-dash-tui` execs, and an installed `qb-seats` older than this file still
# emits it; a launcher that died on the flag naming the thing it now always does
# would be a rebuild that breaks the dash pane. `--can-tui` stays for the same
# reason — it is how that older `qb-seats` asks whether to use `--tui` at all,
# and "could the clickable one run here" still has an honest yes or no.
#
# GONE WITH THE PLAIN RENDERER: `--once`, `--width` and `--interval`, which were
# its flags and had no caller outside its own tests, and the fallback for a box
# where textual will not import. There is no lesser thing left to fall back TO,
# so that case says so and exits 1 — a packaged harness carries its own
# interpreter, so it is a checkout's problem and QB_DASH_PYTHON is its answer.
set -uo pipefail

PROG=${0##*/}

# Where this script really lives. NOT `readlink -f`: home-manager installs each
# file as its own flat /nix/store/…-hm_qb-dash path, so full resolution walks
# straight past the bin/ directory holding the .py beside it.
self_dir() {
  local p="$1" d
  for _ in 1 2 3 4 5 6 7 8; do
    d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || return 1
    [ -r "$d/qbdata.py" ] && { printf '%s\n' "$d"; return 0; }
    [ -L "$p" ] || return 1
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  return 1
}

BIN_DIR="$(self_dir "$0")" || {
  echo "$PROG: cannot find qbdata.py beside this script — broken install" >&2
  exit 1
}

# One question now, where there were two: the plain renderer ran on rich alone,
# so `usable` had to know which renderer was being asked about and read a $MODE
# to find out. With one renderer there is one answer.
usable() { [ -x "$1" ] && "$1" -c 'import rich, textual' >/dev/null 2>&1; }

# The interpreter search, as a function with ONE caller per question rather than
# a straight-line block. `--can-tui` asks the same question the launch path asks
# and must not answer it differently — a second copy would drift, and the box it
# drifted on would be told the dash was available and then shown the error
# instead, in the pane least able to afford it. Sets $PY; empty means none.
find_python() {
  local candidate
  # Built by APPENDING only the candidates that exist, which is how `qb-board`
  # builds the same list and for the reasons its comment gives. The fixed-list
  # form this replaces skipped its empties with a `case` naming them literally —
  # a sentinel string that stops matching the moment the expression above it is
  # edited, leaving a bogus path probed on every launch.
  #
  # It also read `$HOME` unguarded under `set -u`, so a launch with HOME unset
  # died on `HOME: unbound variable` before it could try `python3` — which might
  # have worked. A cron job, a systemd unit and `env -i` all define no HOME, and
  # the message a person got was a line number rather than the dependency error
  # this script exists to print.
  CANDIDATES=()
  [ -n "${QB_DASH_PYTHON:-}" ] && CANDIDATES+=("$QB_DASH_PYTHON")
  [ -n "${QUARTERBACK_REPO:-}" ] && CANDIDATES+=("$QUARTERBACK_REPO/mcp/.venv/bin/python")
  CANDIDATES+=("$BIN_DIR/../../mcp/.venv/bin/python")
  [ -n "${HOME:-}" ] && CANDIDATES+=("$HOME/source/quarterback/mcp/.venv/bin/python")
  PY=""
  # `${arr[@]+…}`: bash before 4.4 treats an empty array as unset under `set -u`.
  for candidate in ${CANDIDATES[@]+"${CANDIDATES[@]}"}; do
    usable "$candidate" && { PY="$candidate"; return 0; }
  done
  command -v python3 >/dev/null 2>&1 && usable "$(command -v python3)" \
    && { PY="$(command -v python3)"; return 0; }
  return 1
}

# A question, not a flag, so it is answered before the argument loop and never
# reaches the dashboard.
if [ "${1:-}" = "--can-tui" ]; then
  find_python >/dev/null 2>&1 && exit 0 || exit 1
fi

# `--tui` ANYWHERE, not only first, and DROPPED rather than passed through: the
# Python has never known the flag, and `qb-dash --scope all --tui` has to reach
# it as the same argv `qb-dash --scope all` does. Everything after a `--` is left
# alone: it belongs to the target.
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tui) ;;
    --) ARGS+=("$@"); break ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- ${ARGS+"${ARGS[@]}"}

if ! find_python; then
  cat >&2 <<EOF
$PROG: no Python here can import what the dashboard needs (rich, textual).

        An installed harness carries its own; from a checkout, point
        QB_DASH_PYTHON at any interpreter that has them:

          QB_DASH_PYTHON=/path/to/venv/bin/python $PROG
EOF
  exit 1
fi

exec "$PY" "$BIN_DIR/qb-dash-tui.py" "$@"

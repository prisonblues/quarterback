#!/usr/bin/env python3
"""heavy-slot — one memory-aware admission queue for the heavy jobs on a host (#874).

A job asks for memory and waits until it fits; see "heavy-slot" in harness/README.md.

  heavy-slot run  --min SIZE [--max SIZE] [--unit SIZE] [--label L] [--timeout MIN] -- CMD...
      Becomes CMD (exec), which inherits the reservation and holds it until it exits.
      CMD sees HEAVY_SLOT_GRANT_BYTES and HEAVY_SLOT_UNITS.
  heavy-slot hold --min SIZE [--max SIZE] [--unit SIZE] [--label L] [--timeout MIN]
      Prints the grant as one JSON line and holds it until its stdin closes.
  heavy-slot status [--json]

Exits: 0 granted, 2 usage or an unreadable config, meminfo or queue, 3 the min can never fit,
4 the wait timed out, 126/127 CMD cannot be run. After the exec, `run` exits as CMD does.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import re
import signal
import stat
import sys
import time

EXIT_USAGE, EXIT_NEVER, EXIT_TIMEOUT = 2, 3, 4
DEFAULTS = {"dir": "/tmp/heavy-slot", "budget": "", "reserve": "12G", "min_free": "2G"}
CONFIG_FILES = ("/etc/heavy-slot.conf", "~/.config/heavy-slot.conf")
POLL_SECONDS = 2.0
LABEL_MAX = 200  # keeps every record well inside the RECORD_MAX a reader takes
RECORD_MAX = 4096
SIZE_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*([KMGT]?)(?:i?B)?\s*$", re.IGNORECASE)
SCALE = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}


def parse_size(text: str) -> int:
    m = SIZE_RE.match(str(text))
    try:
        return int(float(m.group(1)) * SCALE[m.group(2).upper()])
    except (AttributeError, OverflowError):
        raise ValueError(f"not a size: {text!r}") from None


def fmt(n: int) -> str:
    return f"{n / (1 << 30):.1f}G"


def load_config(env: dict) -> dict:
    """DEFAULTS, then each config file's KEY=VALUE lines, then HEAVY_SLOT_<KEY>."""
    cfg = dict(DEFAULTS)
    for path in CONFIG_FILES:
        try:
            with open(os.path.expanduser(path), encoding="utf-8") as f:
                lines = f.read().splitlines()
        except FileNotFoundError:
            continue
        for line in lines:
            key, sep, value = line.split("#", 1)[0].partition("=")
            if sep and key.strip() in DEFAULTS:
                cfg[key.strip()] = value.strip()
    for key in DEFAULTS:
        if env.get(f"HEAVY_SLOT_{key.upper()}"):
            cfg[key] = env[f"HEAVY_SLOT_{key.upper()}"]
    for key in ("budget", "reserve", "min_free"):
        if cfg[key]:
            parse_size(cfg[key])
    return cfg


def meminfo(env: dict) -> tuple[int, int]:
    """(MemTotal, MemAvailable) in bytes. HEAVY_SLOT_MEMINFO names another file (tests)."""
    path = env.get("HEAVY_SLOT_MEMINFO", "/proc/meminfo")
    found = {}
    try:
        with open(path, encoding="ascii") as f:
            for line in f:
                key, _, rest = line.partition(":")
                if key in ("MemTotal", "MemAvailable"):
                    found[key] = int(rest.split()[0]) * 1024
        return found["MemTotal"], found["MemAvailable"]
    except (OSError, KeyError, ValueError, IndexError):
        raise ValueError(f"cannot read MemTotal and MemAvailable from {path}") from None


def budget_of(cfg: dict, total: int) -> int:
    if cfg["budget"]:
        return parse_size(cfg["budget"])
    return max(0, total - parse_size(cfg["reserve"]))


def _fields(raw: bytes) -> dict:
    """An entry's recorded fields, or none when they are not a JSON object."""
    try:
        entry = json.loads(raw)
    except ValueError:
        return {}
    return entry if isinstance(entry, dict) else {}


def live(d: str, prefix: str) -> list[dict]:
    """Every entry of one kind that some process still holds the lock on, oldest first.
    A file nobody holds does not count; this user removes it when it may."""
    out = []
    for name in sorted(os.listdir(d)):
        if not name.startswith(prefix):
            continue
        path = os.path.join(d, name)
        fd = _open_regular(path)
        if fd is None:
            continue
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            out.append({**_fields(os.pread(fd, RECORD_MAX, 0)), "file": name})
            continue
        finally:
            os.close(fd)
        try:
            os.unlink(path)
        except OSError:
            pass
    return out


def _open_regular(path: str) -> int | None:
    """Open a queue file to read, or None. Anyone can create entries here, so a FIFO, a
    device or a symlink must not block or redirect the reader."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except OSError:
        return None
    if stat.S_ISREG(os.fstat(fd).st_mode):
        return fd
    os.close(fd)
    return None


def _publish(d: str, name: str, fields: dict) -> int:
    """Create `name` locked and readable by everyone: written and locked under a temp
    name, then renamed, so no reader sees it unlocked and takes it for a dead holder's."""
    tmp = os.path.join(d, f".tmp-{name}")
    fd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o644)
    os.fchmod(fd, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    os.write(fd, json.dumps(fields).encode())
    os.rename(tmp, os.path.join(d, name))
    return fd


def _open_admit(d: str) -> int:
    """The admission lock, read-only: flock needs no write access, and an O_CREAT open of
    another user's file in a sticky directory is refused (fs.protected_regular)."""
    path = os.path.join(d, ".admit")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CREAT | os.O_EXCL, 0o644)
        os.fchmod(fd, 0o644)
        return fd
    except FileExistsError:
        fd = _open_regular(path)
    if fd is None:
        raise ValueError(f"{path} is not a regular file")
    return fd


def open_dir(cfg: dict) -> str:
    d = os.path.expanduser(cfg["dir"])
    os.makedirs(d, exist_ok=True)
    if os.stat(d).st_uid == os.getuid():
        os.chmod(d, 0o1777)
    return d


def room(cfg: dict, env: dict, holders: list[dict]) -> tuple[int, dict]:
    total, available = meminfo(env)
    budget = budget_of(cfg, total)
    reserved = sum(h["bytes"] for h in holders
                   if isinstance(h.get("bytes"), int) and h["bytes"] > 0)
    free = min(budget - reserved, available - parse_size(cfg["min_free"]))
    return max(0, free), {"budget": budget, "reserved": reserved, "available": available}


def grant_for(want_min: int, want_max: int, unit: int, free: int) -> int:
    """The grant for this request out of `free`, or 0 when its min does not fit."""
    grant = min(want_max, free)
    if unit:
        grant -= grant % unit
    return grant if grant >= want_min else 0


def acquire(args, cfg: dict, env: dict) -> tuple[int, str, int]:
    """Wait for and take a reservation. Returns (lock fd, its file, granted bytes)."""
    d = open_dir(cfg)
    total = meminfo(env)[0]
    # MemAvailable never exceeds MemTotal, so no grant can be bigger than this.
    budget = min(budget_of(cfg, total), total - parse_size(cfg["min_free"]))
    if args.min > budget:
        print(f"heavy-slot: {args.label} wants at least {fmt(args.min)}, more than the whole "
              f"budget of {fmt(budget)}", file=sys.stderr)
        sys.exit(EXIT_NEVER)
    # CLOCK_MONOTONIC is one clock for every process on the host, and never steps back.
    me = f"wait-{time.monotonic_ns():020d}-{os.getpid()}"
    fields = {"pid": os.getpid(), "uid": os.getuid(), "label": args.label, "min": args.min,
              "max": args.max, "since": time.strftime("%Y-%m-%d %H:%M:%S")}
    wait_fd = _publish(d, me, fields)
    deadline = time.monotonic() + args.timeout * 60 if args.timeout else None
    said = False
    admit = _open_admit(d)
    try:
        while True:
            fcntl.flock(admit, fcntl.LOCK_EX)
            try:
                waiters = live(d, "wait-")
                holders = live(d, "res-")
                free, why = room(cfg, env, holders)
                first = bool(waiters) and waiters[0]["file"] == me
                grant = grant_for(args.min, args.max, args.unit, free) if first else 0
                if grant:
                    name = f"res-{me[5:]}"
                    fd = _publish(d, name, {**fields, "bytes": grant})
                    os.unlink(os.path.join(d, me))  # under the lock: no one sees both
                    return fd, os.path.join(d, name), grant
                if deadline and time.monotonic() > deadline:
                    print(f"heavy-slot: {args.label} gave up after {args.timeout:g} min",
                          file=sys.stderr)
                    sys.exit(EXIT_TIMEOUT)
            finally:
                fcntl.flock(admit, fcntl.LOCK_UN)
            if not said:
                ahead = next((i for i, w in enumerate(waiters) if w["file"] == me), 0)
                print(f"heavy-slot: {args.label} waiting for {fmt(args.min)}: budget "
                      f"{fmt(why['budget'])}, {fmt(why['reserved'])} reserved by "
                      f"{len(holders)} holder(s), MemAvailable {fmt(why['available'])}, "
                      f"{ahead} ahead", file=sys.stderr, flush=True)
                said = True
            time.sleep(POLL_SECONDS)
    finally:
        os.close(admit)
        try:
            os.unlink(os.path.join(d, me))
        except FileNotFoundError:
            pass
        os.close(wait_fd)


def cmd_run(args, cfg, env) -> int:
    if not args.cmd:
        print("heavy-slot run: nothing to run after --", file=sys.stderr)
        return EXIT_USAGE
    fd, res, grant = acquire(args, cfg, env)
    env["HEAVY_SLOT_GRANT_BYTES"] = str(grant)
    env["HEAVY_SLOT_UNITS"] = str(grant // args.unit if args.unit else 0)
    os.set_inheritable(fd, True)
    # Python ignores these at start-up, and an ignored signal survives exec.
    for sig in (signal.SIGPIPE, signal.SIGXFSZ):
        signal.signal(sig, signal.SIG_DFL)
    try:
        os.execvpe(args.cmd[0], args.cmd, env)
    except OSError as e:
        os.unlink(res)
        print(f"heavy-slot run: cannot run {args.cmd[0]}: {e.strerror}", file=sys.stderr)
        return 127 if isinstance(e, FileNotFoundError) else 126


def cmd_hold(args, cfg, env) -> int:
    _, res, grant = acquire(args, cfg, env)
    try:
        print(json.dumps({"grant_bytes": grant,
                          "units": grant // args.unit if args.unit else 0}), flush=True)
        while sys.stdin.buffer.read(4096):
            pass  # held until the caller closes our stdin, or dies and the pipe closes
    finally:
        os.unlink(res)
    return 0


def cmd_status(args, cfg, env) -> int:
    d = open_dir(cfg)
    holders, waiters = live(d, "res-"), live(d, "wait-")
    free, why = room(cfg, env, holders)
    if args.json:
        print(json.dumps({**why, "free": free, "holders": holders, "waiters": waiters}))
        return 0
    print(f"budget {fmt(why['budget'])}  reserved {fmt(why['reserved'])}  "
          f"MemAvailable {fmt(why['available'])}  grantable {fmt(free)}")
    for kind, entries, size in (("holds", holders, "bytes"), ("waits", waiters, "min")):
        for e in entries:
            n = e.get(size) if isinstance(e.get(size), int) else 0
            print(f"  {kind}  {fmt(n):>7}  pid {e.get('pid')}  uid {e.get('uid')}  "
                  f"{e.get('label')}  since {e.get('since')}")
    return 0


def _size(text: str) -> int:
    try:
        return parse_size(text)
    except ValueError as e:
        raise argparse.ArgumentTypeError(str(e)) from None


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="heavy-slot", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)
    for name in ("run", "hold"):
        s = sub.add_parser(name)
        s.add_argument("--min", type=_size, required=True)
        s.add_argument("--max", type=_size)
        s.add_argument("--unit", type=_size, default=0)
        s.add_argument("--label", default="")
        s.add_argument("--timeout", type=float, default=0, help="minutes; 0 waits forever")
        if name == "run":
            s.add_argument("cmd", nargs=argparse.REMAINDER)
    sub.add_parser("status").add_argument("--json", action="store_true")
    args = p.parse_args(argv)
    if args.command == "status":
        return args
    args.cmd = getattr(args, "cmd", [])
    if args.cmd[:1] == ["--"]:
        args.cmd = args.cmd[1:]
    if args.unit and args.min % args.unit:
        args.min += args.unit - args.min % args.unit  # a min is whole units
    args.max = args.max if args.max is not None else args.min
    if args.min <= 0 or args.max < args.min or not 0 <= args.timeout < math.inf:
        p.error("need 0 < --min <= --max (in whole --units), and a finite --timeout >= 0")
    label = args.label or (args.cmd[0] if args.cmd else f"pid {os.getppid()}")
    args.label = "".join(c if c.isprintable() else "?" for c in label)[:LABEL_MAX]
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    env = dict(os.environ)
    try:
        cfg = load_config(env)
        return {"run": cmd_run, "hold": cmd_hold, "status": cmd_status}[args.command](
            args, cfg, env)
    except (ValueError, OSError) as e:  # bad config, meminfo or queue directory
        print(f"heavy-slot: {e}", file=sys.stderr)
        return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

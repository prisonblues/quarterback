#!/usr/bin/env python3
"""qb-next — what can I pick up right now, and why.

The third question the fleet asks. `qb-board --follow` answers "what just
happened"; `qb-dash` answers "who is alive and what do they hold"; this answers
"what should I do", which used to cost about ten tool calls and a careful read of
an untracked file (#135).

  qb-next              PRs, then the plan, then what is held and what is blocked
  qb-next --json       the same data, for a hook or another tool
  qb-next --repo R     a different repo's plan
  qb-next --limit N    how many free items to print (0 prints the count alone)

STDLIB ONLY, AND NO LAUNCHER — unlike qb-dash, which needs `rich` and therefore a
bash script to find an interpreter that has it. A one-shot answer printed to a
pipe does not need a renderer, so this keeps a plain shebang that patchShebangs
can rewrite, and runs on any python3 the host happens to have. Do not add a
dependency here without also adding the launcher, because the failure mode is
`qb next` dying on an import the day after a rebuild, which is exactly what the
comment at the top of qb-dash exists to describe.

Every line answers WHY, not just WHAT. "#44 free" is the thing you could already
get by reading the plan; "#44 free — rank 2, nothing blocking it, nobody on it"
is the thing that saves the ten calls.

EXIT CODES, because a hook reads them and two of them used to be the same number:

  0  a complete answer
  1  no board is configured — a message for a person, on stderr
  2  argparse's own usage error, i.e. a flag that does not exist
  3  a PARTIAL answer: some source could not be reached, the `!` lines say
     which, and anything that source could have contradicted is listed as
     uncertain rather than as free

That 3 is the whole reason this file has an exit-code section. It used to be 2,
which argparse had already spent on "you typed it wrong" — so a script could not
tell a bad flag from a dead board, and the two want opposite responses.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from qbdata import (  # noqa: E402
    REPO, board_client, ci_state, clip, fetch_blocked, fetch_board, fetch_plan,
    fetch_prs, minutes_left, plain,
)

# A PR is worth surfacing for a reason, and the reason is the point of the line.
# There is no "?" row: `ci_state` returns that glyph for a rollup it does not
# model, which is precisely what the fallback below already says. Two spellings
# of one message is one of them going stale.
UNMODELLED_CI = ("unclear", "checks in a state this does not model")
CI_REASON = {
    "✓": ("ready", "checks green"),
    "✗": ("broken", "a check is failing"),
    "◐": ("running", "checks still going"),
    "·": ("unchecked", "no checks reported"),
}

#: Why an item's classification cannot be trusted, said in the words of the
#: thing that is missing rather than the name of the fetch that failed.
UNKNOWN_WHY = {
    "claims": "a claim taken outside the plan would not be visible",
    "github": "GitHub's blocked-by edges could not be read",
}


def _issue_of(item: dict) -> int | None:
    """The issue number a plan item points at, if it points at one.

    `ref` is `{"kind": ..., "value": ...}` and nothing else. A bare number or a
    string where that object should be is a malformed item, and `.get` on one
    used to raise AttributeError from inside the join rather than read as "no
    issue". The parse is strict for the same reason: `lstrip("#")` accepted
    `##44` and `int()` accepted `-44`, neither of which is an issue number, and
    both of which then quietly missed every lookup they were used for.
    """
    ref = item.get("ref")
    if not isinstance(ref, dict) or ref.get("kind") != "issue":
        return None
    value = plain(ref.get("value"))
    body = value[1:] if value.startswith("#") else value
    return int(body) if body.isdigit() else None


def _live(claim: dict) -> bool:
    """Whether a claim is still held, checked here as well as on the board.

    The board prunes: `/claims` filters `expires_at > now` on the way past and
    `/plan` selects only unexpired leases, so this should never drop one. It is
    kept because the mistake is not symmetric — a stale claim hides work that is
    actually free, which is the single answer this command must not give — and
    because `--repo` can be pointed at any board, including one older than that
    contract. An expiry that will not parse counts as live: unreadable is not
    evidence of gone.
    """
    left = minutes_left(claim.get("expires"))
    return left is None or left >= 0


def _blocker_label(blocker: object, repo: str) -> str:
    """How one plan dependency is written on a BLOCKED line.

    `/plan` sends each blocker as `{"item_id", "title", "ref", "repo"}`, where
    `ref` is the issue number with the `#` already stripped — and is None for a
    plan item that refs nothing at all, which has only a title. Formatting every
    one of them as f"#{ref}" printed `#None` for those, a Python dict repr for a
    structured ref, and `##44` for one that arrived already prefixed. The last
    also defeated the dedup below, since GitHub's edges format as `#44` and the
    two would not compare equal. So both sources go through one function.
    """
    if not isinstance(blocker, dict):
        return plain(blocker) or "?"
    ref = blocker.get("ref")
    if isinstance(ref, dict):
        ref = ref.get("value")
    number = plain(ref).lstrip("#").strip()
    if not number:
        # The board names a ref-less blocker by its title in its own claim note,
        # for the same reason: a title is all such an item has.
        return clip(blocker.get("title"), 40) or "an item with no ref"
    where = plain(blocker.get("repo"))
    # A fleet-wide plan item has no repo, and this repo's own is not worth the
    # twelve columns. Another repo's is the whole point of naming it.
    elsewhere = bool(where) and where.lower() != plain(repo).lower()
    return f"{where}#{number}" if elsewhere else f"#{number}"


def _settled(future, fallback):
    """A future's value, or the fallback carrying the reason it has none.

    The fetches are written not to raise and this is the belt for the day one
    does anyway. An exception escaping here would lose the three answers that DID
    arrive, and `main` would print one generic line — from a command whose whole
    job is saying which source is missing.
    """
    try:
        return future.result()
    except Exception as exc:                      # noqa: BLE001 — name it, don't die
        return fallback(f"{type(exc).__name__}: {exc}")


def collect(repo: str) -> dict:
    """Everything the three sources know, joined.

    The four fetches never raise: a dead source is a value they return. The
    `board_client()` above them can — resolving the config reads a file and runs
    the user's token command — and "no board configured" is a sentence for a
    person rather than a section of a report, which is why `main` catches it and
    this does not.

    They run CONCURRENTLY. Two HTTP GETs and two `gh` subprocesses, each of the
    latter with a 45-second timeout, ran in series: a degraded GitHub could hold
    a perfectly good board answer for a minute and a half, from the command whose
    pitch is that it replaces ten tool calls with one fast one. They share no
    state and none needs another's result.
    """
    client, _cfg = board_client()
    # A repo is case-insensitive on GitHub but a claim key is a string. `--repo
    # PrisonBlues/Quarterback` queried the plan and GitHub happily and then
    # matched no claim keyed `prisonblues/quarterback#N` — held work offered as
    # free, which is the direction that costs somebody an afternoon.
    repo_key = plain(repo).lower()

    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = {
            "board": pool.submit(fetch_board, client),
            "plan": pool.submit(fetch_plan, client, repo),
            "prs": pool.submit(fetch_prs, repo),
            "github": pool.submit(fetch_blocked, repo),
        }
        board = _settled(futures["board"], lambda e: {"claims": [], "error": e})
        plan = _settled(futures["plan"],
                        lambda e: {"items": [], "next": None, "counts": {}, "error": e})
        prs, pr_error = _settled(futures["prs"], lambda e: ([], e))
        blocked, blocked_error = _settled(futures["github"], lambda e: ({}, e))

    board_error, plan_error = board.get("error"), plan.get("error")
    if plan.get("truncated"):
        # The endpoint says so itself rather than leaving it to be worked out by
        # comparing lengths; passing it on keeps that true one hop further.
        plan_error = "; ".join(filter(None, [plan_error, "the plan is longer than one page"]))

    # Claim keys are `<owner>/<repo>#<number>`. Matched on the WHOLE repo rather
    # than the trailing number: #163 exists in every repo the fleet touches, and
    # a claim on somebody else's must not mark this one held.
    held: dict[int, dict] = {}
    for claim in board.get("claims") or []:
        if not isinstance(claim, dict):
            continue
        claim_repo, hashed, number = plain(claim.get("key")).rpartition("#")
        if hashed and claim_repo.lower() == repo_key and number.isdigit() and _live(claim):
            held.setdefault(int(number), claim)

    items = []
    for item in plan.get("items") or []:
        if not isinstance(item, dict) or item.get("state") != "open":
            continue
        issue = _issue_of(item)
        # The plan's own claim is authoritative; a bare /claims row is the
        # fallback, because a claim taken with `claim` rather than `plan_claim`
        # does not surface on the item (see #172).
        own = item.get("claim")
        claim = own if isinstance(own, dict) and _live(own) else None
        if claim is None and issue is not None:
            claim = held.get(issue)
        # WHICH source could have contradicted this item, and did not answer.
        # Without this the join classified an item off an empty map as free and
        # unblocked and left the `!` line at the bottom to be noticed — so the
        # dangerous half of a partial answer looked exactly like a safe one.
        unknown = []
        if board_error and claim is None:
            unknown.append("claims")
        if blocked_error and issue is not None:
            unknown.append("github")
        items.append({
            "rank": item.get("rank"),
            "title": item.get("title", ""),
            "issue": issue,
            "phase": item.get("phase"),
            "claim": claim,
            # The board decides blocked-ness for plan dependencies; GitHub's
            # graph covers the issues the plan does not model. Either is enough.
            "blocked_by_plan": [_blocker_label(b, repo_key)
                                for b in item.get("blocked_by") or []],
            "blocked_by_github": blocked.get(issue, []) if issue is not None else [],
            "unknown": unknown,
        })

    return {
        "repo": repo,
        "next": plan.get("next"),
        "items": items,
        "prs": prs,
        "counts": plan.get("counts", {}),
        "errors": {k: v for k, v in {
            "board": board_error, "plan": plan_error,
            "prs": pr_error, "github": blocked_error,
        }.items() if v},
    }


def _pr_lines(prs: list[dict]) -> list[str]:
    out = []
    for pr in sorted((p for p in prs if isinstance(p, dict)), key=lambda p: p.get("number", 0)):
        glyph, _colour = ci_state(pr)
        state, why = CI_REASON.get(glyph, UNMODELLED_CI)
        if pr.get("isDraft"):
            # Draft wins over the check state deliberately: whether a draft's
            # checks are green is not the question anybody is asking of it.
            state, why = "draft", "marked draft, so not asking to land"
        ref = f"#{plain(pr.get('number')) or '?'}"
        out.append(f"  {glyph} {ref:<6} {clip(pr.get('title'), 58):<58}  "
                   f"{state} — {why}")
    return out


def _ref(item: dict) -> str:
    """`#44`, or an em dash for a plan item that points at no issue.

    `is not None` rather than truthiness: the question is whether the item has a
    number, and `if issue` also answers "no" for zero. GitHub has no issue 0 so
    nothing breaks today, but the guard should say what it means.
    """
    return f"#{item['issue']}" if item["issue"] is not None else "—"


def _is_free(item: dict) -> bool:
    """Free means nothing is on it, nothing blocks it, and nothing is unknown.

    The third clause is the one that took a defect to write down. An item off a
    failed claims fetch has no claim on it in the same way an unclaimed item
    does, and only one of those is safe to hand somebody.
    """
    return not (item["claim"] or item["blocked_by_plan"]
                or item["blocked_by_github"] or item["unknown"])


def _free_lines(items: list[dict], limit: int) -> list[str]:
    """The free items, capped — and honest about the cap.

    Two defects met on this line. The cap was checked AFTER appending, so
    `--limit 0` printed one item; and the ones past the cap vanished with no
    count, under a header that had already said how many items there were. A
    header disagreeing with the section under it is the thing the comment in
    `render` argues against, and this was that.
    """
    free = [i for i in items if _is_free(i)]
    shown = free[:max(limit, 0)]
    out = []
    for item in shown:
        ref = _ref(item)
        out.append(f"  → {ref:<6} {clip(item['title'], 58):<58}  "
                   f"rank {item['rank']}, free, unblocked")
    if len(free) > len(shown):
        out.append(f"  … and {len(free) - len(shown)} more free — "
                   "raise --limit to see them")
    return out


def _uncertain_lines(items: list[dict]) -> list[str]:
    """Items that would be offered as free if every source had answered."""
    out = []
    for item in items:
        if item["claim"] or item["blocked_by_plan"] or item["blocked_by_github"]:
            continue
        if not item["unknown"]:
            continue
        why = "; ".join(UNKNOWN_WHY.get(s, s) for s in item["unknown"])
        out.append(f"  ? {_ref(item):<6} {clip(item['title'], 58):<58}  {why}")
    return out


def _next_line(nxt: object) -> str:
    """The board's own answer, printed above the list this command recomputes.

    `/plan` computes `next` from the dependencies IT holds. The list below adds
    GitHub's blocked-by edges and any claim taken outside the plan, so the two
    can differ — and when they do, the board's is the one another agent asking
    `plan_read` has already been given. Printing only the recomputed list would
    hide that disagreement; printing only `next` would hide the reasons under it.
    """
    if not isinstance(nxt, dict):
        return "  the board's next: nothing — no open item is both free and unblocked"
    issue = _issue_of(nxt)
    ref = f"#{issue}" if issue is not None else "—"
    return f"  the board's next: {ref} {clip(nxt.get('title'), 58)}"


def render(data: dict, limit: int) -> str:
    lines = [f"NEXT — {plain(data['repo'])}", ""]

    prs = _pr_lines(data["prs"])
    lines += [f"OPEN PRS ({len(data['prs'])})"] + (prs or ["  none"]) + [""]

    held = [i for i in data["items"] if i["claim"]]
    # Every item with a blocker, whether or not somebody also holds it. Filtering
    # the held ones out here made the header's word "blocked" quietly mean
    # "blocked and unheld", so a plan reading "1 held, 0 blocked" could have a
    # live dependency in it. An item in both sections is in both states.
    waiting = [i for i in data["items"] if i["blocked_by_plan"] or i["blocked_by_github"]]

    free = _free_lines(data["items"], limit)
    unsure = _uncertain_lines(data["items"])
    # Counted from the joined view, NOT from the plan's own `counts`. The board
    # can only count the dependencies it holds, so its `blocked` is smaller than
    # what is printed below the moment GitHub's graph contributes an edge — and a
    # header disagreeing with the section under it is worse than no header.
    header = (f"PLAN — {len(data['items'])} open, "
              f"{len(held)} held, {len(waiting)} blocked")
    if not data["items"]:
        empty = "  the plan has no open items"
    elif unsure:
        empty = "  nothing is confirmed free — see UNCERTAIN below"
    else:
        empty = "  nothing free — everything open is held or blocked"
    lines += [header, _next_line(data.get("next"))] + (free or [empty]) + [""]

    if unsure:
        lines.append(f"UNCERTAIN ({len(unsure)}) — free as far as the sources that answered")
        lines += [*unsure, ""]

    if held:
        lines.append(f"HELD ({len(held)})")
        for item in held:
            claim = item["claim"]
            left = minutes_left(claim.get("expires"))
            expiry = f"{left}m left" if left is not None else "no expiry"
            holder = clip(claim.get("holder") or "?", 24)
            lines.append(f"  {_ref(item):<6} {holder:<24} {expiry}")
        lines.append("")

    if waiting:
        lines.append(f"BLOCKED ({len(waiting)})")
        for item in waiting:
            on = [f"#{b}" for b in item["blocked_by_github"]]
            on += [b for b in item["blocked_by_plan"] if b not in on]
            also = " (and held)" if item["claim"] else ""
            lines.append(f"  {_ref(item):<6} waits on {', '.join(on)}{also}")
        lines.append("")

    for source, error in data["errors"].items():
        # Loud, because a section that is empty because a source died looks
        # exactly like a section that is empty because there is no work. The
        # source is named and the message is passed through verbatim rather than
        # wrapped in a word like "unavailable": a source can be dead, or merely
        # capped, and calling a capped read unavailable is its own small lie.
        lines.append(f"! {plain(source)}: {plain(error)}")
    return "\n".join(lines).rstrip() + "\n"


def _nonnegative(value: str) -> int:
    """`--limit -1` is not a smaller list, it is a question with no answer."""
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError(f"must be zero or more, not {number}")
    return number


def main() -> int:
    # `(__doc__ or "")`: -OO strips docstrings, and subscripting None is a
    # TypeError raised before argparse has been built to report it.
    summary = ((__doc__ or "").splitlines() or [""])[0]
    parser = argparse.ArgumentParser(prog="qb-next", description=summary)
    parser.add_argument("--repo", default=REPO, help=f"which repo's plan (default {REPO})")
    parser.add_argument("--json", action="store_true", help="emit the joined data instead")
    parser.add_argument("--limit", type=_nonnegative, default=5,
                        help="free items to show, 0 for the count alone (default 5)")
    args = parser.parse_args()

    try:
        data = collect(args.repo)
    except Exception as exc:                      # noqa: BLE001 — a config error is a message
        print(f"qb-next: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1

    if args.json:
        json.dump(data, sys.stdout, indent=2, default=str)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(render(data, args.limit))
    # A dead source is worth a non-zero exit for a script, but never an empty
    # answer for a person — the text above has already said what is missing. 3
    # rather than 2 because argparse owns 2, and "the board is down" and "you
    # passed a flag that does not exist" want different responses from a hook.
    return 3 if data["errors"] else 0


if __name__ == "__main__":
    sys.exit(main())

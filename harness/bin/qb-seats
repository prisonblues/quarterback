#!/usr/bin/env bash
# qb-seats — one command, one screen: N agent seats plus the board, in tmux.
#
# Usage: qb-seats [-n N] [-C DIR] [-s NAME]   bring up (or reattach to) a screen
#        qb-seats --staged                    build it with each seat awaiting Enter
#        qb-seats --no-yolo                   seats that stop and ask, as agents
#                                             normally do
#        qb-seats --add                       add one seat to a running screen
#        qb-seats --kill                      tear the screen down
#        qb-seats list                        the screens that are up, numbered
#        qb-seats resume [ID|NAME]            reattach to one of them, from
#                                             anywhere — no repo, no -C
#        qb-seats --dash-fit -s NAME          put the dash back to the width the
#                                             screen asked for — what its own
#                                             resize hooks call
#        qb-seats -h|--help                   this text
#
# Exit codes:
#   0  screen is up, or was reattached, added to, or killed; or the list printed
#   1  cannot proceed (no tmux, no qb-seat, no repo, no such session, or a
#      `resume` that names no screen or does not say which)
#   2  malformed arguments — a caller bug, and says so
#
# WHAT THIS IS FOR. Working a plan in parallel took five terminals and a human
# dispatcher: open a terminal, cd, run the agent, say what to work on, repeat.
# The dispatching human is the part that does not scale, and it is the part the
# board exists to remove — the plan records who is on what because somebody read
# it out to each agent that asked.
#
# The alternative already to hand is sub-agents, and it is the wrong shape.
# Sub-agents are a star: one orchestrator holds the plan, fans out, and every
# result funnels back through one context window. Children are anonymous, cannot
# address each other or be addressed mid-flight, die on return, and their context
# is discarded. Seats are a mesh instead — real sessions in real shells, each
# with an identity that outlives the run, findings that persist as posts rather
# than a string collapsed into a parent's summary, and no orchestrator to lose.
#
# And one property the star cannot offer at any price: A HUMAN CAN ATTACH TO ONE
# SEAT, interrupt it and redirect it, without touching the others. Most of what
# follows exists to protect that.
#
# WHAT IT IS. A layout. It arranges panes and starts one process in each. Every
# seat runs `qb-seat <n>` (its sibling in this directory), which is where a
# seat's identity and brief live. The screen knows nothing about either.
#
# WHAT IT DELIBERATELY DOES NOT DO:
#
#   * No worktrees. Under self-selection a seat does not know its branch until it
#     has claimed something, and create-worktree is already driven per issue by
#     the loop that takes it, with the database isolation that implies. A screen
#     that made worktrees up front would be guessing.
#   * No dispatch. It does not read the plan, does not pick items, does not hand
#     seat 3 a different brief from seat 1. A spawner that assigns is hub-and-
#     spoke with a hub that runs once at t=0, and removing the dispatcher is the
#     entire point. Every seat gets the same brief and self-selects.
#   * No driving. It starts the agents. After that the panes are just panes.
#   * No second board client. The board pane runs `qb-board`; if that grows a
#     filter, the filter goes there. The moment this script parses board JSON to
#     decide what to show, it has become the thing we agreed not to build.
#   * No shared QUARTERBACK_INSTANCE. See below — this one is correctness.
#
# ONE SHARED QUARTERBACK_INSTANCE IS NOT AN INCONVENIENCE, IT IS ONE AGENT.
# The value is sent as X-Agent-Instance and the board takes it as the agent KEY.
# Two seats sharing one are therefore not two agents with muddled inboxes; they
# are a single agent with one history, one presence, one lease, and — once work
# claims are atomic — holding each other's claims perfectly legitimately, because
# they are the same holder. So this script unsets the variable before starting
# the server, and marks it for removal from the session environment, which covers
# every pane split off later. qb-seat sets its own, per seat.
#
# WHY TMUX AND NOT ZELLIJ. zellij's case is real — declarative KDL layouts,
# `start_suspended`, and `override-layout --retain-existing-terminal-panes`. It
# still went the other way, for four reasons:
#
#   1. The declarative advantage does not survive this requirement. KDL layouts
#      take no parameters and the seat count is a runtime argument, so N panes
#      means generating the layout anyway.
#   2. zellij 0.44.3's stock keybindings break the property above. Ctrl+p, n, s,
#      o, t, h, b, g and q are bound under `shared_except "<mode>" "locked"`,
#      which INCLUDES normal mode: they fire while you are typing into a pane and
#      never reach the program in it. Agent CLIs are Ctrl-chord TUIs and Ctrl+h
#      is backspace. A multiplexer that swallows the interrupt keys is the wrong
#      one for a screen whose whole purpose is being able to interrupt one seat.
#   3. Both zellij features worth having have one-line tmux equivalents, and both
#      are here: --staged for start_suspended, --add for override-layout.
#   4. tmux is likelier to be the multiplexer a consumer already has, and the
#      SSH-durability argument for running agents inside one is the same either
#      way: the work lives on the box, so the link is disposable.
#
#   Reversible: neither tool needs a plugin under this design, and the board pane
#   and the seat wrapper are identical under both.
#
# WHY THE DEFAULT IS 2. Integration cost grows quadratically in open PRs, which
# is the real ceiling on any autonomous backlog drain — not how many agents a
# monitor fits. Raise it with -n once you have measured your own merge pressure.
set -euo pipefail

PROG=${0##*/}
SH=${SHELL:-/bin/bash}          # the shell a seat drops back to when it exits

# Before anything else, and see the header: two seats sharing this value are ONE
# agent on the board. Dropping it here means neither the tmux server nor the
# first pane can inherit one from whatever shell launched this; the
# `set-environment -r` further down covers every pane split off afterwards.
unset QUARTERBACK_INSTANCE

SEATS=3                 # what one human can actually follow at once
MAX_SEATS=10            # five across, two down — see the layout note below
REPO=""                 # default: the git repo you ran this from
SESSION=""              # default: seats-<repo basename>
STAGED=0                # 1 = pane waits on Enter before starting its agent
YOLO=""                 # "" = as it comes (on), 1 = force on, 0 = prompts back
BOARD_SIZE="25%"        # tape pane height, bottom of the window, full width
KEY_DEFAULT="C-q"       # the qb key, when QB_SEATS_KEY does not say otherwise
BAR_BG=colour235        # the seat bar's OWN ground — see seat_bar for why it
BAR_FG=colour109        # cannot borrow the theme's status-style
TOP_EVERY=30            # seconds between top-line replays; 0 = draw it once
DASH_SIZE="${QB_SEATS_DASH_SIZE:-78}"   # dash width in columns, down the right of
                        # the window. 78 is what the dashboard's own table wants
                        # before it starts wrapping, not a taste in proportions
DASH_SHARE=3            # ...and never more than 1/3 of the window — see dash_resize
WINDOW_COLS=240         # the window a DETACHED session is built in, and a fiction
WINDOW_ROWS=60          # until a client attaches — see the -x/-y note further down
ACTION="up"
TARGET=""               # which screen `resume` was asked for: a number, a name,
                        # or empty for "the only one that is up"

usage() {
  cat <<EOF
usage: $PROG [N] [-C DIR] [-s NAME] [--staged] [--no-yolo] [--add] [--kill]
       $PROG list
       $PROG resume [ID|NAME]

  N           number of seats, 1-$MAX_SEATS (default $SEATS); -n N also works
  -C DIR      repo the seats run in (default: the git root of \$PWD)
  -s NAME     tmux session name (default: seats-<repo basename>)
  --staged    build the screen with each seat waiting on Enter, so the layout
              can be eyeballed before N agents start claiming
  --no-yolo   give the seats their permission prompts back. They start without
              them, because a pane nobody is watching cannot answer one and a
              seat waiting to be asked a question is a seat that has stopped.
              QB_SEAT_YOLO=0 in your environment is the same thing said once
  --yolo      the default, said out loud — useful only to override a
              QB_SEAT_YOLO=0 you have exported
  --add       add one seat to an already-running screen and reflow
  --kill      kill the screen
  list        the screens that are up — number, name, seats, repo — newest
              information first-hand from tmux, so a screen whose name it had to
              mangle is listed under the name it actually has
  resume      reattach to the screen with that number, or that name. It needs no
              repo and no -C: a screen already knows the directory it was built
              in, so this is the command for the ssh link that dropped and the
              shell that came back up somewhere else. With exactly one screen up
              the argument is optional
  --dash-fit  put the dash back to the width the screen was built asking for,
              clamped to a third of the window. The window's own resize hooks
              call this; by hand it is only useful after a resize tmux did not
              notice. Needs -s NAME

Environment:
  QB_SEATS_BOARD      command for the tape pane, overriding the default
  QB_SEATS_DASH       command for the dash pane; empty for a screen with no dash
  QB_SEATS_DASH_SIZE  dash width in columns (default 78, and never more than a
                      third of the window — the seats need the rest)
  QB_SEATS_BAR        0 to leave the status line and the mouse alone (see below)
  QB_SEATS_KEY        the qb key, default $KEY_DEFAULT; empty for no key at all
  QB_SEATS_TOP        what the top line says on the left (default
                      \`quarterback: <repo>\`); empty for no words of ours there
  QB_SEATS_TOP_EVERY  seconds between top-line replays, default $TOP_EVERY; 0 draws
                      it once and leaves nothing running
  QB_SEATS_TOP_ANIMATE 0 to write the top line straight out rather than
                      decrypting it into place
  QB_SEAT_YOLO        0 to give the seats their permission prompts back
  QB_SEAT_AGENT       the agent binary a seat runs, instead of \`claude\`
  QB_SEAT_SCOPE       what the seats are called after — \`seat-<scope>-<n>\`.
                      Defaults to the repository's directory name, which is what
                      makes two screens on two projects able to both number from
                      1; set it when two screens share ONE repository, or set it
                      empty for the machine-wide numbering this had before

The seat bar is a second status line above the seats, one clickable cell per
seat: the name jumps to that pane, the ✕ closes it after a y/n, and ＋ adds one.
Turning it on sets \`mouse on\`, \`status 2\` and \`status-position top\` for this
session, and binds MouseDown1Status for the whole server — QB_SEATS_BAR=0 if
that is not a trade you want.

The qb key is the keyboard half of the same thing, and it is a key table rather
than a menu key: $KEY_DEFAULT then \`a\` adds a seat, \`x\` closes this one, \`1\`-\`9\` jump,
\`t\` and \`d\` hide and show the tape and the dash, \`=\` \`>\` \`<\` size the dash, \`K\`
kills the screen and \`?\` explains it. Anything else opens a menu carrying the
same keys, so the shortcut is learnt from the thing it replaces. The binding is
server-wide, so it is gated on this being a screen and falls through to the key
tmux would have sent anywhere else. QB_SEATS_KEY picks a different one —
\`QB_SEATS_KEY=M-q\`, say, if $KEY_DEFAULT is your XON or your quoted-insert — and
QB_SEATS_KEY= (empty) means no key is bound at all.
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

# For what is worth saying and is not fatal — `list` with nothing up, a `resume`
# that cannot tell which screen you mean, a dash that could not have the width it
# asked for. Stderr only, for two reasons that arrived separately and agree: stdout
# stays the parseable half, so a caller reading the listing gets rows or nothing and
# never prose; and a resize hook's output goes nowhere regardless, because
# `run-shell -b` discards both streams. The second is deliberate — the alternative
# is a display-message nagging the status line on every terminal resize, when the
# width itself already tells the story. From a command line (`up`, `--add`, `list`,
# `--dash-fit` by hand) it is seen.
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }


# ---- what a pane says when the thing it is for is not installed -------------
# An honest empty pane beats this script growing its own board reader or its own
# dashboard: a screen carrying a second, worse client is harder to explain than one
# whose pane says which command is missing.
#
# The message is TYPED INTO THE PANE'S SHELL, which means it has to survive two
# rounds of interpretation — printf's, here, and the pane shell's when the line is
# entered — and the pane shell is whatever `default-shell` says, not necessarily
# bash. Both of those have bitten, so neither is left to chance:
#
#   * `printf 'printf %%s\n %q'` emits `printf %s\n MSG`, where that backslash is
#     the only one left. Entered into a shell, an unquoted `\n` is just `n`, so
#     printf is handed the format `%sn` and the message runs straight into the next
#     prompt: `printf %s\n hello` prints `hellon`. Measured, not reasoned about.
#   * `%q` on a string containing a newline emits bash's `$'...'` ANSI-C form,
#     which a POSIX /bin/sh pane prints verbatim — dollar, backslashes and all.
#
# So: single quotes, which mean the same thing in every shell this can land in; one
# printf argument per line of message, so no newline has to be escaped at all; and
# the usual `'\''` dance in case a message ever grows an apostrophe.
placeholder_cmd() {
  local out="printf '%s\\n'" line q="'\\''"
  for line in "$@"; do
    line=${line//"'"/$q}
    out="$out '$line'"
  done
  printf '%s' "$out"
}

# ---- the board pane ---------------------------------------------------------
# A process, nothing more — which is what keeps the swap cheap if the follower
# is ever replaced. `qb-board --follow` tails the board to stdout the way
# journalctl -f tails a unit.
board_cmd() {
  if [ -n "${QB_SEATS_BOARD:-}" ]; then printf '%s' "$QB_SEATS_BOARD"; return; fi
  if command -v qb-board >/dev/null 2>&1; then
    printf 'qb-board --follow'
  else
    placeholder_cmd \
      'board pane: qb-board is not on PATH, so there is nothing to follow here yet.' \
      'Set QB_SEATS_BOARD to run something else in this pane.'
  fi
}

# ---- the dash pane ----------------------------------------------------------
# The tape says what just happened; the dash says what is true now — fleet, claims,
# PRs, issues. They are different questions and a screen wants both, which is why
# this is a second pane and not a swap of QB_SEATS_BOARD.
#
# Set QB_SEATS_DASH to the empty string for a screen with no dash at all. Same
# spelling as qb-seat's QB_SEAT_BRIEF, and for the same reason: `${VAR+set}` so
# that empty means "none" and unset means "pick for me".
#
# The INSTALLED dash is preferred over anything in a checkout, and that is not a
# style preference. The packaged one carries its own interpreter — the whole point
# of packaging it — whereas a uv-standalone python has no CA bundle, and a dash
# run under one shows "board unreachable" against a board that is up, beside a
# shell where the same URL works. That cost real debugging time while this was
# scaffolding in dev/seats-extras.sh (since removed); it arrives here with the lesson.
#
# THE PLAIN RENDERER IS THE DEFAULT, AND NOT BECAUSE IT IS BETTER. qb-dash-tui is
# the nicer of the two — clickable rows, and the seat bar has already turned the
# mouse on for them — and it should take this slot the moment #209 is fixed.
# Today it cannot: it keys its seat rows by seat name, two screens both number
# their seats from 1, so the second screen anywhere on the box turns this pane into
# a Textual traceback (DuplicateKey). A pane that is meant to be what you look at
# when something is wrong must not be the thing that breaks first, and a default
# has to work on the second screen as well as the first. QB_SEATS_DASH=qb-dash-tui
# opts in meanwhile.
#
# The underlying collision is #208: seat identities are machine-wide while the
# numbering is per-screen.
#
# ONLY qb-dash IS PROBED, and that follows from the paragraph above rather than
# contradicting it: falling through to qb-dash-tui when qb-dash happens to be
# missing — a partial install, or a PATH carrying only the TUI entry point — would
# make the crash-prone renderer the default on exactly the boxes least able to
# afford it. If #209 disqualifies it as a default it is disqualified here too, so
# the not-found message names it as the explicit opt-in instead.
dash_cmd() {
  if [ -n "${QB_SEATS_DASH+set}" ]; then printf '%s' "$QB_SEATS_DASH"; return; fi
  command -v qb-dash >/dev/null 2>&1 && { printf 'qb-dash'; return; }
  placeholder_cmd \
    'dash pane: qb-dash is not on PATH, so there is nothing to show here yet.' \
    'Set QB_SEATS_DASH to a command to run here — QB_SEATS_DASH=qb-dash-tui if' \
    'that is the one you have installed — or QB_SEATS_DASH= for no dash at all.'
}

# The dash is addressed by its label, never by index: it is created after the
# seats and before the tape, and every one of those positions shifts when a seat
# is added or closed. `exit` after the first, because one is all there can be:
# two would make this print two ids, `resize-pane -t` rejects a two-id target, and
# the reassert below would then quietly do nothing at all.
dash_pane() {
  tmux list-panes -t "$SESSION_ID:seats" -F '#{pane_id} #{@qb_label}' \
    | awk '$2 == "dash" { print $1; exit }'
}

# ---- keeping the dash the width it was asked for ----------------------------
# THREE DIFFERENT THINGS MOVE THIS PANE and they do not all want the same answer.
#
# A REFLOW — `select-layout -E`, which --add runs after splitting a seat and
# qb-seat-click runs after closing one — re-equalises every pane in the row it
# spreads, and the dash is in that row. Nothing about the window changed, so the
# right width is the one the dash had a moment ago; both callers read it off the
# pane first and pass it in, which also means a width set by dragging the border
# survives an --add.
#
# A WINDOW RESIZE — a client attaching, or the terminal it is in being resized —
# rescales every pane proportionally instead. Measured on tmux 3.6a: a dash built
# at 78 of this script's 240 columns comes out at 32 when a 100-column client
# attaches. No call anywhere in this script can fix that, because every line of it
# runs BEFORE the attach; that is what dash_hooks is for, and the width it wants is
# the one the screen was built asking for, recorded on the pane.
#
# AND THE CLAMP, WHICH IS NOT POLITENESS. The same measurement with the reassert
# but no clamp is worse than the bug it fixes: 78 columns held on a 100-column
# window left the two seats 19 columns and ONE column. So a REQUEST — a number
# chosen for some other window — is capped at 1/DASH_SHARE of the one actually in
# front of it, and a narrow client costs the dash rather than the seats. A third of
# 240 is 80, so the 78-column default is untouched on the window a screen is built
# in. A width passed in by a reflow is not capped; see dash_resize for why.
#
# EVERY tmux READ IN HERE IS TOLERATED, and that is a race rather than a taste for
# defensive code. --dash-fit is reached from the window-resized hook through
# `run-shell -b`, i.e. asynchronously, so the pane this is about — or the whole
# session — can be gone between the hook firing and these commands running, which
# is the ordinary way a screen ends and not an error. Measured with the session
# killed: tmux prints "no server running" and exits 1, so under `set -euo pipefail`
# a bare `p=$(dash_pane)` took the script down through pipefail, and a bare
# `$(( $(tmux display-message …) / DASH_SHARE ))` was worse — an empty substitution
# makes that `$(( / 3 ))`, an arithmetic SYNTAX error, which is fatal under `set -e`
# whatever the surrounding code tolerates. Invisible under a hook that discards
# both streams; a non-zero exit from --add and from --dash-fit by hand.
dash_resize() {
  local want=${1:-} clamp=1 p max win got
  p=$(dash_pane) || return 0
  [ -n "$p" ] || return 0
  # A width passed IN is one the dash had a moment ago, in a window that has not
  # changed size since — it fitted then and it fits now, so it is taken as given.
  # A border dragged wider than a third of the window is a deliberate act, and a
  # row being reflowed under it is no reason to undo it. Only the RECORDED request
  # is clamped, because that number was chosen for a window the one in front of us
  # may be nothing like.
  if [ -n "$want" ]; then
    clamp=0
  else
    want=$(tmux show-options -p -t "$p" -qv @qb_dash_width)
  fi
  # Not our pane to resize if nothing recorded a width for it, and an option
  # somebody else set to a non-number is not fatal. This guard covers $want only —
  # the window read below needs its own, and did not have one.
  case "$want" in ''|*[!0-9]*) return 0 ;; esac
  if [ "$clamp" = 1 ]; then
    # Read, checked, and only then divided. See the note above the function for
    # what an unchecked substitution here does to a script under `set -e`.
    win=$(tmux display-message -p -t "$p" '#{window_width}') || return 0
    case "$win" in ''|*[!0-9]*) return 0 ;; esac
    max=$(( win / DASH_SHARE ))
    [ "$max" -ge 1 ] || max=1
    if [ "$want" -gt "$max" ]; then
      warn "dash: $want columns asked for, $max is a third of this window — taking $max"
      want=$max
    fi
  fi
  # NOT 2>/dev/null. tmux refuses or clamps a resize when the neighbours cannot
  # give up the columns, and a wrong width here has already cost real debugging
  # time, so tmux's own explanation belongs on stderr rather than in a bin. Then
  # what actually landed is read back, because tmux clamps quietly as well as
  # refusing loudly.
  tmux resize-pane -t "$p" -x "$want" || true
  # A read-back that cannot be made has nothing to report: the pane is gone, which
  # the resize above will already have said on stderr.
  got=$(tmux display-message -p -t "$p" '#{pane_width}') || return 0
  [ "$got" = "$want" ] \
    || warn "dash: asked tmux for $want columns, the pane came out $got"
}

# ---- getting a shell command through tmux intact ----------------------------
# TWO QUOTING LAYERS AND A FORMAT EXPANDER sit between this line and the shell that
# finally runs it, and the session name is whatever the user typed after -s.
# Interpolating it raw broke all three, measured on tmux 3.6a:
#
#   * `-s 'a$Bb'` came out as `--dash-fit -s 'a'`. Inside its own double quotes
#     tmux expands `$NAME` from its environment, so the hook refit a DIFFERENT
#     screen, or none.
#   * a session called `it's` left the shell an unterminated quote, and one
#     containing `"` truncated the command mid-word.
#
# Every one of those is silent: `run-shell -b` discards both streams, so the hook
# fires on every resize and reports nothing. So each value crosses each layer
# explicitly, innermost first:
#
#   sh_quote    — for the shell that ends up running the line. Single quotes and
#                 the `'\''` dance, exactly as placeholder_cmd does it.
#   tmux_quote  — for the command string the hook is STORED as, which tmux parses
#                 when the hook fires and run-shell then FORMAT-EXPANDS (measured:
#                 `#{session_name}` in a run-shell argument is substituted before
#                 the shell sees it). `\`, `"` and `$` are live inside tmux's double
#                 quotes and `\\`, `\"`, `\$` say them literally; `#` introduces a
#                 format and `##` is a literal one. The `#` doubling is belt rather
#                 than braces — tmux expands a format in a session NAME as the
#                 session is created, so one cannot reach here today — and it costs
#                 nothing to keep that true from this side too.
sh_quote() {
  local q="'\\''"
  printf "'%s'" "${1//"'"/$q}"
}

tmux_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\$/\\\$}
  s=${s//\#/\#\#}
  printf '%s' "$s"
}

# THE SAME THING FOR A VALUE THAT CROSSES MORE THAN ONE TMUX PARSE, and the two
# halves do not scale together, which is the whole reason this is a second
# function rather than a loop over the first.
#
# `\`, `"` and `$` are consumed by tmux's PARSER, once per pass — so a value
# inside a string inside a string needs them escaped twice. `#` is not: parsing
# never touches it, and it is the single FORMAT EXPANSION at the end that turns
# `##` into `#`. Doubling it once per pass gives `####`, which expands to `##`
# and leaves the wrong path.
#
# Measured, because it is not guessable: a confirmed action's command is stored
# by `bind-key`, parsed again by `confirm-before` when the answer comes back, and
# format-expanded once by `run-shell`. Two parses, one expansion.
tmux_quote_n() {   # <passes> <value>
  local n=$1 s=$2 i=0
  while [ "$i" -lt "$n" ]; do
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//\$/\\\$}
    i=$((i + 1))
  done
  printf '%s' "${s//\#/\#\#}"
}

# THIS FILE, absolutely. Not `beside_me qb-seats`, which asks PATH first — see
# dash_hooks for why a self-referential caller cannot use that answer unchecked.
myself() { printf '%s/%s' "$(cd -P "$(dirname "$0")" && pwd)" "${0##*/}"; }

# Does the qb-seats at $1 have the flag this hook is about to call? --dash-fit
# against a session that does not exist is the cheapest question available: a hook
# left behind by a killed screen is the ordinary way this ends, so a copy that has
# the flag exits 0 without touching anything, and a copy that predates it falls
# through its argument parser to `usage; exit 2`.
#
# Both streams to /dev/null because the answer is the exit status, and stdin from
# /dev/null because this runs while a human is looking at a terminal: whatever is
# on PATH under this name is not necessarily ours, and a probe that inherited the
# tty could sit there eating the keystrokes meant for the screen being built.
understands_dash_fit() {
  [ -x "$1" ] || return 1
  "$1" --dash-fit -s "qb-seats-flagprobe-$$" </dev/null >/dev/null 2>&1
}

# The reassert a call in this script cannot be. Everything here runs while the
# session is still detached at the size it was built at — i.e. BEFORE the attach
# that rescales it — so the defence has to outlive the build, and a window hook is
# how tmux lets it.
#
# window-resized is the whole of it, and the two obvious other candidates are both
# deliberately absent. client-attached is a SESSION hook rather than a window one,
# and it is not needed anyway: an attach that rescales the row IS a window resize,
# which is what test_a_client_attaching_does_not_narrow_the_dash pins — and an
# attach that does not change the window's size has not moved anything to put back.
# window-layout-changed would fire on our own resize-pane, and again every time a
# user drags a border, so hooking it would both feed itself and make the dash the
# one pane on the screen that cannot be resized by hand.
#
# It calls back into this script because resize-pane cannot do the clamp's
# arithmetic, and by ABSOLUTE PATH: a run-shell in a hook inherits the tmux
# SERVER's PATH, and the server usually predates anything that put this harness on
# one. That is the same trap the ＋ on the seat bar fell into, where it also failed
# silently.
#
# WHICH COPY OF ITSELF A SELF-REFERENTIAL HOOK MEANS, which is the question
# beside_me cannot answer on its own. It asks PATH before this script's directory,
# so an installed copy beats a checkout — right for @qb_seats_bin and the ＋, whose
# path is recorded on the session and has to keep working for as long as the screen
# does, long after a worktree has been dropped. For a hook calling a flag this
# feature ADDS it was silently wrong, and reproduced on the host it was written on,
# whose installed copy is the v2.47 build:
#
#     $ harness/bin/qb-seats --staged -n 2 -s hooktest        # i.e. the new code
#     $ tmux show-hooks -w -t hooktest:seats | grep resized
#     window-resized[0] run-shell -b "'/etc/profiles/…/bin/qb-seats' --dash-fit …"
#     $ /etc/profiles/per-user/rich/bin/qb-seats --dash-fit -s hooktest; echo $?
#     2
#
# During any rollout — the normal state of a box — the working tree installed a
# hook pointing at an older qb-seats with no such flag, which exits 2 into a
# `run-shell -b` that throws it away. The dash bug this whole function exists to
# fix was therefore fixed nowhere the installed copy lagged, and nothing said so.
#
# The fix is to ASK rather than to invert the preference: PATH still wins, but only
# if it answers the flag, and the fallback is this very file — which understands it
# by construction. Both are absolute paths, so the server's PATH remains irrelevant
# either way. If neither answers, NO HOOK IS INSTALLED and it says why: a dash that
# does not put itself back after a resize is an honest screen, and one line on
# stderr at build time is where a version skew can still be acted on. A hook that
# fails invisibly on every resize is neither.
dash_hooks() {
  local self me tried cmd
  me=$(myself)
  # Usually the same file twice — PATH finds the checkout that is running when the
  # checkout is what is on PATH — and then there is one candidate, one probe, and a
  # warning that does not say "neither X nor X".
  tried=("$1")
  [ "$1" = "$me" ] || tried+=("$me")
  for self in "${tried[@]}"; do
    understands_dash_fit "$self" || continue
    cmd="$(sh_quote "$self") --dash-fit -s $(sh_quote "$SESSION")"
    tmux set-hook -w -t "$SESSION_ID:seats" window-resized \
      "run-shell -b \"$(tmux_quote "$cmd")\""
    return 0
  done
  warn "dash: no resize hook — no qb-seats here understands --dash-fit (tried
       ${tried[*]}), so nothing will put the dash back after a client attaches or
       the terminal is resized. Two copies of the harness have drifted somehow;
       reinstalling it is the fix."
}

# ---- the seat bar -----------------------------------------------------------
# A second status line above the seat row, one cell per seat, drawn by tmux from
# the panes themselves: `#{P:...}` loops over the panes of the window, and the
# `#{?@qb_seat,...}` skips the board. Nothing regenerates it. A seat added by
# --add or closed by its ✕ changes the bar on the next redraw, which is the only
# reason this is a format and not a string this script prints.
#
# THE ✕ CANNOT GO ON THE PANE BORDER, which is where you would want it. tmux
# honours `#[range=...]` in status-format and nowhere else; a click on a border
# arrives with #{mouse_x} and #{mouse_y} EMPTY, so no glyph on it is
# distinguishable from any other; and a click on the topmost border row — where
# seat 1's title is drawn — is not delivered at all. Measured on tmux 3.6a; the
# same note is in qb-seat-click, which is where anyone chasing this will look.
# A seat cell is coloured by what the agent in it is DOING, not merely by whether
# a pane is there. `@qb_state` is set on the pane by the lifecycle hook (nix-fleet's
# home/bin/qb-hook, which knows the transitions and is the only thing that does);
# an unset option is the ordinary case — a pane with no agent, or a fleet whose
# hook predates this — and falls through to the colour the bar always had.
#
# Only the two states that WANT something get their own colour. `working` is most
# panes most of the time and colouring it would make the row uniformly loud again,
# which is the opposite of what a glance needs.
#
# `stalled` is not here, and cannot be: it is a conclusion drawn from how OLD a
# state is, tmux has no clock arithmetic worth doing this in, and the two readers
# that can do it — the dashboard and the pane's own footer — both already say it.
#
# Each arm is a whole literal style string rather than a format substituted INTO
# one (`#[fg=#{@qb_state}]`-style): style parsing and format expansion are
# different passes in tmux and the nested spelling is the one that survives both.
#
# EVERY ARM NAMES A BACKGROUND, including the idle ones, and that is the fix for
# the contrast — see seat_bar. An idle cell used to set a foreground only and
# take whatever the status line's own background was, which on a stock tmux
# (`status-style bg=green,fg=black`) meant colour109 on green at 2.15:1.
seat_state_style() {   # <active|idle>
  local on="$1"
  if [ "$on" = active ]; then
    printf '%s' '#{?#{==:#{@qb_state},waiting},#[fg=black]#[bg=colour214],#{?#{==:#{@qb_state},input},#[fg=black]#[bg=colour176],#[fg=black]#[bg=colour109]}}'
  else
    printf '%s' "#{?#{==:#{@qb_state},waiting},#[fg=colour214]#[bg=$BAR_BG],#{?#{==:#{@qb_state},input},#[fg=colour176]#[bg=$BAR_BG],#[fg=$BAR_FG]#[bg=$BAR_BG]}}"
  fi
}

# WHAT THE QB KEY LOOKS LIKE WHILE IT IS WAITING, and it is not decoration.
# Pressing the key switches the client into a key table and tmux says NOTHING
# about that — its own prefix is the same, and its users know. Here nobody did:
# the first press looked like a dead key, so the natural next move was to press
# it again, which lands on `Any` and opens the menu. The menu then has no digit
# accelerators, so `1`-`9` did nothing while the menu's own title promised they
# jumped to a seat. One invisible state, reported as three bugs.
#
# `#{client_key_table}` is the whole fix and it costs one conditional: the bar
# already redraws on every change, so the strip appears the instant the key is
# pressed and goes as soon as the next one lands. It is the mode indicator AND
# the cheatsheet, which the menu was carrying alone.
#
# NO COMMAS IN IT. `,` separates a format conditional's arms, so the separator
# here is `·` — a comma would end the arm early and print the rest of the hint
# unconditionally, in every session on the box.
#
# SIX KEYS AND NOT ELEVEN, because this has to fit beside the seat cells on a
# window somebody actually has. The full list is one keystroke away at `?`, and
# the first spelling of this ran the bar past 120 columns with three seats on it:
# tmux clips the overflow, and it clipped the `qb` badge and the first item —
# i.e. exactly the part that says the key took, which is what the strip is for.
key_hint() {
  printf '%s' \
"#{?#{==:#{client_key_table},qb},"\
"#[fg=black]#[bg=$BAR_FG] qb "\
"#[fg=$BAR_FG]#[bg=$BAR_BG] a add · x close · 1-9 seat · t tape · d dash · ? keys "\
"#[fg=$BAR_FG]#[bg=$BAR_BG],}"
}

# THE BAR PAINTS ITS OWN COLOURS AND NEVER BORROWS THE THEME'S, which is a
# correctness matter rather than taste. Every span here used to set a FOREGROUND
# only and inherit whatever `status-style` was, and on a stock tmux that is
# `bg=green,fg=black`. Read off the wire with a real client attached, that is
# what the terminal was being sent:
#
#     ESC[38;5;108m ESC[42m  ＋ seat      green on green,   2.08:1
#     ESC[38;5;167m ESC[42m  ✕            dull red on green, 1.39:1
#     ESC[38;5;109m ESC[42m  seat 2       pale cyan on green, 2.15:1
#
# 4.5:1 is the readable floor. So the bar names a background on every span, and
# the colours are chosen against THAT rather than against a green nobody chose:
# colour109 6.33:1, colour108 6.13:1, colour214 8.20:1, colour176 6.01:1, and the
# ✕ moved from colour167 (4.10:1, the one that still fell short) to colour210 at
# 6.53:1. The active cells were already explicit pairs and are already fine —
# black on colour214 is 11.38:1.
#
# `#[default]` IS NOT A RESET HERE, it is a jump back to status-style — i.e. back
# to the green. So the gaps between cells set the ground explicitly too; a
# `#[default]` left in one of them is a green notch between two dark cells.
#
# `#[fill=…]` IS WHAT MAKES IT A STRIP rather than a row of dark patches. tmux
# pre-fills the whole status line with status-style and then draws the format
# over it, so without a fill the cells are islands in the theme's green. fill
# paints the line the bar's own colour first.
seat_bar() {
  local ground="#[fg=$BAR_FG]#[bg=$BAR_BG]"
  printf '%s' \
"#[fill=$BAR_BG]"\
'#[align=left]'\
'#{P:#{?@qb_seat,'\
'#[range=user|seat#{@qb_seat}]'"#{?pane_active,$(seat_state_style active),$(seat_state_style idle)}"\
" seat #{@qb_seat} $ground#[norange]"\
"#[range=user|kill#{@qb_seat}]#[fg=colour210]#[bg=$BAR_BG] ✕ $ground#[norange] "\
',}}'\
"#[range=user|add]#[fg=colour108]#[bg=$BAR_BG] ＋ seat $ground#[norange]"\
"$(key_hint)"
}

# One binding for every widget on the bar, because tmux delivers every
# status-line click to MouseDown1Status and the widget is only distinguishable
# by #{mouse_status_range}. Three things are load-bearing here:
#
#   * A key table is SERVER-wide, so this fires in the user's other sessions
#     too. @qb_bar is set only on ours, so everywhere else the first condition
#     is false and the click falls through to `switch-client -t =` — which is
#     verbatim what tmux binds by default. Nothing else on the box changes.
#   * The range is stashed in @qb_click while the mouse event is still live.
#     confirm-before runs its command afterwards, by which point
#     #{mouse_status_range} expands to nothing — the stash is what survives.
#   * Only the ✕ is confirmed. Closing a seat kills the agent working in it, and
#     the ✕ is three columns from the cell that merely jumps to the pane.
install_bar() {
  local click=$1 run stash confirm inner
  # `-t "$SESSION_ID:"` — the id, then the colon that says "that session's current
  # window". These lines used to read `-t "=$SESSION:"`, and both halves of that
  # spelling were about the NAME: set-option would not take the bare `=name`
  # exact-match form at all ("no such session" for a session that plainly exists),
  # and the `=` was there to stop `seats-quarterback-old` being matched by prefix.
  # An id needs neither — it is exact by construction and set-option takes it with
  # or without the colon (measured on 3.6a and 3.7b alike). The colon stays because
  # every other session target in this script carries it and one spelling is easier
  # to hold than two, not because anything here still depends on it.
  tmux set-option -t "$SESSION_ID:" mouse on
  tmux set-option -t "$SESSION_ID:" status 2
  tmux set-option -t "$SESSION_ID:" status-position top
  tmux set-option -t "$SESSION_ID:" 'status-format[1]' "$(seat_bar)"
  tmux set-option -t "$SESSION_ID:" @qb_bar 1

  # Assembled in pieces and passed as ONE LINE. A newline inside a tmux command
  # string ends the command, so the readable indented version of this — nested
  # if-shell with its two branches on their own lines — binds a first line that
  # is missing its arguments and reports nothing when clicked. It looked right
  # in `list-keys`, which shows the newlines escaped as \n.
  run="run-shell -b '$click'"
  # The SESSION is stashed as well as the range, and it is not belt-and-braces:
  # `run-shell` invoked from a MOUSE binding gets no $TMUX_PANE, so the script
  # on the other end has nothing to work out which screen was clicked. From a
  # command line it does get one, which is what made this so quiet — the script
  # worked by hand and did nothing when clicked, silently, because run-shell -b
  # discards its output.
  stash="set-option -s -F @qb_click \"#{mouse_status_range}\""
  stash="$stash ; set-option -s -F @qb_click_session \"#{session_name}\""
  confirm="confirm-before -p 'close seat #{s/kill//:@qb_click} —"
  confirm="$confirm the agent in it goes too (y/n) ' \\\"$run\\\""
  inner="if-shell -F \"#{m:kill*,#{mouse_status_range}}\" \"$confirm\" \"$run\""

  tmux bind-key -n MouseDown1Status \
    if-shell -F '#{&&:#{!=:#{@qb_bar},},#{==:#{mouse_status_line},#{@qb_bar}}}' \
      "$stash ; $inner" \
      'switch-client -t ='
}

# ---- the top line ------------------------------------------------------------
# THE LINE THAT WAS ALWAYS THERE AND ALWAYS BLANK. `status 2` makes room for the
# seat bar and tmux numbers the two lines 0 and 1; install_bar only ever wrote
# `status-format[1]`. Writing ONE index of an array option at session level stops
# tmux inheriting the GLOBAL array, so index 0 — which nothing set — resolved to
# empty, and every screen has carried a full-width blank strip in whatever
# `status-style` is (green, on a stock tmux) since the bar shipped. Measured both
# ways: drop our `status-format[1]` and line 0 renders tmux's own status line
# again; set index 0 alongside ours and it renders whatever we put there.
#
# Nothing was relying on it, which is unusual and is what makes this a free line
# rather than a trade.
#
# IDENTITY ON THE LEFT, THE CEILING ON THE RIGHT. The seat bar says what the
# seats are doing and nothing said whose they were; and the shared
# subscription's caps are the only hard ceiling this fleet has, whose one
# on-screen home was the dash — which the qb key has just made hideable with a
# single keystroke. A ceiling you can hide is not a brake.
#
# NOT `#(qb-pace)`. A status line re-expands every `status-interval` — 15s by
# default, PER ATTACHED CLIENT — and a `#(shell command)` in one runs on that
# cadence. qb-seat-top is awake on its own timer anyway, so it writes the answer
# into a session option and this merely reads it: `#{@qb_pace}` costs nothing to
# expand however many clients are looking.
#
# THE SEVERITY IS A CONDITIONAL OVER LITERAL STYLES, not a colour substituted
# into one. `#[fg=#{@qb_pace_fg}]` does not work — style parsing and format
# expansion are different passes in tmux — and seat_state_style says the same
# thing about a seat's colour. The four arms are 6.13:1, 8.20:1, 6.53:1 and
# 6.36:1 against this ground; see seat_bar for why a background is named at all.
#
# `stale` is the one that is not a severity: it means qb-seat-top could not
# refresh the reading, so what is on screen is the last one it got. It is drawn
# dimmer and prefixed `~`, which is the mark the dashboard already uses for "at
# most this long ago" — a stale ceiling is still the best estimate anyone has,
# and blanking it would throw that away to avoid looking confident.
top_line() {
  local ground="#[fg=$BAR_FG]#[bg=$BAR_BG]"
  printf '%s' \
"#[fill=$BAR_BG]#[align=left]$ground #{@qb_top}"\
"#[align=right]"\
"#{?@qb_pace,"\
"#{?#{==:#{@qb_pace_sev},stale},#[fg=colour248]#[bg=$BAR_BG]~,#{?#{==:#{@qb_pace_sev},critical},#[fg=colour210]#[bg=$BAR_BG],#{?#{==:#{@qb_pace_sev},warning},#[fg=colour214]#[bg=$BAR_BG],#[fg=colour108]#[bg=$BAR_BG]}}}"\
"#{@qb_pace}$ground  ,}"\
"%H:%M "
}

# The knobs are recorded ON THE SESSION rather than read from the environment by
# qb-seat-top, and that is the same rule the ＋ and the resize hook follow: it is
# started by `run-shell`, whose environment is the tmux SERVER's and not the one
# the screen was built in. Recording them also means a screen can be retimed
# while it is up — `tmux set-option -t <screen> @qb_top_every 300` lands on the
# next pass, with nothing restarted.
install_top() {
  local top=$1 every text
  tmux set-option -t "$SESSION_ID:" 'status-format[0]' "$(top_line)"

  # `${VAR+set}` again, so an EMPTY QB_SEATS_TOP is a deliberate "no words of
  # ours on that line" and an unset one means "pick for me" — the same spelling
  # as QB_SEATS_DASH, and the same two different answers.
  if [ -n "${QB_SEATS_TOP+set}" ]; then
    text=$QB_SEATS_TOP
  else
    text="quarterback: ${REPO##*/}"
  fi
  tmux set-option -t "$SESSION_ID:" @qb_top_text "$text"
  tmux set-option -t "$SESSION_ID:" @qb_top "$text"

  every=${QB_SEATS_TOP_EVERY:-$TOP_EVERY}
  case "$every" in ''|*[!0-9]*) every=$TOP_EVERY ;; esac
  tmux set-option -t "$SESSION_ID:" @qb_top_every "$every"
  tmux set-option -t "$SESSION_ID:" @qb_top_animate "${QB_SEATS_TOP_ANIMATE:-1}"
  # One knob for "do not ask about the subscription", not two: QB_SEATS_PACE=off
  # already silences the estimate this script prints, and it means the same thing
  # here.
  # An `if` and not `[ … ] && …`, which is seat_env_fill's warning one function
  # along: a trailing AND-list whose test is false is a failing command, and this
  # script runs under `set -e`.
  if [ "${QB_SEATS_PACE:-on}" = off ]; then
    tmux set-option -t "$SESSION_ID:" @qb_top_pace 0
  fi

  # ASKED FOR BEFORE IT IS RUN, which is dash_hooks' rule and it arrived here the
  # same way: during a rollout PATH's harness and this checkout can disagree
  # about which scripts exist, and `beside_me` then answers with a path that is
  # not there. A `run-shell -b` on a missing command does NOT fail quietly —
  # measured on 3.6a as `no current client` and `not in a mode` on stderr and a
  # non-zero exit, which under `set -e` took the whole build down with the
  # session, the seats, the dash and the tape already created. The line itself is
  # already set above and says the right thing; what is lost without the loop is
  # only that it refreshes, which is worth one line on stderr and not a screen.
  if [ ! -x "$top" ]; then
    warn "top line: no qb-seat-top at $top, so the line is drawn once and will not
       refresh — the ceiling on the right of it will stay blank. Two copies of the
       harness have drifted; reinstalling it is the fix."
    return 0
  fi
  # `--once` for a screen that asked for no replays, so nothing is left running
  # for a line that will never change. Otherwise the loop, in the background,
  # parented to the tmux server and ending with the session.
  #
  # Tolerated as well as probed. The probe covers the case that has happened; a
  # `run-shell` that refuses for some other reason is still not worth failing a
  # screen that is otherwise built and working.
  if [ "$every" = 0 ]; then
    tmux run-shell -b "$(sh_quote "$top") $(sh_quote "$SESSION_ID") --once" \
      || warn "top line: tmux would not start qb-seat-top"
  else
    tmux run-shell -b "$(sh_quote "$top") $(sh_quote "$SESSION_ID")" \
      || warn "top line: tmux would not start qb-seat-top"
  fi
}

# ---- the qb key -------------------------------------------------------------
# The keyboard half of the seat bar, and until it existed there was no other
# half: every seat-level action was a click, adding a seat from the keyboard
# meant dropping to a shell for `qb-seats --add`, and the tape and the dash could
# not be got out of the way at all without dragging borders. Turning the bar on
# also costs `mouse on`, i.e. shift-less text selection, which is a real price
# for the only way in.
#
# A KEY TABLE RATHER THAN A MENU KEY, which is the one design decision here worth
# arguing. `bind-key -n C-q switch-client -T qb` plus `bind-key -T qb <key>` is
# how tmux implements its own prefix, and it costs nothing: C-q t is one chord
# whether or not a menu was drawn, and a menu drawn on every press is a flash in
# front of the screen you were looking at. What the menu is for is the press
# where you do not know the key — so it is bound to `Any`, and a key the table
# does not have opens it rather than being swallowed. That is the whole of "the
# menu teaches the shortcut it is about to replace": you reach it by not knowing.
#
# THE HAZARD IS THAT A KEY TABLE IS SERVER-WIDE, exactly as install_bar says
# about MouseDown1Status, and the answer is the same one. @qb_key is set on this
# session and on nothing else, so in the user's other sessions the condition is
# false and the else branch does verbatim what tmux would have done — sends the
# key on to the pane. A session that is not a screen is therefore not quietly
# missing a keystroke, which is the failure mode a bare `bind-key -n` has.
#
# C-q HAS PRIOR CLAIMS and they are worth stating rather than discovering: it is
# XON under `stty ixon`, and readline and emacs bind it to quoted-insert. Inside
# a seat pane tmux sees it first, so on a screen the agent loses it — hence
# QB_SEATS_KEY, and hence the user's own prefix being left entirely alone.
#
# ONE TABLE GENERATES BOTH THE BINDINGS AND THE MENU. An accelerator on the menu
# that is not the key bound in the table would make the menu a liar about the
# thing it exists to teach, and two lists is how that happens. Each row is
# `key|label|command`, the command is ONE tmux command string — measured on 3.6a:
# bind-key parses a whole command handed to it as a single argument, and
# display-menu takes an item's command as one argument too, so the same string
# serves both without a second spelling.

# `${VAR+set}` and not `${VAR:-}`, the same spelling as QB_SEATS_DASH and
# qb-seat's QB_SEAT_BRIEF, and for the same reason: EMPTY MEANS NONE and unset
# means pick for me. Those are different answers here — a user whose terminal or
# whose emacs wants C-q asks for no key at all with `QB_SEATS_KEY=`, and a `-n`
# test would read that as "not answered" and bind the default over the top of the
# thing they were getting out of the way. QB_SEATS_BAR is spelt the other way
# (`0` turns it off) because it is older than this rule; the two knobs are not
# interchangeable and the usage text says so for each.
qb_key() {
  [ -n "${QB_SEATS_KEY+set}" ] && { printf '%s' "$QB_SEATS_KEY"; return; }
  printf '%s' "$KEY_DEFAULT"
}

qb_actions() {   # <qb-seat-key path> <qb-seats path>
  local d dd k here
  # SH_QUOTE THEN TMUX_QUOTE, which is the rule stated by tmux_quote above and
  # which this function did not follow. sh_quote alone leaves `$`, `"`, `\` and
  # `#` live for tmux's own parser, and the failure is the silent one: a checkout
  # under `a$Bdir` bound every key to `/…/a/qb-seat-key`, because tmux expanded
  # `$Bdir` to nothing. The screen builds, the bar draws, the table installs, and
  # every key does nothing at all — `run-shell -b` discards both streams. A `"`
  # in the path is the loud version: `syntax error`, and a half-built screen.
  #
  # `d` crosses one tmux parse; `dd` crosses two, because a confirmed action's
  # command is a tmux string inside a tmux string.
  d=$(tmux_quote_n 1 "$(sh_quote "$1")")
  dd=$(tmux_quote_n 2 "$(sh_quote "$1")")
  k=$(tmux_quote_n 1 "$(sh_quote "$2")")
  # THE SCREEN AND THE PANE TRAVEL IN THE BINDING, expanded by tmux as the key is
  # pressed. This is where qb-seat-click's stash would have gone, and it is not
  # needed: `#{mouse_status_range}` is scoped to a mouse EVENT and is gone by the
  # time confirm-before runs its command, which is why the ✕ has to record it —
  # but a session and a pane are CLIENT state, not event state. Measured on 3.6a
  # against a real client and a real keystroke: both arrive correct from a plain
  # binding and from behind a `confirm-before` y/n. A server option would have
  # been a race between two clients pressing the key on one server; an argument
  # cannot be.
  #
  # THE ID AND NOT THE NAME, for this script's usual reason plus one specific to
  # here. `.` and `:` are a target's own separators — and this value crosses
  # tmux's expansion into a SHELL command line, where a session called `it's`
  # would leave an unterminated quote. `$0` is a dollar and digits and can be
  # neither. The dollar is safe: a format expands once, so tmux does not re-read
  # `$0` as one of its own variables — measured, because the fall-through arm of
  # the binding is written the other way round and does have to be.
  here="'#{session_id}' '#{pane_id}'"
  # `confirm-before`'s command is parsed when the answer comes back, not now, so
  # it is a tmux string inside a tmux string — the one place here that nests, and
  # the same shape install_bar's ✕ uses. Both confirmed actions kill an agent.
  #
  # NEITHER POPUP TAKES -E, and that is not an oversight. -E closes the popup the
  # moment its command exits, and both of these are things to READ: `list` prints
  # a handful of rows and returns, `guide` prints twenty lines. Without it the
  # popup stays until q or Escape, which is what a cheatsheet wants and what
  # tmux's own popups do.
  printf '%s\n' \
    "a|add a seat|run-shell -b \"$d add $here\"" \
    "x|close this seat|confirm-before -p 'close this seat — the agent in it goes too (y/n) ' \"run-shell -b \\\"$dd close $here\\\"\"" \
    "t|show or hide the tape|run-shell -b \"$d tape $here\"" \
    "d|show or hide the dash|run-shell -b \"$d dash $here\"" \
    "=|the dash back to the width it asked for|run-shell -b \"$d fit $here\"" \
    ">|the dash wider|run-shell -b \"$d wider $here\"" \
    "<|the dash narrower|run-shell -b \"$d narrower $here\"" \
    "j|jump to a seat — then 1-9|switch-client -T qb" \
    "s|the screens that are up|display-popup -w 76 -h 16 \"$k list\"" \
    "||" \
    "K|kill this screen|confirm-before -p 'kill this screen — every agent on it goes too (y/n) ' \"run-shell -b \\\"$dd kill $here\\\"\"" \
    "?|these keys, in full|display-popup -w 72 -h 27 \"$d guide\""
  # NO `$here` ON THE GUIDE. `display-popup` does not format-expand its command —
  # measured on 3.6a, where the popup was handed the literal `#{session_id}` — so
  # the guide asks tmux which session it is in instead. `display-message -p` with
  # no `-t` answers with the client's current one, which inside a popup is the
  # client that opened it.
}

install_key() {
  local key=$1 dispatch=$2 seats=$3 k label cmd n
  local -a menu=()

  # What the gate reads, and what the guide reads to name the key it is about to
  # explain. On the session, so a second screen with a different QB_SEATS_KEY is
  # not answered for by the first.
  tmux set-option -t "$SESSION_ID:" @qb_key "$key"
  # WHICH DISPATCHER THIS SCREEN WAS BUILT WITH, and it is recorded because the
  # `qb` TABLE CANNOT HOLD IT. `bind-key -T qb` is server-wide: the root key is
  # gated per screen, but the table's contents are one set for the whole server,
  # so the last screen built wins and an older screen's keys then run the newer
  # screen's qb-seat-key. That is the same "which copy of itself" question
  # dash_hooks answers for the resize hook, one surface along, and it bites in
  # the same place — a rollout, where PATH's harness and a checkout disagree.
  #
  # The table still names one path; qb-seat-key reads this and hands over to the
  # copy the screen it was pressed on actually belongs to. Recorded even when the
  # two agree, so the answer never depends on which screen was built last.
  tmux set-option -t "$SESSION_ID:" @qb_key_bin "$dispatch"

  # A ROW WITH NO KEY IS A MENU SEPARATOR and binds nothing — which is why the
  # grouping lives in the table beside the actions rather than as a slice of the
  # array afterwards. It was a slice for one draft, `${menu[@]:0:8}`, and eight is
  # not a multiple of three: the rule landed in the middle of the tape item and
  # split its label off from its command.
  while IFS='|' read -r k label cmd; do
    if [ -z "$k" ]; then menu+=('' '' ''); continue; fi
    tmux bind-key -T qb "$k" "$cmd"
    menu+=("$label" "$k" "$cmd")
  done < <(qb_actions "$dispatch" "$seats")

  # The nine seat keys are bound and are deliberately NOT rows on the menu: a
  # screen can have ten seats and a menu with ten more rows is a worse menu, and
  # rows built per screen would go stale the moment a seat is added or closed. A
  # digit naming a seat that is not there reports it the way the bar's cells do,
  # through qb-seat-click.
  #
  # THE MENU MUST NOT PROMISE THEM EITHER. Its title said "1-9 jumps to a seat"
  # and a menu has no digit accelerators, so pressing one did nothing at all —
  # which is how the digits got reported as broken when they worked perfectly
  # from the key. The `j` row is the honest version: it puts you back in the
  # table, which is the one place a digit means a seat.
  n=1
  while [ "$n" -le 9 ]; do
    tmux bind-key -T qb "$n" \
      "run-shell -b \"$(tmux_quote_n 1 "$(sh_quote "$dispatch")") seat$n '#{session_id}' '#{pane_id}'\""
    n=$((n + 1))
  done

  # `Any` is the discovery path — see the header. It is bound last so that every
  # key above beats it, which is how tmux resolves a table: an exact match first,
  # Any only when there is none.
  #
  # Every word its own argument, never a part-string with the items after it:
  # tmux takes a whole command handed to it as ONE argument and it takes a
  # pre-split argv, and mixing the two is a third thing that is neither.
  tmux bind-key -T qb Any \
    display-menu -T '#[align=centre] qb keys ' -x C -y C \
    "${menu[@]}"

  # GATED ON THIS KEY, not merely on this being a screen. `#{!=:#{@qb_key},}`
  # was the first spelling and it is subtly wrong on a box running two screens
  # with different keys: nothing UNBINDS the first screen's key when the second
  # is built, so a server ends up with both bound and both conditions true on
  # both screens — C-q would open the table on a screen whose user had asked for
  # M-q precisely to get C-q back. Comparing the value makes each binding answer
  # for its own screen and fall through everywhere else, which is what the guide
  # promises. The key cannot carry any of the format's own punctuation — `#`, `}`,
  # `,`, `:` — nor a quote or a `$`; it is checked for exactly that before
  # anything is built, which is why it can be interpolated raw here.
  tmux bind-key -n "$key" \
    if-shell -F "#{==:#{@qb_key},$key}" \
      "switch-client -T qb" \
      "send-keys $key"
}

# ---- where the seats work ---------------------------------------------------
default_repo() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "not in a git repo — run this from one, or pass -C DIR"
}

# ---- tmux helpers -----------------------------------------------------------
# THE ID, NEVER THE NAME, IS WHAT A `-t` GETS. `.` and `:` are a target's own
# separators, and a session name is whatever `-s` was handed. tmux used to rewrite
# those characters out of a name it would not take — which is what this script
# leaned on, and what the warning by new-session is about — and tmux 3.7b stopped:
# `my.screen` is now kept verbatim, so `-t "=my.screen"` parses as pane `screen` of
# session `my` and comes back "can't find pane: screen". Every seat command then
# failed against a screen that plainly existed, `list` showed nothing, and `resume`
# could not reach it (#259, which read this as stale tests; the tests were right and
# the script was leaning on a tmux behaviour that went away).
#
# `#{session_id}` is `$0`, `$3` — no separators, unique for the life of the server,
# and tmux's own answer to "which session". Names are for humans and stay in the
# messages; ids do the addressing.
SESSION_ID=""

# The id of a session by exact name, read off `list-sessions` rather than looked up
# with `-t`: a lookup BY name is the very thing that cannot be trusted here. The
# name is the last field for the reason `screens()` gives — it may contain spaces,
# and everything before it is one fixed field.
session_id() {
  local line
  # SPLIT BY HAND, not with `IFS=' ' read -r id nm`: read strips trailing IFS
  # whitespace from the last field, so a session called `mine ` (tmux takes one)
  # would come back as `mine` and never compare equal to what the caller asked
  # for. `IFS=` keeps the line whole and the two expansions cut it at the first
  # space, which is where the id ends.
  tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null \
    | while IFS= read -r line; do
        # `if`, NOT `[ … ] && printf`. A `&&` whose test fails is the last
        # command in the loop body, so the `while` exits 1 whenever the session
        # being looked for is not the LAST one listed — and under `pipefail` that
        # is the pipeline's status, and so the command substitution's. A caller
        # spelling `sid=$(session_id x) || sid=""` then discarded the id it had
        # just been given: measured as a second screen on one server reporting
        # "no screen named 'one' is up" about a screen tmux was listing.
        if [ "${line#* }" = "$1" ]; then printf '%s\n' "${line%% *}"; fi
      done
}

# Sets SESSION_ID as a side effect, so a caller that goes on to address the session
# does not have to remember to. Absent session, empty id, false — one answer.
have_session() {
  SESSION_ID=$(session_id "$SESSION")
  [ -n "$SESSION_ID" ]
}

attach() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION_ID"
  elif [ -t 0 ]; then
    tmux attach-session -t "$SESSION_ID"
  else
    # No terminal to attach to (a script, a unit, a CI check). The screen is up
    # regardless — say how to reach it rather than failing.
    #
    # `$PROG resume` and not `tmux attach -t $SESSION`, which is what this said
    # and which does not work for the names this script now supports: a target
    # session is parsed for `.` and `:` like any other, so `tmux attach -t
    # my.screen` comes back "can't find pane: screen" on 3.7b (measured). Handing
    # a human a command that fails against exactly the screens the id conversion
    # exists for is worse than saying nothing. `resume` takes the name because it
    # resolves it the way session_id does, and it is the spelling `list` already
    # advertises.
    printf '%s: %s is up — %s resume %s\n' "$PROG" "$SESSION" "$PROG" "$SESSION"
  fi
}

# ---- the screens that are up ------------------------------------------------
# WHAT MAKES A TMUX SESSION ONE OF OURS IS A PANE CARRYING @qb_seat, not what the
# session is called. Three separate reasons the name cannot be the test:
#
#   * -s takes anything. The fleet's own screen is `qbseats`, not
#     `seats-nix-fleet`, and it is no less a screen for it.
#   * tmux renames what it will not take verbatim — see the note by new-session.
#     The name you asked for is then not the name that is up, which is precisely
#     the case a user needs a list to get out of.
#   * `seats-` is a prefix anyone may have used for something else.
#
# The option is set on every seat this script creates and on nothing else, so the
# panes that have one both identify the screen and count its seats.
#
# One `list-panes -s` per session rather than a single `-a` sweep, because a
# session name is whatever the user gave it and may contain the separator any
# one-pass format string would have to split on. For the same reason the NAME IS
# THE LAST FIELD of each record: everything before it is a fixed count of fields,
# so a reader can take the rest of the line as the name and be right.
screens() {
  local s sid n att path all line
  # READ THE SESSION LIST FIRST, and tolerate it failing. A server with no
  # sessions at all — which is `list` and `resume` on a box where nothing is up,
  # the commonest reason to run either — makes `tmux list-sessions` exit 1, and
  # under `pipefail` that status is the whole pipeline's however the `while`
  # ends. `set -e` then took the script down before it could say so: measured as
  # `qb-seats list` printing "no screens are up" and exiting 1 anyway.
  all=$(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null) || return 0
  [ -n "$all" ] || return 0
  # Sorted on the NAME, which is field 2 onwards — the id sorts `$10` before `$2`
  # and is not what a reader is scanning. Each line is `<id> <name>`, and the id
  # is what the two lookups below address: a session called `my.screen` is real
  # and unreachable by its own name (see session_id).
  printf '%s\n' "$all" | sort -k2 | while IFS= read -r line; do
    sid=${line%% *}; s=${line#* }
    n=$(tmux list-panes -s -t "$sid" -F '#{@qb_seat}' 2>/dev/null \
          | awk 'NF { n++ } END { print n + 0 }')
    [ "$n" -gt 0 ] || continue
    # `$sid:` WITH THE COLON, exactly as the set-option calls further down use it.
    # These read `=$s:` before the id conversion, and the colon was load-bearing
    # then: display-message takes a target-PANE and a bare session NAME is not
    # one, and it does not fail loudly either — it prints an empty line, which is
    # how the first cut of this listed every screen with no path and every one of
    # them "(attached)". See install_bar for why the colon is kept now that the
    # target is an id and no longer needs it.
    att=$(tmux display-message -p -t "$sid:" '#{session_attached}' 2>/dev/null) || att=
    path=$(tmux display-message -p -t "$sid:" '#{session_path}' 2>/dev/null) || path=
    # NO FIELD MAY BE EMPTY. A tab is IFS whitespace, so a reader splitting on one
    # collapses a run of them: `3\t\t\tname` reads back as two fields, not four,
    # and the name lands in the second variable. The defaults are therefore not
    # cosmetic — they are what keeps a session that vanished between the list and
    # the lookup from silently shifting every column right.
    printf '%s\t%s\t%s\t%s\n' "$n" "${att:-0}" "${path:-?}" "$s"
  done
  return 0
}

# Just the names, in the order `list` numbers them. Field 4 TO THE END, since the
# name is the last field and may contain a tab of its own.
screen_names() { screens | cut -f4-; }

# The numbered list a human reads and `resume` counts against. Both call this, so
# the number beside a screen cannot come to mean two different things.
#
# THE ROWS GO TO STDOUT AND THE HINT UNDER THEM TO STDERR. A list of names is only
# half an answer — the next command has to be visible from the list, because
# `resume` is not guessable from `--add` and `--kill` — but a caller that pipes
# this must still get rows and nothing else. Both land on a terminal in order, so
# the split costs the human reading it nothing.
list_screens() {
  local seats att path name i=0 home=${HOME:-} rows ex_n ex_name count
  rows=$(screens)
  [ -n "$rows" ] || return 0
  printf '%s\n' "$rows" | while IFS=$'\t' read -r seats att path name; do
    i=$((i + 1))
    # ~ for $HOME, because the repo path is the column a human scans to tell two
    # screens apart and the prefix is the same on every row.
    case "$home" in
      ?*) case "$path" in "$home"/*) path="~${path#"$home"}" ;; esac ;;
    esac
    printf '  %-3s %-24s %2s seat%s  %s%s\n' \
      "$i" "$name" "$seats" "$([ "$seats" = 1 ] || printf s)" "$path" \
      "$([ "$att" = 0 ] || printf '  (attached)')"
  done

  # The worked example names a DETACHED screen wherever there is one: that is the
  # row somebody reading this list is looking for. Both spellings are shown
  # because both work and the name is the half that survives a screen being
  # closed further up the list.
  ex_n=$(printf '%s\n' "$rows" | awk -F'\t' '$2 == 0 { print NR; exit }')
  [ -n "$ex_n" ] || ex_n=1
  ex_name=$(printf '%s\n' "$rows" | sed -n "${ex_n}p" | cut -f4-)
  count=$(printf '%s\n' "$rows" | wc -l)
  if [ "$count" -eq 1 ]; then
    # One screen up takes no argument at all, so say that rather than a number
    # whose only value is being the only one.
    printf '\n  open it:  %s resume\n' "$PROG" >&2
  else
    printf '\n  open one: %s resume %s   (or by name: %s resume %s)\n' \
      "$PROG" "$ex_n" "$PROG" "$ex_name" >&2
  fi
  return 0
}

# Which screen `resume` means. Empty output and status 1 for "cannot tell".
#
# A NAME BEATS A NUMBER, both passes over the same list. Both spellings are
# offered because `list` prints both, and a screen that happens to be called `3`
# while sitting at row 1 has to resume when you type its name — the name is the
# thing the user can see is unambiguous.
resolve_screen() {
  local want=$1 list name i=0
  list=$(screen_names)
  [ -n "$list" ] || return 1

  if [ -z "$want" ]; then
    # A list of one is not a choice to make. `qb-seats resume` on a box with a
    # single screen up is the whole of what most people mean by it.
    [ "$(printf '%s\n' "$list" | wc -l)" -eq 1 ] || return 1
    printf '%s\n' "$list"
    return 0
  fi

  while IFS= read -r name; do
    if [ -n "$name" ] && [ "$name" = "$want" ]; then printf '%s\n' "$name"; return 0; fi
  done <<EOF
$list
EOF
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    i=$((i + 1))
    if [ "$i" = "$want" ]; then printf '%s\n' "$name"; return 0; fi
  done <<EOF
$list
EOF
  return 1
}

# Seats are identified by a pane option, not by index or title: the index shifts
# when a pane is added, and the agent in the pane rewrites the title.
seat_panes() {
  tmux list-panes -t "$SESSION_ID:seats" -F '#{pane_id} #{@qb_seat}' \
    | awk '$2 != "" { print $1, $2 }' | sort -k2 -n
}

# TYPE a line into a pane's shell. -l, because send-keys looks its argument up as a
# KEY NAME first and only falls back to literal text: a QB_SEATS_DASH of `Enter`,
# `Space`, `Tab` or `BSpace` would be sent as that key rather than typed, and one
# beginning with `-` would be read as an option — which is what the `--` is for.
# The Enter is a second call, since -l disables exactly the lookup that turns
# `C-m` into one.
type_into() {
  local pane=$1 line=$2 enter=${3:-1}
  tmux send-keys -t "$pane" -l -- "$line"
  [ "$enter" = 1 ] || return 0
  tmux send-keys -t "$pane" C-m
}

# Start a seat by TYPING its command into the pane's shell.
#
# This looks like the lazy option and is in fact the only correct one. The pane
# has to hold a real interactive shell that OWNS the terminal, because the
# property this whole screen exists for is: attach to one seat, interrupt the
# agent, redirect it. If the agent is instead the pane's own process — say
# `split-window "qb-seat 1; exec $SHELL -i"` — then Ctrl-C goes to the whole
# foreground group, bash abandons the rest of the command list, and THE PANE
# CLOSES. You interrupt a seat and lose it, which is the exact opposite of the
# requirement. That is not hypothetical: this script did it that way until the
# test suite caught it, and hand-testing had missed it because a stub that is
# already an interactive shell survives a Ctrl-C that a real agent would not.
#
# Typed into a live shell, the same Ctrl-C returns you to a prompt in the repo,
# every time, whatever the agent does with the signal.
#
# The keys are not racing the shell's startup: tmux writes them into the pane's
# pty, where they wait until something reads them. The one thing that breaks that
# is an rc file which reads stdin itself before the prompt — see QB_SEATS below,
# which is exactly that bug and its fix.
#
# --staged is the equivalent of zellij's `start_suspended`, and better: the
# command is typed but not entered, so it can be read, edited, or abandoned.
start_seat() {
  local pane=$1 n=$2 enter=1
  [ "$STAGED" -eq 1 ] && enter=0
  # The bare name when the pane's shell will find it, which is the ordinary case
  # and keeps the command line in the pane readable. Otherwise the absolute path
  # resolved by require_qb_seat — see there for who is short of a PATH.
  type_into "$pane" "$SEAT_CMD $n" "$enter"
}

SEAT_CMD="qb-seat"      # what start_seat types; require_qb_seat may absolutise it

# PATH is the wrong and only question this used to ask, and --add is where that
# broke. The ＋ on the seat bar reaches this through `run-shell`, whose PATH is
# the TMUX SERVER's — and the server is usually one that was already running for
# something else, long before anything put the harness on a PATH. So the ＋ died
# here with "qb-seat is not on PATH", and `run-shell -b` throws stderr away, so
# the button simply did nothing. Measured, not guessed.
#
# qb-seat, qb-seats and qb-seat-click install into one directory together, so a
# sibling of $0 is a better answer than PATH and is always available. PATH still
# wins when it has one, so an installed copy beats a checkout.
require_qb_seat() {
  SEAT_CMD=$(beside_me qb-seat)
  [ -x "$SEAT_CMD" ] || die \
    "qb-seat is neither on PATH nor beside this script (looked at $SEAT_CMD)"
  # Typed into a pane, the bare name is nicer to read and equivalent whenever
  # the pane's own shell can resolve it.
  command -v qb-seat >/dev/null 2>&1 && SEAT_CMD="qb-seat"
  return 0
}

# Absolute paths for the two scripts the bar shells out to, resolved HERE rather
# than left to PATH. A tmux server usually predates the screen running in it, so
# a `run-shell` inherits whatever PATH started the server — the same trap the
# seat_env forwarding below exists for, one layer along. PATH first so an
# installed copy wins over a checkout; this script's own directory as the
# fallback, because the three install together.
beside_me() {
  local name=$1 found
  found=$(command -v "$name" 2>/dev/null) && { printf '%s' "$found"; return; }
  printf '%s/%s' "$(cd -P "$(dirname "$0")" && pwd)" "$name"
}

# ---- what a screen of N seats is about to spend ------------------------------
#
# N agents on ONE subscription is the largest single spending decision this fleet
# makes, and it is made here, by a human, at a prompt. Until #275 the five-hour
# and weekly caps were drawn on the dash and read by nothing, so the brake on the
# fleet's only hard ceiling was somebody noticing a bar go red — and this command
# is the moment that matters most and the moment nobody is looking at the dash.
#
# IT WARNS AND PROCEEDS, ALWAYS. A human bringing up a screen has already decided
# to spend; what helps is a prediction rather than a refusal — what these N seats
# cost, against what is left and when it comes back. The refusal lives one layer
# down in qb-seat, off by default, for the panes with nobody in front of them
# (QB_SEAT_PACE=obey).
#
# Printed here rather than left to the seats, because a pane execs its agent
# moments later and the agent's own screen paints over anything printed before
# it. This is the terminal that stays.
#
# QB_SEATS_PACE=off silences it — and is how a test avoids reading the developer's
# real subscription.
pace_note() {
  local bin line
  [ "${QB_SEATS_PACE:-on}" = off ] && return 0
  bin=$(beside_me qb-pace)
  # An older or partial install has no qb-pace. That is not a reason to refuse to
  # build a screen; it is a screen built without the estimate, as before.
  [ -x "$bin" ] || return 0
  # `|| true` because this runs under `set -e` and the answer is advisory: a
  # timeout, a broken interpreter or a board that will not answer must cost the
  # note, never the screen. `|| true` rather than `|| line=`, so a command that
  # said something useful AND exited non-zero is still relayed — the assignment
  # has already happened by then, and throwing the line away would silence the
  # one case where a caller most wants to hear it.
  if command -v timeout >/dev/null 2>&1; then
    line=$(timeout 20 "$bin" --estimate "$SEATS" 2>/dev/null) || true
  else
    line=$("$bin" --estimate "$SEATS" 2>/dev/null) || true
  fi
  [ -n "$line" ] || return 0
  printf '%s\n' "$line" | while IFS= read -r l; do
    printf '%s: %s\n' "$PROG" "$l" >&2
  done
  return 0
}

# ---- the knobs qb-seat reads ------------------------------------------------
# qb-seat's own knobs have to be forwarded explicitly. A pane's environment comes
# from the tmux SERVER, and the server is usually one that was already running
# for something else — so `QB_SEAT_AGENT=... qb-seats` would otherwise set a
# variable in this process that no seat ever sees, and start the real agent while
# reporting nothing wrong. Found exactly that way: a smoke test meant to run a
# harmless stand-in launched two live agent sessions instead.
#
# This list is exactly the set qb-seat READS, and test_forwarded_knobs_are_all_read
# pins it that way. Forwarding a name qb-seat does not read is the same silent
# failure one layer along: the variable arrives in the pane, nothing consults it,
# and the seat starts the real agent while reporting nothing wrong. That is how
# QB_SEAT_AGENT_ARGS got here — qb-seat takes agent arguments positionally, so no
# such variable was ever read — and how this list said QB_SEAT_AGENT while qb-seat
# said QB_SEAT_CLAUDE, which is board finding 3632.
#
# --yolo/--no-yolo are not a fourth mechanism, they are this one with the value
# supplied here: the flags set the variable qb-seat already reads, so a flag and
# an exported QB_SEAT_YOLO cannot diverge in behaviour and there is one thing to
# test. Neither flag given leaves the variable alone entirely — an unset variable
# is how qb-seat is told "not answered", and answering it here with a default of
# our own would be a second place for the default to live and drift.
#
# THE PREDICATE MIRRORS HOW qb-seat READS EACH NAME, which is not the same test for
# all of them. qb-seat takes QB_SEAT_BRIEF with `${QB_SEAT_BRIEF+set}` so that
# set-and-empty means "no brief at all" and unset means "use the built-in one" —
# those are different answers, and only the first can ask for a waiting seat. A
# `-n` test here cannot express it: it drops the empty value, nothing arrives in
# the pane, qb-seat sees unset, and the seat starts on the full brief while
# reporting nothing wrong. That is the same silent failure the build path already
# warns about twice, arriving through the forwarder instead of past it.
#
# The other three are read with `${VAR:-}`, where empty and unset are the same
# answer, so `-n` is the honest test for them and forwarding an empty value would
# only add a variable that says nothing.
#
# QB_SEAT_SCOPE goes with QB_SEAT_BRIEF and not with those three, for exactly the
# same reason: qb-seat reads it with `${QB_SEAT_SCOPE+set}` because empty is the
# one value that asks for the machine-wide seat numbering it had before #208, and
# a `-n` test here would drop that request on the floor and give the screen the
# per-project default it was told not to use.
#
# NOTHING IS FORWARDED WHEN IT IS UNSET, which is the whole default: the panes are
# created with `-c "$REPO"`, so each seat derives the same scope from its own cwd
# that this screen would have computed for it. A default written out here as well
# would be a second place for it to live and drift.
#
# THIS IS A FUNCTION BECAUSE BOTH PATHS NEED IT, and for a while only one had it.
# `up` puts the list on the SESSION, so every pane split off later inherits it;
# --add puts the same list on the one pane it creates, with -e, so it does not
# rewrite the session under the seats already working in it. But
# `QB_SEAT_BRIEF= qb-seats --add` onto a screen built without one is the same
# request as `QB_SEAT_BRIEF= qb-seats`, and a predicate written out in only one of
# the two places is the same silent failure in half the cases. One list, one set of
# tests, both callers.
seat_env=()
seat_env_fill() {
  local v
  seat_env=()
  [ -n "$YOLO" ] && QB_SEAT_YOLO="$YOLO"
  for v in QB_SEAT_AGENT QB_SEAT_FORCE QB_SEAT_PACE QB_SEAT_YOLO; do
    [ -n "${!v:-}" ] && seat_env+=(-e "$v=${!v}")
  done
  [ -n "${QB_SEAT_BRIEF+set}" ] && seat_env+=(-e "QB_SEAT_BRIEF=$QB_SEAT_BRIEF")
  [ -n "${QB_SEAT_SCOPE+set}" ] && seat_env+=(-e "QB_SEAT_SCOPE=$QB_SEAT_SCOPE")
  # Said out loud, because the last test is allowed to be false and this script
  # runs under `set -e`: a function whose final command is a failed `[` returns 1,
  # and a bare call to it would then take the whole screen down.
  return 0
}

# ---- args -------------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    -n) SEATS=${2:-}; shift 2 ;;
    -C) REPO=${2:-}; shift 2 ;;
    -s) SESSION=${2:-}; shift 2 ;;
    --staged) STAGED=1; shift ;;
    --yolo) YOLO=1; shift ;;
    --no-yolo) YOLO=0; shift ;;
    --add)  ACTION="add";  shift ;;
    --kill) ACTION="kill"; shift ;;
    # Bare words, and the `--` spellings too, because a user who has just learnt
    # --add and --kill will type --list and must not be told it is a caller bug.
    list|--list) ACTION="list"; shift ;;
    resume|--resume)
      ACTION="resume"; shift
      # Its target is positional and has to be taken RIGHT HERE, because a bare
      # number means the seat count everywhere else on this command line:
      # `qb-seats resume 2` would otherwise be read as "resume, three seats" and
      # the 2 would vanish into $SEATS. Anything starting with `-` is left for
      # the loop, so `resume --help` still prints the help.
      case "${1:-}" in ''|-*) ;; *) TARGET=$1; shift ;; esac
      ;;
    --dash-fit) ACTION="fit"; shift ;;
    -h|--help) usage; exit 0 ;;
    # A bare number is the seat count. `qb-b 3` is the shape this is reached for
    # twenty times a day, and -n is two keystrokes of ceremony on the only
    # argument that varies.
    [0-9]|[0-9][0-9]) SEATS=$1; shift ;;
    *) usage >&2; exit 2 ;;
  esac
done

case "$SEATS" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
[ "$SEATS" -ge 1 ] || { usage >&2; exit 2; }
[ "$SEATS" -le "$MAX_SEATS" ] \
  || die "$SEATS seats: the ceiling is $MAX_SEATS (five across, two down). Past that a
       pane is too narrow to read an agent in, and a human cannot follow it anyway."

command -v tmux >/dev/null 2>&1 \
  || die "tmux is not installed (home-manager: programs.quarterback-harness.seats.enable)"

# --dash-fit is what the window's resize hooks call, so it must not need anything a
# hook cannot give it: no repo (a run-shell's cwd is the tmux server's, not the
# screen's) and no PATH. The session is therefore named on the command line rather
# than derived from a directory, and a hook left behind by a screen that has since
# been killed is not an error — it is the ordinary way this ends.
if [ "$ACTION" = fit ]; then
  [ -n "$SESSION" ] || die "--dash-fit needs -s SESSION"
  have_session || exit 0
  dash_resize
  exit 0
fi

# `list` and `resume` are about screens that ALREADY EXIST, so neither may need
# what building one needs — and in particular neither derives a repo. That is not
# a shortcut, it is the feature: the whole point of `resume` is that you do not
# have to be standing in the right directory. The screen already knows the one it
# was built in and every pane in it is already there, so a dropped ssh link is
# recovered from whatever shell came back up, in whatever cwd. They run before
# default_repo for that reason, exactly as --dash-fit does.
if [ "$ACTION" = list ]; then
  # An empty list on stdout and a word on stderr: a human running this by hand is
  # not left staring at silence, and a caller parsing stdout is not handed prose.
  [ -n "$(screen_names)" ] || warn "no screens are up"
  list_screens
  exit 0
fi

if [ "$ACTION" = resume ]; then
  # resolve_screen answers with a NAME, because that is what a user typed and what
  # the list printed. `attach` addresses the id, so it is looked up here — via
  # have_session, which is the one place that mapping lives.
  if ! SESSION=$(resolve_screen "$TARGET"); then
    if [ -z "$(screen_names)" ]; then
      die "no screens are up — start one with \`$PROG\` in the repo you want it in"
    fi
    if [ -n "$TARGET" ]; then
      warn "no screen numbered or named '$TARGET'. These are up:"
    else
      warn "more than one screen is up, so say which:"
    fi
    list_screens >&2
    exit 1
  fi
  have_session || die "'$SESSION' went away between the listing and the attach"
  attach
  exit 0
fi

# A `--kill` THAT WAS TOLD WHICH SCREEN needs nothing else, and this is above the
# repo derivation for the reason `list`, `resume` and `--dash-fit` are: killing a
# screen is about one that already exists, so it must not need what BUILDING one
# needs. It matters now because the qb key's K reaches here through a
# `run-shell`, whose cwd is the tmux SERVER's — wherever that server was started,
# which need not be a repo at all, and `qb-seats --kill -s t` then refused with
# "not in a git repo" against a screen it could see. A bare `qb-seats --kill`
# still means "the screen for the repo I am standing in" and falls through to the
# derivation below, which is the only reason a kill ever wanted one.
if [ "$ACTION" = kill ] && [ -n "$SESSION" ]; then
  have_session || die "no session $SESSION"
  tmux kill-session -t "$SESSION_ID"
  exit 0
fi

[ -n "$REPO" ] || REPO=$(default_repo)
REPO=$(cd -P "$REPO" 2>/dev/null && pwd) || die "no such directory: $REPO"
[ -n "$SESSION" ] || SESSION="seats-${REPO##*/}"

if [ "$ACTION" = kill ]; then
  have_session || die "no session $SESSION"
  tmux kill-session -t "$SESSION_ID"
  exit 0
fi

if [ "$ACTION" = add ]; then
  have_session || die "no session $SESSION — start it with $PROG first"
  require_qb_seat
  # Highest seat number in use, plus one — not a count, so a seat whose pane was
  # closed does not hand its number to the next one and collide on the board.
  next=$(seat_panes | awk '{ n = $2 + 0; if (n > m) m = n } END { print m + 1 }')
  # Reflow the seat ROW only: -E spreads the target pane and its neighbours. The
  # board was split off full-width, so even-horizontal on the whole window would
  # fold it back into the row. This is the tmux answer to zellij's
  # `override-layout --retain-existing-terminal-panes`: one command, no teardown,
  # the seats already working left alone.
  # By pane ID, never `seats.0`: pane numbering starts whereever the user's
  # pane-base-index says, and a config setting it to 1 — a common one — leaves
  # every `.0` target failing with "can't find pane: 0".
  first_seat=$(seat_panes | awk 'NR == 1 { print $1 }')
  # A pane inherits the SESSION environment as it is created, so a seat added to a
  # screen built with the same knobs already has them and this adds nothing.
  # Passing one to --add is the other case: -e scopes it to the pane being added
  # rather than rewriting the session under the seats already working in it. The
  # list and the predicate are seat_env_fill's, deliberately — see the note there
  # for why writing them out a second time here is how QB_SEAT_BRIEF got dropped
  # from this path.
  seat_env_fill
  # The dash is in the row `select-layout -E` is about to spread, so note its width
  # now and put that back afterwards. Nothing about the WINDOW is changing, so the
  # width it has right this second is the right answer — including one the user set
  # by dragging the border. Without the reassert an --add narrows the dash every
  # time it is called, which is how a screen ends up with a 29-column dashboard
  # nobody chose.
  dash=$(dash_pane)
  dash_was=""
  [ -z "$dash" ] || dash_was=$(tmux display-message -p -t "$dash" '#{pane_width}')
  pane=$(tmux split-window -h -P -F '#{pane_id}' -t "$first_seat" -c "$REPO" \
    ${seat_env[@]+"${seat_env[@]}"})
  tmux set-option -p -t "$pane" @qb_seat "$next"
  # Recorded as well as forwarded, and see the note by the session-wide one: the
  # variable tells the SEAT what it is called, this tells everything that reads
  # the screen from outside — and --add scopes it to the pane it just made, for
  # the same reason its -e list is scoped there.
  [ -z "${QB_SEAT_SCOPE+set}" ] \
    || tmux set-option -p -t "$pane" @qb_scope "$QB_SEAT_SCOPE"
  tmux select-layout -t "$pane" -E 2>/dev/null || true
  [ -z "$dash_was" ] || dash_resize "$dash_was"
  start_seat "$pane" "$next"
  printf '%s: added seat %s to %s\n' "$PROG" "$next" "$SESSION"
  exit 0
fi

# ---- build the screen -------------------------------------------------------
if have_session; then
  # Reattach. This is the path an ssh session takes, and it must never rebuild.
  attach
  exit 0
fi

require_qb_seat
pace_note

# QB_SEATS_DASH_SIZE reaches `split-window -l` and `resize-pane -x` verbatim, so it
# is checked here, where nothing exists yet. `QB_SEATS_DASH_SIZE=78px` makes
# split-window exit non-zero, and that split runs inside a command substitution
# under `set -e`: the script would die with the session, the seats and the tape
# already built but no agent started, on a bare tmux error naming neither the
# variable that caused it nor the fix — and the rerun then fails on the duplicate
# session name instead. The ceiling is the window a screen is built in; dash_resize
# clamps again, against whatever the client actually turns out to be.
case "$DASH_SIZE" in
  ''|*[!0-9]*) die "QB_SEATS_DASH_SIZE=$DASH_SIZE: a width in columns, digits only" ;;
esac
{ [ "$DASH_SIZE" -ge 1 ] && [ "$DASH_SIZE" -le "$WINDOW_COLS" ]; } \
  || die "QB_SEATS_DASH_SIZE=$DASH_SIZE: 1 to $WINDOW_COLS columns (a screen is built
       $WINDOW_COLS wide, and the dash never takes more than a third of the window)"

# The qb key reaches a tmux command line the same way, and is checked here for the
# same reason: `bind-key` is one of the last things this script does, so a key
# tmux will not take would refuse with the session, the seats, the dash and the
# tape already built.
#
# TWO PLACES THE VALUE LANDS, and the second is the strict one. It is a bare word
# in `bind-key -n <key>` and in `send-keys <key>`, which rules out whitespace,
# quotes, a backslash and a `;`. And it is interpolated into the gate's FORMAT,
# `#{==:#{@qb_key},<key>}` — where `#` opens a format, `}` closes one, and `,`
# and `:` are the separators between a format's own arguments. A key carrying one
# of those does not fail loudly: the format still parses, as something else, and
# the gate then answers a question nobody asked. `$` goes too, because tmux
# expands one inside the double quotes the else-arm is written in.
#
# Nothing worth having is lost. Those are all root-table bindings, so a bare `,`
# or `:` as the qb key would take that character away from every pane on the box
# — a screen's user wants C-q or M-q, and a `#` is not a tmux key name at all.
QB_KEY=$(qb_key)
case "$QB_KEY" in
  *[[:space:]]*|*"'"*|*'"'*|*'\'*|*';'*|*'#'*|*'$'*|*','*|*':'*|*'{'*|*'}'*)
    die "QB_SEATS_KEY=$QB_KEY: a tmux key name — letters, digits, C-/M- and most
       punctuation. Not whitespace, quotes, a backslash, or any of ; # \$ , : { }
       — those either end the command the binding is written into or are
       punctuation in the format that decides whether it fires. QB_SEATS_KEY=
       (empty) is how to ask for no key at all." ;;
esac

# QB_SEATS is a contract with the user's shell rc, and it is not cosmetic — on
# the machine this was written for it is the difference between a screen that
# starts and one that does not. That host's rc greeted interactive shells with an
# ANIMATION which ran until a keypress, giving up after five minutes. Every seat
# therefore sat in it for five minutes before its agent started, and the first
# key sent to a pane was consumed dismissing the greeter rather than reaching the
# agent. Both were measured, and both are exactly the "no per-seat human input"
# property this screen is supposed to deliver.
#
# So: if QB_SEATS is set, your rc file is running inside a seat pane and should
# skip anything interactive — greeters, animations, prompts, `read`. FLEET_NO_MOTD
# is set alongside it for the fleet whose rc already had an opt-out under that
# name; it is inert anywhere else.
#
# -e sets these on the SESSION, so every pane split off later inherits them.
#
# -x/-y because a detached session is 80x24, in which a 25% split is six lines and
# a fourth seat does not fit at all. tmux resizes to the client on attach, which is
# the whole reason dash_hooks exists.
#
# The knobs the seats need come from seat_env_fill — read the note there before
# changing the list or the tests that pin it.
seat_env_fill
# -P -F, because THE NAME TMUX MAKES IS NOT ALWAYS THE NAME IT WAS ASKED FOR, and
# every `-t` below addresses the session exactly (`=$SESSION`) — so a rename tmux
# does quietly turns the very next command into a fatal "no such session", with the
# session, its window and one pane already created and nothing else done. Measured
# on tmux 3.6a and 3.4, which do not even mangle the same characters:
#
#   qb-seats -s my.screen   → session `my_screen`, both versions. `.` and `:` are
#                             a target's own separators, so tmux replaces them.
#   qb-seats -s 'a\b'       → session `a\\b`, both versions: session_check_name
#                             runs the name through strvis, which escapes what it
#                             cannot print — and a backslash.
#   qb-seats -s 'a$Bb'      → kept by 3.6a, escaped to `a\\$Bb` by 3.4. THIS is what
#                             CI caught: green here, red there, on the same commit.
#
# So the created name is read back and used from here on, and tmux is the only
# authority on what it is — reimplementing its rules would be one more thing to
# keep in step with a moving target, and 3.4 versus 3.6a is exactly how that fails.
# The one thing this does NOT buy is reattaching to a renamed screen: a later
# `qb-seats -s my.screen` still looks for the name it was given, does not find it,
# and refuses on tmux's own "duplicate session: my_screen" — which at least names
# the screen it is talking about. The warning below is where a user learns it.
SESSION_ASKED=$SESSION
# BOTH halves, in one call: the id to address it by and the name to call it by.
# Asking for the id here rather than looking it up afterwards is the point — a
# lookup by name is exactly what a name carrying `.` or `:` defeats (see
# session_id). The id is the first field and the name is the rest, so a name with
# a space in it still arrives whole.
_created=$(tmux new-session -d -P -F '#{session_id} #{session_name}' -s "$SESSION" \
  -n seats -c "$REPO" -x "$WINDOW_COLS" -y "$WINDOW_ROWS" \
  -e QB_SEATS=1 -e FLEET_NO_MOTD=1 ${seat_env[@]+"${seat_env[@]}"})
# CHECKED ON THE SHAPE, not by comparing the two halves. `${_created%% *}` and
# `${_created#* }` both return the whole string when there is no space in it, so
# "they came back different" reads as "there were two fields" — except for a
# session actually named `$3`, where the two fields are genuinely equal and a
# perfectly good screen would die here as a tmux malfunction. `$` and digits is
# what a session id is, and a name has to be there after the space.
case "$_created" in
  '$'[0-9]*' '?*) ;;
  *) die "tmux did not report the new session's id and name ('$_created')" ;;
esac
SESSION_ID=${_created%% *}
SESSION=${_created#* }
[ "$SESSION" = "$SESSION_ASKED" ] \
  || warn "tmux would not take '$SESSION_ASKED' as a session name and called this
       screen '$SESSION' instead — that is the name to reattach to, and the name
       to pass to --add and --kill."

# Never a shared instance: strip any inherited value from the session
# environment, so nothing a seat spawns can pick one up. qb-seat sets its own.
tmux set-environment -t "$SESSION_ID" -r QUARTERBACK_INSTANCE

# Label the panes. Two seats are indistinguishable once both are printing, and
# being able to address ONE of them is the whole point.
tmux set-option -w -t "$SESSION_ID:seats" pane-border-status top
# @qb_label is how a pane that is NOT a seat says what it is: the option this script
# labels the dash and the tape with, and the one the dashboard marks a review pane
# with when it splits one into this row. Without the middle case every such pane is
# labelled "board", which is the one thing on this screen they are definitely not.
tmux set-option -w -t "$SESSION_ID:seats" pane-border-format \
  ' #{?@qb_seat,seat #{@qb_seat},#{?@qb_label,#{@qb_label},board}} #{?pane_active,*,} '

# What the screen is, recorded on the screen. The bar's ＋ has to run this same
# script against this same repo, and it cannot work either out from a pane: PATH
# in a run-shell is the tmux server's, and the seat panes' cwd is only the repo
# until somebody cds.
SELF=$(beside_me qb-seats)
tmux set-option -t "$SESSION_ID:" @qb_repo "$REPO"

# THE SCOPE IS RECORDED AS WELL AS FORWARDED, and the two are for different
# readers. The variable tells the seat what to call itself; this tells whatever
# reads the screen from OUTSIDE which board identity a pane holds — the dashboard
# joins `zeus/seat-lexray-1` to a tmux pane, and `@qb_repo` alone answers for the
# default scope only. Two screens on ONE repository with different scopes is the
# case the knob exists for, and it is exactly the case the repository cannot
# distinguish (#208).
#
# Only when a scope was actually given. Unset means the seats derive the default
# from their own cwd, which `@qb_repo` already says — and an explicitly EMPTY one
# is indistinguishable from unset in a tmux format, which costs nothing: an empty
# scope asks for machine-wide numbering, in which no second screen can hold the
# same seat number for a reader to confuse it with.
[ -z "${QB_SEAT_SCOPE+set}" ] \
  || tmux set-option -t "$SESSION_ID:" @qb_scope "$QB_SEAT_SCOPE"
tmux set-option -t "$SESSION_ID:" @qb_seats_bin "$SELF"

# The bar is opt-out because turning it on is not free: it takes over the status
# line, turns the mouse on (which costs shift-less text selection), and binds a
# key for the whole server. Everything it does is scoped to this session bar the
# binding, and the binding no-ops everywhere else — see install_bar.
[ "${QB_SEATS_BAR:-1}" = 0 ] || install_bar "$(beside_me qb-seat-click)"

# The key is opt-out on its own knob rather than the bar's, because the two are
# separate costs. The bar takes the status line and turns the mouse on; the key
# takes one keystroke away from whatever a seat pane would have done with it, and
# gives back everything the bar can do without the mouse. Wanting one and not the
# other is an ordinary preference in both directions.
[ -z "$QB_KEY" ] || install_key "$QB_KEY" "$(beside_me qb-seat-key)" "$SELF"

# The top line goes with the bar rather than with the key, because it is the same
# line of screen: without `status 2` there is nowhere to put it, and `status 2`
# is the bar's doing. QB_SEATS_BAR=0 therefore leaves the whole status line alone
# exactly as it says it does.
[ "${QB_SEATS_BAR:-1}" = 0 ] || install_top "$(beside_me qb-seat-top)"

# ROWS ARE BUILT, NOT CHOSEN. `select-layout tiled` picks its own arrangement
# from the window's aspect ratio — six seats in a 240x60 window come out 2 across
# and 3 down, which is the wrong axis: a seat pane wants WIDTH, because an agent
# prints prose and diffs, and it wants only enough height to see the last few
# turns. So the rows are split explicitly and evened out per row.
row_of() {                      # how many seats go in the top row
  [ "$SEATS" -le 5 ] && { printf '%s' "$SEATS"; return; }
  printf '%s' $(( (SEATS + 1) / 2 ))
}
TOP=$(row_of)

first=$(tmux list-panes -t "$SESSION_ID:seats" -F '#{pane_id}')
tmux set-option -p -t "$first" @qb_seat 1

# Split off the pane just made, not off $first: a split lands to the RIGHT of
# its target, so splitting $first every time builds 1,5,4,3,2 across the row.
# Seat numbers are how a human addresses one of these, and reading them out of
# order is a small tax paid on every glance.
i=2
last=$first
while [ "$i" -le "$TOP" ]; do   # the rest of the top row
  last=$(tmux split-window -h -P -F '#{pane_id}' -t "$last" -c "$REPO")
  tmux set-option -p -t "$last" @qb_seat "$i"
  i=$((i + 1))
done
tmux select-layout -t "$first" -E 2>/dev/null || true

if [ "$SEATS" -gt "$TOP" ]; then
  # -f: a full-width split off the top row, which is the second ROW rather than a
  # third column of the first one.
  second=$(tmux split-window -v -f -P -F '#{pane_id}' -t "$first" -c "$REPO")
  tmux set-option -p -t "$second" @qb_seat "$i"
  i=$((i + 1))
  last=$second
  while [ "$i" -le "$SEATS" ]; do
    last=$(tmux split-window -h -P -F '#{pane_id}' -t "$last" -c "$REPO")
    tmux set-option -p -t "$last" @qb_seat "$i"
    i=$((i + 1))
  done
  tmux select-layout -t "$second" -E 2>/dev/null || true
fi
[ "$SEATS" -le 5 ] && tmux select-layout -t "$SESSION_ID:seats" even-horizontal

# The dash, down the right. AFTER the select-layout calls above and BEFORE the
# tape below, and both halves of that matter:
#
#   * after the layouts, because `select-layout` re-equalises every pane in what
#     it spreads — a dash placed first comes back out at whatever width an even
#     split gives it, which is the bug the dev scaffolding recorded finding twice.
#   * before the tape, so the tape's -f split takes its strip from the bottom of
#     the whole window and the dash ends up ABOVE it rather than beside it. The
#     dash answers "what is true now" for the screen, not for the seat row, so it
#     spans both rows when there are two.
#
# -f for the same reason the tape uses it: full height of the WINDOW, not a split
# of the pane it was taken from.
#
# The command is typed in later, with the seats, rather than one line after this
# split — see there. And it is typed rather than being the pane's own command,
# exactly as start_seat does it: if the dash exits or you Ctrl-C it you get a prompt
# in the pane, instead of the pane vanishing and the screen quietly losing a
# quarter of itself.
DASH_CMD=$(dash_cmd)
dash=""
if [ -n "$DASH_CMD" ]; then
  # Tolerated rather than fatal. This is a command substitution under `set -e`, and
  # the seats and the session already exist by now: a screen with no dash and a
  # line saying why beats dying half-built, on a tmux error, with a session name
  # that then makes the obvious rerun fail too.
  if ! dash=$(tmux split-window -h -f -l "$DASH_SIZE" -P -F '#{pane_id}' \
                -t "$SESSION_ID:seats" -c "$REPO"); then
    warn "no dash: the pane could not be split off at $DASH_SIZE columns"
    DASH_CMD=""
    dash=""
  else
    tmux set-option -p -t "$dash" @qb_label dash
    # What this screen asked for, recorded ON THE PANE. --add, qb-seat-click and the
    # resize hooks all reassert this width, and every one of them would otherwise
    # have to re-derive it from an environment that need not be the one the screen
    # was built in — so `QB_SEATS_DASH_SIZE=120 qb-seats` followed by a plain
    # `qb-seats --add` would put the dash back to the default nobody asked for.
    # QB_SEATS_DASH_SIZE is read exactly once, here.
    tmux set-option -p -t "$dash" @qb_dash_width "$DASH_SIZE"
  fi
fi

# The tape, on the same screen as the seats — full width along the bottom, so
# long summaries are read rather than wrapped. -f makes the split span the whole
# window rather than only the pane it was taken from. It drops to a shell rather
# than closing if the follower dies, so a board outage does not silently leave a
# screen with no board on it.
tape=$(tmux split-window -v -f -l "$BOARD_SIZE" -P -F '#{pane_id}' \
  -t "$first" -c "$REPO" "$(printf '%s; exec %q -i' "$(board_cmd)" "$SH")")

# Everything here exists only because the dash does, so it is one condition tested
# once rather than three that a reader has to check are still the same one.
if [ -n "$DASH_CMD" ]; then
  # Only name it 'tape' when there is a dash to tell it apart FROM. On a screen
  # with one auxiliary pane the border has said 'board' since this script existed,
  # and renaming it for everybody to solve a problem only the two-pane screen has
  # would be a gratuitous break — pane-border-format's fallback already prints
  # 'board'.
  tmux set-option -p -t "$tape" @qb_label tape
  # The hooks first, because they are the ones that survive this script: the window
  # is WINDOW_COLS x WINDOW_ROWS until a client attaches, and it is the ATTACH that
  # redistributes the row the dash is in. See dash_hooks.
  dash_hooks "$SELF"
  # Then once here, for the width a detached screen reports and for the case that
  # never attaches at all — a screen built by a script or a unit, read over ssh
  # later.
  dash_resize
fi

# The commands go in last, once every pane exists and its shell has had the time it
# took to build the rest of the screen to reach a prompt. The dash is typed here
# rather than beside its own split for exactly that reason: keystrokes sent into a
# pane whose shell has not started wait in the pty, but an rc file that reads stdin
# before its prompt eats them — see QB_SEATS above — and the dash is the one pane
# whose loss is silent, because an empty pane under a border reading 'dash' looks
# like a dashboard that has not drawn yet.
[ -z "$DASH_CMD" ] || type_into "$dash" "$DASH_CMD"
while read -r pane n; do start_seat "$pane" "$n"; done < <(seat_panes)

# awk rather than `head -1`, which would close the pipe under `set -o pipefail`
# and abort the script on SIGPIPE just as the screen finished building.
tmux select-pane -t "$(seat_panes | awk 'NR == 1 { print $1 }')"

if [ "$STAGED" -eq 1 ]; then
  printf '%s: %s seat(s) staged in %s — press Enter in each pane to start it\n' \
    "$PROG" "$SEATS" "$SESSION"
fi

attach

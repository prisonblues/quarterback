# shellcheck shell=bash
# quarterback site configuration — SOURCED by qb, qb-mcp and qb-hook. Not executable.
#
# WHY THIS EXISTS. The three wrappers used to bake one deployment into themselves:
# `${QUARTERBACK_BASE_URL:-https://qb.fo.ls}` for the URL and a hardwired 1Password
# read for the token. The case that forced the change was a fleet running two
# deliberately disjoint boards — a personal one and a second on an employer-owned
# island — where `qb.fo.ls` was reachable from both, so an unset variable on the
# employer's machine meant "quietly talk to the personal board".
#
# THAT FLEET NOW RUNS ONE BOARD AGAIN, and this file is unchanged by it, which is
# the point worth recording. The rule was never "there are two boards"; it is that a
# machine must be TOLD which board it belongs to. A default is a guess about
# deployment topology, and it is equally wrong when it happens to guess right — it
# just stops being visibly wrong. Anyone reading this after the second board went
# away should not conclude the default can come back.
#
# What varies per site is no longer only the URL. It is the TOKEN SOURCE too, which
# is why that is a command: one site reads a cache a boot-time hydrator wrote, and
# another reads a file a human copied there and has nothing behind it to re-fetch
# from. Both are served by the same contract below.
#
# The published MCP server already got this right; mcp/mcp_server/server.py says of
# its own base URL: "No default: the board is self-hosted, so there is no sensible
# URL to fall back to. Guessing one would silently point an agent at someone else's
# board." These wrappers now agree with it. Unset is an ERROR, never a guess.
#
# THE CONTRACT. A per-host config file, rendered by home-manager (see home/scripts.nix):
#
#   QUARTERBACK_BASE_URL   the board this machine talks to. Required; no default.
#   QUARTERBACK_TOKEN_CMD  a command printing this machine's bearer on stdout. This
#                          is what makes the token source per-site: a boot-hydrated
#                          cache on a host with a vault sidecar, a plain file a human
#                          dropped on one without. Kept cheap — it runs on every call.
#   QUARTERBACK_TOKEN_REFRESH_CMD
#                          optional; used INSTEAD of TOKEN_CMD after a confirmed 401.
#                          It exists because the two are not always the same command:
#                          where TOKEN_CMD reads a cache, re-running it after a
#                          rotation just returns the same stale bearer, so the refresh
#                          has to go past the cache to the source of truth. Defaults
#                          to TOKEN_CMD, which is right wherever that already reads
#                          the authoritative copy — including a site whose bearer is a
#                          file a human maintains. There the 401 re-reads that file:
#                          unchanged, and the refresh reports failure, which is
#                          correct because there is nothing new to present; re-dropped
#                          since the session started, and the new value is picked up in
#                          place with no restart. So "cannot be re-minted without a
#                          human" is the real limit, NOT "cannot be refreshed" — and
#                          leaving this unset is how you ask for that behaviour.
#   QUARTERBACK_REPO       checkout holding mcp/ (for qb-mcp's venv).
#   QUARTERBACK_AGENT      this machine's name in the token file. Defaults to hostname.
#   QUARTERBACK_HUMAN_URL  optional; the BROWSER vhost, where a person is authenticated at
#                          the edge. Read only by `qb-doctor`, which uses it to ask whether
#                          human writes actually work (#204). Deliberately separate from
#                          BASE_URL and deliberately without a default, for the same reason
#                          BASE_URL has none: the two hostnames proxy to the same container
#                          on this fleet and to nothing at all on a single-host deployment,
#                          so deriving one from the other would send a probe somewhere
#                          nobody asked for. Nothing renders it yet — home/scripts.nix
#                          writes the five above — so until it does, `qb-doctor` takes it
#                          from the environment or `--human-url`, and reports the row as
#                          "could not check" rather than as a pass when it has neither.
#   QUARTERBACK_ELEVATED_TOKEN[_CMD]  optional; this machine's DELEGATED credential
#                          (quarterback #478), presented as X-Agent-Elevated beside the
#                          bearer. It authorises exactly two plan writes for an agent
#                          that keeps its own identity — NOT a way to be a person, and
#                          everything else app.auth.human gates stays shut to it. Same
#                          value-or-command shape as QUARTERBACK_TOKEN, and resolved the
#                          same way; unset means those two tools refuse and say so.
#
# Environment beats the config file for the two things resolved through a function —
# QUARTERBACK_TOKEN short-circuits qb_resolve_token, and an explicit QUARTERBACK_AGENT
# is passed through untouched.
#
# IT DOES NOT for the plain assignments. qb_load_config sources the config file, and a
# `VAR=value` line in a sourced file overwrites whatever the caller exported — so
# `QUARTERBACK_BASE_URL=... qb ...` is silently ignored on any host that has a config,
# which is every host that works at all. Measured, not inferred.
#
# Left as-is rather than fixed in a docs change, because the fix is a behaviour change
# to every consumer and wants its own decision: the config would have to assign only
# into unset variables (`: "${VAR:=...}"`), and that flips which side wins for anyone
# currently relying on the file. Recorded here so the next person to try an
# override knows it is the code that is wrong and not their shell.

QB_CONFIG="${QUARTERBACK_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/quarterback/config}"

qb_load_config() {
  # shellcheck disable=SC1090
  [ -r "$QB_CONFIG" ] && . "$QB_CONFIG"
  # `hostname` FIRST, so no host that has it sees its machine name change — that name
  # is the board identity, the `quarterback-<host>` vault item and the ELEVATED_TOKENS
  # key, and a derivation that shifted it would break all three at once.
  #
  # The fallbacks are new because the old pair could not do what it looked like it did:
  # BOTH arms called `hostname`, so `2>/dev/null ||` bought nothing when the binary was
  # simply ABSENT rather than failing. Then this expanded to empty, and an empty agent
  # name is not an error anywhere — it silently becomes `quarterback-` in every `op://`
  # reference built from it (#556). A nix check sandbox has no `hostname`; so, in
  # principle, does a stripped-down host's thin PATH.
  #
  # `uname -n` is coreutils and `/etc/hostname` is a file, so between them there is
  # somewhere to read on any box this script can run on at all.
  if [ -z "${QUARTERBACK_AGENT:-}" ]; then
    QUARTERBACK_AGENT="$(hostname -s 2>/dev/null || uname -n 2>/dev/null \
                         || cat /etc/hostname 2>/dev/null)"
    # Short name only, and only on the DEFAULT path: `uname -n` and `/etc/hostname` can
    # carry a domain where `hostname -s` never does, and the board's machine names are
    # bare. An explicitly set QUARTERBACK_AGENT is passed through untouched — it is
    # somebody naming a machine, not this function guessing one.
    QUARTERBACK_AGENT="${QUARTERBACK_AGENT%%.*}"
  fi
  return 0
}

# Hard-fail rather than guess. Callers that must never break a session (qb-hook)
# check the variable themselves and no-op instead of calling this.
qb_require_base_url() {
  [ -n "${QUARTERBACK_BASE_URL:-}" ] && return 0
  cat >&2 <<EOF
${0##*/}: QUARTERBACK_BASE_URL is not set and there is no default.

  This machine has not been told which quarterback board it belongs to. There is
  deliberately no fallback: guessing would point this agent at another island's
  board. Set it in $QB_CONFIG (rendered per-host by home-manager).
EOF
  return 1
}

# Token resolution, in precedence order. QUARTERBACK_TOKEN_CMD is the per-site hook;
# the /run/op-secrets path is the pre-config fleet layout, kept so a host that has
# not been rebuilt yet still works.
qb_resolve_token() {
  [ -n "${QUARTERBACK_TOKEN:-}" ] && return 0
  if [ -n "${QUARTERBACK_TOKEN_CMD:-}" ]; then
    QUARTERBACK_TOKEN="$(eval "$QUARTERBACK_TOKEN_CMD" 2>/dev/null)" || QUARTERBACK_TOKEN=""
    QUARTERBACK_TOKEN="${QUARTERBACK_TOKEN%%$'\n'*}"
    [ -n "$QUARTERBACK_TOKEN" ] && { export QUARTERBACK_TOKEN; return 0; }
  fi
  if [ -r /run/op-secrets/quarterback-token ]; then
    QUARTERBACK_TOKEN="$(cat /run/op-secrets/quarterback-token 2>/dev/null)"
    [ -n "$QUARTERBACK_TOKEN" ] && { export QUARTERBACK_TOKEN; return 0; }
  fi
  return 1
}

# Re-mint after a confirmed 401 — the generic form of what used to be an inline
# `op read`. A site whose tokens cannot be re-fetched simply leaves TOKEN_CMD unset
# and this is a no-op, which is the honest outcome rather than a fake success.
qb_refresh_token() {
  local cmd="${QUARTERBACK_TOKEN_REFRESH_CMD:-${QUARTERBACK_TOKEN_CMD:-}}"
  [ -n "$cmd" ] || return 1
  local fresh
  fresh="$(eval "$cmd" 2>/dev/null)" || return 1
  fresh="${fresh%%$'\n'*}"
  [ -n "$fresh" ] && [ "$fresh" != "${QUARTERBACK_TOKEN:-}" ] || return 1
  QUARTERBACK_TOKEN="$fresh"; export QUARTERBACK_TOKEN
  return 0
}

# The name an operator asked this agent to answer to, printed on stdout, or
# nothing. Sourced by both clients that talk HTTP — `qb` and `qb-hook` — so there
# is exactly ONE place in the shell that decides what an agent is called.
#
# WHY IT EXISTS (#156). Since v2.12 the board DESIGNATES the name half of an
# identity: `X-Agent-Instance` is an opaque KEY, and `zeus/glacier-amber` is the
# spelling every peer sees. `X-Agent-Name` is the one way to ask for something
# typeable instead — it has worked server-side since v2.12 and no client sent it,
# so `QUARTERBACK_INSTANCE=deploy` named nothing at all. It keyed a two-word
# allocation and survived only as an alias nobody is shown.
#
# ONLY FROM AN EXPLICIT QUARTERBACK_INSTANCE, which is why this reads the variable
# itself rather than taking the caller's already-derived instance. That instance
# falls back to the session-id prefix — a hex fragment — and asking for THAT as a
# name would put `zeus/a4f81c2e` back on every status bar in the fleet, which is
# the exact thing moving naming server-side existed to stop.
#
# ITS OWN SANITISER, not the key's. The board's name shape is stricter than its key
# shape: `^[a-z0-9]+(?:-[a-z0-9]+)*$`, lower case, no `.`, `_` or `~`. So `Deploy_1`
# is a perfectly good key and a 400 as a name — and both callers swallow a 400 in
# silence, `qb-hook` by contract. A label that sanitises away to nothing (`___`)
# asks for no name at all rather than for `-`.
qb_requested_name() {
  local n="${QUARTERBACK_INSTANCE:-}"
  [ -n "$n" ] || return 0
  # Truncate before the final trim: cutting to the board's 40 can itself leave the
  # trailing hyphen that the shape forbids.
  n=$(printf '%s' "$n" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' \
      | sed -E 's/-+/-/g; s/^-//; s/-$//' | cut -c1-40 | sed -E 's/-$//')
  [ -n "$n" ] && printf '%s' "$n"
  return 0
}

# ---- the pane: one CLI process, however many conversations (#146) ------------
#
# A `/clear` does not restart the Claude Code CLI. It mints a NEW conversation id
# inside the SAME process — measured 2026-09-06: pid 352423 ran `4c8f6a8a…` from
# 13:24 and `e267ef87…` from 16:36:59 without ever exec'ing again. Every process
# Claude Code spawns is given the CURRENT conversation's id, so `qb-hook` (a fresh
# process per event) is always right; `qb-mcp` is the one process that is spawned
# ONCE and so keeps answering with a conversation that may have ended hours ago.
#
# The PANE is what the two halves need in common: a name for the CLI process,
# derivable by both, that a clear does not move. `CLAUDE_CODE_MESSAGING_SOCKET` is
# it — `/run/user/<uid>/cc-socks/<cli pid>.sock`, created when the CLI starts and
# unchanged across a conversation switch 25 hours later. The hook writes the
# current conversation to a file named after the pane; the MCP server reads that
# file per call instead of trusting the environment it was spawned with.
#
# TWO GUARDS, and both are load-bearing.
#
# 1. OWNERSHIP. A process may hold a socket variable it did not earn: a shell a
#    dead CLI left behind still carries the dead CLI's. So the pane is ours only
#    if the pid the socket is named for is BOTH alive AND an ancestor of us —
#    measured, a live process here carries `3524155.sock` for a pid that is dead
#    and not in its ancestry, and it must decline. A nested `claude -p` does NOT
#    need this guard as it turns out (measured: the CLI exports its own
#    `<pid>.sock` to everything it spawns, overriding the one it inherited, so a
#    nested agent's hook and MCP server already compute their own pane) — but the
#    guard costs one /proc walk and it is what keeps a process holding somebody
#    else's socket from speaking for somebody else's pane.
#
#    NOTE FOR THE NEXT PERSON: the ownership question is about the SOCKET, and
#    there is no environment variable that answers "am I a sub-agent".
#    `CLAUDE_CODE_CHILD_SESSION` looks like one and is not — it is set on every
#    hook Claude Code runs, on a top-level session with no parent at all
#    (measured 2026-09-06, 2.1.258, with the whole parent environment stripped).
#    A guard on it refuses everything. What protects a Task sub-agent's parent is
#    in `_supersede_previous` in `qb-hook`, and it is that a sub-agent fires no
#    SessionStart and would carry the parent's session id if it did.
#
# 2. RECENCY. Pids are recycled and `$XDG_RUNTIME_DIR` is not swept, so
#    `qb-pane-<pid>` could be a file a previous CLI at the same pid left behind.
#    The socket's mtime goes in the KEY rather than being compared against
#    anything: a stale file simply has a different name and is never found.
#
# THIS IS ONE OF TWO IMPLEMENTATIONS — `mcp/mcp_server/pane.py` is the other, and
# they are pinned against each other over a shared table by
# `harness/tests/test_pane_parity.py`. That test is not decoration. The previous
# attempt at this (PR #765) shipped two slug implementations that disagreed about
# trailing whitespace and about byte-vs-character classes; the hook wrote one
# filename and the server read another, so the mechanism was a silent no-op with
# a green suite. Every rule below is written to be spellable identically in both
# languages — string comparison rather than integer, `[0-9]` rather than `\d`,
# a full-string match rather than one anchored with `$` (which in Python also
# matches before a trailing newline) — and any new rule needs a row in that table.

qb_pane_ppid() {   # qb_pane_ppid <pid>: that process's parent pid, or nothing
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
  # `comm` is parenthesised and may itself contain spaces and parens, so the
  # fields are unambiguous only after the LAST ") ". Same rule in pane.py.
  s=${s##*") "}
  # shellcheck disable=SC2086  # deliberate word splitting: these are stat fields
  set -- $s
  [ $# -ge 2 ] && printf '%s' "$2"
  return 0
}

qb_pane_key() {   # echo <cli pid>-<socket mtime>, or nothing if we own no pane
  local sock base owner mtime p hops
  sock="${CLAUDE_CODE_MESSAGING_SOCKET:-}"
  [ -n "$sock" ] || return 0
  base=${sock##*/}
  case "$base" in *.sock) ;; *) return 0 ;; esac
  owner=${base%.sock}
  case "$owner" in ''|*[!0-9]*) return 0 ;; esac
  mtime=$(stat -c %Y "$sock" 2>/dev/null) || return 0
  case "$mtime" in ''|*[!0-9]*) return 0 ;; esac
  [ -d "/proc/$owner" ] || return 0
  # Compared as STRINGS, never as numbers: `0123` and `123` are different panes
  # here and in pane.py, rather than the same one on whichever side happens to
  # parse an integer.
  p=$$; hops=0
  while [ -n "$p" ] && [ "$p" != "0" ] && [ "$hops" -lt 64 ]; do
    [ "$p" = "$owner" ] && { printf '%s-%s' "$owner" "$mtime"; return 0; }
    p=$(qb_pane_ppid "$p")
    hops=$((hops + 1))
  done
  return 0
}

qb_pane_file() {   # echo the file holding this pane's current conversation
  local k
  k=$(qb_pane_key)
  [ -n "$k" ] || return 0
  printf '%s/qb-pane-%s' "${XDG_RUNTIME_DIR:-/tmp}" "$k"
  return 0
}

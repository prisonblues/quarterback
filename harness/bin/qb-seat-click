#!/usr/bin/env bash
# qb-seat-click — what a click on the seat bar does.
#
# Usage: qb-seat-click [RANGE [SESSION]]   both default to what the click stashed
#
# Exit codes:
#   0  the click was handled, or was for something this does not act on
#   1  not inside tmux, or the screen the click named is gone, or the seat it
#      named no longer has a pane
#   2  malformed arguments — a caller bug, and says so
#
# WHY A SCRIPT AND NOT A KEY BINDING. tmux hands every status-line click to one
# binding, `MouseDown1Status`, and the only thing distinguishing an ✕ from a ＋
# is `#{mouse_status_range}` — a string. Branching on a string is a shell's job;
# doing it in nested `if-shell` would put three levels of tmux quoting into
# qb-seats for logic that is four cases long. It is also the only part of the
# seat bar that can be tested without a terminal: pass it a range, then look at
# what happened to the panes.
#
# WHY IT READS OPTIONS AND NOT ONLY ARGUMENTS. The kill path goes through
# `confirm-before`, and the command confirm-before runs afterwards has lost the
# mouse event — `#{mouse_status_range}` expands to nothing inside it. So the
# binding stashes the range in the server option @qb_click while the event is
# still live, and this reads it back. The argument form is for tests and for
# anyone driving it by hand.
#
# THE SESSION IS STASHED FOR A SEPARATE REASON, and it is the one that cost the
# most to find: `run-shell` from a MOUSE BINDING gets no $TMUX_PANE. From the
# command line it does, which is what makes this so quiet — the script works by
# hand, works when driven by a test, and does nothing at all when clicked, with
# no error anywhere, because run-shell -b throws its output away. So the binding
# records #{session_name} too, and nothing here infers a target from "wherever
# the cursor happens to be".
#
# WHY THE BAR AND NOT THE PANE BORDER. The border is the obvious place to want
# an ✕, and it cannot work. Measured on tmux 3.6a, not read off the manual:
#
#   * `#[range=...]` is documented for status-format and is honoured nowhere
#     else. In pane-border-format it renders away cleanly and registers nothing.
#   * A click on an inner border does fire `MouseDown1Border` — but #{mouse_x}
#     and #{mouse_y} come back EMPTY, so there is no way to tell which glyph on
#     the border was hit.
#   * That event also reports the pane above the border rather than the pane
#     whose title is drawn on it.
#   * A click on the TOPMOST border row — which is exactly where this screen
#     draws seat 1's title — fires nothing at all.
#
# The status line is the only surface in tmux that can carry a clickable widget.
set -euo pipefail

PROG=${0##*/}

# On the screen as well as on stderr, because stderr is nowhere. The bar reaches
# this through `run-shell -b`, which discards both streams — so every failure
# below used to present as the button doing nothing at all, which is the worst
# way for a button to fail and exactly how the ＋ was reported broken.
die() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  if [ -n "${TMUX:-}" ]; then tmux display-message "$PROG: $*" 2>/dev/null || true; fi
  exit 1
}

[ $# -le 2 ] || { printf 'usage: %s [RANGE [SESSION]]\n' "$PROG" >&2; exit 2; }
[ -n "${TMUX:-}" ] || die "not inside tmux"

# Both stashes are SERVER options rather than session ones, because the binding
# that writes them is server-wide too and one click is in flight at a time —
# confirm-before holds the client's input while its prompt is up, so a second
# click cannot arrive and move the target out from under the first.
range=${1:-$(tmux show-options -s -v @qb_click 2>/dev/null || true)}
[ -n "$range" ] || exit 0
session=${2:-$(tmux show-options -s -v @qb_click_session 2>/dev/null || true)}
[ -n "$session" ] || die "no session recorded for the click"

# THE ID, NEVER THE NAME, IS WHAT A `-t` GETS — the same rule qb-seats states at
# length beside its own `session_id`, and every button on this bar needed it too.
# `.` and `:` are a target's own separators; tmux 3.7b keeps them in a session name
# verbatim, so `-t "=my.screen"` parses as pane `screen` of session `my` and comes
# back "can't find pane: screen". Measured on 3.7b, against a screen that plainly
# exists:
#
#     $ tmux list-panes -s -t '=my.screen'
#     can't find pane: screen
#     $ tmux list-panes -s -t '$0'
#     %0
#
# Every widget here — the seat cell, the ✕ and the ＋ — went through one of those
# targets, and this is the worst place on the screen for it: the bar reaches this
# script through `run-shell -b`, which discards both streams, so the whole bar
# would simply stop responding with nothing said anywhere.
#
# THE STASH STAYS A NAME and is resolved here. `#{session_name}` is what the
# binding records, it is what `qb-seats --add -s` takes, and it is what the tests
# and anyone driving this by hand pass — so the name is the argument and the id is
# derived from it, once, rather than a second thing for the binding to keep in
# sync.
#
# Read off `list-sessions` rather than looked up with `-t`, because a lookup BY
# name is the very thing that cannot be trusted here; and split by hand rather than
# with `IFS=' ' read -r id nm`, because `read` strips trailing IFS whitespace from
# the last field and a session tmux happily calls `mine ` would never compare equal
# to what the caller asked for.
session_id() {
  local line
  tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null \
    | while IFS= read -r line; do
        # `if`, NOT `[ … ] && printf`. A `&&` whose test fails is the last
        # command in the loop body, so the `while` exits 1 whenever the session
        # being looked for is not the LAST one listed — and under `pipefail` that
        # is the pipeline's status, and so the command substitution's. A caller
        # spelling `sid=$(session_id x) || sid=""` then discarded the id it had
        # just been given: measured as a second screen on one server reporting
        # "no screen named 'one' is up" about a screen tmux was listing.
        if [ "${line#* }" = "$1" ]; then printf '%s\n' "${line%% *}"; fi
      done
}

# Resolved on demand, not up front: a range this script does not own exits 0 below
# without touching tmux, and a stale @qb_click_session left behind by a screen that
# has since been killed must not turn that into a failure.
sid=""
need_sid() {
  [ -n "$sid" ] && return 0
  sid=$(session_id "$session") || sid=""
  [ -n "$sid" ] || die "no screen named '$session' is up"
  return 0
}

# Seats are found by pane option, never by index: the index shifts the moment a
# pane is added or closed, which is precisely what this script does.
#
# `$2 != ""` is not tidiness. The BOARD pane has no @qb_seat, so its line is one
# field and awk's $2 is the empty string — which compares equal to the seat
# number extracted from a malformed range like a bare `kill`. Without it,
# `qb-seat-click kill` closes the board pane. The test suite found that, not a
# careful reading.
seat_pane() {
  tmux list-panes -s -t "$sid" -F '#{pane_id} #{@qb_seat}' \
    | awk -v want="$1" '$2 != "" && $2 == want { print $1; exit }'
}

# A range this script owns names a seat by number, and nothing else. Anything
# else is a widget belonging to somebody's status line, not to us — the binding
# is server-wide and will hand us those.
seat_number() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) printf '%s' "$1" ;;
  esac
}

# A seat row that has just lost a pane leaves a gap. -E spreads the closed
# pane's neighbours into it — the same call --add uses, and for the same reason:
# the board was split off full-width, so even-horizontal on the whole window
# would fold it back into the row.
#
# THE DASH IS IN THAT ROW, so -E re-equalises it along with the seats: without the
# two lines below, closing a seat narrows the dashboard exactly the way an --add
# used to, and clicking three ✕s in a row leaves a dash nobody chose the width of.
# So its width is read first and put back afterwards. Nothing about the WINDOW
# changed here, so the width it has right now is the right answer — including one
# the user set by dragging the border. qb-seats' own dash_resize is the same
# reassert with a clamp against a window that HAS changed size; this path does not
# need the clamp, because a width that fitted a second ago still fits.
reflow() {
  local survivor dash was=""
  survivor=$(tmux list-panes -s -t "$sid" -F '#{pane_id} #{@qb_seat}' \
    | awk '$2 != "" { print $1; exit }')
  [ -n "$survivor" ] || return 0
  dash=$(tmux list-panes -s -t "$sid" -F '#{pane_id} #{@qb_label}' \
    | awk '$2 == "dash" { print $1; exit }')
  [ -z "$dash" ] || was=$(tmux display-message -p -t "$dash" '#{pane_width}')
  tmux select-layout -t "$survivor" -E 2>/dev/null || true
  # Tolerated, not silenced: a refused resize leaves the dash a little narrow,
  # which is not worth failing a ✕ that has already closed the pane it was asked to.
  [ -z "$dash" ] || tmux resize-pane -t "$dash" -x "$was" || true
}

# TELL THE BOARD BEFORE THE PANE GOES (#277). A `kill-pane` SIGHUPs the agent,
# and Claude Code's SessionEnd hook is not documented to survive that — so a ✕
# used to leave the board holding a live lease and every claim that session had
# taken, for the rest of their TTL. Nothing was wrong with the pane; it just was
# not there any more, and an expired lease cannot say that: "nobody renewed" is
# the same row as an agent thinking hard for half an hour.
#
# The pane knows which session it holds because `qb-hook` stamps it at
# SessionStart. That stamp is the thing #266 records as missing — "nothing stamps
# a pane with its session id, so a plain local session is not locatable at all" —
# and it is what makes a fleet view able to act on a row rather than only describe
# it.
#
# BEST EFFORT, ALWAYS. A ✕ closes the pane whether or not the board hears about
# it: no stamp, no qb-end, no board, a refusal — every one of those falls through
# to the kill below. `timeout` bounds the wait, because the alternative to a
# button that reports nothing is a button that hangs for half a minute on a board
# that is down, and of those two the silent one is right.
end_agent() {   # end_agent <pane id> — best effort, never fails, never blocks long
  local sess bin
  sess=$(tmux show-options -p -t "$1" -v @qb_session 2>/dev/null) || sess=""
  [ -n "$sess" ] || return 0
  # PATH first so an installed copy beats a checkout, then this script's own
  # directory — the same order and the same reason as qb-seats' SELF resolution.
  # A run-shell from a mouse binding inherits the tmux SERVER's PATH, which
  # usually predates anything that put this harness on one.
  bin=$(command -v qb-end 2>/dev/null) || bin="$(dirname -- "$0")/qb-end"
  [ -x "$bin" ] || return 0
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 "$bin" "$sess" --reason killed --quiet || true
  else
    "$bin" "$sess" --reason killed --quiet || true
  fi
  return 0
}

case "$range" in
  seat*)
    n=$(seat_number "${range#seat}") || exit 0
    need_sid
    pane=$(seat_pane "$n")
    [ -n "$pane" ] || die "seat $n has no pane"
    # The window too: the bar stays on screen when another window is current, so
    # the cell you clicked may name a seat that is not being displayed.
    tmux select-window -t "$pane"
    tmux select-pane -t "$pane"
    ;;
  kill*)
    # The confirmation already happened, in the binding — see the header.
    n=$(seat_number "${range#kill}") || exit 0
    need_sid
    pane=$(seat_pane "$n")
    [ -n "$pane" ] || die "seat $n has no pane"
    end_agent "$pane"
    tmux kill-pane -t "$pane"
    reflow
    ;;
  expand)
    # THE ⛶ ON THE TOP LINE, and it does not implement anything: the dash's verbs
    # live in qb-seat-key and this hands over to it, which is the same delegation
    # the `a`, `x` and digit keys make in the other direction. Two copies of
    # "break the dash out and record the widths to put it back with" is two places
    # for the geometry lore to drift, and the drift shows up as a screen nobody
    # chose the shape of.
    #
    # WHICH COPY of qb-seat-key is read off the session, for dash_hooks' reason
    # one surface along: a binding fires with the tmux SERVER's PATH, and the
    # server usually predates whatever put this harness on one. @qb_key_bin is
    # what the screen was built with, so a rollout where PATH's harness and a
    # checkout disagree still reaches the copy this screen belongs to.
    need_sid
    key=$(tmux show-options -v -t "$sid:" @qb_key_bin 2>/dev/null || true)
    [ -n "$key" ] || key=$(command -v qb-seat-key 2>/dev/null || true)
    [ -n "$key" ] || die "qb-seat-key is not on PATH and the session did not record it"
    # Its stderr is captured and re-reported rather than left in the hole
    # `run-shell -b` discards both streams into: an expand that refused for a good
    # reason — a hidden dash, a screen with no dash at all — would otherwise look
    # exactly like a button that is not wired up.
    if ! why=$("$key" expand "$session" 2>&1 >/dev/null); then
      die "${why:-qb-seat-key expand failed}"
    fi
    ;;
  add)
    # --add works out the next seat number itself, and deliberately does not
    # reuse the number of a seat that was closed: the board would read the new
    # agent as the old one coming back.
    #
    # The path is read off the session because a tmux server usually predates
    # the screen running in it, and its PATH is whatever started it — which is
    # the same class of bug as the seat_env forwarding in qb-seats.
    need_sid
    seats=$(tmux show-options -v -t "$sid:" @qb_seats_bin 2>/dev/null || true)
    [ -n "$seats" ] || seats=$(command -v qb-seats 2>/dev/null || true)
    [ -n "$seats" ] || die "qb-seats is not on PATH and the session did not record it"
    repo=$(tmux show-options -v -t "$sid:" @qb_repo 2>/dev/null || true)
    [ -n "$repo" ] || repo=$(tmux display-message -p -t "$sid:" '#{pane_current_path}')
    # Its stderr is captured and re-reported rather than left to fall into the
    # same hole this script's own does: run-shell -b discards it, so a --add
    # that refused for a good reason looked identical to a button that is not
    # wired up.
    if ! why=$("$seats" --add -s "$session" -C "$repo" 2>&1 >/dev/null); then
      die "${why:-qb-seats --add failed}"
    fi
    ;;
  *) exit 0 ;;
esac

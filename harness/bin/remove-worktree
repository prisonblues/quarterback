#!/usr/bin/env bash
set +e  # Don't exit on errors — try all cleanup steps

# Generic Worktree Removal Script
# Usage: remove-worktree [options] <branch-name>
#
# Options:
#   --config <path>      Config file path (default: .worktree.json in repo root)
#   --keep-branch        Don't delete the git branch
#   --keep-db            Don't drop the isolated database
#   --force              Tear down even if another live agent holds the worktree,
#                        or the branch carries commits its PR never took
#   --keep-claim         Don't hand back the board claim on the issue this
#                        worktree's branch names (#337)
#   --no-backup          Don't archive the tree's dirty and ignored files first.
#                        The escape hatch for a backup that cannot succeed (no
#                        disk, an unarchivable file) — without it, a failing
#                        backup makes the worktree permanently un-removable,
#                        because the failure aborts the teardown (#743)
#   --require-lock       Refuse unless the occupancy check gives a DEFINITE
#                        answer. For unattended callers — see the header on
#                        holder_check (#743)

# ============================================
# COLORS & HELPERS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

die() { echo -e "${RED}Error: $1${NC}" >&2; exit 1; }

# Steps that fail non-fatally record here instead of printing a yellow note and
# being forgotten. The old behaviour ended every run with an unconditional
# "Cleanup complete", so a database that was never dropped looked like a clean
# teardown — which is exactly how five orphans accumulated unnoticed.
CLEANUP_WARNINGS=()
warn_cleanup() {
    CLEANUP_WARNINGS+=("$1")
    echo -e "${YELLOW}$1${NC}"
}

env_val() {
    local var="$1" file="$2"
    [[ -f "$file" ]] || return 0
    local line
    line=$(grep "^[[:space:]]*${var}[[:space:]]*=" "$file" 2>/dev/null | head -1 || true)
    [[ -z "$line" ]] && return 0
    local val="${line#*=}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
    elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
    if [[ "$val" != *"://"* ]]; then val="${val%%[[:space:]]#*}"; fi
    echo "$val"
}

db_url_user() { echo "$1" | sed 's|.*://\([^:]*\):.*|\1|'; }

cfg() {
    local key="$1"
    local default="${2:-}"
    if [[ -n "$CONFIG_JSON" ]]; then
        if echo "$CONFIG_JSON" | jq -e "$key != null" >/dev/null 2>&1; then
            echo "$CONFIG_JSON" | jq -r "$key" 2>/dev/null
            return
        fi
    fi
    echo "$default"
}

detect_project_name() {
    local root="$1"
    if [[ -f "$root/pyproject.toml" ]]; then
        local name
        name=$(grep -E '^name[[:space:]]*=' "$root/pyproject.toml" | head -1 | sed 's/.*=[[:space:]]*"\(.*\)".*/\1/' 2>/dev/null)
        [[ -n "$name" ]] && echo "$name" && return
    fi
    if [[ -f "$root/package.json" ]]; then
        local name
        name=$(jq -r '.name // empty' "$root/package.json" 2>/dev/null)
        [[ -n "$name" ]] && echo "$name" && return
    fi
    basename "$root"
}

# Every running container that looks like a Postgres, most-plausible first.
# Deliberately NOT `| head -1`: on a machine also running self-hosted CI, that
# picked an ephemeral `<hex>_postgres16_<hex>` runner service over the project's
# own container. The existence probe then failed against the wrong server and
# printed "Database <name> not found" — a false negative that reads as "already
# clean", so five worktree databases survived a teardown that reported success.
postgres_container_candidates() {
    local names
    names=$(docker ps --format '{{.Names}}' 2>/dev/null || true)
    grep -iE 'postgres|pgdb|_db' <<<"$names" | grep -vE '^[0-9a-f]{16,}_' || true
    grep -iE 'postgres|pgdb|_db' <<<"$names" | grep -E '^[0-9a-f]{16,}_' || true
}

# Pick the first candidate that actually answers as $1 (the DB user).
resolve_postgres_container() {
    local user="$1" c
    while IFS= read -r c; do
        [[ -z "$c" ]] && continue
        if docker exec "$c" psql -U "$user" -d postgres -tAc 'SELECT 1' >/dev/null 2>&1; then
            echo "$c"; return 0
        fi
    done < <(postgres_container_candidates)
    return 1
}

# Drop a database robustly: WITH (FORCE) evicts stray connections (PG 13+),
# else terminate backends and retry. Mirrors prune-worktrees' drop_db.
drop_db_forcefully() {
    local container="$1" user="$2" db="$3"
    docker exec "$container" psql -U "$user" -d postgres \
        -c "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE);" >/dev/null 2>&1 && return 0
    docker exec "$container" psql -U "$user" -d postgres \
        -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$db';" \
        >/dev/null 2>&1 || true
    docker exec "$container" psql -U "$user" -d postgres \
        -c "DROP DATABASE IF EXISTS \"$db\";" >/dev/null 2>&1
}

# Advisory occupancy check. `worktree-holder` is a sibling script, may not be
# installed, and needs a reachable board — so only its "held by a named, live
# agent" answer (exit 3) counts as a reason to stop. Anything else (missing,
# board down, nobody there) returns success and the teardown proceeds, because a
# coordination tool that cannot be reached must never make a worktree unusable.
#
# THAT REASONING IS RIGHT FOR A HUMAN AT A TERMINAL AND WRONG FOR A TIMER, and
# on 2026-09-04 this script acquired its first unattended caller: zeus runs
# `stack-reaper` hourly, after two graphical sessions were lost to leaked
# per-worktree docker stacks. Interactively, "board down, proceeding" is fine —
# somebody typed the command, knows which tree it names, and is watching it go.
# Nobody is watching the reaper, and what it deletes is a worktree, its stack,
# its database and its local branch. So the permissive reading of "could not
# tell" is kept as the DEFAULT and made opt-out: --require-lock (or
# QB_UNATTENDED=1) says the caller cannot supply the judgement that made
# fail-open safe, and turns "could not tell" into a refusal.
#
# Three answers, so the caller can tell the two failure modes apart:
#   0  clear — nobody else is here
#   1  held by a named live agent (holder exit 3)
#   2  could not tell (holder missing, or holder exit 4: no board, no curl/jq —
#      and any other code, because an answer this script does not recognise is
#      not evidence that the tree is free)
#
# Still not a lock. Between this answering and the `rm -rf` landing, an agent can
# still be handed the tree; closing that needs a real claim on both sides, which
# is the other half of #743 and is not this.
holder_check() {
    local dir="$1" hb="" rc
    hb=$(command -v worktree-holder 2>/dev/null || true)
    # The `*/*` guard matters: invoked by bare name with no worktree-holder on
    # PATH, `${0%/*}` leaves $0 untouched and would build a nonsense path.
    if [[ -z "$hb" && "$0" == */* ]]; then hb="${0%/*}/worktree-holder"; fi
    [[ -n "$hb" && -x "$hb" ]] || return 2
    # Stdout dropped, stderr kept: the all-clear would be noise on every single
    # teardown, while the "held by" report is the whole point of asking.
    "$hb" "$dir" >/dev/null
    rc=$?
    [[ $rc -eq 0 ]] && return 0
    [[ $rc -eq 3 ]] && return 1
    return 2
}

# >>> release (extracted verbatim by harness/tests/test_remove_worktree_claim.py)
# Hand back what `create-worktree` took (#337).
#
# The claim on the issue a branch names is taken BY THE CHECKOUT, held by the
# machine with no session, for 8h. Nothing gave it back. #277's `stop` half
# releases a SESSION's claims and these have none — they were taken by a script,
# on behalf of a worktree, before the agent that would use it existed — so the
# only thing that ever freed one was the TTL. Measured on 2026-08-22: four plan
# items still carried live claims after their PRs had merged, one of them shipped
# as v2.78 hours earlier. Symmetry with the thing that acquired it, and it
# catches abandoned work as well as landed work.
#
# **The create-name, not the worktree's resolved branch.** They diverge when
# somebody checks out something else inside the tree, and it is the create-name
# that `create-worktree` derived its claim from. Releasing what `RESOLVED_BRANCH`
# names would hand back a claim this worktree never took — which, on a box where
# another agent holds it, is the one outcome worse than leaving it held.
#
# Best-effort throughout, and it never changes the outcome of the teardown: the
# board is a coordination tool, and one that cannot be reached must not leave a
# worktree half-removed. A failure is recorded as a cleanup warning, because a
# claim silently left held for eight hours is exactly the state this exists to
# stop, and "cleanup complete" over it is how it stayed unnoticed for a day.
release_the_claim() {
    local branch="$1" dir="$2" qr rc
    if [[ "$KEEP_CLAIM" = true ]]; then
        echo -e "${YELLOW}Keeping the claim (--keep-claim)${NC}"
        return 0
    fi
    # **The tree is still there, so the checkout the claim belongs to is still
    # there.** STEP 4 prints "Done" whether or not the directory actually went:
    # the recursive delete is `2>/dev/null` and fails silently against root-owned
    # files a container wrote, which is the case `prune-worktrees --remove-dirs`
    # carries its own sudo hint for. Handing the claim back over a directory
    # somebody can still `cd` into reports a slot free that is occupied — the
    # exact wrong answer for a window that counts claims. So it stays held, is
    # said out loud, and is recorded: the TTL is under it, and
    # `prune-worktrees --prune` sweeps it once the tree really is gone.
    if [[ -n "$dir" && -d "$dir" ]]; then
        warn_cleanup "worktree directory still present — claim on '$branch' left held"
        return 0
    fi
    qr=$(command -v qb-release 2>/dev/null || true)
    # The `*/*` guard matters: invoked by bare name with no qb-release on PATH,
    # `${0%/*}` leaves $0 untouched and would build a nonsense path.
    if [[ -z "$qr" && "$0" == */* ]]; then qr="${0%/*}/qb-release"; fi
    if [[ -z "$qr" || ! -x "$qr" ]]; then
        echo -e "${YELLOW}qb-release not found — claim (if any) left held${NC}"
        return 0
    fi
    "$qr" --branch "$branch" --repo-path "$MAIN_REPO"
    rc=$?
    case "$rc" in
        0) echo -e "${GREEN}Done${NC}" ;;
        1) echo -e "${YELLOW}Not ours to hand back (see above) — left alone${NC}" ;;
        *) warn_cleanup "the claim on '$branch' was NOT handed back (see above) and stays held until it lapses" ;;
    esac
    return 0
}
# <<< release

# Turn `git status --porcelain --ignored -z` on stdin into a NUL-delimited list
# of paths to hand `tar --null -T`. $1 is the worktree root the paths are
# relative to — porcelain always reports from the repository root, and taking it
# as an argument rather than as the process's cwd keeps the whole backup honest
# on the path where the `cd` into the worktree silently failed.
#
# -z IS THE POINT. Without it git *quotes* any path holding a quote, a newline,
# a backslash or a non-ASCII byte — `"caf\303\251.txt"`, with the C escapes
# literal — and the old `substr($0, 4)` handed tar that spelling verbatim. tar
# then cannot stat a file under that name, so the one path most likely to be
# somebody's real work is the one silently missing from the archive. -z emits
# each record raw and NUL-terminated, so there is nothing to unquote.
collect_dirty_files() {
    local root="$1" rec status path
    while IFS= read -r -d '' rec; do
        status="${rec:0:2}"
        path="${rec:3}"
        # A rename or copy is TWO records under -z: the status line naming the
        # new path, then a bare record holding the old one. Consumed rather than
        # parsed — it carries no status field, so reading it as one would take
        # the first three characters off a real filename. (The old ` -> ` split
        # was git's *human* rendering, which -z does not produce at all.)
        if [[ "$status" == R* || "$status" == C* ]]; then
            IFS= read -r -d '' _ || true
        fi
        # A deletion has no bytes to archive, and `tar -T` fails the WHOLE run on
        # one entry it cannot stat. Now that a failed backup aborts the teardown,
        # keeping deleted paths in the list would refuse to tear down any
        # worktree with a `git rm` in it — a guard that fires on the safe case is
        # a guard somebody disables.
        [[ -e "$root/$path" || -L "$root/$path" ]] || continue
        printf '%s\0' "$path"
    done
}

detect_nginx_container() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -iE 'nginx' | head -1
}

# Does <conf> hold a worktree block for exactly <create-name>? Kept identical to
# create-worktree's copy: a substring match would answer "feat-a" with
# "feat-abc"'s marker.
nginx_block_present() {
    awk -v want="$2" '
        /# WORKTREE-START:/ {
            line = $0
            sub(/^.*# WORKTREE-START:/, "", line)
            sub(/[ \t\r]+$/, "", line)
            if (line == want) found = 1
        }
        END { exit !found }
    ' "$1"
}

# ============================================
# PARSE ARGUMENTS
# ============================================
BRANCH_NAME=""
CONFIG_FILE=""
CONFIG_JSON=""
KEEP_BRANCH=false
KEEP_DB=false
KEEP_CLAIM=false
FORCE=false
NO_BACKUP=false
# QB_UNATTENDED=1 is the environment spelling of --require-lock, for a caller
# that is a systemd timer rather than a command line — the reaper's own units
# already set it, and a wrapper script would be one more thing to keep in step.
REQUIRE_LOCK=false
[[ "${QB_UNATTENDED:-}" = "1" ]] && REQUIRE_LOCK=true

while [[ $# -gt 0 ]]; do
    case $1 in
        --config)
            [[ -z "${2:-}" ]] && die "--config requires a path"
            CONFIG_FILE="$2"; shift 2 ;;
        --keep-branch)
            KEEP_BRANCH=true; shift ;;
        --keep-db)
            KEEP_DB=true; shift ;;
        --keep-claim)
            KEEP_CLAIM=true; shift ;;
        --force)
            FORCE=true; shift ;;
        --no-backup)
            NO_BACKUP=true; shift ;;
        --require-lock)
            REQUIRE_LOCK=true; shift ;;
        --*)
            die "Unknown option: $1" ;;
        *)
            [[ -n "$BRANCH_NAME" ]] && die "Unexpected argument '$1'"
            BRANCH_NAME="$1"; shift ;;
    esac
done

[[ -z "$BRANCH_NAME" ]] && die "Branch name required\nUsage: remove-worktree [options] <branch-name>"

# ============================================
# FIND REPO AND LOAD CONFIG
# ============================================
MAIN_REPO=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a git repository"

if [[ -n "$CONFIG_FILE" ]]; then
    [[ -f "$CONFIG_FILE" ]] || die "Config file not found: $CONFIG_FILE"
    CONFIG_JSON=$(cat "$CONFIG_FILE")
elif [[ -f "$MAIN_REPO/.worktree.json" ]]; then
    CONFIG_JSON=$(cat "$MAIN_REPO/.worktree.json")
else
    CONFIG_JSON=""
fi

# ============================================
# RESOLVE CONFIG
# ============================================
PROJECT=$(cfg '.project' "$(detect_project_name "$MAIN_REPO")")
SAFE_NAME=$(echo "$BRANCH_NAME" | tr "/" "-")
WORKTREE_DIR="$(dirname "$MAIN_REPO")/${PROJECT}-${SAFE_NAME}"
NGINX_CONFIG=$(cfg '.nginx.config' "")
NGINX_CONTAINER=$(cfg '.nginx.container' "auto")
DB_ENGINE=$(cfg '.database.engine' "")
DB_CONTAINER=$(cfg '.database.container' "auto")
DB_USER_ENV=$(cfg '.database.user_env' "POSTGRES_USER")
DB_NAME_ENV=$(cfg '.database.name_env' "POSTGRES_DB")
DB_URL_ENV=$(cfg '.database.url_env' "")
WORKER_TYPE=$(cfg '.worker.type' "none")
WORKER_PREFIX=$(cfg '.worker.container_prefix' "")

if [[ -z "$WORKER_PREFIX" ]]; then
    case "$WORKER_TYPE" in
        huey) WORKER_PREFIX="huey-consumer" ;;
        rq) WORKER_PREFIX="${PROJECT}-rq-worker" ;;
        celery) WORKER_PREFIX="${PROJECT}-celery-worker" ;;
    esac
fi

# If no DB engine in config, check .env
if [[ -z "$DB_ENGINE" && -f "$MAIN_REPO/.env" ]]; then
    if grep -qiE 'POSTGRES|postgresql' "$MAIN_REPO/.env" 2>/dev/null; then
        DB_ENGINE="postgresql"
    fi
fi

# ============================================
# RESOLVE WORKTREE IDENTITY
# ============================================
# The positional arg is the "create-name": the identifier used at creation for
# the directory, database, port entry, nginx block and containers. The git
# *branch* can diverge from it — e.g. you check out or fork a different branch
# inside the worktree after creating it. So we (a) resolve the real worktree
# even when the caller passes the current branch name instead of the
# create-name, and (b) capture the worktree's actual branch to delete later,
# rather than assuming arg == branch.
RESOLVED_BRANCH=""
if [[ ! -d "$WORKTREE_DIR" ]]; then
    # Derived dir not found — caller may have passed the branch name. Look it up
    # in the worktree list and recover the create-name from the dir suffix.
    found_dir=$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$BRANCH_NAME" '
        /^worktree / { wt = substr($0, 10) }
        /^branch / && $2 == b { print wt; exit }
    ')
    if [[ -n "$found_dir" && -d "$found_dir" ]]; then
        WORKTREE_DIR="$found_dir"
        CREATE_NAME=$(basename "$found_dir"); CREATE_NAME="${CREATE_NAME#${PROJECT}-}"
        # Prefer the original (possibly slash-bearing) create-name from the port
        # file, so port/nginx keys still match.
        if [[ -f "$MAIN_REPO/.worktree-ports" ]]; then
            pf=$(awk -F: -v d="$CREATE_NAME" '{n=$2; gsub("/","-",n); if (n==d) {print $2; exit}}' "$MAIN_REPO/.worktree-ports")
            [[ -n "$pf" ]] && CREATE_NAME="$pf"
        fi
        BRANCH_NAME="$CREATE_NAME"
        SAFE_NAME=$(echo "$BRANCH_NAME" | tr "/" "-")
    fi
fi
# Capture the worktree's real branch before we remove it (may differ from arg).
if [[ -d "$WORKTREE_DIR" ]]; then
    RESOLVED_BRANCH=$(git -C "$WORKTREE_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    [[ "$RESOLVED_BRANCH" = "HEAD" ]] && RESOLVED_BRANCH=""  # detached HEAD — nothing to delete
fi

# ============================================
# IS SOMEBODY ELSE WORKING IN IT?
# ============================================
# Asked before anything is destroyed, and only about a *live* holder. An agent
# three commits into a review cycle in this directory has no way to defend it:
# the tooling that rewrites a worktree never had to ask who was in it, so the
# only signal was the other agent noticing its own branch had moved. This is
# that question, asked once, and it is advisory — --force always wins.
#
# --require-lock (or QB_UNATTENDED=1) is what an unattended caller passes, and it
# only changes the "could not tell" answer: held is still a refusal and clear is
# still a go. See holder_check's header for why the default stays permissive.
if [[ -d "$WORKTREE_DIR" && "$FORCE" != true ]]; then
    holder_check "$WORKTREE_DIR"
    HOLDER_RC=$?
    if [[ $HOLDER_RC -eq 1 ]]; then
        echo "" >&2
        die "Another live agent is working in $WORKTREE_DIR (see above).
  Talk to it, or re-run with --force if you are certain it has finished.
  This is advisory only: a lapsed lease never blocks, and neither does an
  unreachable board."
    elif [[ $HOLDER_RC -eq 2 && "$REQUIRE_LOCK" = true ]]; then
        echo "" >&2
        die "Could not confirm nobody is working in $WORKTREE_DIR (see above),
  and --require-lock says an unattended teardown must not guess.
  Either worktree-holder is not installed here or the board did not answer.
  Fix the board, or re-run with --force if you have looked at the tree yourself."
    fi
fi

# ============================================
# IS THERE WORK ON THE BRANCH THE PR NEVER TOOK?
# ============================================
# Deleting the branch is the step that actually loses commits, and the commits
# most at risk are the ones added AFTER the PR was opened AND never pushed — the
# post-merge tweak that exists in exactly one place. Three were found sitting in
# reapable worktrees here.
#
# The test is deliberately base-independent. Comparing against the default branch
# is the obvious check and it is wrong wherever PRs do not target it: lexray
# merges into `fca` and `test` while `main` sits frozen, so `git branch --merged
# main` calls every branch unmerged. The PR's own head SHA is the honest
# waterline — anything past it is work the PR never carried.
#
# Best-effort and advisory: no gh, no network, no PR, or an object we do not have
# locally all mean "cannot tell", and cannot-tell must never block a teardown.
# --force and --keep-branch both skip it, the latter because a kept branch keeps
# its commits.
# Sets PR_HEAD and PR_POST_PR rather than echoing: command substitution would
# run this in a subshell and drop PR_HEAD on the floor, leaving the refusal
# unable to show what it is protecting.
# >>> post-pr-guard
PR_HEAD=""
PR_POST_PR=""
post_pr_commits() {
    local repo="$1" branch="$2"
    PR_HEAD=""; PR_POST_PR=""
    command -v gh >/dev/null 2>&1 || return 1
    PR_HEAD=$(cd "$repo" && timeout 20 gh pr list --head "$branch" --state all \
                --json headRefOid -q '.[0].headRefOid' 2>/dev/null) || return 1
    [[ -n "$PR_HEAD" ]] || return 1
    # An absent object makes `git log a..b` fail, and a bare `| wc -l` would read
    # that as 0 — "nothing to lose" on precisely the branch we cannot vouch for.
    git -C "$repo" cat-file -e "$PR_HEAD" 2>/dev/null || return 1
    # `--not --remotes` is what makes this about LOSS rather than tidiness:
    # `remove-worktree` only ever deletes the local branch, so a commit that is
    # already on some remote survives it. Refusing those would block the reaping
    # this guard exists alongside, for work that is in no danger. A stale
    # remote-tracking ref makes this over-refuse, which is the safe direction.
    PR_POST_PR=$(git -C "$repo" log --oneline "$PR_HEAD".."$branch" \
                   --not --remotes 2>/dev/null | wc -l) || return 1
    return 0
}

if [[ "$FORCE" != true && "$KEEP_BRANCH" != true && -n "$RESOLVED_BRANCH" ]]; then
    # `git -C` throughout: a bare `cd` here would silently relocate every step
    # that follows.
    post_pr_commits "$MAIN_REPO" "$RESOLVED_BRANCH" || PR_POST_PR=""
    if [[ -n "$PR_POST_PR" && "$PR_POST_PR" -gt 0 ]]; then
        echo "" >&2
        git -C "$MAIN_REPO" log --oneline "$PR_HEAD".."$RESOLVED_BRANCH" \
            --not --remotes 2>/dev/null \
            | sed 's/^/    /' >&2
        die "Branch $RESOLVED_BRANCH has $PR_POST_PR commit(s) its PR never carried (above).
  Deleting the branch would be their only copy's last stop.
  Push them, or re-run with --keep-branch to drop just the worktree,
  or --force if you have looked and do not want them."
    fi
fi
# <<< post-pr-guard

echo -e "${GREEN}Removing worktree for branch: $BRANCH_NAME${NC}"
echo -e "  Main repo: $MAIN_REPO"
echo -e "  Worktree:  $WORKTREE_DIR"
echo ""

TOTAL_STEPS=8
CURRENT=0
step() { CURRENT=$((CURRENT + 1)); echo -e "${YELLOW}[$CURRENT/$TOTAL_STEPS] $1${NC}"; }

# ============================================
# STEP 1: Stop and remove Docker containers
# ============================================
step "Stopping Docker containers..."
CLEANED=false

if [[ -d "$WORKTREE_DIR" && -f "$WORKTREE_DIR/docker-compose.yml" ]]; then
    cd "$WORKTREE_DIR"
    if docker compose down 2>/dev/null; then
        echo -e "${GREEN}Containers stopped via docker compose down${NC}"
        CLEANED=true
    fi
    cd "$MAIN_REPO"
fi

# Force-remove if still running
for container in "${PROJECT}-${SAFE_NAME}" "${WORKER_PREFIX}-${SAFE_NAME}"; do
    [[ -z "$container" || "$container" = "-${SAFE_NAME}" ]] && continue
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${container}$"; then
        docker rm -f "$container" 2>/dev/null && CLEANED=true
    fi
done

if [[ "$CLEANED" = true ]]; then
    echo -e "${GREEN}Done${NC}"
else
    echo -e "${YELLOW}No containers found${NC}"
fi

# ============================================
# STEP 2: Remove nginx configuration
# ============================================
step "Removing nginx configuration..."
if [[ -n "$NGINX_CONFIG" ]]; then
    NGINX_CONF_PATH="$MAIN_REPO/$NGINX_CONFIG"
    # SAFE_NAME, not BRANCH_NAME: create-worktree keys the markers (and the
    # container the block proxies to) on the slash-free name. Exact match, so
    # tearing down "feat-a" does not answer to "feat-abc"'s marker.
    if [[ -f "$NGINX_CONF_PATH" ]] && nginx_block_present "$NGINX_CONF_PATH" "$SAFE_NAME"; then
        awk -v branch="$SAFE_NAME" '
        # Exact marker name, never a regex match on the whole line: `$0 ~ branch`
        # let worktree "feat-a" strip the block belonging to "feat-abc", and any
        # dot in a branch name matched as a wildcard.
        function marker_name(line, kind) {
            sub("^.*# WORKTREE-" kind ":", "", line)
            sub(/[ \t\r]+$/, "", line)
            return line
        }
        BEGIN { skip = 0 }
        /# WORKTREE-START:/ && marker_name($0, "START") == branch { skip = 1; next }
        /# WORKTREE-END:/ && marker_name($0, "END") == branch { skip = 0; next }
        skip { next }
        { print }
        ' "$NGINX_CONF_PATH" > "$NGINX_CONF_PATH.tmp" && mv "$NGINX_CONF_PATH.tmp" "$NGINX_CONF_PATH"

        # Clean up excess blank lines
        awk 'NF {blank=0; print} !NF {blank++; if (blank <= 2) print}' \
            "$NGINX_CONF_PATH" > "$NGINX_CONF_PATH.tmp" && mv "$NGINX_CONF_PATH.tmp" "$NGINX_CONF_PATH"

        echo -e "${GREEN}Removed nginx block${NC}"
    else
        echo -e "${YELLOW}No nginx block found${NC}"
    fi
else
    echo -e "${YELLOW}No nginx config configured${NC}"
fi

# ============================================
# STEP 3: Restart nginx
# ============================================
step "Restarting nginx..."
if [[ -z "$NGINX_CONFIG" ]]; then
    # No nginx config for this repo — we didn't touch nginx, so don't restart
    # an unrelated project's nginx container.
    echo -e "${YELLOW}No nginx config — skipping restart${NC}"
else
    if [[ "$NGINX_CONTAINER" = "auto" ]]; then
        NGINX_CONTAINER=$(detect_nginx_container)
    fi
    if [[ -n "$NGINX_CONTAINER" ]]; then
        docker restart "$NGINX_CONTAINER" 2>/dev/null && echo -e "${GREEN}Done${NC}" \
            || echo -e "${YELLOW}Could not restart nginx${NC}"
    else
        echo -e "${YELLOW}Nginx container not found${NC}"
    fi
fi

# ============================================
# STEP 4: Backup and remove worktree directory
# ============================================
step "Handling worktree directory..."
if [[ -d "$WORKTREE_DIR" ]]; then
    cd "$WORKTREE_DIR" 2>/dev/null || true

    # `qb-stash` entries live under `refs/worktree/*`, which is what makes them
    # per-worktree — and also what makes `git worktree remove` take them with it.
    # They are invisible to `git status`, so the dirty-file backup below does not
    # see them. Copy them into the repo-wide namespace first, where they survive
    # the removal and can be applied from anywhere. Cheap: a ref write per entry,
    # and nothing at all when there are none.
    # >>> qb-stash-rescue (extracted verbatim by harness/tests/test_stash_guard.py)
    QB_STASH_REFS=$(git for-each-ref --format='%(refname) %(objectname)' \
                        refs/worktree/qb-stash/ 2>/dev/null || true)
    if [[ -n "$QB_STASH_REFS" ]]; then
        RESCUED=0
        while read -r qs_ref qs_sha; do
            [[ -n "$qs_ref" ]] || continue
            if git update-ref "refs/qb-stash-rescued/${SAFE_NAME}/${qs_ref##*/}" "$qs_sha" \
                   2>/dev/null; then
                RESCUED=$((RESCUED + 1))
            fi
        done <<< "$QB_STASH_REFS"
        if [[ "$RESCUED" -gt 0 ]]; then
            echo -e "${YELLOW}Rescued $RESCUED qb-stash entr$([[ $RESCUED -eq 1 ]] && echo y || echo ies)${NC}" \
                    "— they would have died with the worktree."
            echo "  git for-each-ref refs/qb-stash-rescued/${SAFE_NAME}/"
            echo "  git stash apply <that ref>"
        fi
    fi
    # <<< qb-stash-rescue

    if [[ "$NO_BACKUP" = true ]]; then
        echo -e "${YELLOW}Skipping the backup (--no-backup)${NC}"
    else
        # A cheap emptiness probe first, on output nobody parses: nothing dirty
        # and nothing ignored means nothing to lose, and the apparatus below — a
        # temp file, tar, an abort if it fails — should not become a
        # precondition for tearing down a CLEAN tree. This only ever asks "is
        # there anything at all"; the parse that acts on the answer is the -z
        # one below.
        #
        # --ignored, because the ignored files are the ones whose loss hurts.
        # `git status --porcelain` alone sees only tracked and untracked-but-not-
        # ignored paths, and in a real worktree the irreplaceable half is exactly
        # what .gitignore covers: `.env`, `data/`, `CLAUDE.local.md`,
        # `.worktree-port`, `.claude/`. Everything the old list DID cover is
        # either committed elsewhere or trivially regenerated, so the backup was
        # archiving the recoverable half and dropping the rest.
        DIRTY_FILES=$(git -C "$WORKTREE_DIR" status --porcelain --ignored 2>/dev/null || true)
        if [[ -n "$DIRTY_FILES" ]]; then
            FILE_LIST_FILE=$(mktemp "${TMPDIR:-/tmp}/remove-worktree-backup.XXXXXX" 2>/dev/null)
            if [[ -z "$FILE_LIST_FILE" ]]; then
                die "Could not create a temporary file for the backup list.
  Nothing has been deleted. Fix the temp directory, or re-run with --no-backup
  if you have looked at $WORKTREE_DIR and do not want its contents."
            fi
            git -C "$WORKTREE_DIR" status --porcelain --ignored -z 2>/dev/null \
                | collect_dirty_files "$WORKTREE_DIR" > "$FILE_LIST_FILE"
            # Records, not lines: the list is NUL-delimited, and a path may
            # itself contain a newline — which is the whole reason for -z.
            FILE_COUNT=$(tr -cd '\0' < "$FILE_LIST_FILE" | wc -c | tr -d ' ')
            if [[ "$FILE_COUNT" -gt 0 ]]; then
                BACKUP="$(dirname "$MAIN_REPO")/${PROJECT}-${SAFE_NAME}-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
                echo -e "${YELLOW}Uncommitted changes found, creating backup of dirty files...${NC}"
                # A FAILED BACKUP ABORTS. This used to be `|| echo "Backup
                # failed"` with no exit, so the recursive delete below ran
                # anyway: the one teardown on which the backup matters was the
                # one on which it was skipped. `--null -T` rather than a piped
                # list, because the list is NUL-delimited too.
                if tar --null -czf "$BACKUP" -C "$WORKTREE_DIR" -T "$FILE_LIST_FILE" 2>/dev/null; then
                    echo -e "${GREEN}Backup ($FILE_COUNT files): $BACKUP${NC}"
                else
                    rm -f "$BACKUP" "$FILE_LIST_FILE"
                    die "Backup of $WORKTREE_DIR failed — nothing has been deleted.
  $FILE_COUNT dirty or ignored file(s) were to be archived to
  $BACKUP
  Free some disk, or re-run with --no-backup if you have looked at the tree
  and do not want its contents."
                fi
            fi
            rm -f "$FILE_LIST_FILE"
        fi
    fi
    cd "$MAIN_REPO"
fi

# Remove git worktree. A worktree with a copied apps/models (hundreds of MB of
# spaCy models) can take longer than a couple of seconds to delete, so allow a
# generous timeout — too short a limit leaves a half-removed directory behind.
if git worktree list 2>/dev/null | grep -q "$WORKTREE_DIR"; then
    timeout 60 git worktree remove "$WORKTREE_DIR" 2>/dev/null \
        || timeout 60 git worktree remove --force "$WORKTREE_DIR" 2>/dev/null \
        || true
fi

# Force-remove directory if still there
if [[ -d "$WORKTREE_DIR" ]]; then
    rm -rf "$WORKTREE_DIR" 2>/dev/null
    git worktree prune 2>/dev/null || true
fi

echo -e "${GREEN}Done${NC}"

# ============================================
# STEP 5: Drop database
# ============================================
step "Cleaning up database..."
if [[ "$KEEP_DB" = true ]]; then
    echo -e "${YELLOW}Keeping database (--keep-db)${NC}"
elif [[ "$DB_ENGINE" = "postgresql" ]]; then
    DB_BRANCH=$(echo "$BRANCH_NAME" | tr '/-' '__')
    WORKTREE_DB="${PROJECT}_${DB_BRANCH}"

    # Read user from .env
    PG_USER=""
    if [[ -f "$MAIN_REPO/.env" ]]; then
        PG_USER=$(env_val "$DB_USER_ENV" "$MAIN_REPO/.env")
        if [[ -z "$PG_USER" && -n "$DB_URL_ENV" ]]; then
            db_url=$(env_val "$DB_URL_ENV" "$MAIN_REPO/.env")
            [[ -n "$db_url" ]] && PG_USER=$(db_url_user "$db_url")
        fi
    fi

    # Resolve the container only once the user is known, so "answers as this
    # user" can be the tie-breaker rather than docker's listing order.
    if [[ -n "$PG_USER" && "$DB_CONTAINER" = "auto" ]]; then
        DB_CONTAINER=$(resolve_postgres_container "$PG_USER" || true)
    fi

    if [[ -z "$PG_USER" ]]; then
        warn_cleanup "could not determine DB user — database $WORKTREE_DB NOT dropped"
    elif [[ -z "$DB_CONTAINER" || "$DB_CONTAINER" = "auto" ]]; then
        warn_cleanup "no Postgres container answered as '$PG_USER' — database $WORKTREE_DB NOT dropped"
        echo -e "${YELLOW}  Candidates tried: $(postgres_container_candidates | tr '\n' ' ')${NC}"
    else
        DB_EXISTS=$(docker exec "$DB_CONTAINER" psql -U "$PG_USER" -d postgres -tAc \
            "SELECT 1 FROM pg_database WHERE datname='$WORKTREE_DB'" 2>/dev/null || true)
        if [[ "$DB_EXISTS" = "1" ]]; then
            if drop_db_forcefully "$DB_CONTAINER" "$PG_USER" "$WORKTREE_DB"; then
                echo -e "${GREEN}Dropped database: $WORKTREE_DB${NC}"
            else
                warn_cleanup "could not drop database $WORKTREE_DB (still present)"
            fi
        else
            echo -e "${YELLOW}Database $WORKTREE_DB not found${NC}"
        fi
    fi
else
    echo -e "${YELLOW}No database to clean${NC}"
fi

# ============================================
# STEP 6: Delete git branch
# ============================================
step "Cleaning up git branch..."
cd "$MAIN_REPO"
# Delete the worktree's *actual* branch (captured before removal), which can
# differ from the create-name arg if the branch was switched/forked after
# creation. Fall back to the arg when we couldn't resolve one.
DEL_BRANCH="${RESOLVED_BRANCH:-$BRANCH_NAME}"

# The repo's default branch, which must survive a worktree teardown. Local
# lookups only: this runs after the directory is already gone, and a teardown
# that needs the network to decide whether to keep `main` would delete it on a
# train. `origin/HEAD` is a local cache and can be stale or absent (a bare
# `git clone --branch` never sets it), so fall back to whichever common name
# actually exists, then to the literal names. Mirrors detect_default_branch in
# harness_rules.py, minus its ls-remote step.
default_branch() {
    local ref
    ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
    if [[ -n "$ref" ]]; then
        echo "${ref##*/}"
        return
    fi
    local name
    for name in main master; do
        if git rev-parse --verify --quiet "refs/remotes/origin/$name" >/dev/null 2>&1; then
            echo "$name"
            return
        fi
    done
    echo "main"
}
DEFAULT_BRANCH=$(default_branch)

if [[ "$KEEP_BRANCH" = true ]]; then
    echo -e "${YELLOW}Keeping branch (--keep-branch)${NC}"
elif ! git show-ref --verify --quiet "refs/heads/$DEL_BRANCH"; then
    echo -e "${YELLOW}Branch not found: $DEL_BRANCH${NC}"
# A worktree parked on the DEFAULT branch is the case this guard exists for, and
# it is not hypothetical: a worktree created for an issue and later switched to
# `main` reaches here with DEL_BRANCH=main, no other worktree holding it, and
# `git branch -d` refusing only because main is not merged into HEAD — so the
# `|| git branch -D` below force-deletes the repo's trunk as a side effect of
# tidying up. Recoverable from the remote, and silent, which is the bad
# combination. Deleting the default branch is never what a teardown means; there
# is deliberately no flag to override this, because --keep-branch already says
# "leave the branch alone" for anyone who wants that outcome on purpose.
elif [[ "$DEL_BRANCH" = "$DEFAULT_BRANCH" || "$DEL_BRANCH" = "main" || "$DEL_BRANCH" = "master" ]]; then
    echo -e "${YELLOW}Refusing to delete the default branch: $DEL_BRANCH${NC}"
elif git worktree list 2>/dev/null | grep -qF "[$DEL_BRANCH]"; then
    echo -e "${YELLOW}Branch still used by another worktree, skipping: $DEL_BRANCH${NC}"
elif git branch -d "$DEL_BRANCH" 2>/dev/null || git branch -D "$DEL_BRANCH" 2>/dev/null; then
    echo -e "${GREEN}Branch deleted: $DEL_BRANCH${NC}"
else
    echo -e "${YELLOW}Could not delete branch: $DEL_BRANCH${NC}"
fi

# ============================================
# STEP 7: Clean up port tracking
# ============================================
step "Cleaning up port tracking..."
PORT_FILE="$MAIN_REPO/.worktree-ports"
# create-worktree writes "<port>:<branch>" using the branch AS TYPED, so the key
# keeps its slashes ("5698:fix/issue-1503") while the worktree directory has them
# flattened ("lexray-fix-issue-1503"). remove-worktree is normally called with
# that flattened create-name, so an exact ":$BRANCH_NAME$" match never fired and
# every teardown left its entry behind — 18 had silently accumulated here, and
# the "No port entry found" note made it look intentional. (The slash-bearing
# name IS recovered from this file, but only on the branch of the code that runs
# when the derived directory is missing — not the common path.)
#
# Match on the normalised key instead, so either spelling is found, and also on
# the worktree's real branch for entries written under a different create-name.
if [[ -f "$PORT_FILE" ]]; then
    awk -F: -v flat="$SAFE_NAME" -v rb="$RESOLVED_BRANCH" '
        {
            key = $2
            norm = key
            gsub("/", "-", norm)
            if (norm == flat || (rb != "" && key == rb)) { dropped++; next }
            print
        }
        END { exit (dropped ? 0 : 1) }
    ' "$PORT_FILE" > "$PORT_FILE.tmp"
    if [[ $? -eq 0 ]]; then
        mv "$PORT_FILE.tmp" "$PORT_FILE"
        echo -e "${GREEN}Done${NC}"
    else
        rm -f "$PORT_FILE.tmp"
        echo -e "${YELLOW}No port entry found${NC}"
    fi
else
    echo -e "${YELLOW}No port file${NC}"
fi

# ============================================
# STEP 8: Hand the issue claim back
# ============================================
# Last, and after the tree is actually gone: a claim handed back while the
# checkout still exists is a slot reported free that somebody is standing in.
step "Handing back the board claim..."
release_the_claim "$BRANCH_NAME" "$WORKTREE_DIR"

# ============================================
# SUMMARY
# ============================================
echo ""
echo -e "${GREEN}========================================${NC}"
if [[ ${#CLEANUP_WARNINGS[@]} -eq 0 ]]; then
    echo -e "${GREEN}Cleanup complete: $BRANCH_NAME${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
else
    echo -e "${YELLOW}Cleanup finished WITH WARNINGS: $BRANCH_NAME${NC}"
    echo -e "${YELLOW}========================================${NC}"
    for w in "${CLEANUP_WARNINGS[@]}"; do echo -e "  ${YELLOW}- $w${NC}"; done
    echo -e "  ${YELLOW}Re-run \`prune-worktrees\` to sweep whatever was left behind.${NC}"
    echo ""
fi

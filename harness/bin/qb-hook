#!/usr/bin/env bash
# quarterback lifecycle hook — the automatic reflexes for the coordination board.
#
# Invoked by Claude Code hooks (settings.json) with the event name as $1 and the
# hook JSON payload on stdin. This is layer 3: presence/lease/handoff must NOT
# depend on the model remembering to do them, so they live here and the harness
# fires them. It is deliberately fail-open — any error is swallowed and the hook
# exits 0, so a board outage can never block or slow a coding session.
#
# Token: QUARTERBACK_TOKEN if set, else this agent's entry extracted from the
# op-resolved combined token list (/run/op-secrets/quarterback-tokens, one
# `name:token` per machine). Agent name = QUARTERBACK_AGENT or the hostname.
#
# Identity: the token proves the MACHINE, and every session on it shares that
# token — so without more, all of them post as "zeus" and none can be addressed
# individually. The X-Agent-Instance header distinguishes this session. Its value
# is a prefix of the Claude Code session id because qb-mcp derives the same value
# from CLAUDE_CODE_SESSION_ID — that's what keeps a session's tool calls and its
# presence/leases under ONE identity instead of two.
#
# Since v2.12 that header is only an opaque KEY: the board DESIGNATES the name it
# is known by (`zeus/glacier-amber`) and the key survives as a permanent alias. An
# operator who wants a typeable name instead sets QUARTERBACK_INSTANCE, which this
# hook forwards as an X-Agent-Name *request* — see the _auth block below for why
# only an explicit one, and qb-env for the rule that shapes it.

set -uo pipefail   # NOT -e: never abort a session on a curl/jq hiccup

EVENT="${1:-}"

# Site config decides the board and the token source (see qb-env). This hook is
# fail-open by contract, so an unconfigured host no-ops rather than erroring — but
# it must no-op *without* falling back to a board, which is why there is no default
# URL here any more: on the work island the old fallback pointed at the personal
# board, and that board is reachable from there over public DNS.
#
# Two failures are NOT the same and must not be handled the same way. "The board
# is unreachable" — or "this host has no board" — is expected, and gets the silent
# exit 0 below. "I could not load my own library" is a bug in this install, and
# swallowing that silently is how a broken source line ran ~20 hours unnoticed. It
# still exits 0 — a hook must never block a session — but it leaves a breadcrumb
# first, so the next person to wonder why the board went quiet has one file to
# look at rather than a mystery.
qb_broken() {
  local msg="$1" marker="${TMPDIR:-/tmp}/qb-hook-broken"
  echo "qb-hook: $msg (hook disabled; exiting 0)" >&2
  # Overwrite, never append: this fires on every hook event, and an unbounded log
  # in /tmp is its own bug. mtime is the "when", the line is the "what".
  printf '%s qb-hook[%s]: %s\n  argv0=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${EVENT:-?}" "$msg" "$0" >"$marker" 2>/dev/null
  printf 'broken\n' >"${XDG_RUNTIME_DIR:-/tmp}/qb-health" 2>/dev/null
  exit 0
}

# Find qb-env beside this script. NOT `readlink -f`: home-manager installs each
# file as its own flat /nix/store/…-hm_qbhook path, so full resolution walks past
# the bin/ directory and dirname yields /nix/store. Walk the chain one link at a
# time instead and take the first directory that actually holds a qb-env.
qb_env_path() {
  local p="$1" d
  for _ in 1 2 3 4 5 6 7 8; do
    d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || return 1
    [ -r "$d/qb-env" ] && { printf '%s\n' "$d/qb-env"; return 0; }
    [ -L "$p" ] || return 1
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  return 1
}

# ---- which qb-hook is this? -------------------------------------------------
# #204 names three independently versioned things that must agree and misses a fourth:
# this file. While it lived in a consumer's personal config it was pinned by whatever
# repo that was, on a different revision from the harness and the board — and a hook
# calling a route the pinned board does not serve is skew that no check could even see,
# because the file was not in the tree being checked. It ships with the harness now
# (#230), so the question "which one am I running" finally has an answer, and this is
# where a doctor asks it.
#
# What is printed is the RESOLVED PATH of both halves, not a version string, and that is
# deliberate: on a nix install the store hash IS the pin, uniquely and unforgeably,
# whereas the `version` in a derivation name is a field somebody has to remember to bump.
# The two lines are what matter together — a qb-hook and a qb-env from different store
# paths is precisely the half-migrated install this issue is about, and it is invisible
# from either line alone.
#
# `readlink -f` HERE, unlike everywhere else in this file: the other walks are looking for
# a SIBLING and must stop at the bin/ directory, while this one is answering "what am I",
# for which full resolution is the whole point. The fallback covers a platform without
# GNU readlink -f.
if [ "$EVENT" = "--version" ] || [ "$EVENT" = "version" ]; then
  printf 'qb-hook %s\n' "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")"
  if _qbe="$(qb_env_path "$0")"; then
    printf 'qb-env  %s\n' "$(readlink -f -- "$_qbe" 2>/dev/null || printf '%s' "$_qbe")"
    exit 0
  fi
  printf 'qb-env  (not found beside this script — this install cannot post to a board)\n'
  exit 1
fi

QB_ENV="$(qb_env_path "$0")" || qb_broken "no qb-env found next to this script"
# shellcheck source=./qb-env
. "$QB_ENV" || qb_broken "qb-env at $QB_ENV would not load"
# Sourcing can "succeed" on a truncated or half-written file, so check for the
# thing we are about to call rather than trusting the exit status.
command -v qb_load_config >/dev/null 2>&1 \
  || qb_broken "qb-env at $QB_ENV loaded but defines no qb_load_config"
qb_load_config
# This file and qb-env are separately pinned store paths (#204), so a half-migrated
# install can pair a current hook with a library that predates `qb_requested_name`
# (#156). A shim, not a `qb_broken`: losing a requested name costs a cosmetic
# spelling for one session, and taking that session's presence and leases with it
# would cost incomparably more.
if ! command -v qb_requested_name >/dev/null 2>&1; then
  qb_requested_name() { :; }
fi
# jq and the payload come FIRST, ahead of anything about the board, because one
# thing this hook says needs neither. jq is this file's parser — every branch
# below reads the payload with it, including #185's Bash escape — and stdin has
# to be drained on every path, including the ones that exit early.
command -v jq >/dev/null 2>&1 || exit 0
IN=$(cat 2>/dev/null || true)

# ---- the one note that never needed a board ---------------------------------
# WHICH WAY THIS REPO IS WORKED (#178), and whether the tree you are standing in
# agrees. Defined up here, above the board checks, because it is a LOCAL fact:
# `qb-mode` reads the repo's declared mode out of the repo. Below those checks it
# was unreachable on a host with no board configured, no token, or no curl — none
# of which has anything to do with the question, and all of which left the guard
# silent on exactly the hosts least likely to have anyone watching.
#
# It resolves NOTHING itself. `qb-mode` goes through the same `harness_rules`
# layering every other setting does, so this hook cannot become a second place
# the answer is worked out and quietly differ.
#
# Fail-open like everything else here, and one silence on purpose: an absent
# `qb-mode` says nothing at all rather than guessing. A note that appeared on
# boxes carrying the harness and vanished on boxes without it would teach people
# that the absence means "jungle", and it means nothing of the kind.
#
# These are DEFINITIONS, which is what lets them sit on #185's hot path without
# costing it anything: the Bash escape below still leaves before a subprocess is
# spawned, a token is resolved or a board client is built.
_take_a_worktree() {   # _take_a_worktree <root>: the ONE way to say "get your own tree"
  # Two notes and two refusals used to spell this act three different ways, and
  # `create-worktree` is not a synonym for `git worktree add` (#464): it also does
  # the per-worktree database isolation, takes the claim, and installs the git
  # hooks `qb-hooks` provides. An agent that followed the raw-git spelling got a
  # worktree without any of that, in a repo that had just told it that it wants
  # all of it. So the harness's own command wins wherever it exists, and the raw
  # form is the fallback for a host that has not installed one.
  if command -v create-worktree >/dev/null 2>&1; then
    printf 'create-worktree <branch>'
  else
    printf 'git worktree add ../%s-<branch> -b <branch>' \
      "$(basename "${1:-repo}" 2>/dev/null || printf 'repo')"
  fi
}

_mode_note() {   # _mode_note <cwd>: the mode line, plus the remedy if it is contradicted
  local dir="${1:-}" js
  [ -n "$dir" ] || return 0
  command -v qb-mode >/dev/null 2>&1 || return 0
  # Exit code deliberately ignored: 3 IS the interesting answer and it carries the
  # body we want. Emptiness is the only failure this can act on.
  js=$(qb-mode --json "$dir" 2>/dev/null)
  [ -n "$js" ] || return 0
  printf '%s' "$js" | jq -r '
    if .label == null then empty else
      "quarterback: this repo is worked \(.glyph) \(.label) — \(.how)."
      + (if .violation then "\n\n" + .violation else "" end)
    end' 2>/dev/null
}

_inject() {   # _inject <text>: hand Claude Code some session-start context, or nothing
  [ -n "${1:-}" ] || return 0
  jq -nc --arg c "$1" \
    '{hookSpecificOutput:{hookEventName:"SessionStart", additionalContext:$c}}'
}

# Every "this host has no board" exit routes through here rather than exiting
# where it stands, so the local note survives the board being absent. Nothing
# else in this file can run without a board, which is why this is the only thing
# it does before giving up.
_boardless_exit() {
  if [ "$EVENT" = "SessionStart" ]; then
    _inject "$(_mode_note "$(printf '%s' "$IN" | jq -r '.cwd // empty' 2>/dev/null)")"
  fi
  exit 0
}

[ -n "${QUARTERBACK_BASE_URL:-}" ] || _boardless_exit   # unconfigured → never a guess
command -v curl >/dev/null 2>&1 || _boardless_exit

# ---- the Bash escape, and it is here for a measured reason --------------------
# `PreToolUse` used to be scoped to `Task`, which fires a handful of times a
# session. It matches `Bash` now, so this script runs on EVERY shell command
# every agent on this box types — and the hook's preamble (config, token
# resolution, identity, the whole `_auth` construction below) was written when
# that could not happen. Widening the matcher did not create that cost; it
# exposed it, on the hottest path there is.
#
# So the one question the shared-checkout guard actually needs — could this
# possibly be git? — is asked HERE, before the token is resolved and before
# anything else is built. It is one `grep` against a string, deliberately
# over-broad, and it decides nothing: everything that decides lives in
# `_shared_tree_guard`, which still runs the tokeniser on whatever gets past
# this. What it buys is that `ls`, `pytest` and `cargo build` leave through this
# line instead of paying for a board client they will never use.
if [ "$EVENT" = "PreToolUse" ] \
   && [ "$(printf '%s' "$IN" | jq -r '.tool_name // empty' 2>/dev/null)" = "Bash" ] \
   && ! printf '%s' "$IN" | jq -r '.tool_input.command // empty' 2>/dev/null \
        | grep -Eq '(^|[^[:alnum:]_-])git([[:space:]]|$)'; then
  exit 0
fi

# Below the escape, and #185 put it there deliberately — see above. Routed
# through `_boardless_exit` for #178's reason: on a SessionStart that gets this
# far, a host that cannot produce a token has still told us which mode it is in.
qb_resolve_token || _boardless_exit             # no token

BASE="$QUARTERBACK_BASE_URL"
AGENT="$QUARTERBACK_AGENT"
TOK="$QUARTERBACK_TOKEN"

_throttle() {   # _throttle <key> <seconds>: true at most once per <seconds>, else false
  local mark="${XDG_RUNTIME_DIR:-/tmp}/qb-$1"
  if [ -f "$mark" ] && [ $(( $(date +%s) - $(stat -c %Y "$mark" 2>/dev/null || echo 0) )) -lt "$2" ]; then
    return 1
  fi
  : > "$mark"; return 0
}
_once() {   # _once <key>: true the first time only (no expiry) — dedupe by identity
  local mark="${XDG_RUNTIME_DIR:-/tmp}/qb-once-$1"
  [ -f "$mark" ] && return 1
  : > "$mark"; return 0
}

# ---- the state beacon -------------------------------------------------------
# What this session is DOING, for a human looking at a row of panes: working,
# waiting (on you), input (a prompt is up), or gone. One word, one file, rewritten
# on every lifecycle event; the status line stats it.
#
# It has to be a hook rather than anything the status line could work out for
# itself, because "the agent finished its turn" is not visible in the payload
# Claude Code hands a status line — no field says it, and the render that follows
# a Stop looks exactly like the render that follows a tool call.
#
# THE MTIME IS HALF THE SIGNAL. `working` written twelve minutes ago does not mean
# working; it means a pane that looks busy and has not moved, which is the failure
# quarterback's own v2.46 notes describe — "a prompt no one answers is an outage
# that looks like progress, and N of them is a row of stuck panes that reads as a
# working fleet". Removing the permission prompt did not remove that shape, it
# only removed the version of it a human could see. So every tool call rewrites
# this file even when the content does not change, and the reader treats a stale
# `working` as stalled rather than as fine — the same bargain as qb-health.
#
# Not written on a host with no board: this hook exits above before it gets here,
# and a machine with no fleet has no row of panes to scan.
#
# Three consumers, one write. The FILE is for this pane's own footer (a stat, on
# every render). STATE_NOW rides the next lease to the board, so a dashboard on
# another machine can see it. The tmux PANE OPTION colours the seat cell on the
# screen's own bar, which is the only one of the three that a human reads without
# looking at a pane at all.
#
# The tmux write is behind a change check for one reason: this runs on every tool
# call, and a subprocess there is not free where a `cat` is. Comparing first turns
# the common case (still working, said so a second ago) back into two file reads.
STATE_NOW=""
_state() {   # _state <working|waiting|input>
  local f="${XDG_RUNTIME_DIR:-/tmp}/qb-state-$sid" prev
  prev=$(cat "$f" 2>/dev/null)
  printf '%s\n' "$1" > "$f" 2>/dev/null
  STATE_NOW="$1"
  [ "$prev" = "$1" ] && return 0
  # Backgrounded: the bar is cosmetic and tmux is a socket round trip. $TMUX_PANE
  # is the pane the agent was STARTED in, inherited through the environment —
  # which is exactly right for a seat, and absent (so this no-ops) for a session
  # that is not in tmux at all.
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    ( tmux set-option -p -t "$TMUX_PANE" @qb_state "$1" ) >/dev/null 2>&1 &
  fi
  return 0
}

# PostToolUse now matches EVERY tool (settings.json `*`), not just Task and Bash,
# because the ask courier below has to reach an agent BETWEEN prompts (#107). So
# this is the hook's hottest path by a wide margin and it must not grow: one jq
# reads everything the decision needs, and an ordinary tool call with no mail due
# costs that jq plus one stat — no curl, no git, no transcript.
#
# Three jobs hang off this event and they want different things:
#   task  → close the sub-agent record   (no git)
#   push  → announce the commit          (git)
#   merge → catch this machine's checkouts up (git)
#   other → nothing at all, UNLESS the ask poll is due
#
# `agent_id` is present ONLY when the hook fires inside a sub-agent, and it is the
# only thing that says so — `session_id` is the PARENT's, shared verbatim. That
# matters here because the ask cursor is keyed on the session: a sub-agent that
# polled would consume its parent's mail, advance the cursor past it, and inject
# the note into a context that is about to be discarded. The parent would never
# see the ask and nothing would report it missing. That is the machine-wide bug
# recorded at the cursor below, one level down, and much worse at 45s cadence
# than at one poll per prompt — so the poll is refused outright in a sub-agent.
# (Verified on Claude Code 2.1.232: agent_id/agent_type absent on the main thread.)
pt_kind=""; pt_sub=""; turn_id=""
if [ "$EVENT" = "PostToolUse" ]; then
  { read -r pt_kind; read -r pt_sub; read -r sid; read -r turn_id; } < <(
    printf '%s' "$IN" | jq -r '
      (if .tool_name == "Task" then "task"
       elif (.tool_name == "Bash" and ((.tool_input.command // "") | test("\\bgit\\b.*\\bpush\\b"))) then "push"
       elif (.tool_name == "Bash" and ((.tool_input.command // "") | test("\\bgh\\b.*\\bpr\\b.*\\bmerge\\b"))) then "merge"
       else "other" end),
      (.agent_id // ""),
      (.session_id // ""),
      (.prompt_id // "")' 2>/dev/null)
  [ -n "$sid" ] || exit 0
  # Heartbeat. Above the early exit, because the exit is the common case and a
  # beacon that only ticked on the rare ones would call a busy session stalled.
  # A sub-agent's tool calls count: the parent is working precisely because its
  # Task is. One printf — this is the hook's hottest path and the reason the
  # state lives in a file instead of on the board.
  _state working
  # Poll due? Decided once, for every kind, so a session that only ever pushes
  # still gets its mail. The throttle is a stat and a date compare, never a curl.
  [ -z "$pt_sub" ] && _throttle "askpoll-$sid" 45 && ASK_POLL_DUE=1
  # Nothing to do and nothing to say: leave before the git subprocesses below.
  [ "$pt_kind" = "other" ] && [ -z "${ASK_POLL_DUE:-}" ] && exit 0
fi

sid=$(printf '%s' "$IN" | jq -r '.session_id // empty' 2>/dev/null)
cwd=$(printf '%s' "$IN" | jq -r '.cwd // empty' 2>/dev/null)
tp=$(printf '%s'  "$IN" | jq -r '.transcript_path // empty' 2>/dev/null)
[ -n "$sid" ] || exit 0

repo=""; branch=""
if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
  # Repo identity is the origin remote's, not the directory's: a checkout cloned
  # to a different local name is still the same repo to everyone else, and /sync
  # has to agree with what the MCP tools (which read origin) call it.
  #
  # `owner/name`, not the basename. The basename is what every board surface that
  # KEYS on a repo refuses (`app/claimkey.py`, #148), so a lease reporting one made
  # `/active?repo=prisonblues/lexray` — the spelling `plan_read` had just taught the
  # agent, and the only one it accepts — answer that the coast was clear while three
  # agents worked the repo (#714). The reads fold both shapes now, so this is not
  # what fixes that; it is what stops the fleet's own heartbeat being the thing that
  # needs folding.
  _origin=$(git -C "$cwd" config --get remote.origin.url 2>/dev/null)
  if [ -n "$_origin" ]; then
    # Trailing slashes and one `.git` off the end first, so the slug pattern below
    # need not also decide where the repository name stops. `sed -E` is POSIX ERE
    # and has no lazy quantifier, so a name class that can match `.git` and an
    # optional `(\.git)?` after it hands the suffix to the NAME: the first cut of
    # this reported `prisonblues/quarterback.git`, which `canonical_repo` refuses
    # for exactly the reason it is stripped here — GitHub allows no repository name
    # ending in `.git`, so that spelling can only ever be a clone URL's suffix.
    _url=$(printf '%s' "$_origin" | sed -E 's#/+$##; s#\.git$##')
    # A GitHub remote in any of its spellings (https, ssh://, scp-style, with or
    # without an explicit port), anchored on the host so a *path* remote cannot be
    # read as `owner/name`: `/home/rich/source` would otherwise become `rich/source`,
    # which is the open-domain guessing PR #152 was closed for.
    #
    # `(:[0-9]+)?` cannot eat the scp-style separator even for an all-digit owner
    # (`github.com:123/repo`): ERE backtracks, and the only parse where the tail is
    # an `owner/name` is the one where the port group matched nothing.
    #
    # The scheme and the host are matched CASE-INSENSITIVELY, spelled out as
    # character classes because POSIX ERE has no `(?i)`. Both are case-insensitive
    # by their own specs — URI schemes by RFC 3986, DNS hostnames by RFC 4343 — and
    # git clones `https://GitHub.com/Acme/Widget` happily. A lowercase-only host
    # dropped such a remote through to the bare-name fallback and published
    # `Widget`, which is not wrong enough to notice and not an identity: the one
    # spelling the write path exists to converge on is the one it would silently
    # fail to produce. The owner and name keep whatever case they were cloned
    # under; `app.repomatch.fold_repo` folds that on the way in, which is where a
    # case rule belongs — GitHub preserves repository-name case and this hook is
    # not the thing that gets to decide it.
    repo=$(printf '%s' "$_url" | sed -nE \
      's#^([A-Za-z0-9+.-]+://)?([^@/]+@)?[Gg][Ii][Tt][Hh][Uu][Bb]\.[Cc][Oo][Mm](:[0-9]+)?[:/]+([A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*)$#\4#p')
    # Not a GitHub remote: the bare name is genuinely all this checkout has, and the
    # board's reads accept it. Only the *identity* is unavailable, not the grouping.
    [ -n "$repo" ] || repo=$(printf '%s' "$_url" | sed -E 's#.*[:/]##')
  fi
  # No origin at all: the directory basename is the only name this checkout has,
  # and whether it is worth putting on the board depends on WHOSE directory it is.
  #
  # #714 dropped the fallback outright, for a real case: the panel's per-seat
  # sandbox is a `git init` in a temp directory, so it put `repo: "cwd"` and
  # `branch: "master"` on the board — read, reasonably, as an unexpanded variable.
  # A throwaway repo nobody else can name is not a repo the fleet shares, and
  # reporting one is worse than reporting none: it is a repo name a peer can ask
  # `/active` about and be answered about.
  #
  # But "no origin" is not only the sandbox (#721). An ordinary local-only
  # repository — never pushed anywhere, two agents, two worktrees — reported
  # `repo: NULL` on both leases, and a repo-scoped read cannot match NULL, so
  # `active(repo="<basename>")` answered a clean board while two agents were live
  # in it. That is the same false clean #714 exists to abolish, arriving through
  # the other half of the same field. It is also the opposite of what the board
  # does one function away: `_subagents_in_repo` KEEPS a sub-agent whose parent
  # cannot be placed, because on a collision index "unknown" must not be
  # representable as a clean answer.
  #
  # So the suppression is declared rather than inferred. `QB_SANDBOX` is exported
  # by whoever MADE the throwaway checkout — `panel_seats.run_cli`, for the seat
  # sandboxes that are the whole of the #714 case — and only that process's
  # children go silent. Everything else keeps the bare name, which the board's
  # reads already accept (`app.repomatch.name_clause`): only the *identity* is
  # unavailable there, not the grouping.
  #
  # Inferring it from the checkout instead was the alternative, and there is no
  # test for it that a real repo cannot fail: a fresh `git init` and a local-only
  # repository of ten years' commits differ in nothing the hook can see — not the
  # remote, not the temp-dir prefix (a worktree under /tmp is legitimate), not the
  # branch name. The process that created the directory is the only thing that
  # knows, so it is the thing that says.
  #
  # The name is the REPOSITORY's directory and not this worktree's, which is what
  # makes it an answer two agents can share. #721's whole scenario is a local-only
  # repo with two agents in two worktrees, and `create-worktree` names those
  # `<repo>-<branch>` — so the obvious `--show-toplevel` gives them
  # `quarterback-fix-issue-721` and `quarterback-feat-issue-9`, two repositories on
  # the collision index where there is one, and neither agent can be asked about
  # under the name the other reports. `--git-common-dir` is the one path every
  # worktree of a repo agrees about (verified: resolved absolute it answers
  # `<repo>/.git` from the main checkout and from a linked worktree alike).
  # `/.git` off the end gets the repository directory; the second `.git` strip is
  # for a BARE repo, whose common dir IS the repository directory and
  # conventionally ends in `.git`.
  #
  # Resolved with `cd` and `pwd` rather than asked for absolute, and there is NO
  # fallback under it — deliberately. `--git-common-dir` answers relative to the
  # directory git ran in (`$cwd`, via `-C`) whenever it can: `.git` from the main
  # worktree, an absolute path from a linked one. `--path-format=absolute` would
  # collapse that to one call but arrived in git 2.31, so on an older git it is the
  # branch that does not run — and the only thing left to fall back TO is
  # `--show-toplevel`, the per-worktree name this whole block exists to stop
  # reporting. That is not a degraded answer, it is the defect: an old git would
  # have put `checkout-wt-a` and `checkout-wt-b` on the collision index again,
  # silently, with the test that catches it passing on the box that ran it. `cd`
  # and `pwd` are POSIX and answer identically on every git, so the version
  # question does not arise.
  #
  # `CDPATH=` is load-bearing, not hygiene. `--git-common-dir` answers the BARE
  # relative `.git` from a main checkout, and a `cd` operand that does not begin
  # with `/`, `./` or `..` is searched for on CDPATH first — so an agent whose
  # shell profile exports CDPATH with any entry holding a `.git` lands in somebody
  # else's repository, and the hook publishes a lease for a repo this session is
  # not in. That is #714's own failure made worse: not a name nobody can resolve,
  # a name that resolves to the wrong thing. Measured with a decoy at
  # `$CDPATH/.git`: the substitution came back
  # `/tmp/…/decoy/.git\n/tmp/…/decoy/.git` — wrong, and DOUBLED, because `cd`
  # echoes the directory it landed on whenever CDPATH is what found it. Emptying
  # CDPATH closes both halves at once (no search, so nothing to echo); the
  # `>/dev/null` under it is belt-and-braces so no stdout from `cd` can ever reach
  # the value, whatever a future shell decides to print.
  #
  # The subshell is the guard as well as the resolution. `_root` is empty when the
  # common dir came back empty, when either `cd` fails (the checkout deleted under
  # us, an unreadable git dir) or when `pwd` fails — every one of them short-
  # circuits before `pwd`, so nothing partial is printed. An empty `_root` then
  # yields an empty `repo`: `${_root%/.git}` is empty, `printf` writes nothing, and
  # `sed` over no input outputs nothing. No repo is the safe outcome and the same
  # one a sandbox gets.
  if [ -z "$repo" ] && [ -z "${QB_SANDBOX:-}" ]; then
    _gitdir=$(git -C "$cwd" rev-parse --git-common-dir 2>/dev/null)
    _root=$(
      [ -n "$_gitdir" ] || exit 1
      CDPATH=
      cd "$cwd" >/dev/null 2>&1 || exit 1
      cd "$_gitdir" >/dev/null 2>&1 || exit 1
      pwd
    )
    repo=$(printf '%s' "${_root%/.git}" | sed -E 's#/+$##; s#\.git$##; s#.*/##')
  fi
  branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
fi

# Session title + recap from Claude Code's own metadata (its first-class ai-title
# and, when the session has compacted, the isCompactSummary). Falls back to the
# last prompt from history.jsonl. All best-effort.
# Transcript metadata (title/recap/model) is only used by the session-lifecycle
# events' lease/record payloads — skip the jq passes for the frequent Task-tool
# PreToolUse/PostToolUse events, which carry no transcript context.
title=""; recap=""; model=""
case "$EVENT" in SessionStart|Stop|SessionEnd)
  if [ -n "$tp" ] && [ -r "$tp" ]; then
    title=$(jq -rR 'fromjson? | select(.type=="ai-title") | .aiTitle' "$tp" 2>/dev/null | tail -1)
    recap=$(jq -rR 'fromjson? | select(.isCompactSummary==true)
                    | (.message.content // .content // "")
                    | if type=="array" then (map(.text? // "")|join(" ")) else . end' \
              "$tp" 2>/dev/null | tail -1 | tr '\n' ' ' | cut -c1-500)
  fi
  if [ -z "$recap" ] && [ -r "$HOME/.claude/history.jsonl" ]; then
    recap=$(jq -rc --arg s "$sid" 'select(.sessionId==$s) | .display' \
              "$HOME/.claude/history.jsonl" 2>/dev/null | tail -1 | tr '\n' ' ' | cut -c1-300)
  fi
  # Subject beacon. The title is already computed here for the lease, and it is
  # the only human sentence anything local holds about what this session is FOR
  # ("Pull latest changes and rebuild"). Claude Code does not put it in the
  # status-line payload — `session_name` is absent from a real capture — so a bar
  # that wanted it would have to scan the transcript on every render for a string
  # that changes about twice a session. Written here instead, read there for a
  # stat. Empty titles do not overwrite a good one: an untitled turn is not news.
  [ -n "$title" ] && printf '%s\n' "$title" \
    > "${XDG_RUNTIME_DIR:-/tmp}/qb-title-$sid" 2>/dev/null
  if [ -n "$tp" ] && [ -r "$tp" ]; then
    model=$(jq -rR 'fromjson? | select((.type // .role)=="assistant") | (.message.model // .model // empty)' \
              "$tp" 2>/dev/null | tail -1)
  fi
;; esac

# Instance = this session among the machine's several. QUARTERBACK_INSTANCE wins
# (a human label like "deploy"); otherwise the session-id prefix, byte-identical
# to what qb-mcp computes. IDENT is what the board will call us — used to read our
# own inbox, and assumes (as this hook always has) that the token's name is the
# hostname. Sanitized to the charset the board accepts, so a hand-set label can
# never turn every request into a 400 this fail-open hook would swallow silently.
INSTANCE=$(printf '%s' "${QUARTERBACK_INSTANCE:-${sid:0:8}}" \
           | tr -c 'A-Za-z0-9._~-' '-' | sed -E 's/^[._~-]+//' | cut -c1-40)
IDENT="$AGENT${INSTANCE:+/$INSTANCE}"

_auth=(-H "Authorization: Bearer $TOK")
[ -n "$INSTANCE" ] && _auth+=(-H "X-Agent-Instance: $INSTANCE")
# …and the NAME to go with it, when an operator asked for one (#156). The header
# above is only a key; the board designates the name it allocates against that key,
# allocation is first-contact-wins, and this hook fires on SessionStart — so
# whatever it sends is what the whole session is called. Until this line it sent no
# name request at all, which is why `QUARTERBACK_INSTANCE=seat-3` came up as
# `zeus/cotton-indigo`: the label was a key nobody was ever shown.
#
# qb-env decides the name, and it is the only thing that does — see the reasoning
# there, including why an unset QUARTERBACK_INSTANCE must send nothing rather than
# ask for the hex fragment INSTANCE falls back to.
_name_req=$(qb_requested_name)
[ -n "$_name_req" ] && _auth+=(-H "X-Agent-Name: $_name_req")
_json=(-H 'Content-Type: application/json')

# The command classifier, found beside this script the same way qb-env is — one
# link at a time, because home-manager installs each file as its own flat
# /nix/store path and full resolution walks past the bin/ directory. Empty when
# this install predates it, and the guard treats that as "cannot classify" and
# lets the command through, like every other uncertainty here.
_QB_CLASSIFY="$(dirname "$QB_ENV")/qb-classify-command"
[ -r "$_QB_CLASSIFY" ] || _QB_CLASSIFY=""

_refs() {   # emit the refs array for a post (repo + branch when known)
  jq -nc --arg r "$repo" --arg b "$branch" \
    '([ if $r!="" then {kind:"repo",value:$r} else empty end ]
      + [ if $b!="" then {kind:"branch",value:$b} else empty end ])'
}
# Health beacon for the status line. This hook is the only thing that talks to
# the board on every turn, so it is the only honest source of "is quarterback
# actually working" — a status line that probed the board itself would put a
# network call on every render. One file, overwritten: the content is the
# verdict, the mtime is how fresh that verdict is, and a reader that finds it
# stale should say "unknown" rather than "fine". Written from the two calls that
# fire every turn (_lease on UserPromptSubmit/Stop, _post on status/presence);
# the blob/record calls are deliberately left out, since a 45s upload timing out
# on a huge transcript is not the same as the board being down.
_health() { printf '%s\n' "$1" >"${XDG_RUNTIME_DIR:-/tmp}/qb-health" 2>/dev/null; }

# Name beacon for the status line, same bargain as the health one. Since
# quarterback v2.12 the board DESIGNATES the name half of an identity: what we
# send in X-Agent-Instance is an opaque key, and `zeus/glacier-amber` is the
# spelling peers see and reply to. So "what am I called" is a question only the
# board can answer, and a status line cannot derive it — it could only ask, which
# would be an HTTP call per render. /lease already answers it: the response
# carries `holder`, the canonical identity, and it fires every turn. Cache the
# name half per session and the status line reads it for free.
_namefile="${XDG_RUNTIME_DIR:-/tmp}/qb-name-$sid"
_remember_name() {  # _remember_name <lease response body>
  local holder name
  holder=$(printf '%s' "$1" | jq -r '.holder // empty' 2>/dev/null)
  name="${holder#*/}"
  # Write only on a holder that has a name half. A body we don't recognise (a
  # 409 conflict, say — curl -sS exits 0 on those) must leave a good cached name
  # alone rather than blank the footer on one bad turn.
  if [ -n "$name" ] && [ "$name" != "$holder" ]; then
    printf '%s' "$name" >"$_namefile" 2>/dev/null
  fi
}

# The HTTP status, not curl's exit code. `curl -sS` exits 0 on a 401 as readily as on a
# 200, so a token the board has stopped accepting used to write `ok` into the health
# beacon on every turn: the status line said quarterback was fine while every post it
# made was being dropped. That is the exact failure qb-mcp's own self-heal exists for,
# and the one thing a health beacon must not get wrong. `-f` is deliberately not used —
# it would also throw away the body, which _lease needs.
_http_ok() {   # _http_ok <status> — is this a status the board answered normally with?
  case "$1" in 2*) return 0 ;; *) return 1 ;; esac
}

_post() {   # _post <type> <summary>
  local code
  code=$(curl -sS --max-time 6 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/post" \
       -d "$(jq -nc --arg t "$1" --arg s "$2" --arg sid "$sid" --argjson refs "$(_refs)" \
             '{type:$t, summary:$s, session:$sid, refs:$refs}')" \
       -o /dev/null -w '%{http_code}' 2>/dev/null) || code=""
  if _http_ok "$code"; then _health ok; else _health down; fi
}
_opt() {  # jq expr: merge cwd/title/recap/model when set (shared by lease + record)
  # shellcheck disable=SC2016  # a jq program, not a shell string: $c/$t/$r/$m are jq's
  printf '%s' '(if $c!="" then {cwd:$c} else {} end) + (if $t!="" then {title:$t} else {} end) + (if $r!="" then {recap:$r} else {} end) + (if $m!="" then {model:$m} else {} end)'
}
_lease() {  # claim OR renew (same device re-claim == renew, per the API), carrying context
  # repo/branch ride along so /active + /overlap can match live agents by the
  # git repo they're in (topic self-discovery), not just an identical cwd.
  # State rides the lease rather than getting a call of its own: the hook already
  # posts one on every event that changes a state, and a second endpoint for a
  # field this small would double the traffic to say the same thing. The board
  # only overwrites when a state is actually sent (see LeaseIn.state), so the
  # heartbeat leases that know nothing leave the last report — and its age —
  # alone, which is what makes the age worth reading.
  #
  # `-w '\n%{http_code}'` appends the status on its own last line, so the body and the
  # verdict both survive one call. A 409 is counted as the board answering — a lease
  # conflict says somebody else holds it, which is news about the lease and not about
  # quarterback being reachable — while a 401 or a 500 is not, and used to read `ok`.
  local out code body
  out=$(curl -sS --max-time 6 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/lease" \
       -d "$(jq -nc --arg s "$sid" --arg d "$AGENT" --arg c "$cwd" --arg repo "$repo" --arg br "$branch" \
                 --arg t "$title" --arg r "$recap" --arg m "$model" --arg st "$STATE_NOW" \
             "{session:\$s, device:\$d, ttl:1800} + $(_opt) + (if \$repo!=\"\" then {repo:\$repo} else {} end) + (if \$br!=\"\" then {branch:\$br} else {} end) + (if \$st!=\"\" then {state:\$st} else {} end)")" \
       -w '\n%{http_code}' 2>/dev/null) || out=""
  code="${out##*$'\n'}"; body="${out%$'\n'*}"
  if _http_ok "$code" || [ "$code" = 409 ]; then _health ok; else _health down; fi
  _http_ok "$code" && _remember_name "$body"
  return 0
}
_put_blob() {   # PUT the transcript blob; echo its sha (empty on any failure)
  [ -n "$tp" ] && [ -r "$tp" ] && command -v sha256sum >/dev/null 2>&1 || return 0
  local sha; sha=$(sha256sum "$tp" | cut -d' ' -f1) || return 0
  curl -sS --max-time 45 "${_auth[@]}" -X PUT "$BASE/blob/$sha" --data-binary "@$tp" \
    >/dev/null 2>&1 && printf '%s' "$sha"
}
_record() {     # _record <endpoint> <sha> — snapshot (keep lease) or handoff (release)
  curl -sS --max-time 8 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/$1" \
    -d "$(jq -nc --arg s "$sid" --arg b "$2" --arg c "$cwd" --arg t "$title" --arg r "$recap" --arg m "$model" \
          "{session:\$s, blob:\$b} + $(_opt)")" \
    >/dev/null 2>&1 || true
}
# ---- ending a session (#277) -----------------------------------------
# Starting a session was three primitives; ending one was none at all. What stood
# in for it was expiry, and expiry is a floor rather than a report: an expired
# lease says NOBODY RENEWED, which is the same row whether the work finished, the
# pane was closed, or the agent is thinking hard for nine minutes (#252). #263 is
# the sharper half — a seat whose context was reset kept every claim the previous
# conversation took, renewing them from a conversation with no memory of taking
# them, where passive expiry could never reach them because nothing had died.
#
# One call, and it is the LAST word rather than the only one: the board releases
# the lease with the reason on it and hands back every claim stamped with that
# session, so "this session is over" is a fact somebody reported instead of a
# silence a reader has to interpret.
_end_session() {   # _end_session <session key> <reason>
  curl -sS --max-time 8 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/session/end" \
    -d "$(jq -nc --arg s "$1" --arg r "$2" '{session:$s, reason:$r}')" \
    >/dev/null 2>&1 || true
}

# The session this pane last ran, so a NEW one can end it if nothing else did.
# Keyed on the instance rather than the session, which is the whole point: a seat
# keeps one instance across restarts and resets (that is #263's "the seat is the
# identity; the conversation is the worker"), so this file is the only local
# record that the pane held a different conversation five seconds ago. For a
# session with no QUARTERBACK_INSTANCE the instance IS the session prefix, so the
# file is per-session, never holds anything else, and this whole path no-ops.
_sidfile="${XDG_RUNTIME_DIR:-/tmp}/qb-sid-$AGENT-$INSTANCE"

_supersede_previous() {   # end the conversation this pane held before this one
  local prev
  prev=$(cat "$_sidfile" 2>/dev/null)
  printf '%s' "$sid" > "$_sidfile" 2>/dev/null
  [ -n "$prev" ] && [ "$prev" != "$sid" ] || return 0
  # `superseded`, not `context_reset`, and the distinction is the honest one: all
  # this knows is that a different conversation is now in this pane. SessionEnd
  # knows WHY — Claude Code tells it — and fires first, so on the ordinary paths
  # this is a no-op that the board answers "already ended" to and the precise
  # reason is the one that got recorded. This is the backstop for the endings
  # nothing observed: a killed pane, a crashed CLI, a hook that could not reach
  # the board at the time.
  _end_session "$prev" superseded
}

# ---- the ask courier (v2.13, #107) ------------------------------------------
# A directed ask used to reach an agent only at its next prompt. For a headless
# /epic, /lander or /fix-and-land run that meant one poll at the start and then
# never — and those are exactly the runs where a peer's correction is worth most,
# because they are long, unattended, and building on a premise nobody has checked
# since it was formed. The only channel to one was kill(1).
#
# Same poll, same cursor, same formatter as before; what changed is that it is a
# function, so PostToolUse can call it too and the message lands seconds after
# the tool call rather than at the next human keystroke.

# How many times one TURN may be interrupted. The 45s poll throttle bounds the
# network, not the interruptions, and the cursor stops the same ask being
# re-delivered but not a genuine exchange — so two agents asking each other would
# ping-pong without this. Everything pending coalesces into ONE note (the
# formatter always did), so the cap counts conversations, not messages.
ASK_MAX_PER_TURN=2

_ask_budget_ok() {   # true while this turn still has interrupts left
  local f="${XDG_RUNTIME_DIR:-/tmp}/qb-askturn-$sid" prev n
  # No prompt_id (Claude Code <2.1.196) means no turn to key on. Fall back to a
  # quiet period rather than to no limit — and to a limit that expires, rather
  # than to a per-session counter, which would silently kill the channel for the
  # rest of a long run after two messages.
  [ -n "$turn_id" ] || { _throttle "askquiet-$sid" 300; return; }
  read -r prev n < <(cat "$f" 2>/dev/null || echo "- 0")
  [ "$prev" = "$turn_id" ] || n=0
  [ "${n:-0}" -lt "$ASK_MAX_PER_TURN" ] || return 1
  printf '%s %s\n' "$turn_id" "$(( ${n:-0} + 1 ))" > "$f" 2>/dev/null
  return 0
}

_ask_note() {   # _ask_note [midturn] — echo the note for undelivered asks, or nothing
  local mark cur inbox newcur tail_line
  # Cursor and throttle are per SESSION, not per machine: with several agents on
  # one box a machine-wide throttle meant whichever agent polled first swallowed
  # the window, and a shared cursor meant it also consumed everyone's asks. The
  # `to=` filter is hierarchical server-side, so this inbox is what was sent to
  # this agent by name PLUS what was broadcast to the whole machine. Only asks
  # get here at all (type=ask), so a broadcast status/finding/published can never
  # interrupt a turn — which is the rule that keeps this a channel and not a
  # firehose pointed at an agent's attention.
  mark="${XDG_RUNTIME_DIR:-/tmp}/qb-asks-$AGENT-$INSTANCE"
  cur=$(cat "$mark" 2>/dev/null || echo 0)
  inbox=$(curl -sS --max-time 3 "${_auth[@]}" -G "$BASE/board" \
    --data-urlencode "to=$IDENT" --data-urlencode "since=$cur" --data-urlencode "type=ask" 2>/dev/null)
  [ -n "$inbox" ] || return 0
  newcur=$(printf '%s' "$inbox" | jq -r 'if length>0 then (max_by(.id).id) else empty end' 2>/dev/null)
  # Empty inbox: return WITHOUT spending a budget slot. An interrupt allowance is
  # for messages that exist, and polls mostly find nothing.
  [ -n "$newcur" ] || return 0
  # Budget is checked here, after we know there IS mail and before the cursor
  # moves. Refusing later would advance the cursor past an ask nobody was shown
  # and lose it silently; refusing here just leaves it for the next window.
  if [ "${1:-}" = "midturn" ]; then
    _ask_budget_ok || return 0
    tail_line="Answer directly if it concerns your work. This arrived mid-turn — finish what you are doing first; nothing here needs you to abandon an edit."
  else
    tail_line="Answer directly if it concerns your work."
  fi
  printf '%s' "$newcur" > "$mark" 2>/dev/null
  printf '%s' "$inbox" | jq -rc --arg tail "$tail_line" '
    (. // []) as $a
    | if ($a|length)==0 then ""
      else "📨 quarterback: "+($a|length|tostring)+" message(s) addressed to you:\n"
           + ($a | map("  • " + (.from // "?") + ": " + .summary
                        + "  [reply board_post(type=\"ack\", to=\""+(.from // "")+"\", re="+(.id|tostring)+")]")
              | join("\n"))
           + "\n" + $tail
      end' 2>/dev/null
}

# ---- sync advisories (v2.8) -------------------------------------------------
# The classic devops failure: work lands on one machine, another keeps building
# from a checkout days behind, and nothing tells it. Both halves live here rather
# than in the model's head — publishing is a reflex on push, and the staleness
# note arrives before the turn instead of after the wasted build.

_sync_note() {   # echo the board's advice for THIS checkout, or nothing
  [ -n "$repo" ] && [ -n "$cwd" ] || return 0
  local top have state dirty ahead behind
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || return 0
  # "what I have": recent SHAs, newest first. Sending our own history means the
  # answer is about us whether or not this machine ever ran report_git.
  #
  # The window has to outlive the board's PUBLISHED list, not just the last few
  # commits. The server walks that list newest-first and stops at the first entry
  # we hold (app/sync.py: missing_published) — so one entry inside the window
  # vouches for every older one, but if they've ALL scrolled out it reports the
  # lot as missing. At -n25 that fired on nix-fleet: the newest publish was 32
  # commits back and a checkout that held all six was told to pull all six.
  # Abbreviated SHAs buy most of the depth back — the server prefix-matches
  # anything of MIN_SHA (7) or longer, so ten times the history costs about
  # 3.7kB of query string against the old 1kB, well inside any URL limit, and
  # 12 hex digits is far past collision range for a repo this size.
  have=$(git -C "$top" log -n250 --abbrev=12 --format=%h 2>/dev/null | paste -sd, -)
  [ -n "$have" ] || return 0
  dirty=$([ -n "$(git -C "$top" status --porcelain --untracked-files=no 2>/dev/null)" ] \
          && echo true || echo false)
  state=$(git -C "$top" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)
  behind=$(printf '%s' "$state" | cut -f1); ahead=$(printf '%s' "$state" | cut -f2)

  # branch is omitted when detached rather than sent empty — an empty value is a
  # branch named "" server-side, which matches nothing.
  curl -sS --max-time 4 "${_auth[@]}" -G "$BASE/sync" \
    --data-urlencode "repo=$repo" ${branch:+--data-urlencode "branch=$branch"} \
    --data-urlencode "path=$top" --data-urlencode "have=$have" \
    --data-urlencode "dirty=$dirty" \
    ${behind:+--data-urlencode "behind=$behind"} ${ahead:+--data-urlencode "ahead=$ahead"} \
    2>/dev/null \
  | jq -r 'if .advice then "⬇️ quarterback: " + .advice else empty end' 2>/dev/null \
  | _catchup_offer
}

# THE ADVISORY'S ENDING (#83). "git pull" is the right diagnosis and a manual
# ending, paid once per checkout — which was most of the eleven integration
# merges it took to land six PRs on the day #80 was filed. Naming the command
# that does it costs one line and turns N pulls into one.
#
# Appended here rather than sent from the board, because whether the command
# EXISTS is a property of this machine: a fleet member on an older harness would
# otherwise be told to run something it does not have, which is #422's shape
# exactly — a remedy the stale thing cannot perform.
#
# It offers rather than acts. The merge trigger runs the sweep because the agent
# asked for the merge; this arrives unbidden at the top of somebody's turn, and
# rewriting checkouts nobody asked about is the disaster #45 was filed for even
# when every individual refusal is correct.
_catchup_offer() {
  local line any=0
  while IFS= read -r line; do any=1; printf '%s\n' "$line"; done
  [ "$any" = 1 ] || return 0
  command -v qb-catchup >/dev/null 2>&1 \
    && printf '   `qb-catchup` fast-forwards every checkout here it safely can, and says why for the rest.\n'
  return 0
}

# ---- acting on the origin-moved signal (#83) --------------------------------
# A MERGE IS THE MOMENT THIS MACHINE'S OWN CHECKOUTS GO STALE, and unlike a push
# it is the merging agent that goes stale — `gh pr merge` creates the commit
# server-side and runs no local push, so the very session that landed the work is
# the one now behind. The advisory half already handles "somebody else
# published"; this is the half where the somebody is us.
#
# It is the ending #83 asks for. `qb-catchup` decides what is safe and refuses
# everything else — held, cannot tell, dirty, unpushed, diverged — so this is a
# trigger, not a policy.
#
# SYNCHRONOUS AND BOUNDED, unlike _publish_push next door. Its output is the
# point: an agent that has just merged should be told what moved before it picks
# up the next thing, and a backgrounded report would arrive after the turn it
# belongs to. `timeout` is what keeps a slow remote from holding the hook open,
# and a catch-up that times out costs the note rather than the turn.
_catchup_note() {   # echo what was caught up, or nothing
  [ "${QB_CATCHUP:-1}" = 0 ] && return 0
  [ -n "$cwd" ] || return 0
  local bin out
  bin=$(command -v qb-catchup 2>/dev/null) || bin=""
  # A sibling of $0 only when $0 HAS a directory: invoked by bare name, `${0%/*}`
  # is the name itself and the fallback would be `qb-hook/qb-catchup`.
  [ -n "$bin" ] || { case "$0" in */*) bin="${0%/*}/qb-catchup" ;; esac; }
  [ -n "$bin" ] && [ -x "$bin" ] || return 0
  # AND IT MUST FETCH, which is the opposite of what it looks like. `gh pr merge`
  # talked to the remote, but it did so over HTTPS and created the commit THERE:
  # no local ref moved, so `@{u}` still points at what this machine knew before
  # the merge. Skipping the fetch would make the sweep decide "already current"
  # about every checkout, which is the exact failure this exists to fix, and it
  # would look like it worked.
  if command -v timeout >/dev/null 2>&1; then
    out=$(timeout 25 "$bin" -C "$cwd" 2>/dev/null) || true
  else
    out=$("$bin" -C "$cwd" 2>/dev/null) || true
  fi
  [ -n "$out" ] || return 0
  printf '⬇️ quarterback: a merge landed, so this machine caught up:\n%s' "$out"
}

_publish_push() {   # announce HEAD if a push just put it on the tracking branch
  [ -n "$cwd" ] || return 0
  local top sha up subject
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || return 0
  up=$(git -C "$top" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || return 0
  [ -n "$up" ] || return 0
  # Ask git whether the push landed rather than parsing the tool's output: the
  # remote-tracking ref only advances on a successful push, so HEAD being an
  # ancestor of it IS the success condition. A rejected push leaves it behind.
  git -C "$top" merge-base --is-ancestor HEAD "$up" 2>/dev/null || return 0
  sha=$(git -C "$top" rev-parse HEAD 2>/dev/null) || return 0
  # Dedupe by SHA: a re-push, or a push of some other branch, must not re-announce.
  _once "pub-$sha" || return 0
  # Summary is the commit subject alone: the SHA, branch and remote are already
  # in the refs, and a reader's advisory line re-states them around this text.
  subject=$(git -C "$top" log -1 --format=%s 2>/dev/null | cut -c1-120)
  [ -n "$subject" ] || subject="pushed ${sha:0:7} to $up"

  curl -sS --max-time 6 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/post" \
    -d "$(jq -nc --arg s "$subject" --arg sid "$sid" \
              --arg r "$repo" --arg b "$branch" --arg c "$sha" \
          '{type:"published", summary:$s, session:$sid,
            refs: ([{kind:"commit", value:$c}]
                   + [ if $r!="" then {kind:"repo",value:$r} else empty end ]
                   + [ if $b!="" then {kind:"branch",value:$b} else empty end ])}')" \
    >/dev/null 2>&1 || true
}

# ---- the shared-checkout guard (#185) ---------------------------------------
# The one thing on this board that REFUSES a tool call. Everything else here is
# advisory by construction; this is a `deny`, and it is worth being clear about
# why that is the right shape for exactly this case and no other.
#
# Five times now, agents sharing one working tree have destroyed each other's
# uncommitted work. Four in 65lowther (#185's own evidence: boards 3860, 3879,
# 4004, and the 12-second claim race at 3853) and, tonight, twice in THIS repo's
# checkout — board 6236 and 6241, where a `git reset --hard` in
# /home/rich/source/quarterback took a peer's in-flight review fixes with it.
#
# #185 proposes gating "the first write to a path". That would not have caught
# any of tonight: `git reset --hard` writes no path through Edit/Write, so an
# Edit/Write gate never fires at all. The verbs that actually destroy a PEER's
# uncommitted work are almost all git subcommands run through Bash, which is a
# different event with a different matcher — and that is what this guards.
#
# Why a refusal rather than a note. A note is what we already had: posts
# 3962–3979 are four agents agreeing in English about who owns which file, and
# 4004 landed anyway. The distinguishing feature of this class is that the loss
# is SILENT and INSTANT — there is no later moment at which a warning could still
# help, because the bytes are gone at the instant the command runs. That is the
# one thing on this board worth spending a refusal on.
#
# It is still not a lock, and must not read as one:
#   * it fires ONLY when all three of a destructive verb, a dirty tree, and a
#     live peer in this exact cwd are true, so the ordinary case never sees it;
#   * it names the peer, because the product here is somebody to talk to (#172);
#   * it fails OPEN on every uncertainty — no board, no git, bad JSON, a timeout.
#     A coordination board that is down must never stop anyone from working, and
#     this hook's whole contract is that it cannot block a session.
#   * `QB_ALLOW_SHARED_TREE=1` in front of the command proceeds anyway. An escape
#     hatch is not a weakness of an advisory gate, it is the point of one: the
#     agent that has actually talked to its peer needs a way through, and putting
#     it in the command makes taking it a deliberate, visible act rather than a
#     shrug. A gate with no way past gets disabled wholesale, and then it guards
#     nothing.

# The verbs. Every one of these can destroy uncommitted work that this session
# did not write, and none of them is recoverable from git alone once run.
#
# `git stash` is deliberately NOT here, though it belongs to the same family and
# has taken two working trees on this fleet. It is already refused one layer
# down, by the `reference-transaction` hook `qb-hooks` installs — and that guard
# is strictly better for it: it catches a hand-typed stash outside Claude Code
# entirely, where no PreToolUse exists, and it does not wait for a peer to be
# live, because the shared `refs/stash` stack is a hazard whether or not anyone
# is in the tree right now. A second gate on the same command would only give it
# a second escape hatch under a different name. Use `qb-stash`.
#
# `git switch -f|--discard-changes` is the modern spelling of `checkout -f` and
# was missing from the first cut of this list, which is exactly the failure mode
# a verb list has: it ages against the tool it names. Anything added to git that
# overwrites the working tree belongs here.
#
# `rm -rf` is not here either, and that one is a judgement rather than a
# deferral: it would be far broader and far noisier than the evidence supports —
# five incidents, five git commands. If a sixth is an `rm`, it can be added then,
# on the evidence, exactly as these were.
# Built from parts rather than as one unreadable line — each part is one verb and
# is meant to be checked on its own. `_GITX` swallows a leading `git -C <path>`
# or a `-c foo=bar`, so the guard sees `git -C /shared reset --hard` too. `_TOK`
# is one argument that is NOT a shell operator: it lets a flag or a treeish sit
# between the subcommand and its dangerous half without letting the match run on
# past a `&&` into the next command entirely.
_GITX='git([[:space:]]+-C[[:space:]]+[^[:space:]]+|[[:space:]]+-[^[:space:]]+)*[[:space:]]+'
_TOK='[^[:space:];&|]+'
_QB_DESTRUCTIVE="(^|[;&|]|[[:space:]])${_GITX}("\
"reset[[:space:]]+(${_TOK}[[:space:]]+)*--(hard|merge)"\
"|checkout([[:space:]]+${_TOK})*[[:space:]]+--([[:space:]]|\$)"\
"|checkout[[:space:]]+(-f|--force)([[:space:]]|\$)"\
"|checkout[[:space:]]+\\.(/${_TOK})?([[:space:]]|\$)"\
"|switch[[:space:]]+(${_TOK}[[:space:]]+)*(-f|--force|--discard-changes)([[:space:]]|\$)"\
"|restore([[:space:]]|\$)"\
"|clean[[:space:]]+(${_TOK}[[:space:]]+)*(--force|-[A-Za-z]*[fdxFDX])"\
"|worktree[[:space:]]+remove[[:space:]]+(${_TOK}[[:space:]]+)*(-f|--force)"\
")"

# The PREFILTER, and it is the only regex left in this guard. It is deliberately
# over-broad: it may not refuse anything by itself and it does not try to be
# right, it tries to be CHEAP. This runs on every Bash call in every session on
# this box, so the common case — anything that is not git — has to cost one grep
# and no fork whatever.
#
# Everything that decides has moved to `qb-classify-command`, which tokenises.
# A panel round found nine P1 bypasses in the regex that used to decide here and
# they were one premise wearing nine faces: a regular expression cannot parse a
# shell command. `git -c core.filemode=false reset --hard` was not matched at
# all; `git clean -n && git reset --hard` was exempted by a dry run in a
# different clause; `git status --help; git reset --hard` the same through
# --help; the escape hatch the same through grep's per-LINE `^`. Patching those
# at the lines they name is how #67's loop starts — the special case is the next
# round's finding — so the premise went instead.
_QB_MAYBE='(^|[^[:alnum:]_-])git([[:space:]]|$)'

_deny() {   # _deny <reason>: refuse this tool call, with a reason the agent can act on
  jq -nc --arg r "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",
                          permissionDecision:"deny",
                          permissionDecisionReason:$r}}'
  exit 0
}

_tree_root() {   # _tree_root <path>: the canonical worktree root, or nothing
  # THE WORKTREE ROOT, NOT THE CWD, and #185 says so in as many words: "an agent
  # sitting in 65lowther/viz is in the same tree with a different cwd". Comparing
  # raw cwds makes a peer one directory down invisible, and `git reset --hard`
  # from either of them wrecks the same tree. `-P` on top, since a symlinked path
  # and its target are one tree and two strings.
  #
  # BOTH calls are bounded. Only the first used to be: `git status` and
  # `rev-parse` sit on the interactive hot path now and can block indefinitely on
  # a dead network mount or a slow core.fsmonitor, and a `cd -P` into an
  # unresponsive automount hangs exactly the same way.
  local top
  top=$(timeout 3 git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1
  timeout 3 bash -c 'cd -P "$1" 2>/dev/null && pwd' _ "$top" || printf '%s\n' "$top"
}

_tree_peers() {   # _tree_peers <path>: live peers whose lease names this path
  # `peers_only` needs `mine` to know which lease is ours, or our OWN session
  # comes back as its own collision. Sub-agents count: a peer's fan-out edits the
  # peer's tree with the peer's hands, and losing its work loses the peer's.
  #
  # `select(. != null and . != "")` rather than `//"?"`: an entry with neither
  # holder nor label is an entry we cannot name, and printing a literal `?` into
  # a refusal tells the reader to go and talk to nobody.
  local body
  body=$(curl -sS --max-time 3 "${_auth[@]}" \
           "$BASE/active?cwd=$(jq -rn --arg c "$1" '$c|@uri')&mine=$(jq -rn --arg s "$sid" '$s|@uri')&peers_only=true" \
         2>/dev/null) || return 0
  [ -n "$body" ] || return 0
  printf '%s' "$body" \
    | jq -r '[(.agents//[]),(.subagents//[])|.[]|(.holder//.label)]
             |.[]|select(. != null and . != "")' 2>/dev/null
  return 0
}

_shared_tree_guard() {
  local cmd verdict target root cwdroot dirty names n hatch

  cmd=$(printf '%s' "$IN" | jq -r '.tool_input.command // empty' 2>/dev/null)
  [ -n "$cmd" ] || return 0

  # Fast path, and the only one almost every call takes.
  printf '%s' "$cmd" | grep -Eq "$_QB_MAYBE" || return 0

  # Now pay for an answer. Fail-open on every way this can go wrong: an install
  # without python3, a classifier that errors, output that will not parse.
  [ -n "$_QB_CLASSIFY" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  verdict=$(printf '%s' "$cmd" \
            | timeout 5 python3 "$_QB_CLASSIFY" 2>/dev/null) || return 0
  [ -n "$verdict" ] || return 0

  case $(printf '%s' "$verdict" | jq -r '.destructive // false' 2>/dev/null) in
    true) ;; *) return 0 ;;
  esac
  # A command we could not tokenise is a command we know nothing about, and the
  # one thing that must never be dressed up as knowledge.
  case $(printf '%s' "$verdict" | jq -r '.parsed // false' 2>/dev/null) in
    true) ;; *) return 0 ;;
  esac
  # The escape hatch, as a real leading assignment ON THE CLAUSE THAT MATCHED —
  # which is a fact only the tokeniser has.
  hatch=$(printf '%s' "$verdict" | jq -r '.allowed_by // empty' 2>/dev/null)
  [ -n "$hatch" ] && return 0

  [ -n "$cwd" ] || return 0

  # WHICH TREE IS THIS COMMAND GOING TO TOUCH? Not necessarily the one we are
  # standing in — `git -C ../peer-tree reset --hard` destroys somebody else's
  # while the payload cwd stays clean and unshared, and refusing its mirror image
  # (a private tree, from a shared cwd) is the same defect pointed the other way.
  target=$(printf '%s' "$verdict" | jq -r '.target // empty' 2>/dev/null)
  if [ -n "$target" ]; then
    case "$target" in /*) ;; *) target="$cwd/$target" ;; esac
  else
    target="$cwd"
  fi

  root=$(_tree_root "$target") || return 0
  [ -n "$root" ] || return 0

  # Is there anything to lose? A hard reset in a clean tree destroys nothing
  # uncommitted, and refusing it would be the gate crying wolf on the safest
  # instance of the verb it watches.
  #
  # `--untracked-files=all` is explicit because a repo (or a user) can set
  # `status.showUntrackedFiles=no`, and then the check reads a tree full of a
  # peer's new files as clean — which is board 4004's incident exactly, an
  # untracked half-written file, arriving through the config this time.
  #
  # Assigned, not piped: `$(… | head -c 4000)` reports HEAD's exit status, so a
  # git that died still looked like a clean tree. Truncation happens after, on a
  # string we already hold.
  dirty=$(timeout 3 git -C "$root" status --porcelain --untracked-files=all 2>/dev/null) || return 0
  [ -n "$dirty" ] || return 0
  n=$(printf '%s\n' "$dirty" | grep -c '' 2>/dev/null || echo 0)
  dirty=${dirty:0:4000}

  # Is anyone else in this tree? The ROOT, not the repo: two agents in two
  # worktrees of one repo are not in each other's way, and a gate that refused
  # them would be refusing people who are free.
  #
  # Asked twice when our cwd is a DIFFERENT SPELLING OF THE SAME TREE, because a
  # lease records whatever cwd its session started in and the board matches that
  # string exactly. We can canonicalise our own side; we cannot canonicalise
  # theirs. Guarded on the roots being equal — without that check, `git -C
  # ../private reset --hard` from a shared cwd picks up the SHARED tree's peers
  # and refuses a command that cannot touch them.
  cwdroot=$(_tree_root "$cwd" 2>/dev/null) || cwdroot=""
  names=$( { _tree_peers "$root"
             [ "$cwdroot" = "$root" ] && [ "$cwd" != "$root" ] && _tree_peers "$cwd"
             :; } \
           | sort -u | tr -d '\000-\037' | sed '/^$/d' | tr '\n' '@' | sed 's/@$//; s/@/, /g' )
  [ -n "$names" ] || return 0

  # Two harms, two sentences. The guard knew only one — destroying a peer's
  # uncommitted work — and #185's own evidence says the commoner one is ABSORBING
  # it: board 3879 is an agent's in-flight file committed by somebody else under
  # a message saying the work was not theirs. Nothing was destroyed and its
  # author still lost it. Telling that caller their commit will "destroy" work
  # would be wrong, and being wrong here is how a guard gets read as noise.
  if [ "$(printf '%s' "$verdict" | jq -r '.harm // "destroys"' 2>/dev/null)" = "sweeps" ]; then
    _deny "quarterback: refusing this in a SHARED working tree.

$root has $n uncommitted change(s), and these agents are live in it right now: $names

This stages or commits EVERYTHING uncommitted, and in a shared checkout you cannot tell your files from theirs — so it takes their half-finished work into your commit, under your message. That is board 3879: one agent's in-flight clash.py committed by another as 409bae0, with a message saying the work was not theirs. Nothing was destroyed and its author still lost it.

What to do instead, cheapest first:
  1. Work somewhere else: $(_take_a_worktree "$root")
  2. Name your files: git add <the paths you actually changed>   — never . or -A here
  3. Look first: git status --porcelain   — anything there you did not write is theirs

If you have already settled it with them, put QB_ALLOW_SHARED_TREE=1 in front of the command and it will run."
  fi
  _deny "quarterback: refusing this in a SHARED working tree.

$root has $n uncommitted change(s), and these agents are live in it right now: $names

This command destroys uncommitted work, and in a shared checkout some of that work is theirs — that has now happened five times on this fleet, most recently tonight (board 6236/6241), where a hard reset here took a peer's in-flight review fixes.

What to do instead, cheapest first:
  1. Work somewhere else: $(_take_a_worktree "$root")
  2. Ask first: board_post(type='ask', to='<peer>', summary='about to reset $root — anything of yours in it?')
  3. Save theirs and yours before you swing: qb-stash push   (or git diff > /tmp/tree.patch)

If you have already settled it with them, put QB_ALLOW_SHARED_TREE=1 in front of the command and it will run."
}


case "$EVENT" in
  SessionStart)
    # WHOSE PANE IS THIS, and what was in it before. Both are needed by things
    # outside this session: the stamp is how a ✕ on the seat bar can end the
    # agent it is about to kill (nothing else records a pane's session id, which
    # #266 names as the honest limit of what a fleet view can act on), and the
    # supersede is what closes a conversation whose own ending never reached the
    # board. Backgrounded like the state write below and for the same reason —
    # tmux is a socket round trip and this is cosmetic to the turn.
    if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
      ( tmux set-option -p -t "$TMUX_PANE" @qb_session "$sid" ) >/dev/null 2>&1 &
    fi
    _supersede_previous
    # `waiting`, not `working`: the session exists and nothing has been asked of
    # it yet. A seat started by qb-seats submits its brief within the second and
    # flips to working on its own, so the honest value here costs nothing.
    _state waiting
    _lease
    _post presence "started${repo:+ on $repo}${branch:+ @ $branch}"
    # Stale-checkout note (v2.8), first: it's surfaced before any work starts,
    # which is the only moment it saves a wasted build. Merged with the occupancy
    # note below into one injection.
    SEP=$'\n\n'; start_notes="$(_sync_note)"
    # The mode next, and above the occupancy note on purpose: "several agents are
    # live in this repo" reads completely differently depending on whether this
    # repo expects them to share a tree, and the answer has to arrive first to
    # frame it (#178).
    mode_note="$(_mode_note "$cwd")"
    [ -n "$mode_note" ] && start_notes="${start_notes:+$start_notes$SEP}$mode_note"

    # Presence/collision (v2.7): our lease (with repo) is registered; ask who ELSE
    # is live in this repo — or, for a non-git dir, this exact cwd — self-quieted so
    # our own fan-out never reads as a peer. This is a light "who's around" note; the
    # precise same-problem match happens per prompt (UserPromptSubmit), where the
    # task text is the strongest overlap signal. Fail-open.
    scope=""; where=""
    if [ -n "$repo" ]; then scope="repo=$repo"; where="repo $repo"
    elif [ -n "$cwd" ]; then scope="cwd=$cwd"; where="$cwd"; fi
    if [ -n "$scope" ]; then
      lines=$(curl -sS --max-time 6 "${_auth[@]}" -G "$BASE/active" \
        --data-urlencode "$scope" --data-urlencode "mine=$sid" --data-urlencode "peers_only=true" \
        2>/dev/null \
        | jq -rc '[.agents[] | "  • " + .holder + (if .device then " ("+.device+")" else "" end)
                    + (if .title then " — \""+.title+"\"" else "" end)] | unique | join("\n")' 2>/dev/null)
      if [ -n "$lines" ]; then
        occupancy=$(jq -nr --arg w "$where" --arg l "$lines" \
          '"quarterback: also live in " + $w + ":\n" + $l
            + "\nWorking the same area is fine — that is what the board is for. If any of them is on the same thing, say hi with the `peers` tool or a board post and compare notes; no need to hold off."')
        start_notes="${start_notes:+$start_notes$SEP}$occupancy"
      fi
      # …and then the OTHER question, which the one above cannot ask (#185).
      #
      # `repo` wins the scope, and inside a git repo it always wins — which is
      # exactly where worktrees exist, so `cwd` is never sent and the answer is
      # never about a working tree. That is right for a repo: two agents in two
      # worktrees of one repo are not in each other's way, and "no need to hold
      # off" is the correct thing to tell them.
      #
      # It is backwards for a shared checkout, and on 2026-08-25 it was backwards
      # out loud. This note named the very agents whose uncommitted work was
      # destroyed minutes later (boards 6236, 6241) and closed by saying not to
      # hold off. The repo framing was not wrong about the repo; it was answering
      # a different question from the one that mattered, in a voice that sounded
      # like it had answered it.
      #
      # So ask both. Sharing a repo is company. Sharing a working tree is a tree
      # where `git reset --hard` takes somebody else's morning with it, and it
      # gets its own line, its own names, and the opposite instruction.
      if [ -n "$repo" ] && [ -n "$cwd" ]; then
        # The canonical worktree ROOT, which is what the gate asks about. Asking
        # with the raw cwd meant an agent started one directory down was told
        # nothing at startup and then refused at its first destructive verb —
        # one question, answered two ways, by two parts of the same hook.
        _wtroot=$(_tree_root "$cwd" 2>/dev/null) || _wtroot=""
        sharers=$(curl -sS --max-time 6 "${_auth[@]}" -G "$BASE/active" \
          --data-urlencode "cwd=${_wtroot:-$cwd}" --data-urlencode "mine=$sid" --data-urlencode "peers_only=true" \
          2>/dev/null \
          | jq -rc '[(.agents//[]),(.subagents//[]) | .[] | "  • " + (.holder//.label//"?")
                      + (if .title then " — \""+.title+"\"" else "" end)] | unique | join("\n")' 2>/dev/null)
        if [ -n "$sharers" ]; then
          # WHAT EACH NOTE IS FOR, and why only one of them says the remedy
          # (#464). The mode note above is about POLICY — this repo declares that
          # work belongs in a worktree and you are not in one — and it is true
          # with nobody else here, and stays true after they leave. This one is
          # about PEOPLE: somebody is in this tree with you right now, by name,
          # which is the thing the mode note cannot say.
          #
          # So when the mode note has already given the remedy, this one keeps
          # the names and drops its own. Saying it twice is the smaller problem;
          # saying it twice in two different commands is the real one, and it is
          # what the fleet shipped for an hour.
          if [ -n "$mode_note" ]; then
            _tree_remedy=""
          else
            _tree_remedy=" Give yourself your own tree before you edit anything: \`$(_take_a_worktree "${_wtroot:-$cwd}")\`."
          fi
          # The repo note and this one are about the same peer here, and they say
          # opposite things — "no need to hold off" immediately above "get out of
          # this tree". Where the tree note fires it REPLACES the repo note
          # rather than arguing with it directly above.
          start_notes=$(printf '%s' "$start_notes" \
            | sed '/^quarterback: also live in repo /,/^Working the same area is fine/d')
          start_notes="${start_notes#"${start_notes%%[![:space:]]*}"}"
          shared=$(jq -nr --arg c "${_wtroot:-$cwd}" --arg l "$sharers" --arg r "$_tree_remedy" \
            '"⚠️ quarterback: you are SHARING a working tree, not just a repo. Also in " + $c + ":\n" + $l
              + "\nThis is the one kind of overlap that is not free. Their uncommitted edits are in the same files as yours, so anything you build or test here compiles their half-finished work as if it were yours, and `git reset --hard`, `git checkout --`, `git clean` and `git restore` destroy it outright, while `git commit -a` and `git add .` quietly take it into YOUR commit — that has happened five times on this fleet." + $r + " If you must stay, say so to them first — they cannot see you either."')
          start_notes="${start_notes:+$start_notes$SEP}$shared"
        fi
      fi
    fi
    _inject "$start_notes"
    ;;
  UserPromptSubmit)
    _state working
    # Per-turn coordination reflexes (v2.7), each independently throttled and
    # short-timeout so a turn never stalls; combined into one context injection.
    SEP=$'\n\n'; notes=""
    prompt=$(printf '%s' "$IN" | jq -r '.prompt // empty' 2>/dev/null)

    # (0) CLAIM THE WORK BEFORE DOING IT.
    #
    # Until now the first thing that reached the board about a piece of work was
    # the `published` post at the END of it — exactly when a peer can no longer
    # avoid having duplicated it. On 2026-08-09 three agents each independently
    # diagnosed and fixed the same red CI job (#1544, #1545, and a third folding
    # one into the other); the third had *checked for peers first* and been told
    # the coast was clear. It was not: /overlap ranks peers by their LEASE's
    # subject, and a lease only learned its subject at SessionStart or the
    # previous Stop, so two findings already sitting on the board were invisible
    # to it. An announcement that arrives after the work is the one moment it
    # cannot prevent anything.
    #
    # So refresh the subject from this prompt, and do it BEFORE the discovery
    # query below reads everyone else's. Two agents starting together now both
    # see each other rather than neither. Untitled/unrecapped fields stay as they
    # are — the server only overwrites what we actually send.
    if [ -n "$prompt" ]; then
      recap=$(printf '%s' "$prompt" | tr '\n' ' ' | cut -c1-300)
      _lease
      # ...and say it in the stream too, not just the lease table, so a human and
      # a plain board_read can both see who took what. Throttled per session, and
      # skipped for short follow-ups ("yes", "carry on") that claim nothing new.
      if [ "${#prompt}" -gt 25 ] && _throttle "claim-$sid" 600; then
        _post status "working on: $(printf '%s' "$prompt" | tr '\n' ' ' | cut -c1-140)"
      fi
    fi

    # (a) Directed asks addressed to THIS agent we have not surfaced yet — a peer's
    # question lands in the incumbent's next turn, not a manual board read. The
    # poll itself now lives in _ask_note so PostToolUse can call it too (#107);
    # this is the prompt-boundary delivery and takes no per-turn budget, because a
    # prompt boundary is not an interruption.
    if _throttle "askpoll-$sid" 45; then
      a=$(_ask_note)
      [ -n "$a" ] && notes="$a"
    fi

    # (b) Same-problem discovery on the current task: match the PROMPT (the
    # strongest subject signal) against live peers in this repo and seed a DIRECT
    # ask, so a silent overlap becomes a conversation. Throttled per session.
    if [ -n "$repo" ] && [ -n "$prompt" ] && _throttle "discover-$sid" 600; then
      peers=$(curl -sS --max-time 3 "${_auth[@]}" -G "$BASE/overlap" \
        --data-urlencode "mine=$sid" --data-urlencode "repo=$repo" \
        --data-urlencode "subject=$prompt" 2>/dev/null)
      p=$(printf '%s' "$peers" | jq -rc '
        (.peers // []) as $p
        | if ($p|length)==0 then ""
          else
            ($p | map("  • " + .holder + (if .device then " ("+.device+")" else "" end)
                      + " — \"" + (.title // .recap // "?") + "\""
                      + (if .last_post_id then "  [re #"+(.last_post_id|tostring)+"]" else "" end))
               | join("\n")) as $lines
            | $p[0] as $top
            | "quarterback: another agent is also on this, from a different angle:\n" + $lines
              + "\nOverlap is fine — reach out to compare notes when it helps: board_post(type=\"ask\", to=\"" + $top.holder + "\""
              + (if $top.last_post_id then ", re=" + ($top.last_post_id|tostring) else "" end)
              + ", summary=\"...\")."
          end' 2>/dev/null)
      [ -n "$p" ] && notes="${notes:+$notes$SEP}$p"
    fi

    # (c) Stale checkout (v2.8): a peer published commits this checkout doesn't
    # have. Throttled per session — the SessionStart note covers the start, this
    # catches a peer landing work mid-session, before we build on stale code.
    if [ -n "$repo" ] && _throttle "sync-$sid" 300; then
      s=$(_sync_note)
      [ -n "$s" ] && notes="${notes:+$notes$SEP}$s"
    fi

    if [ -n "$notes" ]; then
      jq -nc --arg c "$notes" \
        '{hookSpecificOutput:{hookEventName:"UserPromptSubmit", additionalContext:$c}}'
    fi
    ;;
  Stop)
    # The turn ended, so the pane is waiting on a human. This is the state the
    # whole beacon exists for: with ten seats open it is the only thing that says
    # which one wants you, and it is invisible from the outside — a finished pane
    # and a thinking pane render identically.
    _state waiting
    _lease   # heartbeat: keep this live session's lease from lapsing
    # freshness: snapshot the transcript (keeps the lease) so a peer can resume
    # mid-session — throttled to bound uploads on long sessions.
    if _throttle "snap-$sid" 120; then sha=$(_put_blob); [ -n "$sha" ] && _record snapshot "$sha"; fi
    ;;
  SessionEnd)
    # WHY, from Claude Code's own payload, because the endings are not one event.
    # `clear` is the pane living on with a new conversation in it — the exact
    # thing #263 is about, and the one ending where an agent's claims outlive the
    # context that took them. Everything else (`logout`, `prompt_input_exit`,
    # `other`, and an older Claude Code that sends no reason at all) is the
    # session going away, which is `finished`: the session reported its own end,
    # which is all that word claims. A reason this does not recognise is NOT
    # forwarded — the board's vocabulary is closed, and a 422 swallowed by this
    # fail-open hook would leave the session unended for the sake of a label.
    case "$(printf '%s' "$IN" | jq -r '.reason // empty' 2>/dev/null)" in
      clear) why=context_reset ;;
      *)     why=finished ;;
    esac
    # The beacons go with the session. A `waiting` left behind by a closed pane
    # would be indistinguishable from one that is still open and wants you, and
    # the session id is never reused.
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/qb-state-$sid" \
          "${XDG_RUNTIME_DIR:-/tmp}/qb-title-$sid" 2>/dev/null
    # Push the transcript so another device can pull + resume. SNAPSHOT, not
    # handoff, and the swap is a bug fix rather than a tidy-up: handoff is what
    # used to release the lease, and it only ran `[ -n "$sha" ]` — so a session
    # with no readable transcript, no sha256sum, or a 45s upload timing out on a
    # huge JSONL never released anything at all and sat on the board as a live
    # agent until its TTL. The two facts are independent and are now two calls:
    # this records the transcript, `_end_session` below ends the session, and
    # neither can take the other down with it.
    sha=$(_put_blob); [ -n "$sha" ] && _record snapshot "$sha"
    _end_session "$sid" "$why"
    # The reason rides the presence post too, so the tape a human scrolls says
    # which kind of ending it was without a second lookup. Only when it is not
    # the ordinary one: "ended" already means finished, and a parenthesis on
    # every session's last line would be the noisiest thing on the board.
    _post presence "ended${repo:+ on $repo}$([ "$why" = finished ] || printf ' — %s' "$why")"
    # Ending releases the lease, which retires the name — it may be another
    # agent's within the minute, so stop claiming it here.
    rm -f "$_namefile" 2>/dev/null
    ;;
  Notification)
    # Claude Code fires this when it wants something from the human: a permission
    # prompt it cannot answer itself, or a session idle at the prompt for 60s.
    # Both mean the same thing to somebody scanning a wall of panes — this one is
    # asking — and neither is visible anywhere else, which is why the event is
    # wired at all (see home/claude/settings.json; it was the one lifecycle event
    # this hook did not receive).
    #
    # Nothing is posted to the board: a permission prompt is between an agent and
    # its operator, and at N panes a post per prompt would be the noisiest thing
    # on the tape. The beacon is enough — it is read by the pane's own footer.
    _state input
    # ...and tell the board, so the dashboard sees it and not just this pane's
    # own footer. Throttled: Claude Code also fires this on a 60s idle, and an
    # idle session must not turn into a lease every minute for the rest of the
    # afternoon.
    _throttle "notify-$sid" 60 && _lease
    ;;
  PreToolUse)
    _state working
    # Two tools reach this event now, and they want opposite things of it. Task
    # is bookkeeping and must never delay the spawn; Bash is the shared-checkout
    # guard (#185) and is the ONE place this hook can still change what happens,
    # because after the command runs the bytes are already gone. One jq for the
    # name, since both branches need it.
    _tool=$(printf '%s' "$IN" | jq -r '.tool_name // empty' 2>/dev/null)
    if [ "$_tool" = "Bash" ]; then
      # Writes a deny to stdout and exits if it decides to; returns otherwise.
      # Nothing else happens on a Bash PreToolUse — the beacon above is the
      # whole of the bookkeeping for it.
      _shared_tree_guard
      exit 0
    fi
    # Sub-agent visibility (v2.6): register a Task/Agent spawn as current-state
    # (never a post). Scoped by the settings.json matcher; the tool_name guard is
    # belt-and-braces. agent_id is a stable hash of the invocation so the
    # matching PostToolUse ends exactly this one. Backgrounded so board latency
    # never delays spawning the sub-agent.
    [ "$_tool" = "Task" ] || exit 0
    # agent_id must be byte-identical between Pre and Post for the same Task call,
    # so canonicalize: recursively sort object keys before serializing (jq's
    # tostring/tojson do NOT honor --sort-keys, and payload key order is not a
    # protocol guarantee). Otherwise Post can't end the subagent it opened.
    aid=$(printf '%s' "$IN" | jq -j '.session_id, (.tool_input | walk(if type=="object" then to_entries|sort_by(.key)|from_entries else . end) | tojson)' 2>/dev/null | sha256sum | cut -c1-16)
    label=$(printf '%s' "$IN" | jq -r '.tool_input | ((.subagent_type // "agent") + ": " + (.description // ""))' 2>/dev/null | cut -c1-80)
    curl -sS --max-time 5 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/subagent" \
      -d "$(jq -nc --arg s "$sid" --arg a "$aid" --arg l "$label" --arg c "$cwd" --arg d "$AGENT" \
            '{parent_session:$s, agent_id:$a, label:$l, cwd:$c, device:$d, ttl:1800}')" \
      >/dev/null 2>&1 &
    ;;
  PostToolUse)
    # ONE additionalContext, ACCUMULATED, not one per thing that has something to
    # say. Two `hookSpecificOutput` objects on stdout is two JSON documents in a
    # stream specified to carry one, and the second is the one that gets dropped
    # — silently, and only when two of these fire in the same tool call. The
    # courier was alone here until the catch-up note (#83) joined it, so this
    # collects and emits once at the end.
    note=""
    # (a) The courier (#107). Runs whatever the tool was. $pt_kind /
    # $ASK_POLL_DUE were decided by the hot-path guard at the top, which has
    # already refused this in a sub-agent.
    if [ -n "${ASK_POLL_DUE:-}" ]; then
      a=$(_ask_note midturn)
      [ -n "$a" ] && note=$a
    fi
    case "$pt_kind" in
      merge)
        # (b) The origin-moved signal, acted on rather than merely reported
        # (#83). A merge through the forge is the one route that leaves the
        # MERGING agent stale, because it runs no local push.
        c=$(_catchup_note)
        [ -n "$c" ] && note="${note:+$note

}$c"
        ;;
      push)
        # Publish reflex (v2.8): a push is the moment every other checkout in the
        # fleet goes stale, so announcing it must not depend on anyone remembering
        # to. The command matched loosely in the guard (`git -C x push`, `… && git
        # push -u origin main`); _publish_push asks git whether the push landed.
        # stdout is closed explicitly rather than merely unused: this branch can
        # now run AFTER the courier has written its JSON, and a backgrounded child
        # holding the hook's stdout open would keep the reader waiting on EOF.
        _publish_push >/dev/null 2>&1 &
        ;;
      task)
        # Same canonical hash as PreToolUse (see there) so we end the exact agent_id we opened.
        aid=$(printf '%s' "$IN" | jq -j '.session_id, (.tool_input | walk(if type=="object" then to_entries|sort_by(.key)|from_entries else . end) | tojson)' 2>/dev/null | sha256sum | cut -c1-16)
        curl -sS --max-time 5 "${_auth[@]}" "${_json[@]}" -X POST "$BASE/subagent/end" \
          -d "$(jq -nc --arg s "$sid" --arg a "$aid" '{parent_session:$s, agent_id:$a}')" \
          >/dev/null 2>&1 &
        ;;
    esac
    [ -n "$note" ] && jq -nc --arg c "$note" \
      '{hookSpecificOutput:{hookEventName:"PostToolUse", additionalContext:$c}}'
    ;;
esac
exit 0

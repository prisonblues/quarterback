#!/usr/bin/env bash
# qb-seat — start ONE seat: a real agent session with its own board identity.
#
# Usage: qb-seat <n> [-C DIR]     start seat <n>, working in DIR (default $PWD)
#        qb-seat -h|--help        this text
#
# Exit codes:
#   0  the agent ran and exited normally
#   1  cannot start (no agent CLI, no such directory)
#   2  malformed arguments — a caller bug, and says so
#
# WHAT THIS IS. Three things and no more: it names the seat on the board, puts it
# in the repo, and execs the agent with a brief. `qb-seats` (its sibling) builds
# the screen and calls this once per pane; nothing else here knows about panes.
#
# It is a separate script from the layout on purpose. The layout is about
# rectangles and could arrange anything; this is the only part that knows the
# thing in the pane is a citizen of a coordination board. Keeping the seam there
# means the multiplexer can be swapped without touching what a seat IS, and the
# brief can be rewritten without touching the screen.
#
# WHY THE INSTANCE IS SET HERE AND NOT ONCE FOR THE HOST. The value goes to the
# board as X-Agent-Instance and is taken as the agent KEY. Two seats sharing one
# are not two agents with muddled inboxes — they are ONE agent: one history, one
# presence, one lease, and, once work claims are atomic, holding each other's
# claims perfectly legitimately, because they are the same holder. So it is set
# per seat, in the seat's own process, and never exported host-wide. `qb-seats`
# additionally strips any inherited value from the session it builds.
#
#   Known gap, worth stating rather than discovering: the instance is a KEY, not
#   a NAME. The board allocates a two-word display name regardless, so a seat set
#   to `seat-3` may appear as `machine/cotton-indigo` with `machine/seat-3` as
#   its permanent alias. Both address the same agent and directed posts reach it
#   under either spelling, so nothing is broken — but seats are not yet *called*
#   what they are numbered. The fix is for the hook that talks to the board to
#   send X-Agent-Name alongside X-Agent-Instance; it lives in the client that
#   owns those headers, not here.
#
# WHAT IT DELIBERATELY DOES NOT DO:
#
#   * No worktree. A self-selecting seat does not know its branch until it has
#     claimed something, and create-worktree is driven per issue by the loop that
#     takes it. A seat that made one up front would be guessing at a name.
#   * No dispatch. Every seat gets the SAME brief. It does not read the plan on
#     the agent's behalf, does not pick an item, and does not know which seat
#     number is meant to do what — the number is an address, not an assignment.
#     A wrapper that assigned would be a dispatcher that runs once at t=0, which
#     is the thing the board exists to remove.
#   * No driving. It execs the agent and is gone. There is no supervisor here to
#     restart it, judge its output, or decide it is stuck.
#
# TWO THINGS THIS FIRST CUT DOES NOT DECIDE, on purpose. Whether a seat re-claims
# when it finishes (a drain) or exits (a batch), and whether it should be
# filtered to one stage of the plan rather than claiming anything free. The brief
# below takes ONE item and stops, which is the conservative half of both: a batch
# cannot run away, and an operator who wants a drain can say so in their own
# brief. Both become safe to revisit once there are appetite gates to bound them.
set -euo pipefail

PROG=${0##*/}
DIR=""
SEAT=""

usage() {
  cat <<EOF
usage: $PROG <n> [-C DIR]

  <n>       seat number — becomes QUARTERBACK_INSTANCE=seat-<n>
  -C DIR    directory to work in (default: \$PWD)

Environment:
  QB_SEAT_AGENT       agent CLI to exec (default: claude)
  QB_SEAT_AGENT_ARGS  extra arguments for it, word-split. An unattended seat
                      usually wants a permission mode that does not stop and
                      wait — e.g. --permission-mode acceptEdits. Deliberately
                      NOT a default: how much rope an agent gets on your machine
                      is your call, not this script's.
  QB_SEAT_BRIEF       file holding the brief, replacing the built-in one. Every
                      seat must get the SAME brief; that is what makes them
                      self-selecting rather than dispatched.
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    -C) DIR=${2:-}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *)  [ -z "$SEAT" ] || { usage >&2; exit 2; }; SEAT=$1; shift ;;
  esac
done

case "$SEAT" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
[ "$SEAT" -ge 1 ] || { usage >&2; exit 2; }

AGENT=${QB_SEAT_AGENT:-claude}
command -v "$AGENT" >/dev/null 2>&1 \
  || die "$AGENT is not on PATH (set QB_SEAT_AGENT to the agent CLI you use)"

if [ -n "$DIR" ]; then
  cd -- "$DIR" 2>/dev/null || die "no such directory: $DIR"
fi

# The seat's identity. Exported, not passed: everything that reports to the board
# on this session's behalf reads it from the environment.
export QUARTERBACK_INSTANCE="seat-$SEAT"

# The brief. Identical for every seat — that is the whole design. It describes a
# loop with no human in it: read what is there, take one thing atomically, and
# treat a refusal as "somebody got there first" rather than something to
# negotiate. The refusal is the coordination; asking a peer to yield would just
# reintroduce the conversation the claim exists to replace.
read -r -d '' BRIEF <<EOF || true
You are seat $SEAT on this machine's agent screen, running as $QUARTERBACK_INSTANCE
on the coordination board. Other seats are running the same brief beside you
right now, and none of you has been assigned anything.

Work like this:

1. Read the board first. Find the shared plan and see what peers have already
   claimed, so you start from what is true rather than from what was true when
   the screen opened.

2. Claim ONE unclaimed item, atomically, before you touch it. If the claim is
   refused, another agent holds it: take the next item instead. Do not ask them
   to hand it over and do not work it anyway — the refusal IS the coordination,
   and it is cheaper than the conversation.

3. Work it. Announce direction as you go so a peer circling the same problem can
   find you, and post what you learn rather than only what you changed.

4. Release the claim when you finish or stop, and say on the board what happened
   to it. Then stop; do not automatically take another item.

You are not in charge of the other seats, and none of them is in charge of you.
Do not assign work to them, wait on them, or hold back because one of them might
be near your area — working the same area is fine and is what the board is for.
EOF

if [ -n "${QB_SEAT_BRIEF:-}" ]; then
  [ -r "$QB_SEAT_BRIEF" ] || die "cannot read QB_SEAT_BRIEF: $QB_SEAT_BRIEF"
  BRIEF=$(cat -- "$QB_SEAT_BRIEF")
fi

# Word-splitting QB_SEAT_AGENT_ARGS is intended: it is a list of arguments, and
# the alternative (an array in the environment) does not survive a shell boundary.
# shellcheck disable=SC2086
exec "$AGENT" ${QB_SEAT_AGENT_ARGS:-} "$BRIEF"

#!/usr/bin/env bash
set -uo pipefail

#:usage
# qb-seat — start one seat of the fleet: a real session, with its own board
# identity, told to claim its own work.
#
# Usage: qb-seat <n> [agent args…]   start seat n in this directory
#        qb-seat <n> --dry-run       print what it would run, start nothing
#        qb-seat <n> -- [args…]      pass everything after -- to the agent as-is
#        qb-seat -h|--help           this text
#
# Exit codes. A --dry-run reaches every one of these refusals too — reporting
# them without starting anything is what it is for:
#   0  --help, or a dry run with nothing to refuse
#   2  a seat number that is not 1-99, or a directory that is not a git worktree
#   3  this seat number is already running in another pane on this machine
#   *  otherwise this process is REPLACED by the agent and exits as it does
#:end-usage
#
# WHAT THIS IS FOR. Five agents on one machine is five terminals, five `cd`s and
# a human reading the plan out loud to each of them — and that human is the part
# that does not scale. A multiplexer supplies the panes; this supplies what goes
# in one. It is deliberately the thinnest thing that can turn a pane into a
# working seat, because everything that would otherwise make it thick already
# exists somewhere better: identity, presence, lease renewal, publish-on-push and
# transcript push all arrive from the lifecycle hooks, and the worktree with its
# isolated database arrives from /fix-issue.
#
# So the whole job is three lines of real work — name the seat, enter the repo,
# start the agent on a brief — and a list of things not to do:
#
#   * It does NOT create a worktree. Under self-selection a seat does not know
#     its branch until it has claimed something, and /fix-issue already provisions
#     one per issue with the per-branch `<project>_<branch>` database that came
#     with PR #30. A spawner that pre-made one would be guessing.
#   * It does NOT dispatch. A spawner that reads the plan and hands seat 1 the
#     first item is hub-and-spoke with a hub that runs once, at t=0, and then
#     stops existing. Every seat gets the SAME brief and self-selects.
#   * It does NOT drive the agent past starting it. That line is not ours to
#     move: the board coordinates work, it does not operate the machine.
#
# WHY THE INSTANCE IS PER SEAT AND NEVER HOST-WIDE. The lifecycle hook keys its
# ask-poll cursor on QUARTERBACK_INSTANCE (`qb-asks-<agent>-<instance>`), so one
# value exported for the whole box gives n seats ONE inbox cursor between them:
# whichever seat polls first advances it past everyone else's mail, and the other
# n-1 never see an ask addressed to them. Set per seat it is the opposite — a
# stable, typeable identity (`zeus/seat-3`, not `zeus/a4f81c2e`) that survives the
# seat being restarted in the same pane, because the board hands a returning key
# its old name back.
#
# WHY IT REGISTERS THE NAME ITSELF, BEFORE STARTING ANYTHING. Since v2.12 the
# board DESIGNATES the name half of an identity: a client sends an opaque key and
# is allocated two words. `QUARTERBACK_INSTANCE=seat-3` is honoured as a *request*
# (`X-Agent-Name`) — but only by the MCP server, and only if it is the first
# thing to touch the board for this key. The lifecycle hook sends the same value
# as a bare key with no name request, it fires on SessionStart, and allocation is
# first-contact-wins: whoever gets there first fixes the name for the whole
# session. So the seat that was meant to be `zeus/seat-3` comes up as
# `zeus/glacier-mist` about as often as not, which loses exactly the property the
# per-seat instance was for. One HTTP call before exec settles it: the row is
# created with the requested name, and every process that follows resolves to it.
#
# Addressing is unaffected either way and always was — the board resolves
# `machine/key` as a permanent alias, so an ask sent to `zeus/seat-3` arrives even
# when the board is calling the seat something else. This is about the name a
# human types and reads on a status bar, which is the entire reason to number
# seats rather than let them be hex.
#
# BEST-EFFORT BY CONSTRUCTION. No board configured, no token, no curl, no
# network: the registration is skipped in silence and the seat still starts. A
# seat that refuses to run because a cosmetic name could not be reserved would
# have cost more than the name is worth — the same bargain qb-stage strikes
# beside it, and the panel's board recording before that.

SEAT_NAME_PREFIX="seat-"
AGENT_BIN="${QB_SEAT_AGENT:-claude}"

# QB_SEAT_YOLO — permission prompts. ON unless this says otherwise, which is the
# unusual direction for a knob like this and is the whole point, so:
#
# WHY THE DEFAULT IS TO SKIP THEM. A seat is a pane nobody is watching. The first
# tool call wanting a permission the agent does not already hold stops it dead,
# and it stops in the one way this design cannot recover from: the pane looks
# busy, the board shows a live agent holding a claim, and the work is not moving.
# There is no operator to answer the question — that is the definition of a seat.
# So a seat that stops to ask is not being careful, it is being stuck, and a
# default that produced N stuck panes would be a default nobody could use without
# first learning the flag that makes the tool work at all.
#
# THIS IS A REAL TRADE AND IT IS MADE DELIBERATELY. It hands a full shell to N
# agents at once in a repo whose tests, hooks and scripts all run as the operator.
# What makes it the right way round HERE and not in general is the blast radius
# either way: a seat that cannot act is useless to everyone, while a seat that can
# act is dangerous in a repo you already trusted enough to point a fleet at. A
# consumer who does not want it says so once — `qb-seats --no-yolo`, or
# QB_SEAT_YOLO=0 in the environment — and gets prompts back everywhere.
#
# FALSY VALUES ONLY TURN IT OFF, which is the mirror of QB_SEAT_FORCE's rule and
# is here for the same reason: the value a caller passes must mean what it says.
# Unset and empty both mean "not answered", and the answer to an unanswered
# question is the default, so only an explicit 0/no/false/off disables it.
#
# THE SPELLING IS CLAUDE'S. `--dangerously-skip-permissions` is not a universal
# flag, and QB_SEAT_AGENT can name anything — so a seat running some other agent
# gets an argument that agent will reject, loudly, at startup. That is the right
# failure: it is visible in the pane in the first second, where a per-agent table
# of flags maintained in a script that deliberately knows nothing about the agent
# would be a second implementation of the agent's own CLI. Point QB_SEAT_AGENT at
# a wrapper, or turn this off for that seat.
seat_yolo_requested() {
    case "${QB_SEAT_YOLO:-}" in
        0|n|N|no|NO|No|false|FALSE|False|off|OFF|Off) return 1 ;;
        *) return 0 ;;
    esac
}

# The brief. Identical for every seat — that is the design, not an omission: the
# moment one seat is told something another is not, there is a dispatcher again.
# Overridable wholesale with QB_SEAT_BRIEF so the layout that owns the fleet can
# retune it without a release here — and set to the empty string to say "no brief
# at all", for a pane meant to come up waiting rather than working.
#
# It stops after one item on purpose. A seat that re-claims when it finishes turns
# the fleet into a drain, which is the eventual shape and is NOT safe yet: nothing
# yet bounds how much work a fleet may take on, and #80 measures integration cost
# as quadratic in open PRs. Batch now, drain when the appetite gates land.
default_brief() {
    cat <<EOF
You are seat $SEAT on this machine — one of several agents working this repo in
parallel, as peers. Nobody is going to hand you work; you take it.

1. Call whoami, then read the board to see what the rest of the fleet is doing.
2. Pick ONE unclaimed item: the shared plan on the board if it has one, otherwise
   an open issue nobody has claimed or is discussing. Prefer the top of the plan —
   the ordering in it is reasoned and is not visible in the issue list.
3. Take it ATOMICALLY before you touch anything, with a work claim on the board
   (kind='work', key='<owner>/<repo>#<number>'). A conflict means another seat got
   there first: do not negotiate and do not ask a human — take the next item.
4. Work it with /fix-issue <number>. That owns the worktree and its database; do
   not create one yourself.
5. When it is done, post a 'done', release your claim, and stop. Do not pick up a
   second item unless someone asks you to.

Never assign work to another seat, and never work an item another seat holds. If
you need something from a peer, post an ask addressed to it and carry on.
EOF
}

# The usage text is the header block between the two markers, printed with the
# comment leader stripped. Delimited rather than addressed by line number: the
# `sed -n '4,15p'` this started as prints whatever happens to be sitting on those
# twelve lines, so the first person to add a paragraph to the top of the file —
# the part of any file that gets edited most — silently turns --help into a dozen
# lines of something else, and nothing anywhere fails.
usage() { sed -n '/^#:usage$/,/^#:end-usage$/p' "$0" | sed '1d;$d;s/^# \{0,1\}//'; }

# --dry-run and --help are taken from anywhere in the argument list rather than
# only from the position the usage shows. Everything after the seat number is
# passed through to the agent verbatim, so a misplaced one would otherwise be
# handed to it — and starting n agents is precisely the thing somebody reaches
# for --dry-run to avoid doing by accident. --help gets the same treatment for
# the same reason: `qb-seat 1 --help` is a request for THIS text, and answering
# it by starting a seat and asking the agent for help is the same surprise in a
# smaller size.
#
# Which does mean a caller cannot pass either word on to the agent — as the value
# of one of its flags, say. `--` is the escape hatch for that: everything after
# it is passed through untouched, and nothing after it is read as ours.
HELP=""
DRY_RUN=""
TERMINATED=""
PASS_THROUGH=()
for arg in "$@"; do
    if [[ -n "$TERMINATED" ]]; then
        PASS_THROUGH+=("$arg")
        continue
    fi
    case "$arg" in
        --) TERMINATED=1 ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help) HELP=1 ;;
        *) PASS_THROUGH+=("$arg") ;;
    esac
done

if [[ -n "$HELP" ]]; then
    usage
    exit 0
fi

# Spelled out rather than written as one of the ${arr[@]+…} one-liners, which are
# easy to write in the form that word-splits and impossible to tell apart from
# the form that does not by reading. An argument with a space in it
# (`--append-system-prompt 'be terse'`) has to arrive at the agent as one word.
if [[ ${#PASS_THROUGH[@]} -gt 0 ]]; then
    set -- "${PASS_THROUGH[@]}"
else
    set --
fi

if [[ $# -eq 0 ]]; then
    printf 'qb-seat: need a seat number\n\n' >&2
    usage >&2
    exit 2
fi

SEAT="$1"
shift

# 1-99. The cap is not a statement about how many seats a fleet may have — it is
# a typo guard, sized so the name stays short enough to type and to fit on a
# status bar. #80's integration ceiling is the real limit on seat count, and it
# is far below 99.
if [[ ! "$SEAT" =~ ^[1-9][0-9]?$ ]]; then
    printf 'qb-seat: %s is not a seat number — expected 1-99\n' "$SEAT" >&2
    exit 2
fi

SEAT_NAME="$SEAT_NAME_PREFIX$SEAT"

# Where the seat works. The layout that declares the panes is the natural place
# for this (zellij and tmux both set a per-pane cwd), so the default is simply
# "here"; QB_SEAT_REPO is for a caller that has no such control.
REPO="${QB_SEAT_REPO:-$PWD}"

if [[ ! -d "$REPO" ]]; then
    printf 'qb-seat: %s is not a directory\n' "$REPO" >&2
    exit 2
fi

# A seat's whole brief is "claim an issue and work it", and every step of that —
# /fix-issue, the worktree, the branch, the PR — needs a repository. A pane whose
# cwd is wrong is the likely cause, and it is much cheaper to say so here than to
# have an agent discover it three tool calls in and improvise.
if ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'qb-seat: %s is not a git repository — check the pane'\''s cwd\n' "$REPO" >&2
    exit 2
fi

# …and a working tree, which `rev-parse --git-dir` does not establish: it
# succeeds in a bare repository and in a .git directory, and a seat started in
# either has nowhere to edit a file. That fails much later and much less clearly
# — /fix-issue gets as far as creating a worktree before anything complains — so
# it is worth the second call to git.
if [[ "$(git -C "$REPO" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
    printf 'qb-seat: %s is a bare git repository — a seat needs a working tree\n' "$REPO" >&2
    exit 2
fi

# ---- one pane per seat -------------------------------------------------------

# Two panes started as the same seat is the failure this script exists to prevent,
# arriving one level down: they export the same QUARTERBACK_INSTANCE, so they send
# the same key, so the board hands them ONE identity and one ask-poll cursor — and
# whichever polls first swallows the other's mail, which is precisely the bug a
# per-seat instance was for. The board cannot see it: from its side the two panes
# are indistinguishable by construction. Nothing else looks either, and both seats
# work, so it is invisible until a peer's ask goes unanswered.
#
# So it is caught here, locally, where the panes actually are. The marker holds
# the pid of the process that becomes the agent (we exec, so it stays this pid),
# in the per-user runtime directory that is already scoped to one login.
#
# XDG_RUNTIME_DIR is not everywhere, though: macOS has none, and neither do most
# containers or an ssh session onto a box with no systemd user session. The
# fallback carries the uid in the NAME, because /tmp is shared and a marker there
# is not. Without it the first user to start seat 3 owns /tmp/qb-seat-3.pid for
# everybody, and the second user's seat cannot write it (tee fails, silently),
# cannot remove it, and reads `kill -0` refusing on someone else's live pid as
# proof that the seat has ended.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    SEAT_MARKER="$XDG_RUNTIME_DIR/qb-seat-$SEAT.pid"
else
    SEAT_MARKER="${TMPDIR:-/tmp}/qb-seat-$UID-$SEAT.pid"
fi

# Is that pid still there? `kill -0` fails for "no such process" and for "not
# yours" alike, and the second one is a process that is very much alive — so
# /proc is asked as well, where there is one, rather than reading EPERM as "the
# seat ended" and starting a second seat on top of a live one.
seat_pid_is_live() {
    kill -0 "$1" 2>/dev/null && return 0
    [[ -d /proc && -d "/proc/$1" ]]
}

# The live holder of this seat's marker, or nothing at all — for a marker that is
# missing, unreadable, corrupt, or left behind by a seat that has since ended.
# Nothing cleans those up, and a pane that could never be restarted would be a
# worse failure than the collision.
seat_marker_holder() {
    local holder
    [[ -r "$SEAT_MARKER" ]] || return 0
    holder=$(cat "$SEAT_MARKER" 2>/dev/null)
    [[ "$holder" =~ ^[0-9]+$ ]] || return 0
    seat_pid_is_live "$holder" || return 0
    printf '%s' "$holder"
}

# QB_SEAT_FORCE is for a marker left by a pid that has since been reused by
# something unrelated. Truthy values only: a layout that spells "off" as
# QB_SEAT_FORCE=0 would otherwise be turning the guard ON, which is what any
# test for "non-empty" does to that variable.
seat_force_requested() {
    case "${QB_SEAT_FORCE:-}" in
        1|y|Y|yes|YES|Yes|true|TRUE|True|on|ON|On) return 0 ;;
        *) return 1 ;;
    esac
}

# Refuses rather than warns: a warning scrolls off the top of a pane in seconds,
# and the cost of being wrong is a seat that quietly shares an inbox for hours.
# Renumbering the pane is the fix.
seat_taken_note() {
    printf 'qb-seat: seat %s is already running here (pid %s).\n' "$SEAT" "$1" >&2
    printf '         Two panes on one seat number share a board identity AND an ask\n' >&2
    printf '         cursor, so one of them silently eats the other'\''s mail. Give this\n' >&2
    printf '         pane a different number, or set QB_SEAT_FORCE=1 if that pid is not\n' >&2
    printf '         really a seat.\n' >&2
}

# The override is not silent. It is an assertion, not a check — the operator is
# telling us that pid is not a seat — and if they are wrong the result is exactly
# the shared-inbox bug above with nothing on screen to say so. One line is the
# only trace a forced start leaves anywhere.
seat_force_note() {
    printf 'qb-seat: seat %s looks taken (pid %s); QB_SEAT_FORCE is set, starting anyway\n' \
        "$SEAT" "$1" >&2
    printf '         — if that pid IS a seat, the two now share one identity and one\n' >&2
    printf '         ask cursor.\n' >&2
}

# Claiming the seat has to be ATOMIC, because the case it exists for is n panes
# started in the same instant by one layout. Check-then-write loses that race by
# construction, and loses it in the direction that matters: both panes look, both
# see a free seat, and the one that got there first is still five seconds deep in
# registering the name with the board when the second one decides it is free.
#
# So the marker is created by hard-linking a fully written temp file into place.
# link(2) fails if the destination exists, which makes claim-or-lose one syscall
# with no window in it; it does not follow a symlink at the destination, so a
# marker path aimed at something else is refused rather than written through; and
# unlike an O_EXCL redirect the file is never briefly empty, so a loser cannot
# read it mid-creation and conclude the seat is stale. The lock IS the marker and
# so survives the exec by construction — it is a file holding a pid, not a
# descriptor holding a lock that would need inheriting.
#
# Exit status: 0 claimed it, 1 somebody live holds it, 2 could not claim it
# either way (a read-only runtime dir, a marker path owned by someone else).
SEAT_HOLDER=""
seat_marker_claim() {
    local tmp attempts
    mkdir -p "$(dirname "$SEAT_MARKER")" 2>/dev/null
    tmp=$(mktemp "$SEAT_MARKER.XXXXXX" 2>/dev/null) || return 2
    # Written with tee for the reason the session markers beside it are: a `>`
    # redirect is refused by the dcg pre-tool guard, so the obvious form is the
    # one that silently does not run when an agent is the caller.
    printf '%s' "$$" | tee "$tmp" >/dev/null 2>&1
    # Bounded, because every trip round is a marker somebody else has just taken
    # away from us; three losses in a row is a machine doing something stranger
    # than starting a fleet, and spinning here would hold up a pane forever.
    for ((attempts = 0; attempts < 3; attempts++)); do
        if ln "$tmp" "$SEAT_MARKER" 2>/dev/null; then
            rm -f "$tmp" 2>/dev/null
            return 0
        fi
        SEAT_HOLDER=$(seat_marker_holder)
        if [[ -n "$SEAT_HOLDER" ]] && ! seat_force_requested; then
            rm -f "$tmp" 2>/dev/null
            return 1
        fi
        [[ -z "$SEAT_HOLDER" ]] || seat_force_note "$SEAT_HOLDER"
        # Stale, corrupt, or forced aside: drop it and race for it again. The
        # loser of THAT race comes back round and finds a live holder.
        rm -f "$SEAT_MARKER" 2>/dev/null || break
    done
    rm -f "$tmp" 2>/dev/null
    return 2
}

# ---- name registration (best-effort; see the header) ------------------------

# The site's board configuration, on the contract the fleet's wrappers already
# share: environment first, then a per-host config file. Referenced by variable
# and by config path, never by the path of another repo's script.
#
# Sourced in a SUBSHELL, with exactly three values read back out of it. A config
# file is an unrestricted shell script — everything it sets, it keeps — so
# sourcing it here would let it replace QUARTERBACK_INSTANCE (leaving a seat
# whose marker, dry-run output and refusals all still say seat-3 while the board
# has been told something else), or REPO, or SEAT, or AGENT_BIN, or PATH, and
# anything it EXPORTS is then inherited by the agent we exec. That is not a threat
# model, it is just what "source a file" means, and it is avoidable for free.
#
# Environment still beats the file, which matters because the fleet spans
# deliberately disjoint boards — a work island whose hosts must never talk to the
# personal one — and an env var quietly overwritten by a config file is how a seat
# posts to the wrong one.
BOARD_URL=""
BOARD_TOKEN=""
BOARD_TOKEN_CMD=""
load_board_config() {
    local config cfg line file_url file_token file_token_cmd

    BOARD_URL="${QUARTERBACK_BASE_URL:-}"
    BOARD_TOKEN="${QUARTERBACK_TOKEN:-}"
    BOARD_TOKEN_CMD="${QUARTERBACK_TOKEN_CMD:-}"

    # HOME is not guaranteed. A container, a systemd unit with no User=, `env -i`
    # — any of them can leave it unset, and under `set -u` merely spelling the
    # default path would then end the seat before it started. A registration
    # documented as best-effort must not be the thing that stops a seat running.
    if [[ -n "${QUARTERBACK_CONFIG:-}" ]]; then
        config="$QUARTERBACK_CONFIG"
    elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        config="$XDG_CONFIG_HOME/quarterback/config"
    elif [[ -n "${HOME:-}" ]]; then
        config="$HOME/.config/quarterback/config"
    else
        return 0
    fi

    # Nothing missing, no reason to read the file at all.
    [[ -z "$BOARD_URL" || ( -z "$BOARD_TOKEN" && -z "$BOARD_TOKEN_CMD" ) ]] || return 0
    [[ -r "$config" ]] || return 0

    # A config that ERRORS is not the same thing as a config that is not there,
    # and `|| true` says it is: a typo in the file leaves whatever it managed to
    # set before the error in play, and starts an unregistered seat in silence.
    # The file's own output goes to stderr, so the operator sees bash's complaint
    # about line 4 and so it cannot be mistaken for one of the three values.
    #
    # The three come back one per line, tagged. That truncates a value spanning
    # lines, and none of these three ever does: a URL, a token, a one-line command.
    cfg=$(
        # shellcheck disable=SC1090
        . "$config" >&2 || exit 1
        printf 'url=%s\n' "${QUARTERBACK_BASE_URL:-}"
        printf 'token=%s\n' "${QUARTERBACK_TOKEN:-}"
        printf 'token_cmd=%s\n' "${QUARTERBACK_TOKEN_CMD:-}"
    ) || {
        printf 'qb-seat: %s could not be read — starting without registering the\n' "$config" >&2
        printf '         name, and with none of what it did set before it failed.\n' >&2
        return 1
    }

    file_url=""
    file_token=""
    file_token_cmd=""
    while IFS= read -r line; do
        case "$line" in
            url=*) file_url="${line#url=}" ;;
            token=*) file_token="${line#token=}" ;;
            token_cmd=*) file_token_cmd="${line#token_cmd=}" ;;
        esac
    done <<<"$cfg"

    [[ -n "$BOARD_URL" ]] || BOARD_URL="$file_url"

    # The credential is taken as a SET, never variable by variable. With a token
    # COMMAND in the environment and a static token in the file, best-of-each
    # authenticates the environment's board with the file's credential — the same
    # cross-island mix-up the per-host config exists to prevent, arriving through
    # the one door a check for "the environment has no static token" leaves open.
    if [[ -z "$BOARD_TOKEN" && -z "$BOARD_TOKEN_CMD" ]]; then
        BOARD_TOKEN="$file_token"
        BOARD_TOKEN_CMD="$file_token_cmd"
    fi
    return 0
}

# Token precedence mirrors the wrappers': an explicit token wins, otherwise the
# per-site command that prints one. A site with neither does not pre-register,
# which is a fine outcome — it just gets a board-designated name.
board_token() {
    local token
    if [[ -n "$BOARD_TOKEN" ]]; then
        printf '%s' "$BOARD_TOKEN"
        return 0
    fi
    [[ -n "$BOARD_TOKEN_CMD" ]] || return 1

    # Bounded, and with stdin closed. The network half of this is bounded already
    # and the reason is the same one: a token command is a secret manager as often
    # as not, and one that decides to prompt — or to sit on a lock, or to retry a
    # dead agent socket — holds up the SEAT, not just the cosmetic name it is
    # being asked for. Nothing here is worth waiting past a few seconds for.
    if command -v timeout >/dev/null 2>&1; then
        token=$(timeout 5 "${BASH:-bash}" -c "$BOARD_TOKEN_CMD" </dev/null 2>/dev/null) || return 1
    else
        token=$(eval "$BOARD_TOKEN_CMD" </dev/null 2>/dev/null) || return 1
    fi

    # First line only, and no carriage returns: a command whose output crosses a
    # Windows-shaped boundary prints CRLF, and the \r left on the end of the first
    # line goes straight into the middle of an Authorization header.
    token="${token//$'\r'/}"
    token="${token%%$'\n'*}"
    [[ -n "$token" ]] || return 1
    printf '%s' "$token"
}

# Ask the board for this seat's name and report what it actually says. The read
# back is the point: the request is honoured only when the name is free, so a
# second pane started as the same seat number is told rather than left to look
# identical to the first one on the board.
register_seat_name() {
    local url token escaped reply status http identity
    load_board_config || return 0
    url="$BOARD_URL"
    [[ -n "$url" ]] || return 0
    command -v curl >/dev/null 2>&1 || return 0
    token=$(board_token) || return 0

    # The token goes in on STDIN, as a curl config, and never in argv: every
    # argument a process is started with is readable by any local process for the
    # life of the call, in `ps` and in /proc/<pid>/cmdline. A bearer token for the
    # fleet's board is not a thing to publish to the whole machine for five
    # seconds, n times per layout. The value is quoted in that config, so the two
    # characters that mean something inside one are escaped first.
    escaped="${token//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"

    # --max-filesize as well as --max-time, because the one bounds how LONG a
    # broken or hostile board may talk and not how MUCH it may say, and this reply
    # is read whole into a shell variable before the agent starts. Measured
    # against curl 8: it bounds a chunked reply with no content-length too, not
    # only a declared one.
    #
    # %{http_code} is asked for explicitly because the status is the whole
    # diagnosis and the body is not: a 401, a 403 and a proxy's 502 HTML all
    # produce a body the parse below simply does not match, which used to leave
    # this returning 0 in silence.
    reply=$(printf 'header = "Authorization: Bearer %s"\n' "$escaped" |
        curl --config - \
            --silent \
            --max-time 5 \
            --max-filesize 65536 \
            --write-out '\n%{http_code}' \
            -H "X-Agent-Key: $SEAT_NAME" \
            -H "X-Agent-Name: $SEAT_NAME" \
            "${url%/}/whoami" 2>/dev/null)
    status=$?
    http="${reply##*$'\n'}"
    reply="${reply%$'\n'*}"

    # Two failures, two different messages, and neither of them is nothing. A
    # connection that never happened is a laptop off the network — normal, and
    # the seat is meant to start anyway. A board that answered 401 is a revoked
    # token or the wrong island's token, and it is worth a line here because the
    # lifecycle hooks are about to fail the same way for the same reason for the
    # rest of the session, quietly. (curl's own message is suppressed rather than
    # shown: -sS printed it to a stderr this call was discarding, so that S never
    # did anything at all.)
    if [[ ! "$http" =~ ^[0-9]{3}$ ]] || [[ "$http" == "000" ]]; then
        printf 'qb-seat: board at %s did not answer (curl exit %s) — starting anyway,\n' \
            "${url%/}" "$status" >&2
        printf '         with whatever name the board ends up giving this key.\n' >&2
        return 0
    fi
    if [[ "$http" != 2* ]]; then
        printf 'qb-seat: the board answered %s — the name was NOT registered, and the\n' "$http" >&2
        printf '         lifecycle hooks are about to be refused the same way. Check the\n' >&2
        printf '         token for this island.\n' >&2
        return 0
    fi

    # Parsed without jq — this must work on a box that has not got it, and the
    # field is a plain string the board controls.
    identity=$(printf '%s' "$reply" |
        sed -n 's/.*"agent"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    [[ -n "$identity" ]] || return 0

    # That sed does not decode JSON, so a value carrying any escape at all (\\,
    # \", /) is not the string the board meant and comparing it would warn
    # about our own parser rather than about the name. Everything the board can
    # answer with here is machine/name in a small alphabet; anything else is a
    # value we cannot read, and the honest response to that is silence.
    [[ "$identity" =~ ^[A-Za-z0-9._/-]+$ ]] || return 0

    # What this catches is a key that was already bound to a designated name on
    # an earlier run — a seat started by hand before this script existed, say.
    # Allocation hands a returning key the name it had, and a request cannot
    # override one that exists, so the seat keeps the two words it was given.
    # Not fatal, and not an addressing problem: `<machine>/seat-N` is the key,
    # which the board resolves as a permanent alias for as long as the row lives.
    #
    # It does NOT catch two panes started as the same seat — they send the same
    # key, so the board hands them the same identity and cannot tell them apart.
    # That one is only visible locally, which is what the pane marker is for.
    #
    # Compared on the last segment rather than as `!= */seat-N`, which requires a
    # slash to be there at all: the day the board answers with a bare name, that
    # pattern makes every seat print these three lines on every start, and three
    # lines nobody needs on every start is how an operator learns to skip the one
    # message here that means something.
    if [[ "${identity##*/}" != "$SEAT_NAME" ]]; then
        printf 'qb-seat: the board calls this seat %s, not .../%s — it was named on an\n' \
            "$identity" "$SEAT_NAME" >&2
        printf '         earlier run and keeps that name. Addressing is unaffected: %s\n' \
            "$SEAT_NAME" >&2
        printf '         and %s both reach it.\n' "$identity" >&2
    fi
    return 0
}

# ---- start the seat ----------------------------------------------------------

# Exported, not passed: the hook and the MCP server are separate processes that
# both have to arrive at this same identity, and the environment is the only
# thing they share.
export QUARTERBACK_INSTANCE="$SEAT_NAME"

# ${VAR+…} rather than ${VAR:-…}: a layout that wants a seat with no initial
# prompt at all sets QB_SEAT_BRIEF= and means it, and the :- form hands that seat
# the full built-in brief instead — the one value an override cannot express.
# Unset means "you choose"; set-and-empty means "nothing", and the agent is then
# started with no positional rather than with an empty string to interpret.
if [[ -n "${QB_SEAT_BRIEF+set}" ]]; then
    BRIEF="$QB_SEAT_BRIEF"
else
    BRIEF="$(default_brief)"
fi

# Prepended, not appended: an explicit argument a caller passed for this seat
# comes after it and so wins any argument the agent resolves last-one-wins.
if seat_yolo_requested; then
    set -- --dangerously-skip-permissions "$@"
fi

# A dry run is checked against the marker for the same reason it prints anything
# at all — it is read-only and it is exactly when you want to be told — but it
# only LOOKS. Claiming would leave a marker behind for a seat that never started.
if [[ -n "$DRY_RUN" ]]; then
    HOLDER=$(seat_marker_holder)
    if [[ -n "$HOLDER" ]]; then
        if seat_force_requested; then
            seat_force_note "$HOLDER"
        else
            seat_taken_note "$HOLDER"
            exit 3
        fi
    fi
    printf 'cwd:      %s\n' "$REPO"
    printf 'instance: %s\n' "$QUARTERBACK_INSTANCE"
    printf 'command:  %s' "$AGENT_BIN"
    # Guarded, because with nothing to print `printf ' %q' "$@"` still applies
    # the format once with the missing argument as the empty string, and shows a
    # `claude ''` that this would never really pass.
    [[ $# -gt 0 ]] && printf ' %q' "$@"
    if [[ -n "$BRIEF" ]]; then
        printf ' -- <brief>\n\n'
        printf '%s\n' "$BRIEF"
    else
        printf '\n'
    fi
    exit 0
fi

# Claimed BEFORE the board call, not after it. Registration takes up to five
# seconds, and a guard that passed five seconds before the marker appears is a
# guard the pane started beside this one walks straight through — which is the
# only case any of this exists for, since a layout starts all n panes at once.
seat_marker_claim
case $? in
    1)
        seat_taken_note "$SEAT_HOLDER"
        exit 3
        ;;
    2)
        printf 'qb-seat: could not claim %s — starting unguarded, so nothing here can\n' \
            "$SEAT_MARKER" >&2
        printf '         tell whether another pane is already this seat.\n' >&2
        ;;
esac

register_seat_name

cd "$REPO" || exit 2

# exec, so the pane holds the agent itself and not a shell wrapping it: a human
# attaching to this seat to interrupt or redirect it should reach the agent, and
# closing the pane should signal the agent rather than a parent that outlives it.
#
# The brief goes after a `--` so that it is read as a prompt whatever it starts
# with. QB_SEAT_BRIEF is documented as a wholesale override, and `--help` is
# about the first thing anybody overrides it with while trying it out; without
# the terminator that one is an option to the agent and never a brief at all.
if [[ -n "$BRIEF" ]]; then
    exec "$AGENT_BIN" "$@" -- "$BRIEF"
else
    exec "$AGENT_BIN" "$@"
fi

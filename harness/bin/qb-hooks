#!/usr/bin/env bash
set -uo pipefail

# qb-hooks — install the harness's git hooks into a repo, without turning off
# the machine's managed ones.
#
# It installs two guards.
#
# A `reference-transaction` hook that refuses to put anything on the SHARED
# `refs/stash` while the repo has linked worktrees (issue #210). `git stash` is
# a C built-in, so a git alias cannot shadow it and a `git-stash` on PATH is
# never consulted; there is no `pre-stash` hook. A ref-transaction refusal is
# the only interception point git offers, which is why the guard lives here and
# not in a wrapper script — it catches a HUMAN typing `git stash` by hand, not
# just the harness's own scripts.
#
# A `pre-push` hook that refuses a multi-head migration graph on a protected
# branch, a branch that has stamped a release number the base already carries
# (issue #343), and a branch that has rewritten or deleted a release entry that
# already shipped (issue #325). All three are silent in a repo the check does not
# apply to — no migrations, no CHANGELOG, no reconciler — because this installs
# into repos that are neither quarterback nor lexray, and a warning nobody there
# can act on is how the whole thing gets uninstalled. See
# `harness/githooks/pre-push`.
#
#   qb-hooks install [--repo <dir>]   idempotent; safe to re-run
#   qb-hooks status  [--repo <dir>]   what is installed and what it delegates to
#   qb-hooks uninstall [--repo <dir>] unset core.hooksPath, leave the dir
#
# `core.hooksPath` REPLACES the hooks directory rather than stacking with it, so
# install re-exports every hook the previously-effective dir provided as a
# symlink to `qb-hook-forward`. On this fleet that dir is a read-only nix store
# path holding a gitleaks `pre-commit`; losing it would be a secret-scanning
# regression introduced by a stash-safety feature.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

die() { echo -e "${RED}qb-hooks: $*${NC}" >&2; exit 1; }

SELF_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

# Two layouts, because the hook sources are data rather than entry points: beside
# bin/ in a source checkout, and under share/ in an installed harness (package.nix
# ships `githooks` with loops/commands/templates for exactly this).
SRC_DIR=""
for cand in "${QB_GITHOOKS_DIR:-}" \
            "$SELF_DIR/../githooks" \
            "$SELF_DIR/../share/quarterback-harness/githooks"; do
    if [[ -n "$cand" && -f "$cand/reference-transaction" ]]; then SRC_DIR="$cand"; break; fi
done
[[ -n "$SRC_DIR" ]] || die "cannot find the githooks sources near $SELF_DIR"

action="${1:-status}"
shift || true
repo=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo) repo="${2:-}"; shift 2 ;;
        -h|--help) sed -n '3,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done
[[ -n "$repo" ]] || repo="$PWD"

git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "$repo is not a git repository"

common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir) \
    || die "could not resolve the common git dir"
hooks_dir="$common/qb-hooks"

# The dir whose hooks we must keep running. Read from global/system only: the
# repo-level value is (or is about to be) ours, and reading it back would make
# a re-install delegate to itself.
effective_delegate() {
    local d top
    d=$(git -C "$repo" config --global --type=path --get core.hooksPath 2>/dev/null) || d=""
    [[ -n "$d" ]] || d=$(git -C "$repo" config --system --type=path --get core.hooksPath 2>/dev/null) || d=""
    # A relative `core.hooksPath` is relative to the directory git RUNS hooks from — the top
    # of the working tree — and not to wherever `qb-hooks install` happened to be invoked
    # from, which for every caller in this harness is some other repo entirely. Unresolved,
    # the `-x` tests below look in the wrong place, find nothing, and leave no `.delegate`
    # marker: the managed hook then silently stops running, which is the exact failure
    # `qb-hook-forward` exists to prevent. (`qb-hook-forward` itself needs no such fix — it
    # runs with the worktree root as its cwd, which is what makes the relative path work.)
    if [[ -n "$d" && "$d" != /* ]]; then
        top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || top=""
        [[ -n "$top" ]] && d="$top/$d"
    fi
    [[ -n "$d" ]] || d="$common/hooks"
    printf '%s' "$d"
}

do_install() {
    local delegate name
    delegate=$(effective_delegate)

    mkdir -p "$hooks_dir" || die "could not create $hooks_dir"
    install -m 0755 "$SRC_DIR/reference-transaction" "$hooks_dir/reference-transaction" \
        || die "could not install reference-transaction"
    install -m 0755 "$SRC_DIR/pre-push" "$hooks_dir/pre-push" \
        || die "could not install pre-push"
    install -m 0755 "$SRC_DIR/qb-hook-forward" "$hooks_dir/qb-hook-forward" \
        || die "could not install qb-hook-forward"

    # Re-export the delegate's hooks. Ours are excluded because each chains to its
    # own delegate below; exporting them here would overwrite the real script with
    # a forwarder and the guard would never run. `*.sample` is git's scaffolding.
    local exported=0
    if [[ -d "$delegate" && "$delegate" != "$hooks_dir" ]]; then
        for h in "$delegate"/*; do
            [[ -e "$h" ]] || continue
            name=$(basename "$h")
            case "$name" in
                *.sample|reference-transaction|pre-push|qb-hook-forward) continue ;;
            esac
            [[ -x "$h" ]] || continue
            ln -sfn "qb-hook-forward" "$hooks_dir/$name" || die "could not export $name"
            exported=$((exported + 1))
        done
    fi

    # Each guard chains to a managed hook of the same name only when this marker is
    # present, so the hot path (there is no such hook, which is the usual case) costs
    # a stat rather than two `git config` invocations. For `reference-transaction`
    # that is per REF UPDATE — every commit, branch, fetch and rebase step — and an
    # early draft resolving the delegate with two `git config` calls made `git branch`
    # 8x slower. `pre-push` is nowhere near as hot; it is done the same way so there
    # is one pattern here rather than two.
    local guard
    for guard in reference-transaction pre-push; do
        if [[ -x "$delegate/$guard" ]]; then
            ln -sfn "qb-hook-forward" "$hooks_dir/$guard.delegate"
        else
            rm -f "$hooks_dir/$guard.delegate"
        fi
    done

    git -C "$repo" config core.hooksPath "$hooks_dir" \
        || die "could not set core.hooksPath (config not writable?)"
    git -C "$repo" config qb.hooksDelegate "$delegate" >/dev/null 2>&1 || true

    echo -e "  ${GREEN}stash guard installed${NC} — 'git stash' in this repo now refuses to"
    echo "  write the shared refs/stash while linked worktrees exist. Use 'qb-stash'."
    echo -e "  ${GREEN}pre-push guard installed${NC} — a push is refused when it would leave a"
    echo "  protected branch multi-headed in migrations, when the branch has stamped a"
    echo "  release number the base already carries, or when it rewrites the text of a"
    echo "  release that already shipped. Silent where none of those applies."
    if [[ "$exported" -gt 0 ]]; then
        echo "  ($exported managed hook(s) re-exported from $delegate)"
    fi
}

do_status() {
    local current delegate
    current=$(git -C "$repo" config --type=path --get core.hooksPath 2>/dev/null) || current=""
    delegate=$(effective_delegate)
    echo "repo:      $repo"
    echo "hooksPath: ${current:-<unset>}"
    echo "delegate:  $delegate"
    if [[ "$current" == "$hooks_dir" && -x "$hooks_dir/reference-transaction" ]]; then
        echo -e "stash:     ${GREEN}installed${NC}"
    else
        echo -e "stash:     ${YELLOW}not installed${NC} (run: qb-hooks install)"
    fi
    if [[ "$current" == "$hooks_dir" && -x "$hooks_dir/pre-push" ]]; then
        echo -e "pre-push:  ${GREEN}installed${NC}"
    else
        echo -e "pre-push:  ${YELLOW}not installed${NC} (run: qb-hooks install)"
    fi
    # An opt-out is deliberate and per-repo, and it is REPORTED, so a repo whose guard
    # has been switched off cannot look like one where it is quietly passing. That is the
    # whole difference between an escape hatch and a hole.
    local knob off
    for knob in qb.prePush.migrationHeads qb.prePush.releaseNumber \
               qb.prePush.releaseBodies qb.prePush.reserveRelease; do
        off=$(git -C "$repo" config --bool --get "$knob" 2>/dev/null) || off=""
        if [[ "$off" == "false" ]]; then
            echo -e "           ${YELLOW}$knob is off${NC} for this repo"
        fi
    done
    local n
    n=$(git -C "$repo" stash list 2>/dev/null | wc -l)
    if [[ "$n" -gt 0 ]]; then
        echo -e "${YELLOW}shared refs/stash holds $n entr$([[ $n -eq 1 ]] && echo y || echo ies)${NC}" \
                "— they predate the guard and belong to nobody in particular."
    fi
}

do_uninstall() {
    git -C "$repo" config --unset core.hooksPath >/dev/null 2>&1 || true
    git -C "$repo" config --unset qb.hooksDelegate >/dev/null 2>&1 || true
    echo "qb-hooks: core.hooksPath unset for $repo"
}

case "$action" in
    install) do_install ;;
    status) do_status ;;
    uninstall) do_uninstall ;;
    -h|--help|help) sed -n '3,34p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown action '$action' (install|status|uninstall)" ;;
esac

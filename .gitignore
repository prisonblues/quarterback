# Python
__pycache__/
*.py[cod]
.venv/
# …and as a bare name too: in a worktree .venv is a *symlink* to the main
# checkout's, and a trailing-slash pattern only matches real directories.
.venv
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
*.local

# Local data
logs/
pgdata/
CLAUDE.local.md

# Worktree bookkeeping: the main checkout's port ledger and a worktree's own
# port. Both are per-machine state written by create-worktree.
.worktree-ports
.worktree-port

# uv resolves this from pyproject.toml on every `uv run`; it is a build artefact
# here, not a pinned input. It reached main once via a stray `git add -A` (99ba651).
# Tracking it is a reasonable choice — but a deliberate one, not an accidental one.
uv.lock

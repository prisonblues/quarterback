# Python
__pycache__/
*.py[cod]
.venv/
# …and as a bare name too: in a worktree .venv is a *symlink* to the main
# checkout's, and a trailing-slash pattern only matches real directories.
.venv
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
*.local

# Local data
logs/
pgdata/
CLAUDE.local.md

# Worktree bookkeeping: the main checkout's port ledger and a worktree's own
# port. Both are per-machine state written by create-worktree.
.worktree-ports
.worktree-port

# uv resolves this from pyproject.toml on every `uv run`; it is a build artefact
# here, not a pinned input. It reached main once via a stray `git add -A` (99ba651).
# Tracking it is a reasonable choice — but a deliberate one, not an accidental one.
uv.lock

# The per-box, per-repo overlay (untracked). What one MACHINE will serve differs
# from what the fleet pins: see .harness-rules.sample and harness_rules.py.
#
# This path WAS tracked, and the migration (`git mv .harness-rules
# .harness-rules.sample`) deletes it. A checkout with LOCAL EDITS to it should copy
# the file aside before pulling that commit — the copy is what becomes this box's
# overlay. And where a repo did the two halves in two commits, both files end up
# tracked: safe, and reported (the sample wins as the baseline and the resolver names
# the file it did not read), finished with
#     git rm --cached .harness-rules
# which untracks it while keeping it on disk. See harness/loops/README.md.
.harness-rules

# Per-machine agent config. Neither was tracked before fc0834b, which committed
# them as ABSOLUTE symlinks from inside a worktree via a stray `git add -A`.
# Checked out into the main repo those paths point at themselves, so every read
# fails ELOOP — and every worktree linking here dead-ends at the same loop.
# create-worktree writes these links itself, relative and per-machine; git must
# not also own them.
.claude/
CLAUDE.md
